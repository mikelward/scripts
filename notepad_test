#!/bin/bash
# Tests for notepad

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$SCRIPT_DIR/notepad"
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0

# run_it <os> [args...]: run notepad with only stub commands on PATH, each
# recording its name and arguments to $calls; uname answers <os>.
run_it() {
    os="$1"
    shift
    bin="$(mktemp -d)"
    log="$bin/calls"
    : > "$log"
    printf '#!/bin/sh\necho %s\n' "$os" > "$bin/uname"
    for name in open xdg-open hexchat scite; do
        printf '#!/bin/sh\necho "%s $*" >> "%s"\n' "$name" "$log" > "$bin/$name"
    done
    chmod +x "$bin"/*
    set +e
    output="$(HOME=/home/user PATH="$bin" "$SCRIPT" "$@" 2>&1)"
    status=$?
    set -e
    calls="$(cat "$log")"
    rm -rf "$bin"
}

check() {
    if test "$status" -ne 0 || test "$calls" != "$1"; then
        echo "  FAIL: status $status, calls: $calls, expected: $1, output: $output"
        return 1
    fi
}

run_test() {
    TESTS_RUN=$((TESTS_RUN + 1))
    if "$2"; then
        echo "ok $TESTS_RUN $1"
        TESTS_PASSED=$((TESTS_PASSED + 1))
    else
        echo "not ok $TESTS_RUN $1"
        TESTS_FAILED=$((TESTS_FAILED + 1))
    fi
}

test_linux() { run_it Linux /tmp/a.txt; check "scite /tmp/a.txt"; }
test_mac() { run_it Darwin /tmp/a.txt; check "open -a TextEdit /tmp/a.txt"; }
test_mac_no_file() { run_it Darwin; check "open -a TextEdit"; }

run_test "Linux runs SciTE" test_linux
run_test "macOS opens the file in TextEdit" test_mac
run_test "macOS with no file opens TextEdit" test_mac_no_file

echo
echo "$TESTS_RUN tests, $TESTS_PASSED passed, $TESTS_FAILED failed"
test "$TESTS_FAILED" -eq 0
