#!/bin/bash
# Tests for setup-tide: switching to greetd, and what the greeter runs
#
# The harness, its fixtures and mocks are in setup-tide_testlib.

# shellcheck source=setup-tide_testlib
. "$(dirname "$0")/setup-tide_testlib"

set -e

# --- greetd ---

# On a GDM machine, greetd becomes the display manager from the next boot,
# running tide's greeter as the user and on the VT this greetd needs.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; run
check "greetd: installs greetd" has "$calls" "sudo apt-get install -y greetd"
check "greetd: the config is tide's, with Debian's user and VT" \
    test "$(cat "$T/etc/greetd/config.toml")" = "$(sed -e 's/^user = .*/user = "_greetd"/' -e 's/^vt = .*/vt = 7/' "$T/greetd.toml")"
check "greetd: the config is root's" has "$calls" "sudo install -D -m 644"
check "greetd: checks greetd's user can run each command the greeter starts" \
    test "$(printf '%s\n' "$calls" | grep -c "^sudo -u _greetd env PATH=$T/usr-local-bin:$T/usr-bin /bin/sh -c _p=")" -eq 4
check "greetd: and asks its own Hyprland for its version" \
    has "$calls" "sudo -u _greetd env PATH=$T/usr-local-bin:$T/usr-bin /bin/sh -c Hyprland --version"
check "greetd: notes the display manager it replaces" test "$(cat "$T/var/lib/setup-tide/previous-display-manager")" = gdm3.service
check "greetd: takes the display manager's alias" has "$calls" "sudo systemctl enable --force greetd.service"
check "greetd: is the display manager" test "$(cat "$T/dm")" = greetd.service
check "greetd: starts nothing now, which would end this session" lacks "$calls" "--now greetd"
check "greetd: restarts nothing" lacks "$calls" "restart"
check "greetd: says when, and the way back" \
    has "$output" "From the next boot, greetd's greeter replaces gdm3.service. If it doesn't come up, press Ctrl+Alt+F3, log in, and run 'sudo systemctl enable --force gdm3.service && sudo systemctl disable greetd.service', or rerun 'setup --no-greeter'"
check "greetd: says where to pick tide" has "$output" "Pick the \"tide\" session at greetd's greeter; KDE Plasma stays available there."
check "greetd: gives greetd's user a home outside /etc" \
    has "$calls" "sudo install -d -m 700 -o 999 -g 999 $T/var/lib/tide-greeter"
check "greetd: and makes it its home" has "$calls" "sudo usermod -d $T/var/lib/tide-greeter _greetd"
check "greetd: the run succeeds" test "$status" -eq 0
# A rerun keeps the note of what greetd replaced.
: > "$CALLS"
run
check "greetd: a rerun doesn't switch again" lacks "$calls" "enable --force"
check "greetd: a rerun keeps the note of GDM" test "$(cat "$T/var/lib/setup-tide/previous-display-manager")" = gdm3.service
check "greetd: a rerun keeps the greeter's home" lacks "$calls" "usermod"
# --no-greeter puts GDM back.
: > "$CALLS"
ARGS=(--no-greeter); run
check "--no-greeter: puts back what greetd replaced" has "$calls" "sudo systemctl enable --force gdm3.service"
# A greetd unit that's wanted by a target too would start beside it.
check "--no-greeter: and disables greetd" has "$calls" "sudo systemctl disable greetd.service"
check "--no-greeter: GDM is the display manager" test "$(cat "$T/dm")" = gdm3.service
check "--no-greeter: says so" has "$output" "gdm3.service is the display manager again from the next boot"
check "--no-greeter: installs no greetd" lacks "$calls" "install -y greetd"
check "--no-greeter: leaves the session's own greeting" has "$output" "Log out and pick the \"tide\" session"
# And when greetd isn't the display manager, --no-greeter does nothing.
: > "$CALLS"
run
check "--no-greeter: with GDM, touches no display manager" lacks "$calls" "enable --force"
teardown

# Without --greeter or --no-greeter, the display manager is left alone: on
# a GDM machine, tide is one more session at GDM's login screen.
setup; ARGS=(); echo gdm3.service > "$T/dm"; run
check "default: installs no greetd" lacks "$calls" "install -y greetd"
check "default: enables no display manager" lacks "$calls" "systemctl enable"
check "default: GDM stays the display manager" test "$(cat "$T/dm")" = gdm3.service
check "default: writes no greetd config" test ! -e "$T/etc/greetd/config.toml"
check "default: notes no display manager" test ! -e "$T/var/lib/setup-tide/previous-display-manager"
check "default: says how to switch, once" \
    test "$(printf '%s\n' "$output" | grep -c "Leaving gdm3.service as the display manager; 'setup --greeter' makes tide's greeter the login screen")" -eq 1
check "default: says where to pick tide" has "$output" "Log out and pick the \"tide\" session"
check "default: the run succeeds" test "$status" -eq 0
# Once --greeter has made greetd the display manager, a plain rerun keeps it
# and puts its config right.
ARGS=(--greeter); run
rm "$T/etc/greetd/config.toml"
: > "$CALLS"
ARGS=(); run
check "default after --greeter: greetd stays the display manager" test "$(cat "$T/dm")" = greetd.service
check "default after --greeter: puts GDM back for no boot" lacks "$calls" "enable --force gdm3.service"
check "default after --greeter: rewrites greetd's config" \
    test "$(cat "$T/etc/greetd/config.toml")" = "$(sed -e 's/^user = .*/user = "_greetd"/' -e 's/^vt = .*/vt = 7/' "$T/greetd.toml")"
check "default after --greeter: says where to pick tide" has "$output" "Pick the \"tide\" session at greetd's greeter"
check "default after --greeter: the run succeeds" test "$status" -eq 0
teardown

# A greetd that setup didn't make the display manager keeps its own config.
setup; ARGS=(); echo greetd.service > "$T/dm"
mkdir -p "$T/etc/greetd"; echo mine > "$T/etc/greetd/config.toml"
run
check "default, greetd by hand: leaves its config" test "$(cat "$T/etc/greetd/config.toml")" = mine
check "default, greetd by hand: stays the display manager" test "$(cat "$T/dm")" = greetd.service
check "default, greetd by hand: disables nothing" lacks "$calls" "disable greetd"
check "default, greetd by hand: says why, once" \
    test "$(printf '%s\n' "$output" | grep -c "Leaving greetd's config as it is, since setup didn't make greetd the display manager; 'setup --greeter' has it run tide's greeter")" -eq 1
check "default, greetd by hand: the run succeeds" test "$status" -eq 0
teardown

# Without a note, --no-greeter can't guess what to put back.
setup; ARGS=(--no-greeter); echo greetd.service > "$T/dm"; run
check "--no-greeter: without a note, says what to run" has "$output" "setup doesn't know which one it replaced; enable yours, as in 'sudo systemctl enable --force gdm.service && sudo systemctl disable greetd.service'"
check "--no-greeter: without a note, touches nothing" lacks "$calls" "enable --force"
check "--no-greeter: without a note, isn't fatal" test "$status" -eq 0
teardown

# A note that isn't a unit's name never reaches systemctl.
setup; ARGS=(--no-greeter); echo greetd.service > "$T/dm"
mkdir -p "$T/var/lib/setup-tide"; echo 'gdm3.service; reboot' > "$T/var/lib/setup-tide/previous-display-manager"
run
check "--no-greeter: a bad note isn't used" lacks "$calls" "enable --force gdm3"
teardown

# A machine with no display manager: greetd replaces the text console, and
# --no-greeter disables it again.
setup; ARGS=(--greeter); run
check "greetd: with no display manager, notes none" test "$(cat "$T/var/lib/setup-tide/previous-display-manager")" = none
check "greetd: and says the way back" has "$output" "replaces the text console login. If it doesn't come up, press Ctrl+Alt+F3, log in, and run 'sudo systemctl disable greetd.service'"
ARGS=(--no-greeter); run
check "--no-greeter: disables greetd where there was none" has "$calls" "sudo systemctl disable greetd.service"
check "--no-greeter: leaving no display manager" test ! -s "$T/dm"
teardown
# One whose unit doesn't name the alias, made the display manager by hand,
# doesn't take it back when enabled, and disabling greetd would leave none.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; run
: > "$CALLS"
ARGS=(--no-greeter); run FAKE_ENABLE_NO_ALIAS_FOR=gdm3.service
check "--no-greeter: an old display manager that doesn't take the alias back is enabled" has "$calls" "sudo systemctl enable --force gdm3.service"
check "--no-greeter: and greetd stays" test "$(cat "$T/dm")" = greetd.service
check "--no-greeter: and isn't disabled" lacks "$calls" "systemctl disable greetd.service"
check "--no-greeter: and says what to do" has "$output" "enabling gdm3.service didn't make it the display manager again, as its unit would with Alias=display-manager.service, so greetd stays; make gdm3.service the display manager, then run 'sudo systemctl disable greetd.service'"
check "--no-greeter: and doesn't say it's back" lacks "$output" "gdm3.service is the display manager again"
teardown
# Nor when systemd won't say which is the display manager after.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; run
: > "$CALLS"; : > "$T/dm-queries"
ARGS=(--no-greeter); run FAKE_DM_QUERY_FAILS_FROM=2
check "--no-greeter: a display manager systemd won't say after leaves greetd" lacks "$calls" "systemctl disable greetd.service"
check "--no-greeter: and says so" has "$output" "couldn't ask systemd whether gdm3.service is the display manager again, so greetd stays; once it is, run 'sudo systemctl disable greetd.service'"
teardown

# Each thing the greeter needs is checked before greetd takes over, and
# what's missing is named; the display manager stays.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; run FAKE_MISSING=greetd
greeter_not_ready "no greetd" "greetd isn't installed"
check "greetd: no greetd says it couldn't be installed" has "$output" "couldn't install greetd"
teardown
# Without its own PAM file, PAM's fallback checks greetd's logins.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; rm "$T/pam.d/greetd"; run
greeter_not_ready "no PAM file for greetd" "greetd has no PAM file at $T/pam.d/greetd or $T/vendor-pam.d/greetd, and PAM's fallback for one can refuse every login"
teardown
# PAM reads the vendor's when PAM_DIR has none, and the keyring's lines go
# in a copy of it in PAM_DIR, which PAM then reads in its place.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; rm "$T/pam.d/greetd"; mkdir -p "$T/vendor-pam.d"
printf '#%%PAM-1.0\n@include login\n' > "$T/vendor-pam.d/greetd"; cp "$T/vendor-pam.d/greetd" "$T/original-pam"; run
check "greetd: a PAM file only in the vendor's directory is the greeter's" test "$(cat "$T/dm")" = greetd.service
check "keyring: a vendor's PAM file gains it in a copy in PAM's own directory" \
    test "$(cat "$T/pam.d/greetd")" = "$(cat "$T/original-pam"; printf '\n# Unlock gnome-keyring with the login password (setup-tide).\nauth       optional     pam_gnome_keyring.so\nsession    optional     pam_gnome_keyring.so auto_start')"
check "keyring: and leaves the vendor's alone" cmp -s "$T/vendor-pam.d/greetd" "$T/original-pam"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; rm "$T/greetd.toml"; run
greeter_not_ready "no template" "tide's greetd config isn't installed at $T/greetd.toml"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; : > "$T/passwd"; run
greeter_not_ready "no greetd user" "greetd has no system account to run the greeter as (setup looked for greeter _greetd greetd)"
teardown
# The Hyprland on the greeter's PATH is the one checked, not this user's.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; run FAKE_GREETER_HYPRLAND_VERSION=0.55.0
greeter_not_ready "an old Hyprland" "the greeter's Hyprland is 0.55.0, and it needs 0.56 or later"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; run FAKE_HYPRLAND_VERSION=0.55.0
check "greetd: an old Hyprland only on this user's PATH doesn't stop the switch" test "$(cat "$T/dm")" = greetd.service
teardown
# Its Quickshell has to load the greeter's QML, so it's asked too.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; run FAKE_GREETER_QS_VERSION="quickshell 0.2.1, revision 0000000, distributed by: Debian"
greeter_not_ready "an old Quickshell" "the greeter's Quickshell is 0.2.1, and it needs 0.3.0 or later"
check "greetd: asks its own qs for its version" has "$calls" "sudo -u _greetd env PATH=$T/usr-local-bin:$T/usr-bin /bin/sh -c qs --version"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; run FAKE_GREETER_QS_VERSION="Quickshell nightly"
greeter_not_ready "a Quickshell of no known version" "the greeter's Quickshell is of no version setup can read, and it needs 0.3.0 or later"
teardown
# A prerelease of the version needed isn't that version.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; run FAKE_GREETER_QS_VERSION="Quickshell 0.3.0-rc1 (revision 0000000)"
greeter_not_ready "a prerelease Quickshell" "the greeter's Quickshell is of no version setup can read, and it needs 0.3.0 or later"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; run FAKE_GREETER_HYPRLAND_VERSION=0.56.0-rc1
greeter_not_ready "a prerelease Hyprland" "the greeter's Hyprland is of no version setup can read, and it needs 0.56 or later"
teardown
# The one first on the greeter's PATH is the one asked.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"
printf '#!/bin/sh\necho "quickshell 0.2.1, revision 0000000" >&2\n' > "$T/usr-local-bin/qs"; chmod +x "$T/usr-local-bin/qs"
run
greeter_not_ready "an old Quickshell ahead of a new one on the PATH" "the greeter's Quickshell is 0.2.1, and it needs 0.3.0 or later"
teardown
# Stands in for a build in a home directory, which greetd's user can't reach.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; rm "$T/usr-bin/qs"; run
greeter_not_ready "a qs greetd's user can't run" "greetd's user _greetd can't run qs from $T/usr-local-bin:$T/usr-bin"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; rm "$T/usr-bin/hyprctl"; run
greeter_not_ready "a hyprctl greetd's user can't run, which ends its Hyprland," "greetd's user _greetd can't run hyprctl from $T/usr-local-bin:$T/usr-bin"
teardown
# Each has to be a program the kernel can start: an ELF file, or a script
# whose #! names what runs it, which has to be there, and root's alone, as
# does what env finds on the greeter's PATH.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; printf 'not a program\n' > "$T/usr-bin/tide-greeter"; run
greeter_not_ready "a tide-greeter that isn't a program" "greetd's user _greetd can't start tide-greeter: $T/usr-bin/tide-greeter isn't a program the kernel can start: it's neither an ELF file nor a script whose #! names what runs it"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; printf '#!/nonexistent/sh\n' > "$T/usr-bin/tide-greeter"; run
greeter_not_ready "a tide-greeter whose interpreter isn't there" "greetd's user _greetd can't start tide-greeter: $T/usr-bin/tide-greeter is run by /nonexistent/sh, which isn't there or can't be run"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; mkdir -p "$T/interp"; printf '#!/bin/sh\n' > "$T/interp/sh"; chmod +x "$T/interp/sh"
chmod o+w "$T/interp/sh"; printf '#! %s -e\n' "$T/interp/sh" > "$T/usr-bin/tide-greeter"; run
greeter_not_ready "a tide-greeter run by an interpreter others can write" "the greeter's tide-greeter isn't root's alone: $T/usr-bin/tide-greeter is run by $T/interp/sh: users other than root can write $T/interp/sh"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; printf '#!/usr/bin/env sh\n' > "$T/usr-bin/tide-greeter"; run
greeter_not_ready "a tide-greeter run by an env's interpreter not on the greeter's PATH" "greetd's user _greetd can't start tide-greeter: $T/usr-bin/tide-greeter is run by env's sh, which isn't on its PATH, $T/usr-local-bin:$T/usr-bin, as a program it can run"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; printf '#!/usr/bin/env -S sh -e\n' > "$T/usr-bin/tide-greeter"; run
greeter_not_ready "a tide-greeter run by env with options" "greetd's user _greetd can't start tide-greeter: $T/usr-bin/tide-greeter is run by env with -S sh -e, which setup can't follow"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; mkdir -p "$T/usr-local-bin"; printf '#!/bin/sh\n' > "$T/usr-local-bin/greeter-sh"
chmod +x "$T/usr-local-bin/greeter-sh"; chmod o+w "$T/usr-local-bin/greeter-sh"; printf '#!/bin/sh\n' > "$T/usr-bin/greeter-sh"; chmod +x "$T/usr-bin/greeter-sh"
printf '#!/usr/bin/env greeter-sh\n' > "$T/usr-bin/tide-greeter"; run
greeter_not_ready "a tide-greeter run by env, with one of that name on the greeter's PATH others can write" "the greeter's tide-greeter isn't root's alone: $T/usr-bin/tide-greeter is run by env's greeter-sh, $T/usr-local-bin/greeter-sh: users other than root can write $T/usr-local-bin/greeter-sh"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; printf '#!/bin/sh\n' > "$T/usr-bin/greeter-sh"; chmod +x "$T/usr-bin/greeter-sh"
printf '#!/usr/bin/env greeter-sh\n' > "$T/usr-bin/tide-greeter"; run
check "greetd: a tide-greeter run by env's interpreter on the greeter's PATH, a script itself, is the greeter's" test "$(cat "$T/dm")" = greetd.service
teardown
# env by another name, through a link, is still env.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; mkdir -p "$T/usr-local-bin" "$T/interp"; ln -s /usr/bin/env "$T/interp/envalias"
printf '#!/bin/sh\n' > "$T/usr-local-bin/greeter-sh"; chmod +x "$T/usr-local-bin/greeter-sh"; chmod o+w "$T/usr-local-bin/greeter-sh"
printf '#!%s greeter-sh\n' "$T/interp/envalias" > "$T/usr-bin/tide-greeter"; run
greeter_not_ready "a tide-greeter run by a link to env, with one of that name on the greeter's PATH others can write" "the greeter's tide-greeter isn't root's alone: $T/usr-bin/tide-greeter is run by env's greeter-sh, $T/usr-local-bin/greeter-sh: users other than root can write $T/usr-local-bin/greeter-sh"
teardown
# The kernel reads only a script's first 256 bytes: with no newline among
# them, the line ends after the 255th, and env gets the name cut short.
long_name=$(printf 'g%.0s' $(seq 250))
cut_name=$(printf 'g%.0s' $(seq 240))
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; printf '#!/bin/sh\n' > "$T/usr-bin/$long_name"; chmod +x "$T/usr-bin/$long_name"
printf '#!/usr/bin/env %s\n' "$long_name" > "$T/usr-bin/tide-greeter"; run
greeter_not_ready "a tide-greeter whose env name runs past the 256 bytes the kernel reads" "greetd's user _greetd can't start tide-greeter: $T/usr-bin/tide-greeter is run by env's $cut_name, which isn't on its PATH, $T/usr-local-bin:$T/usr-bin, as a program it can run"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; printf '#!/bin/sh\n' > "$T/usr-bin/$cut_name"; chmod +x "$T/usr-bin/$cut_name"
printf '#!/usr/bin/env %s\n' "$long_name" > "$T/usr-bin/tide-greeter"; run
check "greetd: a tide-greeter run by env's name as the kernel cuts it, which is there, is the greeter's" test "$(cat "$T/dm")" = greetd.service
teardown
# An interpreter whose name runs past them isn't started at all.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; long_dir=$T/interp/$(printf 'd%.0s' $(seq 200)); mkdir -p "$long_dir"
printf '#!/bin/sh\n' > "$long_dir/$long_name"; chmod +x "$long_dir/$long_name"
printf '#!%s\n' "$long_dir/$long_name" > "$T/usr-bin/tide-greeter"; run
greeter_not_ready "a tide-greeter whose interpreter's name runs past the 256 bytes the kernel reads" "greetd's user _greetd can't start tide-greeter: $T/usr-bin/tide-greeter isn't a program the kernel can start: its #! line names an interpreter that runs past the 256 bytes the kernel reads"
teardown
# A NUL ends the line, as a newline does.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; printf '#!/bin/sh\0garbage\n' > "$T/usr-bin/tide-greeter"; run
check "greetd: a tide-greeter whose #! line ends in a NUL is the greeter's" test "$(cat "$T/dm")" = greetd.service
teardown
# But the kernel trims the blanks that end the line only before a newline:
# before a NUL, or the end of a short file, env gets the name with them.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; printf '#!/bin/sh\n' > "$T/usr-bin/greeter-sh"; chmod +x "$T/usr-bin/greeter-sh"
printf '#!/usr/bin/env greeter-sh \t\n' > "$T/usr-bin/tide-greeter"; run
check "greetd: a tide-greeter run by env, with blanks before the newline, is the greeter's" test "$(cat "$T/dm")" = greetd.service
teardown
for end in '\0garbage\n' ''; do
    setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; printf '#!/bin/sh\n' > "$T/usr-bin/greeter-sh"; chmod +x "$T/usr-bin/greeter-sh"
    # shellcheck disable=SC2059  # the format is the file's bytes
    printf "#!/usr/bin/env greeter-sh $end" > "$T/usr-bin/tide-greeter"; run
    what=${end:+a NUL}
    greeter_not_ready "a tide-greeter run by env, with a blank before ${what:-the end of the file}," "greetd's user _greetd can't start tide-greeter: $T/usr-bin/tide-greeter is run by env with greeter-sh , which setup can't follow"
    teardown
done
# An ELF one has to be a program for this machine, whole, and, when a loader
# starts it, have that loader there, root's alone, able to load it with
# every library it needs.
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; elf_program "$T/usr-bin/tide-greeter"; run
check "greetd: a tide-greeter that's a static program is the greeter's" test "$(cat "$T/dm")" = greetd.service
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; mkdir -p "$T/loader"; elf_program "$T/loader/ld.so" --type=3
elf_program "$T/usr-bin/tide-greeter" --interp="$T/loader/ld.so"; run
check "greetd: a tide-greeter its loader can load is the greeter's" test "$(cat "$T/dm")" = greetd.service
check "greetd: which the loader is asked about" has "$calls" "ldd -r -- $T/usr-bin/tide-greeter"
teardown
greeter_elf_not_ready() {
    greeter_not_ready "a tide-greeter that $1" "greetd's user _greetd can't start tide-greeter: $T/usr-bin/tide-greeter $2"
}
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; printf '\177ELF' > "$T/usr-bin/tide-greeter"; run
greeter_elf_not_ready "is only an ELF file's first bytes" "isn't a program the kernel can start"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; elf_program "$T/usr-bin/tide-greeter" --machine=183; run
greeter_elf_not_ready "is built for another machine" "is built for another kind of machine than this one"
teardown
setup; ARGS=(--greeter); echo gdm3.service > "$T/dm"; pam_module "$T/usr-bin/tide-greeter"; chmod +x "$T/usr-bin/tide-greeter"; run
greeter_elf_not_ready "is a library" "has no code where the kernel would start it"
teardown
