#!/bin/bash
# Bootstrap script for setting up a new machine.
#
# Usage:
#     setup [--gui | --no-gui] [--kde] [--no-tide] [--greeter | --no-greeter] \
#           [--minimal | --full] [--no-install] [--purge-obsolete] [--ignore-errors] \
#           [--ssh | --no-ssh] [--no-npm] [--github PREFIX] [-v | --verbose] \
#           [-h | --help]
#
#  or, to bootstrap from scratch:
#     curl -fsSL https://mikelward.com/setup | sh
#     wget -qO- https://mikelward.com/setup | sh
#
# The full GitHub URLs also work:
#     curl -fsSL https://github.com/mikelward/scripts/raw/main/setup | sh
#     wget -qO- https://github.com/mikelward/scripts/raw/main/setup | sh
#
# Graphical components (KDE/Plasma, kitty, fonts, desktop config) are
# installed only when a display server is detected. Pass --gui to force
# them on, or --no-gui to skip them (e.g. on a headless server). On a
# Linux machine with no battery whose screens hang off an AMD card, setup
# also keeps that card from powering itself down while they're off, which
# can leave the screen dark or hang the machine (see keep_display_gpu_awake).
#
# The heavyweight extras (helix, jj, nushell) install from Homebrew bottles
# when brew is available (or on macOS), and otherwise from each project's
# GitHub release artifacts, fetched into ~/.local by homepkg. Nothing is built
# from source, so no Rust toolchain is installed either way. Pass --brew to
# force Homebrew (installing it if needed) or --release to force the release
# artifacts. jj is skipped when the box already has one setup didn't install
# (a distro package, say), so the packaged copy stays the one that runs.
# shpool is no longer installed at all -- see the shpool note by
# install_extras. The extras are skipped when the disk is small (see
# MIN_DISK_GB). Pass --minimal to force that lean profile, or --full to
# install everything. To pass flags through a pipe:
#     curl -fsSL https://mikelward.com/setup | sh -s -- --no-gui --minimal
#
# Pass --no-install to skip all software installation (packages, fonts,
# uv, the heavyweight extras, and the root config build) and only
# (re)apply configuration -- handy when re-running on a machine that
# already has the tools. Pass --ignore-errors to keep going past failures
# instead of aborting on the first one. Both flags are forwarded to
# setup-kde / setup-macos.
#
# Every privileged command runs through sudo_or_warn, so an unexpected sudo
# denial already degrades to a warning instead of aborting the bootstrap --
# which means a box that only permits "sudo apt" works as-is (the package
# installs succeed and the other privileged steps warn and skip). Pass
# --no-sudo when the box has no sudo at all: sudo_or_warn then skips every
# privileged command up front, package installs included, so setup never
# prompts for a password or stalls on a command it can't run. --no-sudo is
# forwarded to setup-kde / setup-macos.
#
# An SSH key is generated only when one isn't already available -- the
# check skips generation when ssh-add -l lists a key (e.g. a forwarded
# agent) or a key file already exists. Pass --ssh to generate one anyway,
# or --no-ssh to skip it entirely.
#
# Node.js (node/npm) and the TypeScript compiler (tsc) are installed as a
# fallback for setup-kde: it normally fetches Krohnkite's prebuilt release,
# but falls back to building from source (which needs tsc, without fetching
# from the npm registry at build time) when that release can't be fetched.
# On privileged boxes they come from the distro package (apt/dnf/brew); under
# --no-root, where the distro installs are skipped, and on an Intel Mac, where
# Homebrew would compile them, they come from conda-forge via homepkg instead
# (rootless). Pass
# --no-npm to skip them where Node is provided some other way (nvm, fnm,
# corepack, a system package, etc.) -- then provide tsc yourself.
#
# The scripts/conf/root repos clone from github.com over SSH by default. Behind
# a corporate network that mirrors GitHub at an internal host -- or serves it
# over HTTPS -- pass --github PREFIX to point the clones there, e.g.
#     setup --github git@ghe.corp.example.com    (internal SSH host)
#     setup --github https://ghe.corp.example.com (internal HTTPS mirror)
# PREFIX is the part before OWNER/REPO; a bare host is treated as SSH, and its
# trailing separator (: or /) is supplied for you. GITHUB_PREFIX in the
# environment does the same, which is handy when piping setup from a mirror.
#
# A non-default prefix also stops setup assuming github.com-over-SSH elsewhere:
# the SSH key instructions name that host instead of github.com, an HTTPS
# prefix doesn't stop to wait for the key at all (nothing it clones needs one),
# the end-of-run offer to rewrite remotes to SSH is skipped, and a repo already
# cloned from somewhere else is reported rather than silently left behind.
# setup-tide clones its source builds (Quickshell, Hyprland and the hyprwm
# libraries, at pinned commits) from the mirror too.
#
# A run prints what it changed, what's left for you to do, and what went
# wrong, and ends with a line per source (apt, dnf or brew; homepkg; git;
# download) naming what was already installed, what it installed or updated,
# and what failed. What package managers, builds and make print goes to
# ~/.local/state/setup/setup.log ($XDG_STATE_HOME/setup), with the previous
# run's beside it as setup.log.1; a command that fails shows the end of its
# output and points there. Pass --verbose (-v) to see everything as it
# happens, as setup-kde, setup-tide and setup-macos do too: setup passes it on.

# The three repositories setup clones, kept as OWNER/REPO paths. The host and
# protocol come from GITHUB_PREFIX, which defaults to GitHub over SSH and can be
# pointed at an internal mirror with --github (e.g. behind a corporate network
# that proxies github.com at a different host, or serves it over HTTPS). One
# flag carries the whole prefix because SSH and HTTPS remotes are shaped
# differently -- git@HOST: vs https://HOST/ -- so a bare host couldn't tell them
# apart. The path is appended to the prefix; the URLs themselves are assembled
# after argument parsing (see normalize_github_prefix). Override the default
# host by exporting GITHUB_PREFIX, or per-run with --github.
#
# The default is kept as its own constant so the steps that care whether the
# repos come from somewhere else -- the SSH key prompt and the offer to rewrite
# remotes -- can compare against it (see GITHUB_MIRROR below).
GITHUB_DEFAULT_PREFIX="git@github.com:"
GITHUB_PREFIX="${GITHUB_PREFIX:-$GITHUB_DEFAULT_PREFIX}"
SCRIPTS_REPO_PATH="mikelward/scripts.git"
CONF_REPO_PATH="mikelward/conf.git"
ROOT_REPO_PATH="mikelward/root.git"
TIDE_REPO_PATH="mikelward/tide.git"

SCRIPTS_DIR="$HOME/scripts"
CONF_DIR="$HOME/conf"
SRC_DIR="$HOME/src"
ROOT_DIR="$SRC_DIR/root"

# Homebrew's ask mode is on by default, so `brew install` prints its plan and
# waits for a yes whenever the plan pulls in dependencies -- which every
# formula and cask list here does. Running setup is the yes; re-asking per
# package is a question the user already answered. Exported rather than passed
# per call so it covers setup-macos too, and so it survives an older brew that
# predates the --no-ask flag (an unknown HOMEBREW_ variable is ignored, an
# unknown flag is a hard error).
#
# This deliberately stops at confirmations. The administrator password a .pkg
# cask asks for is the user's to give, and nothing here suppresses it.
export HOMEBREW_NO_ASK=1

# Whether to install/configure graphical components. One of:
#   auto - decide based on a detected display server (the default)
#   yes  - forced on via --gui
#   no   - forced off via --no-gui
GUI=auto

# Install profile for the heavyweight source-built extras. One of:
#   auto - decide based on available disk space (the default)
#   yes  - forced lean via --minimal
#   no   - forced full via --full
MINIMAL=auto

# Below this many GB free on $HOME's filesystem, auto mode picks --minimal.
# Override by exporting MIN_DISK_GB before running.
MIN_DISK_GB="${MIN_DISK_GB:-15}"

# Whether to install software at all. One of:
#   yes - install packages, fonts, and tools (the default)
#   no  - skip every install step and only (re)apply configuration (--no-install)
INSTALL=yes

# Whether to purge the obsolete Sway/Hyprland desktop packages an earlier setup
# installed (setup now builds KDE Plasma + Krohnkite, and tide, whose
# packages stay). One of:
#   no  - leave them in place (the default)
#   yes - purge the Sway/Hyprland-specific packages (--purge-obsolete)
# Off by default because setup is also fetched via "curl | sh" onto machines
# that may run Sway or Hyprland deliberately, where purging them would be hostile.
PURGE_OBSOLETE=no

# Whether to also install the tide session (Hyprland + uwsm,
# github.com/mikelward/tide) beside KDE, via setup-tide. One of:
#   yes - KDE Plasma plus tide (the default; --tide says so)
#   no  - KDE Plasma only (--no-tide)
# tide is one more session at the login screen: the display manager stays
# unless --greeter is given. The packages it needs are kept out of
# --purge-obsolete.
TIDE=yes
# Flags for setup-tide only.
TIDE_SETUP_FLAGS=""

# Whether to keep going after a command fails. One of:
#   no  - abort on the first error, via set -e (the default)
#   yes - keep going past failures (--ignore-errors)
IGNORE_ERRORS=no

# Whether to ask setup-kde to apply keyboard shortcuts to the running session
# (--live-shortcuts). On by default, matching setup-kde: kglobalaccel never
# re-reads its config, so without the live apply the shortcuts do nothing until
# the next login. --no-live-shortcuts opts out.
LIVE_SHORTCUTS=yes

# Whether to generate an SSH key. One of:
#   auto - skip when a key is already available -- loaded in the agent
#          (ssh-add -l) or present on disk -- otherwise generate one (default)
#   yes  - generate even if the agent already has a key (--ssh)
#   no   - never generate (--no-ssh)
SSH=auto

# Whether to install Node.js (node/npm) and the TypeScript compiler (tsc),
# needed by setup-kde's source-build fallback for Krohnkite (its normal path
# fetches a prebuilt release and needs neither). One of:
#   yes - install them (the default). Privileged boxes get the distro npm/node
#         package plus tsc; --no-root boxes get node/npm/tsc from conda-forge
#         via homepkg instead.
#   no  - skip them (--no-npm), for machines where Node is provided some other
#         way (nvm, fnm, corepack, a system package, etc.) -- provide tsc too.
NPM=yes

# Whether to run sudo at all. One of:
#   yes - sudo is available; run every privileged step (the default). An
#         unexpected sudo failure is still folded into a warning by
#         sudo_or_warn and the bootstrap continues -- so a box that only lets
#         you "sudo apt" already works in this mode: the package installs
#         succeed and every other privileged step warns and skips on the denial.
#   no  - no sudo (--no-sudo). sudo_or_warn skips every privileged command up
#         front instead of attempting it -- so setup never prompts for a
#         password or stalls on a command it can't run. For machines with no
#         sudo at all (packages preinstalled or provided some other way).
# Override with --sudo / --no-sudo, or by exporting SUDO before running.
SUDO="${SUDO:-yes}"

# Whether we have root/admin privileges on this machine (policy, as opposed to
# SUDO's mechanism). One of:
#   yes - privileged: install system packages, the root config, etc. (default)
#   no  - unprivileged (--no-root). Implies --no-sudo (an unprivileged user
#         can't escalate), and, since the apt/dnf packages are then skipped,
#         installs the CLI tools into a home prefix with homepkg instead.
# SUDO is the "do we invoke sudo" mechanism; ROOT is the "do we have privileges"
# policy. --no-sudo alone just skips sudo (tools assumed provided some other
# way); --no-root additionally provisions the tools rootlessly via homepkg.
# Override with --root / --no-root, or by exporting ROOT before running.
ROOT="${ROOT:-yes}"

# Which backend installs the heavyweight extras (helix, jj, nushell). One of:
#   auto    - Homebrew when brew is available or on macOS; else the release
#             artifacts (default)
#   brew    - install them from Homebrew bottles, installing Homebrew if needed
#   release - install the prebuilt binaries from each project's GitHub releases
#             into ~/.local via homepkg (no root, no build)
# Override with --brew / --release.
EXTRAS=auto

usage() {
    cat <<'USAGE'
Usage: setup [--gui | --no-gui] [--kde] [--no-tide] [--greeter | --no-greeter]
             [--minimal | --full]
             [--no-install] [--purge-obsolete] [--no-sudo] [--no-root]
             [--ignore-errors] [--no-live-shortcuts]
             [--ssh | --no-ssh] [--no-npm] [--github PREFIX]
             [-v | --verbose] [-h | --help]

Bootstrap a new machine: install packages, fonts, tools, and dotfiles.

Options:
  --gui            Install graphical packages and desktop config
  --no-gui         Skip graphical packages and desktop config
  --kde            Accepted for compatibility; KDE Plasma is always installed
  --tide           Install the tide session beside KDE (the default)
  --no-tide        Install KDE Plasma alone, without tide
  --no-build-hyprland
                   Use the distro's Hyprland for tide, even if it's too old
  --greeter        Make greetd, with tide's greeter, the display manager
  --no-greeter     Put back the display manager greetd replaced
  --minimal        Skip the heavyweight extras (helix, jj, nushell)
  --full           Install everything, even when disk space looks tight
  --brew           Install the extras from Homebrew
  --release        Install the extras from their GitHub releases via homepkg
  --no-install     Skip every install step and only (re)apply config
  --purge-obsolete Remove the Sway/Hyprland desktop packages an earlier setup
                   installed (keeping what tide uses) and retired CLI tools
  --no-sudo        Run no sudo at all; privileged steps are skipped
  --no-root        Install the CLI tools into your home directory, without
                   root. Implies --no-sudo
  --ignore-errors  Keep going past failures instead of aborting on the first
  --live-shortcuts Apply KDE's keyboard shortcuts to the running session (the
                   default)
  --no-live-shortcuts
                   Leave KDE's keyboard shortcuts for the next login
  --ssh            Generate an SSH key even if one is already available
  --no-ssh         Skip SSH key generation
  --no-npm         Skip installing Node.js and the TypeScript compiler
  --github PREFIX  Clone from PREFIX instead of github.com, e.g.
                   git@ghe.example.com or https://ghe.example.com. Also
                   settable via GITHUB_PREFIX
  -v, --verbose    Show every step and the commands' own output, not just
                   changes, warnings and errors
  -h, --help       Show this help and exit

Graphical setup runs only when a display is detected, and the extras are
skipped below MIN_DISK_GB (default 15GB) free. The commands' output goes to
~/.local/state/setup/setup.log unless --verbose.
USAGE
}

# --- What a run prints ---

# setup and the helpers it runs (setup-kde, setup-tide, setup-macos) print
# what a run changed, what's left for you to do, and what went wrong, and
# nothing else unless --verbose:
#   say          a change, or something to do: always shown
#   info         progress, and what was skipped or already so: --verbose only
#   warn, error  problems, on stderr, repeated as the run ends
# Package managers, builds and make run through logged, which keeps their
# output in $SETUP_LOG. What each install step found is tallied with
# record_install, and the run ends with a line per source: what was already
# installed, what it installed or updated, and what failed. The outermost of
# setup and its helpers makes the log and the tally and prints the summary; a
# helper it runs inherits both and only adds to them.
VERBOSE=no

say() {
    printf "%s\n" "$*"
}

info() {
    test "${VERBOSE:-no}" = yes || return 0
    printf "%s\n" "$*"
}

# Every warning and error goes to $SETUP_PROBLEMS too, so the run ends by
# repeating them all: one line among thousands scrolls by unseen.
note_problem() {
    test -n "${SETUP_PROBLEMS:-}" || return 0
    printf '%s\n' "$1" >>"$SETUP_PROBLEMS" ||
        printf "Warning: couldn't add that to %s, so the end of the run won't repeat it\n" "$SETUP_PROBLEMS" >&2
}

# record_install SOURCE STATE NAME...: tallies NAME... for the summary.
# SOURCE is where they come from: a package manager (apt, dnf, pacman, brew,
# npm), homepkg, git (checkouts, and builds from them) or download (an
# installer fetched with curl). STATE is already (installed before this run),
# installed, updated, failed-update (a checkout that couldn't be pulled) or
# failed. record_why SOURCE STATE NAME WHY tallies one NAME with a few words
# on it, which the summary puts in parentheses after it.
record_install() {
    _ri_source=$1
    _ri_state=$2
    shift 2
    for _ri_name in "$@"; do
        record_why "$_ri_source" "$_ri_state" "$_ri_name" ""
    done
}

record_why() {
    test -n "${SETUP_INSTALLS:-}" || return 0
    printf '%s %s %s %s\n' "$1" "$2" "$3" "$4" >>"$SETUP_INSTALLS" ||
        printf "Warning: couldn't add %s to %s, so the summary leaves it out\n" "$3" "$SETUP_INSTALLS" >&2
}

# print_installs: the tally as a line per source, in the order they came:
#   apt: already installed: git jq; newly installed: zoxide; failed: kitty
# A name tallied twice keeps its best news: newly installed, then updated,
# then failed to update, then already installed, then failed.
print_installs() {
    test -s "${SETUP_INSTALLS:-}" || return 0
    printf '\n'
    awk '
        BEGIN {
            rank["installed"] = 5; rank["updated"] = 4; rank["failed-update"] = 3
            rank["already"] = 2; rank["failed"] = 1
            order[1] = "already"; order[2] = "installed"; order[3] = "updated"
            order[4] = "failed-update"; order[5] = "failed"
            words["already"] = "already installed"; words["installed"] = "newly installed"
            words["updated"] = "updated"; words["failed-update"] = "failed to update"
            words["failed"] = "failed"
        }
        NF >= 3 && ($2 in rank) {
            if (!($1 in seen)) { seen[$1] = 1; sources[++nsources] = $1 }
            key = $1 SUBSEP $3
            why = $0
            sub(/^[^ ]+ [^ ]+ [^ ]+ ?/, "", why)
            if (!(key in state)) names[$1, ++count[$1]] = $3
            if (!(key in state) || rank[$2] > rank[state[key]]) { state[key] = $2; note[key] = why }
        }
        END {
            for (s = 1; s <= nsources; s++) {
                src = sources[s]
                line = ""
                for (o = 1; o <= 5; o++) {
                    list = ""
                    for (i = 1; i <= count[src]; i++) {
                        key = src SUBSEP names[src, i]
                        if (state[key] != order[o]) continue
                        list = list " " names[src, i]
                        if (note[key] != "") list = list " (" note[key] ")"
                    }
                    if (list != "") line = line (line == "" ? "" : ";") " " words[order[o]] ":" list
                }
                print src ":" line
            }
        }' "$SETUP_INSTALLS"
}

PROBLEMS_OWNER=no
start_problem_recap() {
    test -z "${SETUP_PROBLEMS:-}" || return 0
    if ! SETUP_PROBLEMS=$(mktemp "${TMPDIR:-/tmp}/setup-problems-XXXXXX"); then
        SETUP_PROBLEMS=
        warn "couldn't make a file to collect warnings in, so the end of the run won't repeat them"
        return 0
    fi
    export SETUP_PROBLEMS
    PROBLEMS_OWNER=yes
    start_run_files
}

# start_run_files: the tally, in $TMPDIR, and the log, in
# $XDG_STATE_HOME/setup, a fresh one each run, with the last run's kept as
# setup.log.1.
start_run_files() {
    if SETUP_INSTALLS=$(mktemp "${TMPDIR:-/tmp}/setup-installs-XXXXXX"); then
        export SETUP_INSTALLS
    else
        SETUP_INSTALLS=
        warn "couldn't make a file to tally installs in, so the run won't end with a summary of them"
    fi
    _log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/setup"
    SETUP_LOG="$_log_dir/setup.log"
    if ! mkdir -p "$_log_dir" \
            || { test -f "$SETUP_LOG" && ! mv -f "$SETUP_LOG" "$SETUP_LOG.1"; } \
            || ! printf "" >"$SETUP_LOG"; then
        warn "couldn't start $SETUP_LOG, so commands' output shows here instead"
        SETUP_LOG=
    fi
    export SETUP_LOG
}

# recap_problems STATUS, from the EXIT trap: prints the install summary,
# repeats every warning and error, says if the run stopped early, and keeps
# STATUS as the exit status.
recap_problems() {
    test "$PROBLEMS_OWNER" = yes || return "$1"
    print_installs
    if test -n "${SETUP_INSTALLS:-}"; then
        rm -f "$SETUP_INSTALLS"
    fi
    if test -s "$SETUP_PROBLEMS"; then
        printf '\n%s: the warnings and errors from this run, again:\n' "setup" >&2
        sed 's/^/  /' "$SETUP_PROBLEMS" >&2
        if test -s "${SETUP_LOG:-}"; then
            printf "The commands' output is in %s\n" "$SETUP_LOG" >&2
        fi
    fi
    if test "$1" -ne 0; then
        printf '%s stopped early, with exit status %s\n' "setup" "$1" >&2
    fi
    rm -f "$SETUP_PROBLEMS"
    return "$1"
}

# logged COMMAND...: runs COMMAND with its output added to $SETUP_LOG rather
# than shown, unless --verbose (or there's no log). Its stdin is /dev/null,
# so it can't wait on a question no one can see: apt's debconf takes its
# defaults, and sudo, ssh and git ask on the terminal itself, as they always
# do. A warning from COMMAND, a function, still shows: warn and error write
# to the terminal through descriptor 3 meanwhile. When COMMAND fails, the end
# of its output is shown, and where the rest is.
logged() {
    if test "${VERBOSE:-no}" = yes || test -z "${SETUP_LOG:-}"; then
        "$@"
        return
    fi
    # A URL's user-info can be a token (https://USER:TOKEN@host/..., from
    # --github or $TIDE_REPO, say), so neither the log nor what's shown of a
    # failure keeps it, as redact_url_credentials does for the terminal.
    _lg_redact='s#(://)[^/@[:space:]]*@#\1***@#g'
    _lg_cmd=$(printf '%s\n' "$*" | sed -E "$_lg_redact")
    # Inside another logged command, whose output already goes to the log:
    # its variables are global, so this one only notes the command and runs
    # it, and the outer one reports, redacts and restores LOGGING.
    if test "${LOGGING:-no}" = yes; then
        printf '+ %s\n' "$_lg_cmd"
        "$@"
        return
    fi
    _lg_start=$(awk 'END { print NR }' "$SETUP_LOG" 2>/dev/null) || _lg_start=0
    printf '+ %s\n' "$_lg_cmd" >>"$SETUP_LOG"
    LOGGING=yes
    _lg_status=0
    "$@" </dev/null 3>&2 >>"$SETUP_LOG" 2>&1 || _lg_status=$?
    LOGGING=no
    # The command's own output too: git quotes the URL it couldn't reach.
    if grep -Eq '://[^/@[:space:]]*@' "$SETUP_LOG" 2>/dev/null; then
        if ! { sed -E "$_lg_redact" "$SETUP_LOG" >"$SETUP_LOG.redacted" \
                && mv -f "$SETUP_LOG.redacted" "$SETUP_LOG"; }; then
            rm -f "$SETUP_LOG.redacted"
            warn "couldn't take a URL's credentials out of $SETUP_LOG; delete it"
        fi
    fi
    if test "$_lg_status" -eq 0; then
        return 0
    fi
    # From "$*" again: a logged command inside this one set _lg_cmd.
    _lg_what=$(printf '%s\n' "$*" | sed -E "$_lg_redact" | awk '{
        sub(/^sudo_or_warn /, "sudo ")
        s = $1
        for (i = 2; i <= NF && i <= 3; i++) s = s " " $i
        if (NF > 3) s = s " ..."
        print s
    }')
    _lg_tail=$(sed -n "$((${_lg_start:-0} + 2)),\$p" "$SETUP_LOG" | tail -n 20)
    if test -n "$_lg_tail"; then
        printf "%s failed (exit status %s), ending:\n" "$_lg_what" "$_lg_status" >&2
        printf '%s\n' "$_lg_tail" | sed 's/^/    /' >&2
    else
        printf "%s failed (exit status %s)\n" "$_lg_what" "$_lg_status" >&2
    fi
    printf "  Its output is in %s\n" "$SETUP_LOG" >&2
    return "$_lg_status"
}

# While logged runs a command, stderr is the log, so warn and error write to
# the terminal through the descriptor logged keeps for them.
warn() {
    if test "${LOGGING:-no}" = yes; then
        printf "Warning: %s\n" "$*" >&3
    else
        printf "Warning: %s\n" "$*" >&2
    fi
    note_problem "Warning: $*"
}

# Run one privileged command without letting a sudo failure abort the whole
# bootstrap. Stderr is preserved on success; on failure its last non-empty
# line is folded into a concise warning. Shell-standard 126/127 statuses are
# more useful than some sudo implementations' diagnostics, so name those
# explicitly.
#
# Under --no-sudo (SUDO=no) the command is skipped up front rather than
# attempted, and reported with a non-zero return so a caller's `|| warn` or
# `if sudo_or_warn ...` guard skips the dependent work. This is the single
# choke point for every privileged command, so gating it here is all it takes
# to make setup never invoke sudo. (A box that allows only "sudo apt" doesn't
# need this: leave sudo on and the reactive path below warns and skips on the
# denials by itself.)
sudo_or_warn() {
    _sudo_name=${1##*/}
    if test "$SUDO" = no; then
        warn "skipping 'sudo $_sudo_name' (--no-sudo)"
        return 1
    fi
    _sudo_stderr=$(mktemp) || {
        warn "sudo $_sudo_name: could not create a temporary error log"
        return 1
    }

    if sudo "$@" 2>"$_sudo_stderr"; then
        cat "$_sudo_stderr" >&2
        rm -f "$_sudo_stderr"
        return 0
    else
        _sudo_status=$?
    fi
    # Under logged, stderr is the log, which then has all of it.
    if test "${LOGGING:-no}" = yes; then
        cat "$_sudo_stderr" >&2
    fi
    _sudo_detail=$(awk 'NF { line = $0 } END { print line }' "$_sudo_stderr")
    rm -f "$_sudo_stderr"

    case "$_sudo_status" in
        126) _sudo_detail="permission denied" ;;
        127) _sudo_detail="command not found" ;;
        *)
            case "$_sudo_detail" in
                "sudo: $_sudo_name: "*) _sudo_detail=${_sudo_detail#"sudo: $_sudo_name: "} ;;
                "sudo: "*) _sudo_detail=${_sudo_detail#"sudo: "} ;;
                "$_sudo_name: "*) _sudo_detail=${_sudo_detail#"$_sudo_name: "} ;;
            esac
            if test -z "$_sudo_detail"; then
                _sudo_detail="failed (exit status $_sudo_status)"
            fi
            ;;
    esac
    warn "sudo $_sudo_name: $_sudo_detail"
    return "$_sudo_status"
}

error() {
    if test "${LOGGING:-no}" = yes; then
        printf "Error: %s\n" "$*" >&3
    else
        printf "Error: %s\n" "$*" >&2
    fi
    note_problem "Error: $*"
}

# normalize_github_prefix PREFIX: echo PREFIX with a trailing separator so a
# repo path (OWNER/REPO.git) can be appended directly. A prefix that already
# ends in ':' or '/' is used unchanged; a URL-scheme prefix (https://host,
# ssh://git@host) gets a trailing '/'; an scp-style or bare host (git@host,
# host) gets a trailing ':'. This lets --github accept the target in whatever
# form its protocol wants -- with or without the separator the user would
# otherwise have to remember -- without a second flag to say which protocol.
normalize_github_prefix() {
    case "$1" in
        */ | *:) printf '%s' "$1" ;;
        *://*)   printf '%s/' "$1" ;;
        *)       printf '%s:' "$1" ;;
    esac
}

# github_prefix_host PREFIX: print the host from a normalized prefix, for the
# messages that name where the repos came from. Handles both shapes the prefix
# can take -- scp-style (git@HOST:) and URL (https://HOST/, ssh://git@HOST/).
github_prefix_host() {
    case "$1" in
        *://*)
            _prefix_rest=${1#*://}
            _prefix_rest=${_prefix_rest%%/*}
            ;;
        *)
            _prefix_rest=${1%%:*}
            ;;
    esac
    printf '%s' "${_prefix_rest#*@}"
}

# redact_url_credentials URL: print URL with any embedded user-info replaced by
# "***", so a message can name a remote without echoing a secret to the
# terminal or to a captured bootstrap log. An HTTPS clone URL can carry one --
# https://USER:TOKEN@host/..., and the token-as-username forms
# (https://TOKEN@host/..., https://x-access-token:TOKEN@host/...) mean a bare
# user-info is no safer than a password, so the whole of it goes. scp-style
# remotes (git@HOST:PATH) are printed unchanged: that syntax has no password
# field, so its user is a plain SSH login rather than a credential.
redact_url_credentials() {
    case "$1" in
        *://*) ;;
        *) printf '%s' "$1"; return ;;
    esac
    _redact_scheme=${1%%://*}
    _redact_rest=${1#*://}
    # User-info is only what precedes the '@' in the authority, i.e. before the
    # first '/'. An '@' further along is part of the path, not a credential.
    _redact_authority=${_redact_rest%%/*}
    case "$_redact_authority" in
        *@*) ;;
        *) printf '%s' "$1"; return ;;
    esac
    _redact_path=${_redact_rest#"$_redact_authority"}
    printf '%s://***@%s%s' \
        "$_redact_scheme" "${_redact_authority##*@}" "$_redact_path"
}

# canonical_remote URL: print URL with the spellings git treats as
# interchangeable removed -- a trailing slash and the optional .git suffix --
# so a checkout cloned as .../OWNER/REPO compares equal to the .../OWNER/REPO.git
# the repo paths are written as. Protocol and host are deliberately left alone:
# a difference there is a real one, and reporting it is the point.
canonical_remote() {
    _canon=${1%/}
    printf '%s' "${_canon%.git}"
}

# require_github_prefix VALUE: abort with the usage error unless VALUE is a
# usable --github argument. Both flag forms route through this so they can't
# drift. Two shapes are rejected up front rather than failing later at clone
# time: an empty value ("--github=" or a bare "--github" with no following
# word, which would normalize to ":" and clone from ":mikelward/..."), and an
# option-looking value (a real host/prefix never starts with '-', so
# "setup --github --no-install" is a forgotten value that would otherwise
# swallow the flag and clone from "--no-install:mikelward/...").
require_github_prefix() {
    case "$1" in
        "" | -*)
            error "--github requires a host/prefix argument"
            usage >&2
            exit 1
            ;;
    esac
}

# --- Parse arguments ---

while test $# -gt 0; do
    case "$1" in
        --gui)
            GUI=yes
            ;;
        --no-gui)
            GUI=no
            ;;
        --kde)
            # Accepted for compatibility: KDE Plasma + Krohnkite is always
            # installed, so there's nothing to select.
            ;;
        --tide)
            TIDE=yes
            ;;
        --no-tide)
            TIDE=no
            ;;
        --no-build-hyprland)
            TIDE_SETUP_FLAGS="$TIDE_SETUP_FLAGS --no-build-hyprland"
            ;;
        --greeter)
            TIDE_SETUP_FLAGS="$TIDE_SETUP_FLAGS --greeter"
            ;;
        --no-greeter)
            TIDE_SETUP_FLAGS="$TIDE_SETUP_FLAGS --no-greeter"
            ;;
        --minimal)
            MINIMAL=yes
            ;;
        --full)
            MINIMAL=no
            ;;
        --brew)
            EXTRAS=brew
            ;;
        --release)
            EXTRAS=release
            ;;
        --cargo)
            # Kept so an existing invocation still runs: there is no
            # from-source path left to select, and the release artifacts are
            # what --cargo was a slower way of getting.
            warn "--cargo is gone; installing the extras from their release artifacts instead"
            EXTRAS=release
            ;;
        --install)
            INSTALL=yes
            ;;
        --no-install)
            INSTALL=no
            ;;
        --purge-obsolete)
            PURGE_OBSOLETE=yes
            ;;
        --no-purge-obsolete)
            PURGE_OBSOLETE=no
            ;;
        --sudo)
            SUDO=yes
            ;;
        --no-sudo)
            SUDO=no
            ;;
        --root)
            ROOT=yes
            ;;
        --no-root)
            ROOT=no
            ;;
        --ignore-errors)
            IGNORE_ERRORS=yes
            ;;
        --live-shortcuts)
            LIVE_SHORTCUTS=yes
            ;;
        --no-live-shortcuts)
            LIVE_SHORTCUTS=no
            ;;
        --ssh)
            SSH=yes
            ;;
        --no-ssh)
            SSH=no
            ;;
        --npm)
            NPM=yes
            ;;
        --no-npm)
            NPM=no
            ;;
        --github)
            shift
            require_github_prefix "${1:-}"
            GITHUB_PREFIX="$1"
            ;;
        --github=*)
            GITHUB_PREFIX="${1#--github=}"
            require_github_prefix "$GITHUB_PREFIX"
            ;;
        -v|--verbose)
            VERBOSE=yes
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            error "Unknown option: $1"
            usage >&2
            exit 1
            ;;
    esac
    shift
done

# Assemble the repo URLs now that --github (if any) has been parsed. The prefix
# is normalized to end in the right separator so github.com stays the default
# and an internal mirror needs only --github HOST (or a full https://HOST/).
GITHUB_PREFIX=$(normalize_github_prefix "$GITHUB_PREFIX")
SCRIPTS_REPO="${GITHUB_PREFIX}${SCRIPTS_REPO_PATH}"
CONF_REPO="${GITHUB_PREFIX}${CONF_REPO_PATH}"
ROOT_REPO="${GITHUB_PREFIX}${ROOT_REPO_PATH}"
TIDE_REPO="${GITHUB_PREFIX}${TIDE_REPO_PATH}"

# Whether the repos come from somewhere other than the default (github.com over
# SSH), i.e. --github or GITHUB_PREFIX pointed them elsewhere. Compared after
# normalization, so "--github git@github.com" is recognized as the default
# rather than mistaken for a mirror. Steps that assume github.com-over-SSH key
# off this: the SSH key prompt names the right host, and the offer to rewrite
# remotes to SSH is skipped -- see offer_ssh_remotes.
if test "$GITHUB_PREFIX" = "$GITHUB_DEFAULT_PREFIX"; then
    GITHUB_MIRROR=no
else
    GITHUB_MIRROR=yes
fi
GITHUB_HOST=$(github_prefix_host "$GITHUB_PREFIX")

# Whether cloning from the prefix authenticates with an SSH key. An HTTPS
# prefix -- an internal mirror served over HTTPS, or github.com itself where a
# network blocks SSH -- needs no key for any repo setup clones, so
# generate_ssh_key doesn't stop the bootstrap to wait for one.
case "$GITHUB_PREFIX" in
    https://* | http://*) GITHUB_PREFIX_SSH=no ;;
    *)                    GITHUB_PREFIX_SSH=yes ;;
esac

# From here on, the run ends by repeating its warnings and errors.
start_problem_recap
trap 'recap_problems "$?"' EXIT

# Abort on the first error by default. --ignore-errors leaves set -e off so
# the bootstrap pushes through failing steps. We toggle this only after
# parsing args, so an unknown option above still exits non-zero.
if test "$IGNORE_ERRORS" = no; then
    set -e
fi

# --no-root is a policy that implies the no-sudo mechanism: an unprivileged
# user can't escalate. (--no-sudo alone leaves ROOT=yes -- just the mechanism.)
# Set this before the SUDO-keyed forwarding below so it propagates too.
if test "$ROOT" = no; then
    SUDO=no
fi

# Flags to forward to the desktop setup helpers (setup-kde / setup-macos).
DESKTOP_SETUP_FLAGS=""
if test "$INSTALL" = no; then
    DESKTOP_SETUP_FLAGS="$DESKTOP_SETUP_FLAGS --no-install"
fi
if test "$SUDO" = no; then
    DESKTOP_SETUP_FLAGS="$DESKTOP_SETUP_FLAGS --no-sudo"
fi
if test "$IGNORE_ERRORS" = yes; then
    DESKTOP_SETUP_FLAGS="$DESKTOP_SETUP_FLAGS --ignore-errors"
fi
if test "$VERBOSE" = yes; then
    DESKTOP_SETUP_FLAGS="$DESKTOP_SETUP_FLAGS --verbose"
fi
# Flags for setup-kde only, kept out of DESKTOP_SETUP_FLAGS because
# setup-macos shares that and rejects anything it doesn't know.
#
# Forwarded either way rather than letting setup-kde's default decide, so what
# this run does to the session is stated outright and doesn't change under it
# if that default moves again. See setup-kde's apply_shortcuts_live.
KDE_SETUP_FLAGS=""
if test "$LIVE_SHORTCUTS" = yes; then
    KDE_SETUP_FLAGS="$KDE_SETUP_FLAGS --live-shortcuts"
else
    KDE_SETUP_FLAGS="$KDE_SETUP_FLAGS --no-live-shortcuts"
fi

clone_or_pull() {
    repo="$1"
    dir="$2"
    # Whether REPO was built from GITHUB_PREFIX. Only for those does an
    # existing checkout pointing elsewhere mean --github failed to apply; the
    # helix clone shares this function with a hard-coded upstream URL the flag
    # never steers, and its origin may legitimately be an SSH URL or a fork.
    # Default off so a new caller has to opt in rather than inherit the check.
    from_prefix="${3:-no}"

    if test -d "$dir/.git"; then
        # The prefix only steers fresh clones; an existing checkout keeps
        # whatever remote it was cloned with. Say so when they disagree, rather
        # than letting --github look like it took effect on a re-run. Only
        # under a non-default prefix: on the default, a repo cloned over HTTPS
        # differs from the SSH default URL harmlessly, and that's exactly what
        # offer_ssh_remotes exists to fix.
        if test "$from_prefix" = yes && test "$GITHUB_MIRROR" = yes; then
            # config --get, not "remote get-url": we want the raw stored URL,
            # not one an url.*.insteadOf rule has already rewritten. An unset
            # key (a local-only checkout with no origin) exits 1 with no
            # output -- not an error here, just nothing to compare against.
            existing=$(git -C "$dir" config --get remote.origin.url) || existing=""
            # Compared canonically, so a checkout cloned without the .git
            # suffix isn't reported as a mismatch against the same URL with it.
            if test -n "$existing" \
                    && test "$(canonical_remote "$existing")" != "$(canonical_remote "$repo")"; then
                # Both URLs are redacted before they're printed: a stored origin
                # can carry a token the user has long forgotten, and the prefix
                # they passed lands in any captured log just the same. In the
                # ordinary credential-free case nothing changes and the
                # set-url command below is copy-pasteable as printed.
                warn "$dir is cloned from $(redact_url_credentials "$existing"), not $(redact_url_credentials "$repo"); leaving it (git -C $dir remote set-url origin $(redact_url_credentials "$repo") changes it)"
            fi
        fi
        # A failed pull must not abort the bootstrap: the existing checkout is
        # enough to keep going. This is also what lets an offline "setup
        # --no-root" reach the homepkg bundle install, which runs after these
        # repo refreshes. update_checkout says why it failed, and names a
        # checkout on a branch of its own, so a stale one doesn't pass unseen.
        if update_checkout "$dir" "${dir##*/}" "using it as is"; then
            logged git -C "$dir" submodule update --init --recursive \
                || warn "couldn't update the submodules in $dir; using them as they are"
        fi
    else
        # No existing checkout, so a failed clone stays fatal: there's nothing
        # to fall back to, and later steps (confinst, the root build) need the
        # repo. An offline box must therefore pre-stage the repos it needs.
        # Redacted for the same reason as the mismatch warning above: a prefix
        # passed with credentials shouldn't be echoed into a bootstrap log.
        info "Cloning $(redact_url_credentials "$repo") into $dir"
        if ! logged git clone --recurse-submodules "$repo" "$dir"; then
            record_install git failed "${dir##*/}"
            error "couldn't clone $(redact_url_credentials "$repo") into $dir"
            return 1
        fi
        record_install git installed "${dir##*/}"
    fi
}

# --- Checkouts ---

# default_branch DIR: origin's default branch, as DIR's clone recorded it, or
# main or master when it recorded none.
default_branch() {
    if _db=$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
        printf '%s\n' "${_db#origin/}"
        return 0
    fi
    for _db in main master; do
        if git -C "$1" show-ref --verify --quiet "refs/remotes/origin/$_db"; then
            printf '%s\n' "$_db"
            return 0
        fi
    done
    return 1
}

# git_message OUTPUT: the line of git's OUTPUT that says what went wrong (its
# first fatal: or error:, or else its first line that isn't the fetch's
# progress or a hint), with any credentials in a URL taken out.
git_message() {
    printf '%s\n' "$1" | awk '
        NF && first == "" && $0 !~ /^(From |remote: |hint: |[ \t])/ { first = $0 }
        /^(fatal|error): / && found == "" { found = $0 }
        END { print (found != "" ? found : first) }' |
        sed 's#://[^/@ ]*@#://***@#g'
}

# update_checkout DIR NAME USE [GIT...]: pulls DIR, tallying NAME under git
# as already (nothing new), updated, or failed to update, with why. USE says
# what happens next, for the warnings: a checkout that couldn't be pulled is
# used as it is, and so is one on a branch other than origin's default, which
# is named even when the pull works. Nothing here switches a branch or drops
# a change: that's yours to do. GIT... is the command that pulls (default:
# git -C DIR pull).
update_checkout() {
    _uc_dir=$1
    _uc_name=$2
    _uc_use=$3
    shift 3
    test "$#" -gt 0 || set -- git -C "$_uc_dir" pull
    # symbolic-ref exits 1 for a detached HEAD, and more when it can't say.
    _uc_detached=no
    _uc_branch=$(git -C "$_uc_dir" symbolic-ref --quiet --short HEAD 2>/dev/null) || {
        test "$?" -ne 1 || _uc_detached=yes
        _uc_branch=
    }
    _uc_default=$(default_branch "$_uc_dir") || _uc_default=
    _uc_off=
    if test "$_uc_detached" = yes; then
        _uc_off="detached at $(git -C "$_uc_dir" rev-parse --short HEAD 2>/dev/null)"
    elif test -n "$_uc_branch" && test -n "$_uc_default" && test "$_uc_branch" != "$_uc_default"; then
        _uc_off="on branch $_uc_branch, not $_uc_default"
    fi
    _uc_before=$(git -C "$_uc_dir" rev-parse HEAD 2>/dev/null) || _uc_before=
    info "Updating $_uc_dir"
    _uc_status=0
    # Its output is read for why it failed, so it's caught here rather than
    # by logged, and then logged or shown the same way.
    _uc_out=$("$@" </dev/null 2>&1) || _uc_status=$?
    if test -n "$_uc_out"; then
        if test "${VERBOSE:-no}" = yes || test -z "${SETUP_LOG:-}"; then
            printf '%s\n' "$_uc_out"
        else
            printf '+ %s\n%s\n' "$*" "$_uc_out" >>"$SETUP_LOG"
        fi
    fi
    if test "$_uc_status" -ne 0; then
        if test "$_uc_detached" = yes; then
            _uc_why=$_uc_off
        elif test -n "$_uc_branch" && ! git -C "$_uc_dir" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
            _uc_why="on branch $_uc_branch, no upstream"
        else
            case "$_uc_out" in
                *"Could not resolve host"* | *"Could not read from remote"* | *"unable to access"* \
                | *"timed out"* | *"Network is unreachable"* | *"Connection refused"*)
                    _uc_why="can't reach origin" ;;
                *"local changes"* | *"would be overwritten"* | *"unstaged changes"* \
                | *"uncommitted changes"* | *"commit or stash"* | *"commit your changes"*)
                    _uc_why="local changes" ;;
                *"fast-forward"* | *"divergent"* | *"diverged"*)
                    _uc_why="diverged from $(git -C "$_uc_dir" rev-parse --abbrev-ref '@{u}' 2>/dev/null)" ;;
                *CONFLICT* | *"merge failed"*)
                    _uc_why="merge conflicts to resolve" ;;
                *)
                    _uc_why="git failed" ;;
            esac
            case "$_uc_off" in
                "on branch"*) _uc_why="$_uc_off; $_uc_why" ;;
            esac
        fi
        _uc_said=$(git_message "$_uc_out")
        warn "couldn't update $_uc_dir: $_uc_why (git pull exited $_uc_status${_uc_said:+: $_uc_said}); $_uc_use"
        record_why git failed-update "$_uc_name" "$_uc_why"
        return 1
    fi
    if test -n "$_uc_off"; then
        warn "$_uc_dir is $_uc_off; $_uc_use"
    fi
    _uc_after=$(git -C "$_uc_dir" rev-parse HEAD 2>/dev/null) || _uc_after=
    _uc_state=already
    test "$_uc_after" = "$_uc_before" || _uc_state=updated
    record_why git "$_uc_state" "$_uc_name" "${_uc_off%%,*}"
}

# --- Detect OS ---

detect_os() {
    case "$(uname -s)" in
        Darwin)
            OS="macos"
            ;;
        Linux)
            if command -v apt-get >/dev/null 2>&1; then
                OS="debian"
            elif command -v dnf >/dev/null 2>&1; then
                OS="redhat"
            else
                OS="unknown"
            fi
            ;;
        *)
            OS="unknown"
            ;;
    esac
}

# Whether this is a Mac running Intel Homebrew. Homebrew stopped building Intel
# bottles in August 2026 (Intel is its Tier 3 now), so there every formula that
# changes compiles from source -- about 40 minutes for Node.js on one. uname -m
# names the process's architecture, not the chip's: a shell under Rosetta says
# x86_64, and the brew that installs there is Intel Homebrew too (the Apple
# Silicon one won't install under Rosetta), so it compiles just the same.
is_intel_mac() {
    test "$OS" = macos && test "$(uname -m)" = x86_64
}

# --- Detect Crostini ---

# ChromeOS's Linux container (Crostini). It looks like Debian with a display,
# but ChromeOS owns the desktop, keyboard and power, so setup keeps to the
# shell, kitty and fonts there. CROS_ROOT points the checks at a test tree.
is_crostini() {
    test -e "${CROS_ROOT:-}/dev/.cros_milestone" && return 0
    test -d "${CROS_ROOT:-}/opt/google/cros-containers" && return 0
    return 1
}

# Sets CROSTINI (1/0). Must run after detect_os.
resolve_crostini() {
    CROSTINI=0
    if test "$OS" = debian && is_crostini; then
        CROSTINI=1
        info "Skipping the desktop, keyboard and power setup: ChromeOS (Crostini) owns them"
    fi
}

# configure_linux_desktop sets up KDE Plasma + Krohnkite and, unless
# --no-tide, the tide session beside it.
configure_linux_desktop() {
    info "Configuring KDE Plasma"
    # shellcheck disable=SC2086  # both expand to zero or more flags
    "$SCRIPTS_DIR/setup-kde" $DESKTOP_SETUP_FLAGS $KDE_SETUP_FLAGS
    if test "$TIDE" = no; then
        info "Skipping tide: --no-tide"
        return 0
    fi
    info "Installing tide"
    # Cloned here, not by setup-tide, so --github, the origin
    # check and URL redaction work as for setup's other repos.
    clone_or_pull "$TIDE_REPO" "$SRC_DIR/tide" yes
    # A mirror stands in for GitHub in setup-tide's source builds too; in
    # the environment, not argv, where a token in it would show in ps.
    tide_github=
    if test "$GITHUB_MIRROR" = yes; then
        tide_github=$GITHUB_PREFIX
    fi
    # shellcheck disable=SC2086  # expands to zero or more flags
    TIDE_DIR="$SRC_DIR/tide" GITHUB_PREFIX="$tide_github" \
        "$SCRIPTS_DIR/setup-tide" --no-fetch $DESKTOP_SETUP_FLAGS $TIDE_SETUP_FLAGS
}

# What setup leaves to ChromeOS, and where to set it instead.
crostini_settings() {
    say "Set these in ChromeOS rather than here:"
    say "  keyboard layout and Caps Lock: Settings > Device > Keyboard and inputs"
    say "  sleep and lock: Settings > Device > Power, and Privacy > Lock screen"
    say "  more disk for Linux: Settings > About ChromeOS > Linux development environment > Disk size"
    say "tileco's options page has the full checklist."
}

# --- Detect GUI ---

# True if a graphical session appears to be available. Checks the usual
# environment variables plus the session type reported by logind, so it
# works under both X11 and Wayland.
have_display() {
    test -n "${DISPLAY:-}" && return 0
    test -n "${WAYLAND_DISPLAY:-}" && return 0
    case "${XDG_SESSION_TYPE:-}" in
        x11|wayland) return 0 ;;
    esac
    return 1
}

# Resolve $GUI (auto/yes/no) into GUI_ENABLED (1/0). Must run after
# detect_os, since macOS is always graphical and exposes no DISPLAY.
resolve_gui() {
    case "$GUI" in
        yes)
            GUI_ENABLED=1
            info "Graphical setup: on (--gui)"
            ;;
        no)
            GUI_ENABLED=0
            info "Graphical setup: off (--no-gui)"
            ;;
        *)
            if test "$OS" = "macos"; then
                # macOS has no DISPLAY variable; it's always graphical.
                GUI_ENABLED=1
                info "Graphical setup: on (macOS)"
            elif have_display; then
                GUI_ENABLED=1
                info "Graphical setup: on (display found)"
            else
                GUI_ENABLED=0
                info "Graphical setup: off (no display; --gui turns it on)"
            fi
            ;;
    esac
}

# --- Detect available disk space ---

# Available space, in whole GB, on the filesystem holding $HOME. Prints
# nothing if df can't report it (caller treats that as "unknown").
available_disk_gb() {
    df -Pk "$HOME" 2>/dev/null | awk 'NR==2 {print int($4 / 1024 / 1024)}'
}

# Resolve $MINIMAL (auto/yes/no) into MINIMAL_ENABLED (1/0). In auto mode,
# pick the lean profile when free disk space is below MIN_DISK_GB.
resolve_minimal() {
    case "$MINIMAL" in
        yes)
            MINIMAL_ENABLED=1
            info "Install profile: minimal (--minimal)"
            ;;
        no)
            MINIMAL_ENABLED=0
            info "Install profile: full (--full)"
            ;;
        *)
            avail=$(available_disk_gb)
            if test -n "$avail" && test "$avail" -lt "$MIN_DISK_GB"; then
                MINIMAL_ENABLED=1
                info "Install profile: minimal (${avail}GB free, under ${MIN_DISK_GB}GB; --full overrides)"
                # Crostini's default disk is about 10GB, so say how to grow it.
                if test "${CROSTINI:-0}" -eq 1; then
                    info "Linux's disk grows in Settings > About ChromeOS > Linux development environment > Disk size"
                fi
            elif test -n "$avail"; then
                MINIMAL_ENABLED=0
                info "Install profile: full (${avail}GB free)"
            else
                MINIMAL_ENABLED=0
                info "Install profile: full (free disk space unknown)"
            fi
            ;;
    esac
}

# Resolve $EXTRAS (auto/brew/release) into EXTRAS_BACKEND. Auto picks brew when
# it's available or on macOS, else the release artifacts -- which is also where
# Linux boxes without Homebrew used to get a Rust toolchain and a source build.
# Must run after detect_os.
resolve_extras() {
    case "$EXTRAS" in
        brew)
            EXTRAS_BACKEND=brew
            info "Extras backend: Homebrew (--brew)"
            ;;
        release)
            EXTRAS_BACKEND=release
            info "Extras backend: GitHub release artifacts (--release)"
            ;;
        *)
            if command -v brew >/dev/null 2>&1; then
                EXTRAS_BACKEND=brew
                info "Extras backend: Homebrew (brew detected)"
            elif test "$OS" = "macos"; then
                EXTRAS_BACKEND=brew
                info "Extras backend: Homebrew (macOS)"
            else
                EXTRAS_BACKEND=release
                info "Extras backend: GitHub release artifacts (no Homebrew; --brew overrides)"
            fi
            ;;
    esac
}

# --- Install Homebrew (macOS) ---

install_homebrew() {
    if command -v brew >/dev/null 2>&1; then
        info "Skipping Homebrew: already installed"
        return 0
    fi
    # Not logged: the installer asks for RETURN and a password.
    say "Installing Homebrew"
    # Deliberately not NONINTERACTIVE=1, tempting as it looks: that suppresses
    # more than the installer's opening RETURN. It switches the installer's
    # sudo calls to `sudo -n` and skips the `sudo -v` that would cache
    # credentials, so on a fresh Mac with no warm sudo timestamp the installer
    # aborts with "Need sudo access on macOS" instead of asking for the
    # password. The administrator password is the user's to give -- one RETURN
    # on the one run that installs Homebrew is the better trade.
    if ! /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
        record_install download failed Homebrew
        warn "couldn't install Homebrew"
        return 1
    fi
    # Add Homebrew to PATH for the rest of this script. macOS installs to
    # /opt/homebrew (Apple silicon) or /usr/local (Intel); Linuxbrew installs
    # to /home/linuxbrew/.linuxbrew or ~/.linuxbrew.
    for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew \
                    /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
        if test -x "$brew_bin"; then
            eval "$("$brew_bin" shellenv)"
            break
        fi
    done
    # Return status reflects whether brew is now usable, so callers can fall
    # back (e.g. to the release artifacts) rather than assume success.
    if command -v brew >/dev/null 2>&1; then
        record_install download installed Homebrew
        return 0
    fi
    record_install download failed Homebrew
    return 1
}

# --- Go ---

# vcs (conf) and tide-grant (tide) are built with Go.
# install_packages installs it from the distro, brew on macOS, or conda-forge
# through homepkg under --no-root (install_home_tools). setup builds vcs, which
# needs 1.21: from there on, Go fetches the newer toolchain vcs's go.mod asks
# for. setup-tide checks tide's own minimum. Overridable for tests.
GO="${GO:-go}"
MIN_GO=1.21

# go_at_least says whether Go version $1 (1.22.2, 1.24rc1) is at least $2
# (1.22). Plain arithmetic, since macOS's sort has no -V.
go_at_least() {
    have_major=${1%%.*}
    have_minor=${1#*.}
    have_minor=${have_minor%%[!0-9]*}
    want_major=${2%%.*}
    want_minor=${2#*.}
    want_minor=${want_minor%%[!0-9]*}
    test "${have_major:-0}" -gt "$want_major" \
        || { test "${have_major:-0}" -eq "$want_major" && test "${have_minor:-0}" -ge "$want_minor"; }
}

# check_go says whether $GO can build vcs, and warns why not.
check_go() {
    if ! command -v "$GO" >/dev/null 2>&1; then
        warn "no Go; vcs needs Go $MIN_GO or newer: install golang (Debian, Ubuntu, Fedora) or go (Homebrew)"
        return 1
    fi
    if ! go_version=$("$GO" env GOVERSION 2>&1); then
        warn "couldn't ask $GO for its version: $go_version"
        return 1
    fi
    go_version=${go_version#go}
    case "$go_version" in
        [0-9]*.[0-9]*) ;;
        *)
            warn "couldn't read $GO's version: $go_version"
            return 1
            ;;
    esac
    if ! go_at_least "$go_version" "$MIN_GO"; then
        warn "vcs needs Go $MIN_GO or newer, and $GO is $go_version; on Debian 12, install golang from bookworm-backports, or Go from https://go.dev/dl/"
        return 1
    fi
}

# --- Install system packages ---

# pkg_source: the package manager's name, for the summary.
pkg_source() {
    case "$OS" in
        debian) echo apt ;;
        redhat) echo dnf ;;
        macos) echo brew ;;
        *) echo packages ;;
    esac
}

# brew_has NAME: whether Homebrew has formula or cask NAME installed. One
# `brew list` answers for every name it lists, kept in BREW_LIST until the
# next install; an alias (python3), which it lists under its real name, is
# asked about on its own.
brew_has() {
    brew_warm
    case "$BREW_LIST" in
        *" $1 "*) return 0 ;;
    esac
    brew list --versions "$1" >/dev/null 2>&1
}

# brew_version NAME: the versions Homebrew lists for formula or cask NAME,
# failing when it lists none. One `brew list --versions` of each kind
# answers for every name, kept in BREW_VERSIONS until the next install; an
# alias (python3), listed under its real name, is asked about on its own.
brew_version() {
    brew_warm
    _bv=$(printf '%s\n' "$BREW_VERSIONS" | awk -v n="$1" '$1 == n { sub(/^[^ ]+ /, ""); print; exit }')
    if test -z "$_bv"; then
        _bv=$(brew list --versions "$1" 2>/dev/null) || return 1
        _bv=${_bv#* }
    fi
    test -n "$_bv" || return 1
    printf '%s\n' "$_bv"
}

# brew_warm: fills what brew_has and brew_version cache, if it's empty. Call
# it in the shell a run of checks starts from: each $(pkg_version ...) is a
# subshell, whose cache is gone when it returns, so without it every package
# asks brew for its whole inventory again.
brew_warm() {
    # A brew that can't answer lists nothing, rather than ending the run
    # under set -e.
    if test -z "${BREW_LIST:-}"; then
        BREW_LIST=" $(brew list -1 2>/dev/null | tr '\n' ' ' || :) "
    fi
    if test -z "${BREW_VERSIONS:-}"; then
        BREW_VERSIONS="
$(brew list --formula --versions 2>/dev/null || :)
$(brew list --cask --versions 2>/dev/null || :)
"
    fi
}

# brew_forget: after an install, what brew_has and brew_version cached is
# out of date.
brew_forget() {
    BREW_LIST=
    BREW_VERSIONS=
}

# pkg_has NAME: whether the system package manager has NAME installed. A dnf
# group (@name) is never taken as installed here: dnf itself knows, and
# installing one that is does nothing.
pkg_has() {
    case "$OS" in
        debian)
            _ph_status=$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null) || return 1
            case "$_ph_status" in
                *" installed") return 0 ;;
            esac
            return 1
            ;;
        redhat)
            case "$1" in
                @*) return 1 ;;
            esac
            rpm -q --whatprovides "$1" >/dev/null 2>&1
            ;;
        macos) brew_has "$1" ;;
        *) return 1 ;;
    esac
}

# pkg_version NAME: prints the version of system package NAME installed
# ("installed" where the package manager doesn't say which), failing when
# it isn't installed or, a dnf group, can't be asked about.
pkg_version() {
    case "$OS" in
        debian)
            _pv=$(dpkg-query -W -f='${Status} ${Version}\n' "$1" 2>/dev/null) || return 1
            printf '%s\n' "$_pv" | awk '$3 == "installed" { print ($4 == "" ? "installed" : $4); found = 1; exit }
                END { exit !found }'
            ;;
        redhat)
            case "$1" in
                @*) return 1 ;;
            esac
            _pv=$(rpm -q --whatprovides --qf '%{VERSION}-%{RELEASE}\n' "$1" 2>/dev/null) || return 1
            printf '%s\n' "${_pv:-installed}"
            ;;
        macos)
            brew_has "$1" || return 1
            brew_version "$1" || echo installed
            ;;
        *) return 1 ;;
    esac
}

# apt_conffile_options: dpkg's answer for a quiet install to the question it
# asks about a config file you've changed that the package changed too: keep
# yours, or take the package's default where it names one. A quiet install
# reads /dev/null, where dpkg's question would fail the install, leaving the
# package unconfigured; --verbose asks on the terminal, as before. The new
# version is left beside yours, and report_new_conffiles says where.
apt_conffile_options() {
    if test "${VERBOSE:-no}" != yes && test -n "${SETUP_LOG:-}"; then
        printf '%s\n' -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold
    fi
}

# report_new_conffiles MARKER: warns about each new config file dpkg left
# beside one of yours (FILE.dpkg-dist), since MARKER was made, so the
# package's changes to it aren't lost without a word. $SETUP_ETC stands in
# for /etc in the tests.
report_new_conffiles() {
    find "${SETUP_ETC:-/etc}" -name '*.dpkg-dist' -newer "$1" 2>/dev/null | while IFS= read -r _rn_file; do
        warn "kept your ${_rn_file%.dpkg-dist}; the package's new version is $_rn_file, to merge by hand"
    done
}

# install_pkgs [--cask] NAME...: installs the system packages NAME..., and
# upgrades any already installed that have a newer version, in one
# transaction with its output logged, as an unquiet setup always did. Each
# is tallied for the summary: newly installed, updated (its version moved),
# or already installed. apt's lists are updated once, before the first apt
# install a run makes. Fails, having shown why, when the package manager
# does; the caller says what that costs.
APT_UPDATED=no
install_pkgs() {
    _ip_cask=
    if test "$1" = --cask; then
        _ip_cask=--cask
        shift
    fi
    _ip_source=$(pkg_source)
    # Each one's version before, to tell an install or upgrade from a package
    # left as it was.
    test "$OS" != macos || brew_warm
    _ip_before=
    for _ip_pkg in "$@"; do
        _ip_before="$_ip_before$_ip_pkg=$(pkg_version "$_ip_pkg" || :)
"
    done
    info "Installing or upgrading $*"
    _ip_status=0
    case "$OS" in
        debian)
            if test "${APT_UPDATED:-no}" = no; then
                if logged sudo_or_warn apt-get update -qq; then
                    APT_UPDATED=yes
                else
                    APT_UPDATED=failed
                    warn "apt-get update failed, so apt installs nothing this run"
                fi
            fi
            if test "$APT_UPDATED" = yes; then
                _ip_marker=$(mktemp "${TMPDIR:-/tmp}/setup-apt-XXXXXX") || _ip_marker=
                # shellcheck disable=SC2046  # none or four options, without spaces
                logged sudo_or_warn apt-get install -y --install-recommends "$@" $(apt_conffile_options) || _ip_status=$?
                if test -n "$_ip_marker"; then
                    report_new_conffiles "$_ip_marker"
                    rm -f "$_ip_marker"
                fi
            else
                _ip_status=1
            fi
            ;;
        redhat)
            logged sudo_or_warn dnf install -y "$@" || _ip_status=$?
            ;;
        macos)
            # shellcheck disable=SC2086  # $_ip_cask is empty or one flag
            logged brew install $_ip_cask "$@" || _ip_status=$?
            brew_forget
            ;;
        *) _ip_status=1 ;;
    esac
    # One transaction: when it worked, it installed them all, and when it
    # didn't, only what's there afterwards made it. A dnf group can't be
    # asked about, so it's named only when it failed.
    test "$OS" != macos || brew_warm
    for _ip_pkg in "$@"; do
        _ip_was=$(printf '%s' "$_ip_before" | awk -F= -v n="$_ip_pkg" '$1 == n { sub(/^[^=]*=/, ""); print; exit }')
        _ip_now=$(pkg_version "$_ip_pkg") || _ip_now=
        case "$_ip_pkg" in
            @*)
                test "$_ip_status" -eq 0 || record_install "$_ip_source" failed "$_ip_pkg"
                continue
                ;;
        esac
        if test -z "$_ip_now" && test "$_ip_status" -ne 0; then
            record_install "$_ip_source" failed "$_ip_pkg"
        elif test -z "$_ip_was"; then
            record_install "$_ip_source" installed "$_ip_pkg"
        elif test "$_ip_now" != "$_ip_was"; then
            record_install "$_ip_source" updated "$_ip_pkg"
        else
            record_install "$_ip_source" already "$_ip_pkg"
        fi
    done
    return "$_ip_status"
}

# install_tsc_npm: tsc from npm's registry, once, where the distro has none.
install_tsc_npm() {
    if command -v tsc >/dev/null 2>&1; then
        info "Skipping typescript: tsc is already installed at $(command -v tsc)"
        return 0
    fi
    info "Installing typescript with npm"
    if logged sudo_or_warn npm install -g typescript; then
        record_install npm installed typescript
    else
        record_install npm failed typescript
        warn "couldn't install tsc, which setup-kde's Krohnkite source build needs"
    fi
}

install_packages() {
    case "$OS" in
        debian)
            if ! install_pkgs \
                    adb \
                    atool \
                    bat \
                    build-essential \
                    curl \
                    fd-find \
                    fzf \
                    gh \
                    git \
                    git-delta \
                    git-email \
                    golang \
                    jq \
                    mercurial \
                    micro \
                    p7zip-full \
                    python3 \
                    python3-pip \
                    python3-venv \
                    ripgrep \
                    shellcheck \
                    unzip \
                    vim \
                    zsh; then
                warn "skipping the rest of the apt packages"
                return 0
            fi
            # zoxide is missing from older releases (Ubuntu 20.04 has no
            # package), and apt rejects the whole transaction on one unknown
            # name -- which would take git/make down with it. Its own
            # best-effort step keeps that contained; the shell config skips
            # zoxide when it isn't installed.
            install_pkgs zoxide \
                || warn "couldn't install zoxide, so z and zi don't work"
            # zsh-autosuggestions (inline history ghost text) gets its own
            # best-effort step for the same reason as zoxide: apt aborts the
            # whole transaction on one unknown name, and older releases may not
            # package it. The shell config skips it when it's missing.
            install_pkgs zsh-autosuggestions \
                || warn "couldn't install zsh-autosuggestions, so zsh shows no history suggestions"
            # lf (terminal file manager) isn't in the Debian/Ubuntu repos, so
            # it's not attempted here -- install_file_managers installs it from
            # conda-forge via homepkg after the clone, on every profile.
            # Node.js + tsc from the distro on the privileged path (setup-kde's
            # source-build fallback for Krohnkite needs tsc; its normal path
            # fetches a prebuilt release and needs neither). Under --no-root
            # apt is skipped above, and these come from conda-forge via
            # homepkg instead (install_home_tools).
            if test "$NPM" = yes; then
                install_pkgs npm \
                    || warn "couldn't install npm; trying tsc anyway"
                # tsc lets setup-kde's fallback build Krohnkite from source
                # without fetching typescript from the npm registry at build
                # time. Debian/Ubuntu package it as node-typescript; fall
                # back to a one-time global npm install where unavailable.
                # Either does, so neither is a failure while the other works,
                # and npm is tried too when apt's package won't install.
                if pkg_has node-typescript || { ! command -v tsc >/dev/null 2>&1 \
                        && apt-cache show node-typescript >/dev/null 2>&1; }; then
                    install_pkgs node-typescript || install_tsc_npm
                else
                    install_tsc_npm
                fi
            fi
            if test "$GUI_ENABLED" -eq 1; then
                install_pkgs kitty \
                    || warn "couldn't install kitty"
                if test "$CROSTINI" -eq 1; then
                    # Gigabytes the container's small disk can't spare, for a
                    # desktop ChromeOS already is.
                    info "Skipping KDE Plasma's packages: Crostini"
                    return 0
                fi
                install_pkgs \
                    kde-standard \
                    kwin-dev \
                    plasma-desktop plasma-sdk \
                    || warn "couldn't install KDE Plasma's packages"
                # gdbus (glib's D-Bus CLI) is how setup-kde applies keyboard
                # shortcuts to the running session instead of deferring them to
                # the next login -- see kdeshortcut.py. Its own step, because
                # apt rejects a whole transaction on one unknown name, and
                # because it's usually already pulled in by the desktop.
                install_pkgs libglib2.0-bin \
                    || warn "couldn't install libglib2.0-bin, so KDE's new shortcuts wait for a logout unless python3-dbus is installed"
                # fuzzel is the menu of KDE's Win+V (clipboard-menu), and
                # wl-copy puts the entry chosen back. Their own step, so a
                # release without them keeps the rest.
                install_pkgs fuzzel wl-clipboard \
                    || warn "couldn't install fuzzel or wl-clipboard, so Win+V on KDE can't show the clipboard"
            fi
            ;;
        redhat)
            if ! install_pkgs \
                    '@development-tools' \
                    android-tools \
                    atool \
                    bat \
                    curl \
                    fd-find \
                    fzf \
                    gh \
                    git \
                    git-delta \
                    git-email \
                    golang \
                    jq \
                    mercurial \
                    micro \
                    p7zip \
                    p7zip-plugins \
                    python3 \
                    python3-pip \
                    ripgrep \
                    ShellCheck \
                    unzip \
                    vim \
                    zsh; then
                warn "skipping the rest of the dnf packages"
                return 0
            fi
            # Its own transaction, for the same reason as the Debian branch:
            # dnf aborts the lot when one name is unknown.
            install_pkgs zoxide \
                || warn "couldn't install zoxide, so z and zi don't work"
            # Its own step, as with zoxide: dnf aborts the lot on one unknown
            # name, and the shell config skips it when it's missing.
            install_pkgs zsh-autosuggestions \
                || warn "couldn't install zsh-autosuggestions, so zsh shows no history suggestions"
            # lf (terminal file manager) isn't in the base Fedora repos, so
            # it's not attempted here; install_file_managers installs it from
            # conda-forge via homepkg after the clone, on every profile.
            # Node.js + tsc from the distro on the privileged path (setup-kde's
            # source-build fallback for Krohnkite needs tsc; its normal path
            # fetches a prebuilt release and needs neither). Under --no-root
            # dnf is skipped above, and these come from conda-forge via
            # homepkg instead (install_home_tools).
            if test "$NPM" = yes; then
                install_pkgs npm \
                    || warn "couldn't install npm; trying tsc anyway"
                # tsc lets setup-kde's fallback build Krohnkite from source
                # without fetching typescript from the npm registry at build
                # time. Fedora ships no typescript rpm, so this is a one-time
                # global npm install during bootstrap.
                install_tsc_npm
            fi
            if test "$GUI_ENABLED" -eq 1; then
                install_pkgs kitty \
                    || warn "couldn't install kitty"
                install_pkgs \
                    '@kde-desktop-environment' \
                    kwin-devel \
                    plasma-desktop \
                    plasma-sdk \
                    || warn "couldn't install KDE Plasma's packages"
                # gdbus (glib's D-Bus CLI) is how setup-kde applies keyboard
                # shortcuts to the running session instead of deferring them to
                # the next login -- see kdeshortcut.py. Its own step so one
                # unavailable name can't take the desktop packages down with it.
                install_pkgs glib2 \
                    || warn "couldn't install glib2, so KDE's new shortcuts wait for a logout unless python3-dbus is installed"
                install_pkgs fuzzel wl-clipboard \
                    || warn "couldn't install fuzzel or wl-clipboard, so Win+V on KDE can't show the clipboard"
            fi
            ;;
        macos)
            # Every brew step below warns and continues rather than aborting,
            # matching the apt/dnf branches: one renamed formula or one tap
            # outage shouldn't take the whole bootstrap down under set -e.
            if ! install_homebrew; then
                warn "no Homebrew, so no macOS packages"
                return 0
            fi
            if ! install_pkgs \
                atool \
                autoconf \
                automake \
                bat \
                curl \
                fd \
                fzf \
                gh \
                git \
                git-delta \
                go \
                jq \
                mercurial \
                micro \
                p7zip \
                python3 \
                ripgrep \
                shellcheck \
                unzip \
                vim \
                zsh; then
                warn "couldn't install some of the core Homebrew packages"
            fi
            # Separate, so a formula rename or a tap outage can't take the
            # core package list down with it.
            install_pkgs zoxide \
                || warn "couldn't install zoxide, so z and zi don't work"
            # Its own step, matching zoxide; the shell config skips it when
            # it's missing.
            install_pkgs zsh-autosuggestions \
                || warn "couldn't install zsh-autosuggestions, so zsh shows no history suggestions"
            # lf (terminal file manager) is a CLI tool, not graphical, so
            # install it regardless of --no-gui (matching the Linux paths).
            install_pkgs lf || warn "couldn't install lf"
            # Node.js + tsc from Homebrew on the privileged path (setup-kde's
            # source-build fallback for Krohnkite needs tsc; its normal path
            # fetches a prebuilt release and needs neither). brew needs no
            # sudo, so unlike the apt/dnf branches this can't self-skip under
            # --no-root -- gate it on ROOT so an unprivileged macOS run gets
            # node/tsc from conda-forge via homepkg (install_home_tools)
            # instead of a second copy here. An Intel Mac gets them from
            # homepkg too (install_node_home), as Homebrew would compile them.
            if test "$NPM" = yes && test "$ROOT" = yes && is_intel_mac; then
                info "Skipping Homebrew's node and typescript: an Intel Mac gets them from homepkg"
            elif test "$NPM" = yes && test "$ROOT" = yes; then
                install_pkgs node \
                    || warn "couldn't install node, which setup-kde's Krohnkite source build needs"
                # tsc lets setup-kde's fallback build Krohnkite from source
                # without fetching typescript from the npm registry at build
                # time. Installed on macOS too so the toolchain matches Linux.
                install_pkgs typescript \
                    || warn "couldn't install tsc, which setup-kde's Krohnkite source build needs"
            fi
            # adb/fastboot are CLI tools (used by pidcat and friends), not
            # graphical -- install them regardless of --no-gui, matching the
            # Linux paths which keep adb/android-tools as core packages.
            install_pkgs --cask android-platform-tools \
                || warn "couldn't install android-platform-tools, so there's no adb or fastboot"
            if test "$GUI_ENABLED" -eq 1; then
                install_pkgs kitty \
                    || warn "couldn't install kitty"
                # No Amethyst or Rectangle: setup-macos sets up tilemo, which
                # they'd fight over keys and windows. `setup-macos --wm
                # amethyst` installs Amethyst itself.
                install_pkgs --cask iterm2 \
                    || warn "couldn't install iTerm2"
            fi
            ;;
        *)
            warn "unknown OS; install these yourself: atool bat curl fd fzf git git-delta golang jq kitty lf make mercurial npm p7zip python3 ripgrep shellcheck typescript unzip zoxide zsh zsh-autosuggestions"
            ;;
    esac
}

# --- Purge obsolete desktop packages ---

# Packages an earlier setup installed for the Sway and Hyprland desktops, which
# setup dropped when it settled on KDE Plasma + Krohnkite as its one desktop
# (July 2026). apt/dnf never uninstall on their own, so a box that once ran the
# old setup keeps them -- most visibly a sway-notification-center (swaync)
# systemd user unit that keeps starting. --purge-obsolete removes them.
#
# Only the Sway/Hyprland-specific packages are named: the compositors, their
# lock/idle/bg helpers, the wlroots portals, and the shared bar/launcher/
# notification stack (waybar, fuzzel, swaync). The generic Wayland utilities the
# old setup also pulled in (pipewire, network-manager-gnome, ...) are left
# alone -- they're useful under KDE too, and autoremove is the tool for their
# orphaned deps, which is why we point at it rather than running it ourselves.
# Report whether package $1 is installed, telling the expected "not installed"
# answer apart from a real package-database query failure (a corrupt or
# unreadable db). A failure must never masquerade as "not installed": that would
# drop an installed package from the purge and let it report success while
# leaving the package -- the swaync unit included -- behind. On such a failure
# this warns with the query's own error and returns 2; otherwise 0 (installed),
# 1 (not), or 3 (installed but held on Debian -- the caller reports those and
# leaves them alone). We filter to installed packages because passing an unknown
# name to apt-get/dnf aborts the whole transaction.
obsolete_pkg_installed() {
    _op_pkg="$1"
    _op_errf=$(mktemp) || {
        warn "couldn't make a temporary file to ask about $_op_pkg; leaving it out of the purge"
        return 2
    }
    _op_ret=2
    case "$OS" in
        debian)
            # dpkg-query exits 0 when it knows the package (status on stdout),
            # 1 when no package matches (the not-installed answer), and >1 on a
            # real error. The Status is "want eflag state": the state word (the
            # last) says whether it's installed at all, whatever the desired
            # action, and the want word (the first) flags a hold. A held package
            # is installed but must not go into the -y purge -- apt-get -y aborts
            # the whole transaction on a held change without
            # --allow-change-held-packages -- so it gets its own return.
            _op_status=$(dpkg-query -W -f='${Status}' "$_op_pkg" 2>"$_op_errf")
            case $? in
                0) case "${_op_status##* }" in
                       installed)
                           case "${_op_status%% *}" in
                               hold) _op_ret=3 ;;
                               *) _op_ret=0 ;;
                           esac ;;
                       *) _op_ret=1 ;;
                   esac ;;
                1) _op_ret=1 ;;
            esac
            ;;
        redhat)
            # rpm -q exits 0 when installed. A not-installed package exits
            # non-zero with its message on stdout and nothing on stderr; a real
            # error writes to stderr -- so stderr, not the exit code, separates
            # the two, since rpm reuses exit 1 for both.
            if rpm -q "$_op_pkg" >/dev/null 2>"$_op_errf"; then
                _op_ret=0
            elif ! test -s "$_op_errf"; then
                _op_ret=1
            fi
            ;;
    esac
    if test "$_op_ret" -eq 2; then
        warn "couldn't ask about package $_op_pkg ($(cat "$_op_errf")); leaving it out of the purge"
    fi
    rm -f "$_op_errf"
    return "$_op_ret"
}

purge_obsolete_packages() {
    # The list is reconciled against the July 2026 removal commit's install
    # paths, not memory: swaync ships as sway-notification-center on
    # Debian/Ubuntu and SwayNotificationCenter on Fedora, but those paths fell
    # back to the upstream "swaync" name, so it goes in the shared list too. The
    # session manager uwsm and the tiler autotiling were installed on both. The
    # generic Wayland utilities those paths also pulled in (pipewire, blueman,
    # grim/slurp, the GTK portal, the polkit agent, ...) are deliberately left
    # out -- they're useful under KDE too. The rest share names across distros.
    obsolete="sway swaybg swayidle swaylock xdg-desktop-portal-wlr \
              hyprland hypridle hyprlock swww xdg-desktop-portal-hyprland \
              uwsm waybar fuzzel kanshi autotiling swaync"
    case "$OS" in
        debian) obsolete="$obsolete sway-notification-center" ;;
        redhat) obsolete="$obsolete SwayNotificationCenter" ;;
        *) info "Skipping the obsolete-package purge: not on this OS"; return 0 ;;
    esac
    # tide runs on Hyprland, uwsm and (until its own shell lands) the
    # waybar/swaync/fuzzel stack, with swww or swaybg for the wallpaper, so
    # the purge keeps those unless --no-tide is given.
    if test "$TIDE" = yes; then
        tide_pkgs=" hyprland hypridle hyprlock swww swaybg xdg-desktop-portal-hyprland uwsm waybar fuzzel swaync sway-notification-center SwayNotificationCenter "
        kept=""
        for pkg in $obsolete; do
            case "$tide_pkgs" in
                *" $pkg "*) ;;
                *) kept="$kept $pkg" ;;
            esac
        done
        obsolete=$kept
    fi

    # obsolete_pkg_installed warns and returns non-zero on a real query failure,
    # so a package whose status can't be determined is left out of the purge
    # rather than silently skipped. Held Debian packages (return 3) are split
    # off: a hold is a deliberate "do not touch", and apt-get -y would abort the
    # whole purge on one anyway, so report them and leave them rather than force
    # them out -- but don't drop them silently.
    installed=""
    held=""
    for pkg in $obsolete; do
        # Capture the status via || so a non-zero "not installed"/"held"/error
        # return doesn't trip set -e (it isn't in a condition context here).
        _pkg_state=0
        obsolete_pkg_installed "$pkg" || _pkg_state=$?
        case $_pkg_state in
            0) installed="$installed $pkg" ;;
            3) held="$held $pkg" ;;
        esac
    done
    if test -n "$held"; then
        warn "not purging these, which are held ('sudo apt-mark unhold PKG' and rerun, or purge them yourself):$held"
    fi
    if test -z "$installed"; then
        info "Skipping the obsolete-package purge: none installed"
        return 0
    fi

    case "$OS" in
        debian)
            # shellcheck disable=SC2086  # word-split the collected package list
            if logged sudo_or_warn apt-get purge -y $installed; then
                say "Purged obsolete packages:$installed"
                say "Run 'sudo apt-get autoremove --purge' to remove what they depended on"
            else
                warn "couldn't purge some of the obsolete packages; purge them yourself:$installed"
            fi
            ;;
        redhat)
            # shellcheck disable=SC2086  # word-split the collected package list
            if logged sudo_or_warn dnf remove -y $installed; then
                say "Removed obsolete packages:$installed"
                say "Run 'sudo dnf autoremove' to remove what they depended on"
            else
                warn "couldn't remove some of the obsolete packages; remove them yourself:$installed"
            fi
            ;;
    esac
}

# --- Install fonts ---

# Returns true if the given font family is already known to fontconfig.
# Falls back to false if fc-list is unavailable (caller should do a file check).
font_installed() {
    family="$1"
    command -v fc-list >/dev/null 2>&1 && fc-list | grep -qi "$family"
}

install_fonts() {
    case "$OS" in
        macos)
            font_dir="$HOME/Library/Fonts"
            ;;
        *)
            font_dir="$HOME/.local/share/fonts"
            ;;
    esac
    mkdir -p "$font_dir"
    fonts_changed=no

    # Remove any previously installed Ubuntu Mono Nerd Font files; they alter
    # font metrics and cause kitty to render bold text smaller than regular.
    if ls "$font_dir"/UbuntuMonoNerdFont*.ttf >/dev/null 2>&1; then
        rm -f "$font_dir"/UbuntuMonoNerdFont*.ttf
        say "Removed Ubuntu Mono Nerd Font, which made kitty's bold text smaller"
        fonts_changed=yes
    fi

    # Ubuntu Mono
    if font_installed "Ubuntu Mono" || ls "$font_dir"/UbuntuMono*.ttf >/dev/null 2>&1; then
        info "Skipping Ubuntu Mono: already installed"
        record_install download already UbuntuMono
    else
        info "Installing Ubuntu Mono"
        ubuntu_mono_url="https://github.com/google/fonts/raw/main/ufl/ubuntumono"
        font_status=installed
        for style in Regular Bold Italic BoldItalic; do
            if ! logged curl -fsSL -o "$font_dir/UbuntuMono-${style}.ttf" \
                    "$ubuntu_mono_url/UbuntuMono-${style}.ttf"; then
                font_status=failed
                break
            fi
        done
        record_install download "$font_status" UbuntuMono
        if test "$font_status" = installed; then
            fonts_changed=yes
        else
            rm -f "$font_dir"/UbuntuMono-*.ttf
            warn "couldn't download Ubuntu Mono"
        fi
    fi

    # Refresh font cache on Linux
    if test "$fonts_changed" = yes && command -v fc-cache >/dev/null 2>&1; then
        info "Refreshing the font cache"
        logged fc-cache -f "$font_dir" || warn "couldn't refresh the font cache; fc-cache -f $font_dir retries"
    fi
}

# --- Start services ---

# Whether there's a systemd user manager to talk to at all. Without one every
# --user query fails identically ("Failed to connect to bus"), so asking about a
# unit can't tell "no such unit" from "couldn't ask" -- and nothing could be
# enabled anyway. Checked with a query that doesn't name a unit, so the only
# thing its failure can mean is that there's no manager.
systemd_user_available() {
    systemctl --user show --property=Version >/dev/null 2>&1
}

# True when an shpool.service already exists in any form: a distro package's
# unit, one a previous setup run wrote, or one that's merely loaded (a generated
# or transient unit with no file behind it). Whatever set it up owns it -- and a
# unit setup writes into the user config directory silently overrides a packaged
# one, since user config outranks /usr/lib -- so leave it alone.
#
# Both probes need a user manager, and callers check for one first. Asking
# systemd beats reimplementing its unit load path: that path varies by version,
# includes places easy to forget ($XDG_DATA_HOME/systemd/user, the generator
# directories), and a local copy of it would quietly rot.
#
# They're questions rather than operations: for a unit systemd has never heard
# of, systemctl exits non-zero and says "No files found", which is the negative
# answer and not a failure to report.
shpool_service_exists() {
    if systemctl --user cat shpool.service >/dev/null 2>&1; then
        return 0
    fi
    # cat only sees file-backed units, so ask about loaded ones separately.
    test -n "$(systemctl --user list-units --all --plain --no-legend \
        shpool.service 2>/dev/null)"
}

start_services() {
    case "$OS" in
        debian|redhat)
            # setup doesn't install shpool at all (see the note by
            # install_extras), so all this does is give a systemd user service
            # to an shpool that arrived some other way -- a distro/Nix package,
            # or a hand-run cargo install -- and only when nothing has set one
            # up already. Use the resolved shpool path in ExecStart rather than
            # hard-coding %h/.cargo/bin/shpool: pointing the unit at a
            # nonexistent binary would just make `enable --now` fail.
            if command -v shpool >/dev/null 2>&1 && command -v systemctl >/dev/null 2>&1; then
                if ! systemd_user_available; then
                    # Asked first, because the probes below can't answer without
                    # a manager. Nothing could be enabled here anyway, and
                    # writing a unit blind would leave an override shadowing
                    # whatever a packaged unit turns out to be once there is one.
                    warn "no systemd user manager, so shpool.service isn't set up"
                elif shpool_service_exists; then
                    info "Skipping shpool.service: already set up"
                else
                    shpool_bin=$(command -v shpool)
                    shpool_service_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
                    shpool_service="$shpool_service_dir/shpool.service"
                    info "Writing $shpool_service"
                    mkdir -p "$shpool_service_dir"
                    cat > "$shpool_service" <<SERVICE
[Unit]
Description=shpool session manager
Documentation=https://github.com/shell-pool/shpool

[Service]
ExecStart=$shpool_bin daemon
Restart=on-failure

[Install]
WantedBy=default.target
SERVICE
                    # Both steps are best-effort even though a manager answered
                    # a moment ago: an optional session daemon must not take the
                    # bootstrap down with it. The unit file stays either way --
                    # it's valid, and nothing shadows it, since we only get here
                    # when no other shpool.service exists.
                    if ! logged systemctl --user daemon-reload; then
                        warn "wrote $shpool_service, but couldn't reload the systemd user manager, so it isn't enabled"
                    elif logged systemctl --user enable --now shpool.service; then
                        say "Enabled shpool.service ($shpool_service)"
                    else
                        warn "wrote $shpool_service, but couldn't enable it, so sessions use tmux"
                    fi
                fi
            fi
            ;;
        macos)
            # App launch shortcuts are handled by Automator Quick Actions
            # configured in setup-macos (no service needed)
            ;;
    esac
}

# --- The Helix runtime ---

# hx loads grammars, queries, and themes from a runtime directory, and searches
# <config dir>/runtime ahead of both $HELIX_RUNTIME and anything beside the
# binary. Each install path below brings its own runtime, so a symlink one of
# them left in the config directory shadows the next one's -- these two keep
# that straight.

# Point ~/.config/helix/runtime at the runtime tree homepkg unpacked from the
# release asset, replacing whatever an earlier install path left there.
link_helix_runtime() {
    helix_runtime_src="$1/share/helix/runtime"
    if ! test -d "$helix_runtime_src"; then
        warn "hx has no runtime directory, so it starts with no grammars or queries"
        return
    fi
    helix_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/helix"
    if test "$(readlink "$helix_config_dir/runtime")" = "$helix_runtime_src"; then
        return 0
    fi
    mkdir -p "$helix_config_dir"
    ln -sfn "$helix_runtime_src" "$helix_config_dir/runtime"
    say "Linked $helix_config_dir/runtime to the release's runtime"
}

# Drop ~/.config/helix/runtime when it points at a runtime tree setup itself
# put there -- the old cargo source checkout, or a release install's payload --
# so the hx being installed now uses the runtime that came with it. Anything
# else (a hand-made symlink, a real directory) is left alone.
#
# One exception: the release install's hx is a plain file in ~/.local/bin, which
# no other install path removes, and ~/.local/bin is on PATH. While that binary
# is still there it may well be the hx that runs, and taking its runtime away
# leaves it with no grammars at all -- a worse outcome than the version skew of
# leaving it in place, since the config directory runtime shadows every hx on
# the box and only one of the two can be right. Keep it, and say so; removing
# the superseded binary is the user's call, not this script's.
clear_managed_helix_runtime() {
    helix_runtime="${XDG_CONFIG_HOME:-$HOME/.config}/helix/runtime"
    test -L "$helix_runtime" || return 0
    helix_release_runtime="$HOME/.local/share/helix/runtime"
    case "$(readlink "$helix_runtime")" in
        "$SRC_DIR/helix/runtime")
            ;;
        "$helix_release_runtime")
            if test -f "$HOME/.local/bin/hx" && ! test -L "$HOME/.local/bin/hx"; then
                warn "keeping ~/.config/helix/runtime for the release hx in ~/.local/bin, which still needs it; remove that hx to use the new one's runtime"
                return 0
            fi
            ;;
        *) return 0 ;;
    esac
    rm -f "$helix_runtime"
    say "Removed $helix_runtime, an earlier install's"
}

# --- homepkg ---

# homepkg_bin TOOL: the command homepkg's TOOL puts in ~/.local/bin.
homepkg_bin() {
    case "$1" in
        ripgrep) echo rg ;;
        helix) echo hx ;;
        typescript) echo tsc ;;
        *) echo "$1" ;;
    esac
}

# homepkg_present TOOL...: those of TOOL... whose command is in ~/.local/bin,
# each with a space either side, for homepkg_tally.
homepkg_present() {
    for _hp_tool in "$@"; do
        if test -e "$HOME/.local/bin/$(homepkg_bin "$_hp_tool")"; then
            printf ' %s ' "$_hp_tool"
        fi
    done
}

# homepkg_tally BEFORE TOOL...: tallies each TOOL for the summary, from
# whether its command was in ~/.local/bin BEFORE (homepkg_present's answer)
# and is now. homepkg refreshes a tool that's there, which this can't tell
# from leaving it, so that's already installed.
homepkg_tally() {
    _ht_before=$1
    shift
    for _ht_tool in "$@"; do
        if ! test -e "$HOME/.local/bin/$(homepkg_bin "$_ht_tool")"; then
            record_install homepkg failed "$_ht_tool"
        else
            case "$_ht_before" in
                *" $_ht_tool "*) record_install homepkg already "$_ht_tool" ;;
                *) record_install homepkg installed "$_ht_tool" ;;
            esac
        fi
    done
}

# homepkg_install [--backend NAME] TOOL...: homepkg install, logged and
# tallied.
homepkg_install() {
    _hi_backend=
    if test "$1" = --backend; then
        _hi_backend=$2
        shift 2
    fi
    _hi_before=$(homepkg_present "$@")
    _hi_status=0
    if test -n "$_hi_backend"; then
        logged "$SCRIPTS_DIR/homepkg" --backend "$_hi_backend" install "$@" || _hi_status=$?
    else
        logged "$SCRIPTS_DIR/homepkg" install "$@" || _hi_status=$?
    fi
    homepkg_tally "$_hi_before" "$@"
    return "$_hi_status"
}

# --- Install the heavyweight extras ---

# Print the jj that something other than setup already put on PATH -- a distro
# package (Fedora packages it as jujutsu), a Homebrew formula, a manual
# install -- and return non-zero when there isn't one. setup's own extras
# land under ~/.local (homepkg, release artifacts), so a jj there is ours to
# keep refreshing rather than a reason to skip the install.
#
# This looks at the jj that would actually run, not at every jj on the box: with
# a distro jj in /usr/bin and setup's own in ~/.local/bin, whichever PATH picks
# is the one that matters. Installing over a packaged jj would leave a second
# copy shadowing it, with two things updating on different schedules.
system_jj() {
    if ! jj_path="$(command -v jj)"; then
        return 1
    fi
    case "$jj_path" in
        "$HOME"/.local/*) return 1 ;;
    esac
    printf '%s\n' "$jj_path"
}

# Set EXTRAS_TOOLS to the heavyweight extras this run should install, dropping
# jj when the box already has one setup didn't install. $1 is the nushell
# package name, which differs by backend: homebrew-core calls it nushell,
# homepkg's registry calls it nu.
set_extras_tools() {
    EXTRAS_TOOLS=helix
    if jj_path="$(system_jj)"; then
        info "Skipping jj: already installed at $jj_path"
    else
        EXTRAS_TOOLS="$EXTRAS_TOOLS jj"
    fi
    EXTRAS_TOOLS="$EXTRAS_TOOLS $1"
}

# helix, jj, and nushell live in homebrew-core with prebuilt Linux/macOS
# bottles, each bottle carrying its own helix runtime.
install_extras_brew() {
    # One formula at a time so a single failure doesn't block the rest.
    helix_installed=no
    set_extras_tools nushell
    # brew install upgrades one already installed that's outdated.
    for formula in $EXTRAS_TOOLS; do
        brew_warm
        _ib_was=
        if brew_has "$formula"; then
            _ib_was=$(brew_version "$formula") || _ib_was=installed
        fi
        info "Installing or upgrading $formula with Homebrew"
        if logged brew install "$formula"; then
            brew_forget
            brew_warm
            _ib_now=$(brew_version "$formula") || _ib_now=installed
            if test -z "$_ib_was"; then
                record_install brew installed "$formula"
            elif test "$_ib_now" != "$_ib_was"; then
                record_install brew updated "$formula"
            else
                record_install brew already "$formula"
            fi
        else
            brew_forget
            record_install brew failed "$formula"
            warn "couldn't install $formula with Homebrew"
            continue
        fi
        test "$formula" = helix && helix_installed=yes
    done
    # Only when brew actually installed helix: otherwise an hx from another
    # path would lose the runtime it still needs.
    if test "$helix_installed" = yes; then
        clear_managed_helix_runtime
    fi
}

# The release-artifact path: the prebuilt binaries each project publishes with
# its own GitHub releases, fetched by homepkg into ~/.local. No Homebrew and no
# root -- and no build, which is what this used to spend a Rust toolchain and
# several minutes per box on.
#
# helix's asset carries the hx binary and the runtime/ tree hx needs at run
# time; homepkg installs both (its registry's "payload" key) and
# link_helix_runtime points hx at the result.
install_extras_release() {
    if local_bin_blocked; then
        info "Skipping helix, jj and nushell: $LOCAL_BIN_WHY"
        return 0
    fi
    homepkg="$SCRIPTS_DIR/homepkg"
    if ! test -x "$homepkg"; then
        warn "no homepkg in the scripts repo, so no helix, jj or nushell"
        return 0
    fi
    set_extras_tools nu
    info "Installing $EXTRAS_TOOLS from their GitHub releases"
    # shellcheck disable=SC2086  # $EXTRAS_TOOLS is a space-separated list expanded into multiple args
    homepkg_install --backend github $EXTRAS_TOOLS \
        || warn "couldn't install some of $EXTRAS_TOOLS from their releases"
    # A partial run can still have landed helix, so wire up its runtime on the
    # strength of the binary being there rather than of homepkg's exit status.
    # A release hx is a plain file; an hx that's a symlink is homepkg's, pointing
    # into its conda env, and it carries its own runtime -- so a failed release
    # install on a box provisioned that way must not point that hx at a release
    # payload left over from before.
    if test -f "$HOME/.local/bin/hx" && ! test -L "$HOME/.local/bin/hx"; then
        link_helix_runtime "$HOME/.local"
    fi
}

# Dispatch to the resolved extras backend. When Homebrew is requested but
# can't be made available, fall back to the release artifacts.
install_extras() {
    if test "$EXTRAS_BACKEND" = brew; then
        if install_homebrew; then
            install_extras_brew
            return
        fi
        warn "no Homebrew, so the extras come from their GitHub releases"
    fi
    install_extras_release
}

# --- shpool ---
#
# setup doesn't install shpool. It publishes no release artifact, isn't in
# homebrew-core or the shell-pool tap as a bottle, and has no conda-forge
# feedstock, so a cargo build was the only way to get it -- and building from
# source is what this script no longer does.
#
# Sessions still prefer shpool wherever something else has put it on PATH (a
# distro package, a manual cargo install): sessionlib picks it over tmux, and
# start_services enables a systemd user service for whichever shpool it finds.
#
# TODO: install shpool again once there's a prebuilt artifact to fetch --
# upstream release binaries, a brew bottle, or a conda-forge feedstock (which
# would give the --no-root homepkg path a way to provide it too).

# --- Install CLI tools into a home prefix (--no-root) ---

# Under --no-root the apt/dnf package installs are skipped, so the CLI tools
# they'd provide have to come from somewhere else: homepkg installs prebuilt
# binaries into a home prefix (~/.local), no root required. Core tools mirror
# the distro CLI package set; the node toolchain (node/npm/tsc) is added
# unless --no-npm, and the heavyweight extras (helix, jj, nushell) unless the
# minimal profile is in effect. homepkg resolves them into one home-prefix env;
# a solve/network failure warns rather than aborting the bootstrap. When a
# prebuilt bundle is present it's used first (so a fresh box provisions fully
# offline), then refreshed online best-effort -- see the provisioning block.
install_home_tools() {
    if local_bin_blocked; then
        info "Skipping the home-prefix tools: $LOCAL_BIN_WHY"
        return 0
    fi
    homepkg="$SCRIPTS_DIR/homepkg"
    if ! test -x "$homepkg"; then
        warn "no homepkg in the scripts repo, so no tools in ~/.local"
        return 0
    fi
    # fnm (Node version manager) is a convenience tool -- installed regardless
    # of --no-npm, mirroring the root path's install_fnm (which is skipped under
    # --no-root, so fnm comes from here instead).
    # go builds vcs and tide-grant, as the distro's does on the
    # privileged path.
    tools="ripgrep fd bat fzf jq delta gh fnm zoxide lf go"
    if test "$NPM" = yes; then
        # node/npm + tsc are the actual build toolchain for setup-kde's
        # Krohnkite source-build fallback (its normal path fetches a
        # prebuilt release and needs neither), gated on --no-npm. The
        # --no-root counterpart to the distro npm/tsc install on the
        # privileged path -- no root, no distro pkg.
        tools="$tools node typescript"
    fi
    if test "$MINIMAL_ENABLED" -eq 0; then
        set_extras_tools nu
        tools="$tools $EXTRAS_TOOLS"
        # shpool has no prebuilt artifact anywhere, so none of setup's install
        # paths can provide it (see the shpool note by install_extras).
        # start_services skips its user service when shpool is absent, so the
        # shell falls back to tmux.
        info "Skipping shpool: it has no prebuilt release, so sessions use tmux"
    fi

    # Prefer a prebuilt bundle if one is staged (it unpacks its full contents
    # flat into the prefix -- offline, no network, no env); otherwise install
    # the requested set online into a managed conda env. Look for a bundle at
    # $HOMEPKG_BUNDLE, then homepkg-bundle.tgz beside the scripts repo or in
    # $HOME (build one online with "homepkg bundle -o homepkg-bundle.tgz" -- no
    # args = every tool).
    env_dir="$HOME/.local/share/homepkg/env"   # mirrors homepkg's <prefix>/share/homepkg/env
    bundle=""
    for cand in "${HOMEPKG_BUNDLE:-}" "$SCRIPTS_DIR/homepkg-bundle.tgz" "$HOME/homepkg-bundle.tgz"; do
        if test -n "$cand" && test -f "$cand"; then
            bundle="$cand"
            break
        fi
    done

    provisioned=no
    if test -n "$bundle"; then
        # A bundle unpacks its FULL contents (install-bundle can't cherry-pick),
        # so --minimal/--no-npm don't trim it.
        info "Installing the tools in $bundle (all of them: --minimal and --no-npm don't trim a bundle)"
        # shellcheck disable=SC2086  # $tools is a space-separated list
        bundle_before=$(homepkg_present $tools)
        rc=0
        logged "$homepkg" install-bundle "$bundle" || rc=$?
        # shellcheck disable=SC2086  # $tools is a space-separated list
        homepkg_tally "$bundle_before" $tools
        if test "$rc" -eq 0; then
            provisioned=yes
        else
            # install-bundle exits 2 for a partial install (a tool the bundle
            # was built without didn't land, the rest did) and 1 when it
            # installed nothing (wrong platform, unreadable bundle). Keep a
            # partial -- the PATH block below covers what landed; on a total
            # failure fall through to the online install, so a connected box
            # still gets its tools (on an air-gapped box that also fails,
            # harmlessly).
            if test "$rc" -eq 2; then
                warn "$bundle didn't have everything; using what it had"
                provisioned=yes
            else
                warn "$bundle installed nothing (made for another platform, or unreadable?); installing online instead"
            fi
        fi
    fi

    if test "$provisioned" = no; then
        test "$MINIMAL_ENABLED" -eq 0 \
            || info "Skipping helix, jj and nushell: minimal profile"
        info "Installing $tools into ~/.local with homepkg"
        # shellcheck disable=SC2086  # $tools is a space-separated list expanded into multiple args
        if homepkg_install $tools; then
            provisioned=yes
        else
            warn "couldn't install some of $tools with homepkg"
        fi
    fi

    test "$provisioned" = yes || return 0

    # homepkg links the tools into ~/.local/bin. Put that on PATH for the rest
    # of THIS run so later steps and child processes find them -- notably
    # setup-kde's Krohnkite source-build fallback, which needs tsc on PATH.
    # The conf repo already puts ~/.local/bin on PATH for interactive shells;
    # this covers the non-interactive bootstrap however setup was invoked.
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) PATH="$HOME/.local/bin:$PATH" ;;
    esac

    # The online path's helix comes from conda-forge with its runtime inside the
    # homepkg env, so a symlink left in the config directory by another install
    # path has to go -- hx searches there first. Gate on the hx that will
    # actually run being the env's, not merely on some hx existing: homepkg
    # links the env's binaries into ~/.local/bin but deliberately leaves a
    # conflicting regular file alone, so on a box that installed the release hx
    # first, that release binary is still what runs -- and clearing the runtime
    # symlink would take its grammars away. A bundle-unpacked hx is a regular
    # file that carries its own runtime under the prefix's share/, so it doesn't
    # match this gate and needs no clearing.
    if test -L "$HOME/.local/bin/hx" \
            && test "$(readlink "$HOME/.local/bin/hx")" = "$env_dir/bin/hx"; then
        clear_managed_helix_runtime
    fi
}

# --- Install the terminal file managers with no reliable distro package ---

# lf isn't in the Debian/Ubuntu or base Fedora repos -- but it's on
# conda-forge, so install it from there via homepkg rather than attempting
# apt/dnf and warning about a miss we already expect.
# Runs after the clone (homepkg lives in the scripts repo) on every profile, but
# installs only what's missing: the --no-root path already got it from
# install_home_tools and macOS from Homebrew, so this is a no-op there and does
# the real work only on a privileged Linux box. homepkg installs into
# ~/.local/bin, not necessarily on setup's own PATH, so check there too.
lf_missing() {
    ! command -v lf >/dev/null 2>&1 && ! test -x "$HOME/.local/bin/lf"
}

install_file_managers() {
    if ! lf_missing; then
        info "Skipping lf: already installed"
        if test -e "$HOME/.local/bin/lf"; then
            record_install homepkg already lf
        fi
        return 0
    fi
    if local_bin_blocked; then
        info "Skipping lf: $LOCAL_BIN_WHY"
        return 0
    fi
    homepkg="$SCRIPTS_DIR/homepkg"
    if ! test -x "$homepkg"; then
        warn "no homepkg in the scripts repo, so no lf"
        return 0
    fi
    info "Installing lf into ~/.local with homepkg"
    homepkg_install lf \
        || warn "couldn't install lf with homepkg"
}

# --- Install Node.js and tsc on an Intel Mac ---

# Homebrew compiles node on an Intel Mac (see is_intel_mac), and typescript
# depends on it, so install_packages leaves both to this step: conda-forge
# still builds them for osx-64, and homepkg installs those into ~/.local with
# no compiler. Runs after the clone because homepkg lives in the scripts repo.
# The --no-root path already got them from install_home_tools.
#
# A Homebrew node left from an earlier run stays -- removing it is the user's
# call, as something else may depend on it -- but it would keep compiling on
# every upgrade, so this says how to remove it.
install_node_home() {
    if test "$NPM" != yes || test "$ROOT" != yes || ! is_intel_mac; then
        return 0
    fi
    if local_bin_blocked; then
        info "Skipping node and typescript: $LOCAL_BIN_WHY"
        return 0
    fi
    homepkg="$SCRIPTS_DIR/homepkg"
    if ! test -x "$homepkg"; then
        warn "no homepkg in the scripts repo, so no node or tsc"
        return 0
    fi
    info "Installing node and typescript into ~/.local with homepkg"
    homepkg_install node typescript \
        || warn "couldn't install node and tsc with homepkg"
    if command -v brew >/dev/null 2>&1 && brew list --formula --versions node >/dev/null 2>&1; then
        say "Homebrew's node, which compiles on every upgrade here, is still installed: 'brew uninstall typescript node' removes it"
    fi
}

# --- Remove the homepkg tools setup no longer installs ---

# Dropping a tool from homepkg's registry stops new installs, but a machine an
# earlier setup installed it on keeps it in homepkg's env, linked into
# ~/.local/bin: joshuto and yazi, both replaced by lf. homepkg prune removes
# its RETIRED tools, and only from its own env and links, so a copy installed
# any other way stays. A removal, so it runs on --purge-obsolete, with the
# obsolete desktop packages.
prune_retired_tools() {
    homepkg="$SCRIPTS_DIR/homepkg"
    if ! test -x "$homepkg"; then
        warn "no homepkg in the scripts repo, so the tools it retired stay"
        return 0
    fi
    "$homepkg" prune \
        || warn "couldn't remove the tools homepkg retired; $homepkg prune retries"
}

# --- Whether this machine runs binaries from ~/.local/bin ---

# Some managed machines run only binaries their policy has approved, wherever
# they're installed, and kill the rest: on macOS a binary run from ~/.local/bin
# exits 137 (SIGKILL), even a copy of one the system ships. Everything homepkg
# and the uv installer download lands there, so on such a machine none of it
# would run, and the shell would hit each one as it starts (atuin, carapace).
#
# So setup checks once, before installing anything there: it copies a small
# system binary (true) into ~/.local/bin and runs the copy. Any failure means
# the directory's binaries don't run (killed by a policy, or a noexec home);
# setup then installs nothing there and removes the shell tools it installed
# there before, which the shell would otherwise start and see killed. Nothing
# here looks for a particular company or product. Sets LOCAL_BIN_WHY to say
# why. LOCAL_BIN_PROBE names the binary to copy, for the tests.
local_bin_blocked() {
    if test -z "${LOCAL_BIN_CHECKED:-}"; then
        LOCAL_BIN_CHECKED=1
        LOCAL_BIN_BLOCKED=no
        LOCAL_BIN_WHY=
        probe_src="${LOCAL_BIN_PROBE:-}"
        if test -z "$probe_src"; then
            for cand in /usr/bin/true /bin/true; do
                if test -x "$cand"; then
                    probe_src="$cand"
                    break
                fi
            done
        fi
        if test -z "$probe_src"; then
            warn "no system binary to test ~/.local/bin with; assuming it runs binaries"
        elif ! mkdir -p "$HOME/.local/bin"; then
            warn "couldn't make ~/.local/bin to test it; assuming it runs binaries"
        else
            probe="$HOME/.local/bin/.setup-probe-$$"
            if ! cp "$probe_src" "$probe"; then
                warn "couldn't copy $probe_src into ~/.local/bin to test it; assuming it runs binaries"
            else
                "$probe" </dev/null >/dev/null 2>&1
                probe_status=$?
                rm -f "$probe"
                if test "$probe_status" -ne 0; then
                    LOCAL_BIN_BLOCKED=yes
                    LOCAL_BIN_WHY="this machine doesn't run binaries from ~/.local/bin (a copy of $probe_src there exited $probe_status)"
                    warn "$LOCAL_BIN_WHY; installing nothing there"
                    remove_blocked_shell_tools
                fi
            fi
        fi
    fi
    test "$LOCAL_BIN_BLOCKED" = yes
}

# The atuin and carapace an earlier run put in ~/.local/bin, on a machine that
# won't run them: the shell starts both and would see them killed every time.
# Only a plain file that fails to run goes, so a working one, or one installed
# some other way as a link, stays.
remove_blocked_shell_tools() {
    for tool in atuin carapace; do
        bin="$HOME/.local/bin/$tool"
        if test -f "$bin" && ! test -L "$bin" \
                && ! "$bin" --version </dev/null >/dev/null 2>&1; then
            if rm -f "$bin"; then
                say "Removed ~/.local/bin/$tool, which this machine won't run"
            else
                warn "couldn't remove ~/.local/bin/$tool, which this machine won't run; remove it so the shell stops starting it"
            fi
        fi
    done
}

# --- Install the interactive shell tools with no packaged build ---

# The conf repo's shell config wires up five optional tools. fzf, zoxide and
# zsh-autosuggestions are packaged (installed from the distro sets above; on
# the --no-root path fzf and zoxide come from conda-forge via homepkg, and
# zsh-autosuggestions from install_zsh_autosuggestions_home's pinned clone),
# but atuin and carapace are in neither the distro repos nor conda-forge, so
# they come from their GitHub releases through homepkg's stateless github
# backend. That needs no root, so the same call serves every path --
# privileged, --no-root and macOS alike. Each shell config skips whichever tool
# is missing, so a failure here degrades to "no history search / no extra
# completions" rather than breaking the shell.
#
# Offline hosts install from a push bundle instead, the same way
# install_home_tools does. The mamba bundle can't carry these two (no
# conda-forge package), so they need the github variant, built on an online
# host with:
#     homepkg --backend github bundle -o homepkg-shell-tools.tgz atuin carapace
# Staged at $HOMEPKG_SHELL_BUNDLE, or beside the scripts repo / in $HOME as
# homepkg-shell-tools.tgz.
# The shell tools that aren't installed yet, space-prefixed for the messages
# below. homepkg installs into ~/.local/bin, which isn't necessarily on
# setup's own PATH, so check there too rather than trusting command -v alone.
missing_shell_tools() {
    missing=""
    for tool in atuin carapace; do
        if ! command -v "$tool" >/dev/null 2>&1 \
                && ! test -x "$HOME/.local/bin/$tool"; then
            missing="$missing $tool"
        fi
    done
    printf '%s' "$missing"
}

install_shell_tools() {
    if local_bin_blocked; then
        info "Skipping atuin and carapace: $LOCAL_BIN_WHY"
        return 0
    fi
    homepkg="$SCRIPTS_DIR/homepkg"
    if ! test -x "$homepkg"; then
        warn "no homepkg in the scripts repo, so no atuin or carapace"
        return 0
    fi
    shell_tools="$(missing_shell_tools)"
    # shellcheck disable=SC2046  # word-split the list
    homepkg_tally "$(homepkg_present atuin carapace)" $(homepkg_present atuin carapace)
    if test -z "$shell_tools"; then
        info "Skipping atuin and carapace: already installed"
        return 0
    fi

    shell_bundle=""
    for cand in "${HOMEPKG_SHELL_BUNDLE:-}" \
            "$SCRIPTS_DIR/homepkg-shell-tools.tgz" \
            "$HOME/homepkg-shell-tools.tgz"; do
        if test -n "$cand" && test -f "$cand"; then
            shell_bundle="$cand"
            break
        fi
    done
    if test -n "$shell_bundle"; then
        # A bundle installs its full contents, so it can't be trimmed to the
        # missing tools; re-installing one that's already present is harmless.
        info "Installing$shell_tools from $shell_bundle"
        if logged "$homepkg" install-bundle "$shell_bundle"; then
            # It only installs what its manifest carries, so a partial or
            # stale bundle can still leave tools missing. Recheck, and let
            # whatever it didn't provide fall through to the download.
            bundled=$shell_tools
            shell_tools="$(missing_shell_tools)"
            for tool in $bundled; do
                case "$shell_tools " in
                    *" $tool "*) ;;
                    *) record_install homepkg installed "$tool" ;;
                esac
            done
            if test -z "$shell_tools"; then
                return 0
            fi
            info "Installing$shell_tools from their releases: $shell_bundle lacks them"
        else
            # Non-zero can mean a partial install -- whatever the bundle did
            # carry stays put, and the download below covers the rest.
            warn "$shell_bundle didn't have everything; downloading the rest"
        fi
    fi

    info "Installing$shell_tools with homepkg"
    # shellcheck disable=SC2086  # deliberate word split: one flag per tool
    homepkg_install --backend github $shell_tools \
        || warn "couldn't install$shell_tools (offline? stage a bundle: homepkg --backend github bundle -o homepkg-shell-tools.tgz atuin carapace)"
}

# --- zsh-autosuggestions without root ---

# The privileged paths install zsh-autosuggestions from apt, dnf or brew, but
# --no-root skips apt and dnf, and conda-forge has no package for homepkg to
# fetch, so an unprivileged Linux box clones the pinned release into
# ~/.zsh/zsh-autosuggestions -- the first place conf's shrc looks. A tag can be
# moved, so the clone must be exactly this commit. (macOS is covered already:
# brew needs no root, so it installs the formula even under --no-root.)
ZSH_AUTOSUGGESTIONS_REPO=https://github.com/zsh-users/zsh-autosuggestions.git
ZSH_AUTOSUGGESTIONS_TAG=v0.7.1
ZSH_AUTOSUGGESTIONS_COMMIT=e52ee8ca55bcc56a17c828767a3f98f22a68d4eb

# A copy already there -- this checkout from an earlier run, or one the system
# has -- is left alone. Without it the shell only loses its ghost text, so a
# failure warns rather than stopping the bootstrap. SETUP_SYSROOT is for the
# tests.
install_zsh_autosuggestions_home() {
    case "$OS" in
        debian|redhat) ;;
        *) return 0 ;;
    esac
    zas_dir="$HOME/.zsh/zsh-autosuggestions"
    if test -e "$zas_dir"; then
        info "Skipping zsh-autosuggestions: already in ~/.zsh/zsh-autosuggestions"
        record_install git already zsh-autosuggestions
        return 0
    fi
    for zas_system in "${SETUP_SYSROOT:-}/usr/share/zsh-autosuggestions" \
            "${SETUP_SYSROOT:-}/usr/share/zsh/plugins/zsh-autosuggestions"; do
        if test -r "$zas_system/zsh-autosuggestions.zsh"; then
            info "Skipping zsh-autosuggestions: already in ${zas_system#"${SETUP_SYSROOT:-}"}"
            return 0
        fi
    done
    info "Installing zsh-autosuggestions $ZSH_AUTOSUGGESTIONS_TAG into ~/.zsh/zsh-autosuggestions"
    if ! mkdir -p "${zas_dir%/*}" \
            || ! logged git clone -c advice.detachedHead=false --quiet --depth 1 \
                --branch "$ZSH_AUTOSUGGESTIONS_TAG" "$ZSH_AUTOSUGGESTIONS_REPO" "$zas_dir"; then
        record_install git failed zsh-autosuggestions
        warn "couldn't clone zsh-autosuggestions, so zsh shows no history suggestions"
        # A clone that died partway would pass for a finished one next run.
        rm -rf "$zas_dir" || warn "couldn't remove the partial clone in $zas_dir"
        return 0
    fi
    if ! zas_commit=$(git -C "$zas_dir" rev-parse HEAD); then
        zas_commit="unreadable"
    fi
    if test "$zas_commit" != "$ZSH_AUTOSUGGESTIONS_COMMIT"; then
        record_install git failed zsh-autosuggestions
        warn "zsh-autosuggestions' $ZSH_AUTOSUGGESTIONS_TAG tag is commit $zas_commit, not the pinned $ZSH_AUTOSUGGESTIONS_COMMIT; not using it"
        rm -rf "$zas_dir" || warn "couldn't remove the rejected clone in $zas_dir"
        return 0
    fi
    record_install git installed zsh-autosuggestions
}

# --- Install uv (Python package manager) ---

install_uv() {
    # Both paths are non-fatal: a failed update/install (e.g. no network) must
    # not abort the bootstrap. install_uv runs before install_home_tools, so on
    # an offline "setup --no-root" a hard failure here would kill the run before
    # the homepkg bundle install -- where uv can instead come from the bundle.
    if command -v uv >/dev/null 2>&1; then
        info "Updating uv"
        uv_before=$(uv --version 2>/dev/null) || uv_before=
        # uv self update reruns the installer, which edits the shell rc/profile
        # files unless UV_NO_MODIFY_PATH is set; PATH is managed by the conf repo.
        if logged env UV_NO_MODIFY_PATH=1 uv self update; then
            if test "$(uv --version 2>/dev/null)" = "$uv_before"; then
                record_install download already uv
            else
                record_install download updated uv
            fi
        else
            record_install download failed-update uv
            warn "couldn't update uv; keeping $uv_before"
        fi
    elif local_bin_blocked; then
        info "Skipping uv: $LOCAL_BIN_WHY"
    else
        info "Installing uv"
        # --no-modify-path keeps the uv installer out of the shell rc/profile
        # files; PATH is managed by the conf repo. uv installs to ~/.local/bin
        # (or ~/.cargo/bin), which the conf repo already puts on PATH.
        if logged sh -c 'curl -LsSf https://astral.sh/uv/install.sh | sh -s -- --no-modify-path'; then
            record_install download installed uv
        else
            record_install download failed uv
            warn "couldn't install uv (offline?); a homepkg bundle can provide it"
        fi
    fi
}

# --- Install fnm (Fast Node Manager) ---

# fnm is installed as a convenience for interactive, per-project Node version
# switching (the conf repo hooks it into the shell). It is NOT used to provide
# the build toolchain -- node/npm and tsc come from the distro or, under
# --no-root, from homepkg (see install_packages / install_home_tools) -- so
# setup-kde never depends on it. On the privileged path fnm comes from its curl
# installer here; under --no-root it comes from conda-forge via homepkg instead,
# so this function skips.
install_fnm() {
    # TODO: explore sourcing fnm from conda-forge on root boxes too, to drop
    # this curl|bash installer for one uniform mechanism. Deferred for now to
    # avoid bootstrapping micromamba on every root box just for fnm.
    if test "$ROOT" = no; then
        info "Skipping fnm's installer: --no-root gets fnm from homepkg"
        return
    fi
    if command -v fnm >/dev/null 2>&1; then
        info "Skipping fnm: already installed"
        record_install download already fnm
        return
    fi
    info "Installing fnm"
    # The upstream installer edits shell rc files by default; --skip-shell
    # keeps it out of them since the shell config is managed by the conf repo.
    # Download to a temp file rather than piping curl into bash: a piped curl
    # failure (network/HTTP error) is masked because bash exits 0 on the empty
    # stdin, so set -e wouldn't catch it and fnm would silently never install.
    fnm_installer=$(mktemp)
    if logged curl -fsSL https://fnm.vercel.app/install -o "$fnm_installer" \
            && logged bash "$fnm_installer" --skip-shell; then
        rm -f "$fnm_installer"
        record_install download installed fnm
    else
        fnm_status=$?
        rm -f "$fnm_installer"
        record_install download failed fnm
        error "couldn't install fnm"
        return "$fnm_status"
    fi
}

# --- Generate SSH key ---

generate_ssh_key() {
    if test "$SSH" = no; then
        info "Skipping the SSH key: --no-ssh"
        return
    fi

    # In auto mode, skip when the agent already has a key loaded. This
    # catches keys that aren't on this machine's disk -- a forwarded agent
    # over SSH, or a hardware token -- which the on-disk check below misses.
    # ssh-add -l exits 0 only when at least one identity is loaded.
    if test "$SSH" = auto \
            && command -v ssh-add >/dev/null 2>&1 \
            && ssh-add -l >/dev/null 2>&1; then
        info "Skipping the SSH key: ssh-agent has one (--ssh makes one anyway)"
        return
    fi

    # Only auto mode skips on existing key files: --ssh promises to
    # generate anyway, so it pushes past this check too. It still never
    # clobbers the file ssh-keygen would write.
    if test "$SSH" = auto; then
        for key in "$HOME"/.ssh/id_*; do
            case "$key" in
                *.pub) continue ;;
            esac
            if test -f "$key"; then
                info "Skipping the SSH key: $key exists (--ssh makes one anyway)"
                return
            fi
        done
    elif test -f "$HOME/.ssh/id_ed25519"; then
        info "Skipping the SSH key: $HOME/.ssh/id_ed25519 exists"
        return
    fi

    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    logged ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519" -N ""
    say "Made an SSH key, $HOME/.ssh/id_ed25519"

    say ""
    say "Add this SSH public key to $GITHUB_HOST and Codeberg:"
    if test "$GITHUB_MIRROR" = yes; then
        # A mirror's web UI lives wherever that deployment puts it, so name the
        # host rather than guessing at a settings URL that probably 404s.
        say "  $GITHUB_HOST: add it under your account's SSH keys"
    else
        say "  GitHub:   https://github.com/settings/ssh/new"
    fi
    say "  Codeberg: https://codeberg.org/user/settings/keys"
    say ""
    cat "$HOME/.ssh/id_ed25519.pub"
    say ""

    # Only block on the key when this run's clones actually need it. Under an
    # HTTPS prefix nothing setup clones authenticates with it (the repos come
    # over HTTPS, as does Krohnkite), so waiting would stall a bootstrap that
    # would otherwise finish unattended -- print the key and keep going.
    if test "$GITHUB_PREFIX_SSH" = no; then
        info "Not waiting for the key: this run clones from $GITHUB_HOST over HTTPS"
        return
    fi

    # When run via "curl | sh", stdin is the script itself, so we
    # can't read user input.  Open /dev/tty to read from the terminal.
    prompt="Press Enter after adding the key to $GITHUB_HOST and Codeberg..."
    if test -t 0; then
        printf "%s" "$prompt"
        read -r _
    elif test -e /dev/tty; then
        printf "%s" "$prompt"
        read -r _ < /dev/tty
    else
        warn "can't ask you to add the key; add it to $GITHUB_HOST and Codeberg yourself before cloning over SSH"
    fi
}

# --- Offer to switch personal repo remotes to SSH ---

# The default clone URLs are already SSH, but a repo cloned over HTTPS (e.g.
# before an SSH key was added, or Krohnkite, which now defaults to HTTPS) can
# be flipped here so pushes use the key. Defaults to no, so a non-interactive
# "curl | sh" run never rewrites anything without being asked.
offer_ssh_remotes() {
    # A non-default prefix put these remotes where they are deliberately, so
    # don't offer to move them. Both shapes it can take argue against the
    # offer: an internal mirror is a host gittossh doesn't rewrite at all (it
    # only knows github.com and codeberg.org), so the prompt could only ever
    # answer "nothing to convert"; and an HTTPS prefix was chosen precisely
    # because SSH isn't the way in, so converting would break the remote.
    if test "$GITHUB_MIRROR" = yes; then
        info "Skipping the SSH remotes: cloned from $GITHUB_HOST"
        return 0
    fi

    converter="$SCRIPTS_DIR/gittossh"
    test -x "$converter" || return 0

    # Collect the cloned repos as positional parameters, not a space-joined
    # string, so paths survive an $SCRIPTS_DIR/etc. that contains whitespace.
    set --
    for dir in "$SCRIPTS_DIR" "$CONF_DIR" "$ROOT_DIR"; do
        if test -d "$dir/.git"; then
            set -- "$@" "$dir"
        fi
    done
    test "$#" -gt 0 || return 0
    # Asked only when there's something to switch, so a rerun doesn't ask
    # again once they're SSH.
    if ! "$converter" --dry-run "$@" 2>/dev/null | grep -q '^Would update'; then
        info "Skipping the SSH remotes: none are HTTPS"
        return 0
    fi

    prompt="Switch your repo remotes (scripts, conf, root) from HTTPS to SSH? [y/N] "
    reply=n
    if test -t 0; then
        printf "%s" "$prompt"
        read -r reply
    elif test -e /dev/tty; then
        printf "%s" "$prompt"
        read -r reply < /dev/tty
    else
        say "Leaving the repo remotes on HTTPS: no terminal to ask on (gittossh switches them)"
        return 0
    fi

    case "$reply" in
        y|Y|yes|YES)
            "$converter" "$@"
            ;;
        *)
            info "Leaving the repo remotes on HTTPS"
            ;;
    esac
}

# --- Set kitty as default terminal ---

# The KDE half, shared by both Linux branches. update-alternatives (Debian)
# only covers x-terminal-emulator; what makes Plasma's own "open terminal"
# actions use kitty is kdeglobals, so every KDE box needs this, not just
# Fedora. Nothing here is privileged -- kdeglobals is per-user -- so it runs
# without sudo_or_warn.
set_kde_default_terminal() {
    command -v kwriteconfig6 >/dev/null 2>&1 || return 0
    # TerminalApplication is what Plasma 6 reads; TerminalService is the
    # .desktop-based successor. Write both: which one wins varies by version.
    kwriteconfig6 --file kdeglobals --group General --key TerminalApplication kitty \
        || warn "couldn't make kitty KDE's terminal (TerminalApplication)"
    kwriteconfig6 --file kdeglobals --group General --key TerminalService kitty.desktop \
        || warn "couldn't make kitty KDE's terminal (TerminalService)"
}

set_default_terminal() {
    case "$OS" in
        debian)
            if command -v kitty >/dev/null 2>&1; then
                info "Making kitty the default terminal"
                if command -v update-alternatives >/dev/null 2>&1; then
                    logged sudo_or_warn update-alternatives --set x-terminal-emulator "$(command -v kitty)" \
                        || warn "couldn't make kitty the x-terminal-emulator"
                fi
                set_kde_default_terminal
            fi
            ;;
        redhat)
            if command -v kitty >/dev/null 2>&1; then
                info "Making kitty the default terminal"
                # Set via xdg for Wayland/X11
                mkdir -p "$HOME/.config"
                if command -v xdg-mime >/dev/null 2>&1; then
                    xdg-mime default kitty.desktop x-scheme-handler/terminal \
                        || warn "couldn't make kitty the terminal scheme handler"
                fi
                set_kde_default_terminal
            fi
            ;;
        macos)
            # macOS doesn't have a system-wide default terminal concept;
            # kitty is launched directly via scripts/terminal
            info "Skipping the default terminal: macOS has none; ~/scripts/terminal starts kitty"
            ;;
        *)
            warn "unknown OS, so no default terminal"
            ;;
    esac
}

# --- Configure keyboard ---

# System-level only: the console keymap, the persistent X11 config, and a live
# setxkbmap. Plasma overrides the layout at login from kxkbrc, so the matching
# session-level config is setup-kde's configure_keyboard_layout -- change both
# or the two drift apart.
configure_keyboard() {
    # No VT for the console keymap, and setxkbmap would reach X apps only.
    if test "${CROSTINI:-0}" -eq 1; then
        info "Skipping the keyboard: ChromeOS (Crostini) sets the layout"
        return 0
    fi
    case "$OS" in
        debian)
            keyboard_file="${SETUP_KEYBOARD_FILE:-/etc/default/keyboard}"
            keyboard_conf='XKBMODEL="pc105"
XKBLAYOUT="us"
XKBVARIANT="dvorak"
XKBOPTIONS="compose:caps"
BACKSPACE="guess"'
            if test "$(cat "$keyboard_file" 2>/dev/null)" = "$keyboard_conf"; then
                info "Skipping the keyboard: already Dvorak, with Caps Lock as Compose"
            elif printf '%s\n' "$keyboard_conf" | sudo_or_warn tee "$keyboard_file" >/dev/null; then
                say "Set the keyboard to Dvorak, with Caps Lock as Compose ($keyboard_file)"
                # Applying the console copy depends on the persistent config
                # write above. Skip it if that sudo command was denied.
                if command -v setupcon >/dev/null 2>&1; then
                    logged sudo_or_warn setupcon --save \
                        || warn "couldn't apply the keyboard layout to the virtual consoles"
                fi
            else
                warn "couldn't write $keyboard_file, so the console and X keep their keyboard layout"
            fi
            ;;
        redhat)
            keyboard_now=$(localectl status 2>/dev/null) || keyboard_now=
            case "$keyboard_now" in
                *"VC Keymap: us-dvorak"*"X11 Variant: dvorak"*"X11 Options: compose:caps"*)
                    info "Skipping the keyboard: already Dvorak, with Caps Lock as Compose"
                    ;;
                *)
                    if logged sudo_or_warn localectl set-keymap us-dvorak; then
                        if logged sudo_or_warn localectl set-x11-keymap us "" dvorak compose:caps; then
                            say "Set the keyboard to Dvorak, with Caps Lock as Compose"
                        else
                            warn "couldn't set X's keyboard layout"
                        fi
                    else
                        warn "couldn't set the keyboard layout"
                    fi
                    ;;
            esac
            ;;
        macos)
            # Handled by setup-macos
            return
            ;;
        *)
            warn "unknown OS, so the keyboard layout is left as it is"
            return
            ;;
    esac
    # Apply to current X/Wayland session if running. Don't let a failure
    # (e.g. Wayland without Xwayland) abort the whole bootstrap under set -e.
    if command -v setxkbmap >/dev/null 2>&1 && test -n "${DISPLAY:-${WAYLAND_DISPLAY:-}}"; then
        setxkbmap -layout us -variant dvorak -option "" -option compose:caps \
            || warn "setxkbmap failed, so this session keeps its keyboard layout"
    fi
}

# --- Keep the display card powered ---

# Whether this machine runs on a battery of its own: a laptop's, not the one in
# a wireless mouse or keyboard, which the kernel marks with scope "Device".
has_system_battery() {
    for psu in "${SETUP_SYSFS:-/sys}"/class/power_supply/*; do
        test -r "$psu/type" || continue
        test "$(cat "$psu/type")" = Battery || continue
        if test -r "$psu/scope" && test "$(cat "$psu/scope")" = Device; then
            continue
        fi
        return 0
    done
    return 1
}

# Whether keep_display_gpu_awake may write or remove $gpu_rule: it's absent,
# or setup wrote it (it carries $gpu_mark). A file there without the mark is
# somebody else's, and every path that touches the rule asks this first.
display_gpu_rule_is_ours() {
    test -e "$gpu_rule" || return 0
    grep -qF "$gpu_mark" "$gpu_rule"
}

# Removes the rule keep_display_gpu_awake wrote, once this machine no longer
# qualifies for it ($1 says why), so a card doesn't stay held powered after,
# say, a laptop's battery reappears or the card is swapped. The card stays
# held until the next boot.
remove_display_gpu_rule() {
    test -e "$gpu_rule" || return 0
    if ! display_gpu_rule_is_ours; then
        info "Skipping $gpu_rule: setup didn't write it"
        return 0
    fi
    if sudo_or_warn rm -f "$gpu_rule"; then
        say "Removed $gpu_rule: $1"
    else
        warn "couldn't remove $gpu_rule, so the display card stays powered from the next boot"
    fi
}

# amdgpu powers a desktop card almost fully off (BACO) whenever none of its
# screens is lit -- a monitor switched off, or the idle blank -- and that fails
# two ways: a powered-down card can't see a monitor switched back on, so the
# screen stays dark on a running machine, and waking it can hang the machine
# outright. A Radeon PRO WX 3200 did both in one afternoon (2026-10-06), under
# tide and then at GDM's login screen. Holding it powered costs a few watts
# while the screens are off.
#
# Nothing is held on a machine with its own battery: there, a card's power
# saving is what the battery runs on, and a laptop isn't safe to tell apart by
# its cards -- a muxed hybrid laptop can start on its discrete card. Elsewhere
# every display controller (PCI class 0x03) under one of these drivers is held,
# since nothing says reliably which card the screens hang off: boot_vga names
# the card the firmware started on, which a desktop can leave for another, and
# a connector reads disconnected while its monitor is switched off -- the very
# state this guards. A second card that drives no screens pays a few watts for
# that (maintainer, 2026-10-06). amdgpu is the driver that powers a desktop
# card down on its own; radeon, nouveau and the NVIDIA driver do it only in a
# hybrid laptop, so for them this is a backstop against a changed default.
# Intel's i915 and xe are left alone: they keep seeing hotplugs while powered
# down.
#
# The sysfs write holds the card now, and the udev rule from the next boot on.
# The rule matches add as well as bind: binding is when amdgpu turns runtime
# power management on, so the rule has to come after it, and a card bound in
# the initramfs gets its rules run again by the add udev replays at boot.
# SETUP_SYSFS and SETUP_UDEV_RULES are for the tests.
keep_display_gpu_awake() {
    case "$OS" in
        debian|redhat) ;;
        *) return 0 ;;
    esac
    # The container sees no display card of its own.
    test "${CROSTINI:-0}" -eq 1 && return 0
    gpu_drivers="amdgpu|radeon|nouveau|nvidia"
    gpu_rule="${SETUP_UDEV_RULES:-/etc/udev/rules.d}/80-display-gpu-awake.rules"
    # The rule's first words, which tell a later run the rule is setup's own.
    gpu_mark="# Written by setup (github.com/mikelward/scripts)"
    if has_system_battery; then
        remove_display_gpu_rule "this machine runs on a battery"
        return 0
    fi
    gpu_found=no
    for gpu_dev in "${SETUP_SYSFS:-/sys}"/bus/pci/devices/*; do
        # A display controller, not, say, a compute accelerator under amdgpu.
        test -r "$gpu_dev/class" || continue
        case "$(cat "$gpu_dev/class")" in
            0x03*) ;;
            *) continue ;;
        esac
        # No driver bound means nothing to power it down.
        test -L "$gpu_dev/driver" || continue
        gpu_driver=$(basename "$(readlink "$gpu_dev/driver")")
        case "|$gpu_drivers|" in
            *"|$gpu_driver|"*) ;;
            *) continue ;;
        esac
        gpu_found=yes
        if test "$(cat "$gpu_dev/power/control")" = on; then
            info "Skipping the display card at ${gpu_dev##*/} ($gpu_driver): already held powered"
        elif printf 'on\n' | sudo_or_warn tee "$gpu_dev/power/control" >/dev/null; then
            say "Holding the display card at ${gpu_dev##*/} ($gpu_driver) powered while its screens are off"
        else
            warn "couldn't hold the display card at ${gpu_dev##*/} powered for this boot"
        fi
    done
    if test "$gpu_found" = no; then
        remove_display_gpu_rule "no display card here powers itself down"
        return 0
    fi
    if ! display_gpu_rule_is_ours; then
        warn "leaving $gpu_rule, which setup didn't write, so the display card can power down again after a reboot"
        return 0
    fi
    gpu_rule_text="$gpu_mark: holds display cards
# powered while their screens are off. See keep_display_gpu_awake there.
ACTION==\"add|bind\", SUBSYSTEM==\"pci\", ATTR{class}==\"0x03*\", DRIVER==\"$gpu_drivers\", ATTR{power/control}=\"on\""
    if test "$(cat "$gpu_rule" 2>/dev/null)" = "$gpu_rule_text"; then
        info "Skipping $gpu_rule: already written"
    elif printf '%s\n' "$gpu_rule_text" | sudo_or_warn tee "$gpu_rule" >/dev/null; then
        say "Wrote $gpu_rule, which holds display cards powered from the next boot"
    else
        warn "couldn't write $gpu_rule, so the display card can power down again after a reboot"
    fi
}

# --- Main ---

detect_os
resolve_crostini
resolve_gui
resolve_minimal
resolve_extras
if test "$INSTALL" = yes; then
    install_packages
    if test "$GUI_ENABLED" -eq 1; then
        install_fonts
    fi
    install_uv
    install_fnm
else
    info "Skipping the software: --no-install"
fi
# A removal, not an install, so it's keyed on its own flag rather than $INSTALL:
# --purge-obsolete --no-install is a valid "clean up, change nothing else" run.
if test "$PURGE_OBSOLETE" = yes; then
    purge_obsolete_packages
fi
generate_ssh_key
if test "$GUI_ENABLED" -eq 1; then
    set_default_terminal
fi
configure_keyboard
# Not keyed on the GUI: that only says whether this shell has a display, and a
# run over SSH on the same desktop has none. A headless box whose boot card
# qualifies pays a few watts for it (maintainer, 2026-10-06).
keep_display_gpu_awake

if ! command -v git >/dev/null 2>&1; then
    error "git is not installed and could not be installed"
    exit 1
fi

if ! command -v make >/dev/null 2>&1; then
    error "make is not installed and could not be installed"
    exit 1
fi

clone_or_pull "$SCRIPTS_REPO" "$SCRIPTS_DIR" yes
clone_or_pull "$CONF_REPO" "$CONF_DIR" yes

# Not logged: confinst prints only what it links or moves.
info "Running confinst"
"$SCRIPTS_DIR/confinst"

if test "$INSTALL" = no; then
    info "Skipping helix, jj and nushell: --no-install"
elif test "$ROOT" = no; then
    # Unprivileged (--no-root): apt/dnf were skipped, so install the CLI tools
    # (the core distro package set plus the extras) into a home prefix with
    # homepkg instead. --no-sudo alone (ROOT=yes) leaves this to install_extras
    # below, whose brew and release installs are themselves rootless.
    install_home_tools
    # The one packaged shell tool homepkg can't fetch.
    install_zsh_autosuggestions_home
elif test "$MINIMAL_ENABLED" -eq 0; then
    install_extras
else
    info "Skipping helix, jj and nushell: minimal profile"
fi

# After install_home_tools, which is where --no-root gets its Go.
if test -f "$CONF_DIR/vcs/Makefile"; then
    if check_go; then
        info "Installing vcs"
        logged make -C "$CONF_DIR/vcs" install
    else
        # The prompt shows no VCS status without it, but the shell works.
        warn "skipping vcs; rerun setup once Go $MIN_GO or newer is installed"
    fi
fi

# atuin/carapace are small static binaries with no packaged build, and lf
# has no reliable distro package -- all come from homepkg once the scripts
# repo (and with it homepkg) is on disk, on every profile (including --minimal).
# install_file_managers is a no-op where lf is already installed (--no-root
# via install_home_tools, macOS via Homebrew). An Intel Mac's node and tsc
# come from homepkg here too (install_node_home).
if test "$INSTALL" = yes; then
    install_shell_tools
    install_file_managers
    install_node_home
fi
# After the clone, so it reads the scripts repo's current list.
if test "$PURGE_OBSOLETE" = yes; then
    prune_retired_tools
fi

start_services

if test "$GUI_ENABLED" -eq 1; then
    if test "$OS" = "macos"; then
        info "Configuring macOS"
        # shellcheck disable=SC2086  # $DESKTOP_SETUP_FLAGS expands to zero or more flags
        "$SCRIPTS_DIR/setup-macos" $DESKTOP_SETUP_FLAGS
    elif test "$CROSTINI" -eq 1; then
        # No KDE session to configure, and tide needs its own OS.
        info "Skipping KDE Plasma and tide: Crostini"
        crostini_settings
    else
        configure_linux_desktop
    fi
else
    info "Skipping the desktop: no GUI"
fi

# --- Install root config ---

# The root config builds helper tools and installs files via make, so it's
# an install step too: skip it under --no-install.
if test "$INSTALL" = yes; then
    mkdir -p "$SRC_DIR"
    clone_or_pull "$ROOT_REPO" "$ROOT_DIR" yes
    # The default root config builds helper tools that require cargo. setup
    # installs no Rust toolchain of its own any more (the extras come prebuilt
    # from Homebrew or from release artifacts), so this uses whatever toolchain
    # the machine already has and installs the legacy config from the legacy/
    # subdir when there is none. Source ~/.cargo/env first so a rustup
    # toolchain counts as available even in a non-login shell.
    if test -f "$HOME/.cargo/env"; then
        # shellcheck source=/dev/null
        . "$HOME/.cargo/env"
    fi
    if command -v cargo >/dev/null 2>&1; then
        info "Installing the root config"
        logged make -C "$ROOT_DIR"
        logged sudo_or_warn make -C "$ROOT_DIR" install \
            || warn "couldn't install the root config"
    else
        info "Installing the legacy root config from $ROOT_DIR/legacy: no cargo for the main one"
        logged sudo_or_warn make -C "$ROOT_DIR/legacy" install \
            || warn "couldn't install the legacy root config"
    fi
else
    info "Skipping the root config: --no-install"
fi

# Now that the repos are cloned, offer to switch their remotes to SSH.
offer_ssh_remotes

# Group membership is configuration, not an install, so apply it regardless
# of --no-install.
if test "$CROSTINI" -eq 1; then
    # The container's user already has sudo.
    info "Skipping the root group: Crostini"
elif test "$OS" = "macos"; then
    # macOS: the admin group (GID 80) already has sudo access; the wheel/admin
    # group membership is managed by Directory Services, not /etc/group.
    info "Skipping the root group: macOS's System Settings manages admin membership"
else
    root_group=$(getent group 0 | cut -d: -f1)
    case " $(id -Gn "$USER" 2>/dev/null) " in
        *" $root_group "*)
            info "Skipping the $root_group group: $USER is already in it"
            ;;
        *)
            if logged sudo_or_warn gpasswd -a "$USER" "$root_group"; then
                say "Added $USER to the $root_group group; log out and back in for it to take effect"
            else
                warn "couldn't add $USER to the $root_group group"
            fi
            ;;
    esac
fi
