setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_CMAKE_FAILS=Hyprland FAKE_GREETD_TAKES=1
check "greetd: a fatal failure earlier ends the run" test "$status" -ne 0
check "greetd: before greetd is installed" lacks "$calls" "install -y greetd"
check "greetd: so it isn't the display manager" test ! -s "$T/dm"
