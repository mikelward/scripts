teardown
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf '#%%PAM-1.0\n@include login\nauth optional pam_gnome_keyring.so\nsession optional \\\n    pam_gnome_keyring.so\n' > "$T/pam.d/greetd"
cp "$T/pam.d/greetd" "$T/original-pam"; run
check "keyring: a carried session line without auto_start is left" cmp -s "$T/pam.d/greetd" "$T/original-pam"
check "keyring: and says so" has "$output" "$T/pam.d/greetd carries a pam_gnome_keyring session line on with a backslash, so setup leaves it, and logging in may not unlock the keyring unless it has auto_start"
check "keyring: and greetd still takes over" test "$(cat "$T/dm")" = greetd.service
teardown
# A line that only looks like one, as the rest of a line carried on, isn't.
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf '#%%PAM-1.0\n@include login\nauth optional pam_permit.so \\\n    session optional pam_gnome_keyring.so\n' > "$T/pam.d/greetd"
cp "$T/pam.d/greetd" "$T/original-pam"; run
check "keyring: the rest of a carried line isn't a keyring line" \
    test "$(head -n 4 "$T/pam.d/greetd")" = "$(cat "$T/original-pam")" -a "$(grep -c '^auth  *optional  *pam_gnome_keyring.so$' "$T/pam.d/greetd")" -eq 1 -a "$(grep -c '^session  *optional  *pam_gnome_keyring.so auto_start$' "$T/pam.d/greetd")" -eq 1
teardown
# PAM can't read a file that ends in a line a backslash carries on, so
# greetd doesn't take over, and nothing is added after it.
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf '#%%PAM-1.0\n@include login\nsession optional pam_permit.so \\\n' > "$T/pam.d/greetd"
cp "$T/pam.d/greetd" "$T/original-pam"; run
greeter_not_ready "a PAM file that ends in a carried line" "greetd's PAM stack, in $T/pam.d/greetd, ends in a line a backslash carries on, which PAM can't read, and PAM refuses a login through a stack it can't load whole"
check "keyring: nothing is added after a carried last line" cmp -s "$T/pam.d/greetd" "$T/original-pam"
teardown
# What setup would write is checked as PAM would load it, before it's
# written, and isn't written if it can't be checked.
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf '#%%PAM-1.0\n@include login\n' > "$T/pam.d/greetd"; cp "$T/pam.d/greetd" "$T/original-pam"
cat > "$T/bin/awk" <<MOCK
#!/bin/sh
test -z "\$PAM_CHAIN_OVERRIDE" || exit 2
exec $real_awk "\$@"
MOCK
chmod +x "$T/bin/awk"; run
check "keyring: a change that can't be checked isn't written" cmp -s "$T/pam.d/greetd" "$T/original-pam"
check "keyring: and says why" has "$output" "not adding pam_gnome_keyring to $T/pam.d/greetd, since PAM couldn't load greetd's stack with it: couldn't read greetd's PAM stack"
check "keyring: and greetd still takes over" test "$(cat "$T/dm")" = greetd.service
teardown

# Each awk program setup runs has to parse under whichever awk a distro
# ships as awk: mawk on Debian and Ubuntu, gawk on Fedora and Arch. A name
# one of them reserves, as gawk does func, breaks only that one. Each is
# checked here, when it's installed, without running anything: the first
# BEGIN and END exit before the program's own.
awk_programs=$(grep -o "^[A-Z_]*_AWK='" "$SCRIPT" | sed "s/='\$//")
check "awk: setup's awk programs are found" test -n "$awk_programs"
awk_parses() {
    test -n "$2" && "$1" "BEGIN { exit } END { exit } $2" /dev/null
}
for awk_name in mawk gawk; do
    command -v "$awk_name" >/dev/null || continue
    for awk_program in $awk_programs; do
        awk_text=$(awk -v name="$awk_program" '
            !on && index($0, name "=\047") == 1 { on = 1; $0 = substr($0, length(name) + 3) }
            on && index($0, "\047") { print substr($0, 1, index($0, "\047") - 1); exit }
            on { print }' "$SCRIPT")
        check "awk: $awk_program parses under $awk_name" awk_parses "$awk_name" "$awk_text"
    done
done

setup; ARGS=(--bogus); run
check "an unknown option fails" test "$status" -eq 1
teardown

echo
echo "setup-tide: $TESTS_PASSED/$TESTS_RUN passed"
test "$TESTS_FAILED" -eq 0
