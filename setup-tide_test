setup; ARGS=(); echo gdm3.service > "$T/dm"; run
printf 'garbage\n' > "$T/etc/greetd/config.toml"
run FAKE_GO_VERSION=go1.19.8 FAKE_GREETD_CONFLICTS="shutdown.target"
check "greetd: a config this run can't write puts GDM back even when a later step fails" test "$(cat "$T/dm")" = gdm3.service
check "greetd: and says why" has "$output" "greetd's unit keeps getty off no VT, so the greeter would share one with a login prompt; greetd isn't kept with a config this run couldn't put right, so putting back gdm3.service for the next boot"
teardown
# One this run makes runnable again takes over again at the end.
setup; ARGS=(); echo gdm3.service > "$T/dm"; run
mv "$T/usr-bin/qs" "$T/qs"
cat > "$T/bin/make" <<MOCK
#!/bin/sh
printf "%s\\n" "make \$*" >> "$CALLS"
case "\$*" in *install-session*) mv "$T/qs" "$T/usr-bin/qs" ;; esac
