    test "$(printf '%s\n' "$calls" | grep -n 'install-session' | head -n1 | cut -d: -f1)" -lt \
        "$(printf '%s\n' "$calls" | grep -n 'install -y greetd' | head -n1 | cut -d: -f1)"
teardown

# Every other way of not switching undoes the package's switch too: here,
# a note of the way back that can't be written.
setup; ARGS=(); mkdir -p "$T/var/lib"; : > "$T/var/lib/setup-tide"; run FAKE_GREETD_TAKES=1
check "greetd: an unwritable note doesn't switch" has "$output" "not making greetd the display manager, so the text console login stays: couldn't note it in $T/var/lib/setup-tide/previous-display-manager, which is the way back"
check "greetd: and undoes the package's switch" has "$calls" "sudo systemctl disable greetd.service"
check "greetd: leaving no display manager" test ! -s "$T/dm"
teardown

# And a display manager systemd can't name once greetd is installed: the
# package may have switched, so the one before is put back.
setup; ARGS=(); run FAKE_GREETD_TAKES=1 FAKE_DM_QUERY_FAILS_AFTER_INSTALL=1
check "greetd: an unnamed display manager after the install is named" has "$output" "not making greetd the display manager, so the text console login stays: couldn't tell which display manager this is after installing greetd"
check "greetd: and the one before is put back" has "$calls" "sudo systemctl disable greetd.service"
check "greetd: leaving none" test ! -s "$T/dm"
teardown

# And a config that can't be written.
setup; ARGS=(); rm -r "$T/etc/greetd"; : > "$T/etc/greetd"; run FAKE_GREETD_TAKES=1
check "greetd: an unwritable config is named" has "$output" "not making greetd the display manager, so the text console login stays: couldn't write $T/etc/greetd/config.toml"
check "greetd: and that undoes the package's switch too" test ! -s "$T/dm"
teardown

# The user greetd's own config names comes first.
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf 'greeter:x:998:998::/nonexistent:/usr/sbin/nologin\n' >> "$T/passwd"
printf '[terminal]\nvt = 7\n\n[default_session]\ncommand = "agreety --cmd /bin/sh"\nuser = "_greetd" # the package'"'"'s\n' > "$T/etc/greetd/config.toml"
run
check "greetd: uses the user greetd's config names" has "$(cat "$T/etc/greetd/config.toml")" 'user = "_greetd"'
teardown
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf 'greeter:x:998:998::/nonexistent:/usr/sbin/nologin\n' >> "$T/passwd"
run
check "greetd: without a config, greetd's own default user comes first" has "$(cat "$T/etc/greetd/config.toml")" 'user = "greeter"'
check "greetd: a home that doesn't exist is replaced" has "$calls" "sudo usermod -d $T/var/lib/tide-greeter greeter"
teardown

# The greeter runs only as one of greetd's own system accounts: not root,
# a person's account, or another service's, whatever greetd's config names.
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf 'root:x:0:0::/root:/bin/sh\nalice:x:1000:1000::/home/alice:/bin/sh\npostgres:x:120:120::/nonexistent:/bin/sh\n' >> "$T/passwd"
for name in root alice postgres; do
    printf '[default_session]\ncommand = "agreety"\nuser = "%s"\n' "$name" > "$T/etc/greetd/config.toml"
    : > "$CALLS"
    run
    check "greetd: a config naming $name isn't followed" has "$(cat "$T/etc/greetd/config.toml")" 'user = "_greetd"'
    check "greetd: nor is $name's home changed" lacks "$calls" "usermod -d $T/var/lib/tide-greeter $name"
done
teardown
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf 'root:x:0:0::/root:/bin/sh\n' > "$T/passwd"
printf '[default_session]\ncommand = "agreety"\nuser = "root"\n' > "$T/etc/greetd/config.toml"
run
greeter_not_ready_config() {
    check "greetd: $1 doesn't switch" lacks "$calls" "enable --force greetd"
    check "greetd: $1 is named" has "$output" "$2"
}
greeter_not_ready_config "only root" "greetd has no system account to run the greeter as (setup looked for greeter _greetd greetd)"
teardown
# Nor another service's, when greetd has none of its own.
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf 'postgres:x:120:120::/nonexistent:/bin/sh\n' > "$T/passwd"
printf '[default_session]\ncommand = "agreety"\nuser = "postgres"\n' > "$T/etc/greetd/config.toml"
run
greeter_not_ready_config "only another service's account" "greetd has no system account to run the greeter as (setup looked for greeter _greetd greetd)"
check "greetd: and leaves that account's home" lacks "$calls" "usermod"
teardown
# UID_MIN comes from login.defs.
setup; ARGS=(); echo gdm3.service > "$T/dm"; printf 'UID_MIN\t\t\t 500\n' > "$T/login.defs"; run
check "greetd: a UID at login.defs' UID_MIN is a person's" has "$output" "greetd has no system account to run the greeter as"
teardown

# The VT is the one greetd's unit keeps getty off.
setup; ARGS=(); echo gdm3.service > "$T/dm"; run FAKE_GREETD_CONFLICTS="getty@tty1.service shutdown.target"
check "greetd: upstream's unit gets VT 1" has "$(cat "$T/etc/greetd/config.toml")" "vt = 1"
teardown
setup; ARGS=(); echo gdm3.service > "$T/dm"; run FAKE_GREETD_CONFLICTS="getty@tty63.service shutdown.target"
check "greetd: a unit keeping getty off VT 63, Linux's last, gets it" has "$(cat "$T/etc/greetd/config.toml")" "vt = 63"
teardown
# Linux has VTs 1 to 63, and greetd would fail to start on any other at
# every boot.
for tty in 0 64 07; do
    setup; ARGS=(); echo gdm3.service > "$T/dm"; run FAKE_GREETD_CONFLICTS="getty@tty$tty.service shutdown.target"
    greeter_not_ready "a unit keeping getty off tty$tty" "greetd's unit keeps getty off tty$tty, which isn't one of Linux's VTs, 1 to 63, so greetd couldn't start there"
    teardown
done
# A unit that keeps getty off no VT, or a VT systemd won't say, isn't
# switched to: the greeter would share its VT with a login prompt.
setup; ARGS=(); echo gdm3.service > "$T/dm"; run FAKE_GREETD_CONFLICTS="shutdown.target"
check "greetd: a unit naming no getty doesn't switch" test "$(cat "$T/dm")" = gdm3.service
check "greetd: and says why" has "$output" "not making greetd the display manager, so gdm3.service stays: greetd's unit keeps getty off no VT, so the greeter would share one with a login prompt"
check "greetd: and writes no config" test ! -e "$T/etc/greetd/config.toml"
teardown
setup; ARGS=(); echo gdm3.service > "$T/dm"; run FAKE_CONFLICTS_FAILS=1
check "greetd: an unreadable unit doesn't switch" test "$(cat "$T/dm")" = gdm3.service
check "greetd: and says why" has "$output" "couldn't ask systemd which VT greetd's unit keeps for it"
teardown

# A home greetd's user owns, outside /etc, is kept. stat says it's 999's.
setup; ARGS=(); echo gdm3.service > "$T/dm"; mkdir "$T/greeter-home"
printf '_greetd:x:999:999::%s:/usr/sbin/nologin\n' "$T/greeter-home" > "$T/passwd"
printf '#!/bin/sh\necho 999\n' > "$T/bin/stat"; chmod +x "$T/bin/stat"
run
check "greetd: a home of its own is kept" lacks "$calls" "usermod"
check "greetd: and nothing is made for it" test ! -e "$T/var/lib/tide-greeter"
teardown

# Without a home, the greeter only forgets the last login: still switch.
setup; ARGS=(); echo gdm3.service > "$T/dm"; run FAKE_USERMOD_FAILS=1
check "greetd: a failed usermod is named" has "$output" "couldn't give _greetd the home $T/var/lib/tide-greeter, so the greeter won't remember the last login"
check "greetd: and greetd still takes over" test "$(cat "$T/dm")" = greetd.service
teardown

# An enable that took the alias before it failed is undone too.
setup; ARGS=(); echo gdm3.service > "$T/dm"; run FAKE_ENABLE_FAILS_AFTER=1
check "greetd: an enable that fails after taking the alias is undone" has "$calls" "sudo systemctl enable --force gdm3.service"
check "greetd: GDM is the display manager again" test "$(cat "$T/dm")" = gdm3.service
check "greetd: and says why" has "$output" "not making greetd the display manager, so gdm3.service stays: systemctl couldn't enable greetd"
teardown

# A failed switch leaves GDM, and says so.
setup; ARGS=(); echo gdm3.service > "$T/dm"; run FAKE_ENABLE_FAILS=1
check "greetd: a failed switch is named" has "$output" "not making greetd the display manager, so gdm3.service stays: systemctl couldn't enable greetd"
check "greetd: a failed switch isn't fatal" test "$status" -eq 0
check "greetd: a failed switch leaves the old greeting" has "$output" "Log out and pick the \"tide\" session"
teardown
# A greetd unit without Alias=display-manager.service, enabled, would start
# beside the display manager, so it's disabled again.
setup; ARGS=(); echo gdm3.service > "$T/dm"; run FAKE_ENABLE_NO_ALIAS=1
check "greetd: a unit that doesn't take the alias is named" has "$output" "not making greetd the display manager, so gdm3.service stays: enabling greetd didn't make it the display manager, as its unit would with Alias=display-manager.service"
check "greetd: and is disabled again" has "$calls" "systemctl disable greetd.service"
check "greetd: and GDM stays" test "$(cat "$T/dm")" = gdm3.service
check "greetd: and isn't said to replace it" lacks "$output" "greetd's greeter replaces"
teardown
# When disabling it again fails too, greetd's other links may start it
# beside the display manager, and setup says so.
setup; ARGS=(); echo gdm3.service > "$T/dm"; run FAKE_ENABLE_NO_ALIAS=1 FAKE_DISABLE_FAILS=1
check "greetd: a failed disable after the alias isn't taken is named" has "$output" "couldn't disable greetd again, so it may start beside gdm3.service from the next boot; run 'sudo systemctl disable greetd.service'"
check "greetd: and GDM keeps the alias" test "$(cat "$T/dm")" = gdm3.service
check "greetd: and the run still says why it didn't switch" has "$output" "not making greetd the display manager, so gdm3.service stays: enabling greetd didn't make it the display manager"
teardown

# --no-install sets up the greetd that's there, without installing one.
setup; ARGS=(--no-install); echo gdm3.service > "$T/dm"; : > "$T/greetd-installed"; run
check "--no-install: installs no greetd" lacks "$calls" "install -y greetd"
check "--no-install: still makes greetd the display manager" test "$(cat "$T/dm")" = greetd.service
teardown

setup; ARGS=(--no-sudo); echo gdm3.service > "$T/dm"; : > "$T/greetd-installed"; run
check "--no-sudo leaves the display manager alone" test "$(cat "$T/dm")" = gdm3.service
check "--no-sudo writes no greetd config" test ! -e "$T/etc/greetd/config.toml"
teardown

# Logging in at the greeter unlocks gnome-keyring, as GDM's login does.
setup; ARGS=(); echo gdm3.service > "$T/dm"; cp "$T/pam.d/greetd" "$T/debian-pam"; run
check "keyring: installs PAM's gnome-keyring module" has "$calls" "sudo apt-get install -y gnome-keyring libpam-gnome-keyring"
check "keyring: leaves Debian's file, which lists it" cmp -s "$T/pam.d/greetd" "$T/debian-pam"
teardown

setup; ARGS=(); run SETUP_OS=redhat
check "keyring: Fedora's module is gnome-keyring-pam" has "$calls" "dnf install -y gnome-keyring gnome-keyring-pam"
teardown
setup; ARGS=(); run SETUP_OS=arch
check "keyring: Arch's is in gnome-keyring" has "$calls" "pacman -S --needed --noconfirm gnome-keyring"
teardown
setup; ARGS=(); run FAKE_MISSING=libpam-gnome-keyring
check "keyring: a missing module is named" has "$output" "couldn't install libpam-gnome-keyring, so logging in won't unlock the keyring"
check "keyring: and greetd still installs" has "$calls" "apt-get install -y greetd"
teardown

# A file without it gets both lines, after everything it includes; a
# commented-out line doesn't count.
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf '#%%PAM-1.0\nauth       substack     system-auth\n#auth optional pam_gnome_keyring.so\nsession    include      system-auth\n' > "$T/pam.d/greetd"
cp "$T/pam.d/greetd" "$T/original-pam"
run
check "keyring: a stack without it gains it" \
    test "$(cat "$T/pam.d/greetd")" = "$(cat "$T/original-pam"; printf '\n# Unlock gnome-keyring with the login password (setup-tide).\nauth       optional     pam_gnome_keyring.so\nsession    optional     pam_gnome_keyring.so auto_start')"
check "keyring: and says so" has "$output" "greetd's PAM stack now unlocks the keyring at login"
cp "$T/pam.d/greetd" "$T/once-pam"
run
check "keyring: a rerun adds nothing" cmp -s "$T/pam.d/greetd" "$T/once-pam"
teardown

# Only the missing one is added.
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf '#%%PAM-1.0\nauth optional pam_gnome_keyring.so\n' > "$T/pam.d/greetd"
run
check "keyring: a stack with auth gains only session" \
    test "$(grep -c pam_gnome_keyring "$T/pam.d/greetd")" -eq 2 -a "$(grep -c '^session.*auto_start$' "$T/pam.d/greetd")" -eq 1
teardown

# A session line without auto_start starts no keyring daemon at login, so
# it gains auto_start, and nothing is added.
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf '#%%PAM-1.0\nauth       optional     pam_gnome_keyring.so\nsession    optional     pam_gnome_keyring.so\n-session optional pam_gnome_keyring.so  \n' > "$T/pam.d/greetd"
run
check "keyring: a session line without auto_start gains it" \
    test "$(cat "$T/pam.d/greetd")" = "$(printf '#%%PAM-1.0\nauth       optional     pam_gnome_keyring.so\nsession    optional     pam_gnome_keyring.so auto_start\n-session optional pam_gnome_keyring.so auto_start')"
check "keyring: and says so" has "$output" "greetd's PAM stack now unlocks the keyring at login"
teardown
# PAM ignores everything from a # on, so the module or auto_start named
# only in a comment doesn't count, and auto_start goes before one.
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf '#%%PAM-1.0\nauth optional pam_gnome_keyring.so # unlock\nsession optional pam_gnome_keyring.so # auto_start\n' > "$T/pam.d/greetd"
run
check "keyring: auto_start goes before a comment" \
    test "$(cat "$T/pam.d/greetd")" = "$(printf '#%%PAM-1.0\nauth optional pam_gnome_keyring.so # unlock\nsession optional pam_gnome_keyring.so auto_start # auto_start')"
cp "$T/pam.d/greetd" "$T/once-pam"
run
check "keyring: and a rerun leaves it" cmp -s "$T/pam.d/greetd" "$T/once-pam"
teardown
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf '#%%PAM-1.0\nauth optional pam_unix.so # pam_gnome_keyring.so\nsession include system-auth # pam_gnome_keyring.so\n' > "$T/pam.d/greetd"
run
check "keyring: a module named only in comments is added" \
    test "$(grep -c '^auth  *optional  *pam_gnome_keyring.so$' "$T/pam.d/greetd")" -eq 1 -a "$(grep -c '^session  *optional  *pam_gnome_keyring.so auto_start$' "$T/pam.d/greetd")" -eq 1
teardown
# Lines are read as PAM reads them, joined where a backslash carries one
# on. One that's carried on already has auto_start or is left alone, since
# text added at its end would follow the backslash.
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf '#%%PAM-1.0\n@include login\nauth optional pam_gnome_keyring.so\nsession optional pam_gnome_keyring.so \\\n    auto_start\n' > "$T/pam.d/greetd"
cp "$T/pam.d/greetd" "$T/original-pam"; run
check "keyring: a session line carried on to its auto_start is left" cmp -s "$T/pam.d/greetd" "$T/original-pam"
check "keyring: and greetd takes over" test "$(cat "$T/dm")" = greetd.service
teardown
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf '#%%PAM-1.0\n@include login\nauth optional pam_gnome_keyring.so\nsession optional \\\n# the keyring\n    pam_gnome_keyring.so\n' > "$T/pam.d/greetd"
cp "$T/pam.d/greetd" "$T/original-pam"; run
check "keyring: a carried session line without auto_start is left" cmp -s "$T/pam.d/greetd" "$T/original-pam"
check "keyring: and says so" has "$output" "$T/pam.d/greetd carries a pam_gnome_keyring session line on with a backslash, so setup leaves it, and logging in may not unlock the keyring unless it has auto_start"
check "keyring: and greetd still takes over" test "$(cat "$T/dm")" = greetd.service
teardown
# A line that only looks like one, as the rest of a line carried on, isn't.
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf '#%%PAM-1.0\n@include login\nauth optional pam_permit.so \\\n    session optional pam_gnome_keyring.so\n' > "$T/pam.d/greetd"
cp "$T/pam.d/greetd" "$T/original-pam"; run
check "keyring: the rest of a carried line isn't a keyring line" \
    test "$(head -n 4 "$T/pam.d/greetd")" = "$(cat "$T/original-pam")" -a "$(grep -c '^auth  *optional  *pam_gnome_keyring.so$' "$T/pam.d/greetd")" -eq 1 -a "$(grep -c '^session  *optional  *pam_gnome_keyring.so auto_start$' "$T/pam.d/greetd")" -eq 1
teardown
# Nothing is added after a last line a backslash carries on, which it would
# join.
setup; ARGS=(); echo gdm3.service > "$T/dm"
printf '#%%PAM-1.0\n@include login\nsession optional pam_permit.so \\\n' > "$T/pam.d/greetd"
cp "$T/pam.d/greetd" "$T/original-pam"; run
check "keyring: nothing is added after a carried last line" cmp -s "$T/pam.d/greetd" "$T/original-pam"
check "keyring: and says so" has "$output" "$T/pam.d/greetd ends in a line a backslash carries on, which lines added after it would join, so setup adds no pam_gnome_keyring lines, and logging in may not unlock the keyring"
check "keyring: and greetd still takes over" test "$(cat "$T/dm")" = greetd.service
teardown

setup; ARGS=(--bogus); run
check "an unknown option fails" test "$status" -eq 1
teardown

echo
echo "setup-tide: $TESTS_PASSED/$TESTS_RUN passed"
test "$TESTS_FAILED" -eq 0
