# --- greetd ---

# On a GDM machine, greetd becomes the display manager from the next boot,
# running tide's greeter as the user and on the VT this greetd needs.
setup; ARGS=(); echo gdm3.service > "$T/dm"; run
check "greetd: installs greetd" has "$calls" "sudo apt-get install -y greetd"
check "greetd: the config is tide's, with Debian's user and VT" \
    test "$(cat "$T/etc/greetd/config.toml")" = "$(sed -e 's/^user = .*/user = "_greetd"/' -e 's/^vt = .*/vt = 7/' "$T/greetd.toml")"
check "greetd: the config is root's" has "$calls" "sudo install -D -m 644"
check "greetd: checks greetd's user can run each command the greeter starts" \
    test "$(printf '%s\n' "$calls" | grep -c "^sudo -u _greetd env PATH=$T/usr-local-bin:$T/usr-bin /bin/sh -c _p=")" -eq 3
check "greetd: and asks its own Hyprland for its version" \
    has "$calls" "sudo -u _greetd env PATH=$T/usr-local-bin:$T/usr-bin /bin/sh -c Hyprland --version"
check "greetd: notes the display manager it replaces" test "$(cat "$T/var/lib/setup-tide/previous-display-manager")" = gdm3.service
check "greetd: takes the display manager's alias" has "$calls" "sudo systemctl enable --force greetd.service"
check "greetd: is the display manager" test "$(cat "$T/dm")" = greetd.service
check "greetd: starts nothing now, which would end this session" lacks "$calls" "--now greetd"
check "greetd: restarts nothing" lacks "$calls" "restart"
check "greetd: says when, and the way back" \
    has "$output" "From the next boot, greetd's greeter replaces gdm3.service. If it doesn't come up, press Ctrl+Alt+F3, log in, and run 'sudo systemctl enable --force gdm3.service && sudo systemctl disable greetd.service', or rerun 'setup --tide --no-greeter'"
check "greetd: says where to pick tide" has "$output" "Pick the \"tide\" session at greetd's greeter; KDE Plasma stays available there."
check "greetd: gives greetd's user a home outside /etc" \
    has "$calls" "sudo install -d -m 700 -o 999 -g 999 $T/var/lib/tide-greeter"
check "greetd: and makes it its home" has "$calls" "sudo usermod -d $T/var/lib/tide-greeter _greetd"
check "greetd: the run succeeds" test "$status" -eq 0
# A rerun keeps the note of what greetd replaced.
: > "$CALLS"
run
check "greetd: a rerun doesn't switch again" lacks "$calls" "enable --force"
check "greetd: a rerun keeps the note of GDM" test "$(cat "$T/var/lib/setup-tide/previous-display-manager")" = gdm3.service
check "greetd: a rerun keeps the greeter's home" lacks "$calls" "usermod"
# --no-greeter puts GDM back.
: > "$CALLS"
ARGS=(--no-greeter); run
check "--no-greeter: puts back what greetd replaced" has "$calls" "sudo systemctl enable --force gdm3.service"
# A greetd unit that's wanted by a target too would start beside it.
check "--no-greeter: and disables greetd" has "$calls" "sudo systemctl disable greetd.service"
check "--no-greeter: GDM is the display manager" test "$(cat "$T/dm")" = gdm3.service
check "--no-greeter: says so" has "$output" "gdm3.service is the display manager again from the next boot"
check "--no-greeter: installs no greetd" lacks "$calls" "install -y greetd"
check "--no-greeter: leaves the session's own greeting" has "$output" "Log out and pick the \"tide\" session"
# And when greetd isn't the display manager, --no-greeter does nothing.
: > "$CALLS"
run
check "--no-greeter: with GDM, touches no display manager" lacks "$calls" "enable --force"
teardown

# Without a note, --no-greeter can't guess what to put back.
