check "no user manager still masks, just not --now" \
    has "$calls" "systemctl --user mask waybar.service swaync.service"
check "no user manager says a running bar isn't stopped" \
    has "$output" "masking waybar.service swaync.service without stopping them"
teardown

# Any installed daemon that D-Bus can activate for the notification name is
# masked through its unit; one without a unit is named; KDE's is left alone.
setup; ARGS=()
mkdir -p "$T/dbus" "$T/units"
printf '[D-BUS Service]\nName=org.freedesktop.Notifications\nExec=/usr/lib/xfce4/notifyd/xfce4-notifyd\nSystemdService=xfce4-notifyd.service\n' \
    > "$T/dbus/org.xfce.xfce4-notifyd.Notifications.service"
printf '[D-BUS Service]\nName=org.freedesktop.Notifications\nExec=/usr/bin/dunst\nSystemdService=dunst.service\n' \
    > "$T/dbus/org.knopwob.dunst.service"
printf '[D-BUS Service]\nName=org.freedesktop.Notifications\nExec=/usr/bin/swaync\nSystemdService=swaync.service\n' \
    > "$T/dbus/org.erikreider.swaync.service"
printf '[D-BUS Service]\nName=org.freedesktop.Notifications\nExec=/usr/libexec/mate-notification-daemon/mate-notification-daemon\n' \
    > "$T/dbus/org.freedesktop.mate.Notifications.service"
printf '[D-BUS Service]\nName=org.freedesktop.Notifications\nExec=/usr/bin/plasma_waitforname org.freedesktop.Notifications\n' \
    > "$T/dbus/org.kde.plasma.Notifications.service"
printf '[D-BUS Service]\nName=org.xfce.Notifyd\nExec=/usr/lib/xfce4/notifyd/xfce4-notifyd\nSystemdService=other.service\n' \
    > "$T/dbus/org.xfce.Notifyd.service"
touch "$T/units/xfce4-notifyd.service" "$T/units/swaync.service" "$T/units/other.service"
run SETUP_DBUS_SERVICE_DIRS="$T/no-such-dir $T/dbus" SETUP_USER_UNIT_DIRS="$T/units"
check "masks every installed notification daemon's unit, stopping it now" \
    has "$calls" "systemctl --user mask --now waybar.service swaync.service xfce4-notifyd.service"
check "skips a daemon whose unit isn't installed" lacks "$calls" "dunst.service"
check "masks only units for the notification name" lacks "$calls" "other.service"
check "names a daemon that has no unit to mask" \
    has "$output" "$T/dbus/org.freedesktop.mate.Notifications.service can start a notification daemon"
check "leaves KDE's, which only waits for plasmashell" lacks "$output" "org.kde.plasma.Notifications.service"
teardown

# GDM shows the short hostname, through the gdm dconf database.
host=$(uname -n | cut -d. -f1)
setup; ARGS=(); : > "$T/gdm-defaults"; run SETUP_GDM_DEFAULTS="$T/gdm-defaults"
check "GDM: writes the hostname banner" \
    test "$(cat "$T/dconf/db/gdm.d/50-tide-hostname")" = "$(printf "[org/gnome/login-screen]\nbanner-message-enable=true\nbanner-message-text='%s'" "$host")"
check "GDM: writes a profile that reads the gdm database" \
    test "$(cat "$T/dconf/profile/gdm")" = "$(printf 'user-db:user\nsystem-db:gdm\nfile-db:%s' "$T/gdm-defaults")"
check "GDM: compiles the database" has "$calls" "sudo dconf update"
: > "$CALLS"; run SETUP_GDM_DEFAULTS="$T/gdm-defaults"
check "GDM: an unchanged banner isn't rewritten" lacks "$calls" "dconf"
teardown

setup; ARGS=(); : > "$T/gdm-defaults"; printf 'user-db:user\nsystem-db:gdm\n' > "$T/share-profile"
run SETUP_GDM_DEFAULTS="$T/gdm-defaults" SETUP_DCONF_SHARE_PROFILE="$T/share-profile"
check "GDM: a shipped profile that reads the gdm database is used" test ! -e "$T/dconf/profile/gdm"
check "GDM: the banner is still written" test -e "$T/dconf/db/gdm.d/50-tide-hostname"
teardown

setup; ARGS=(); : > "$T/gdm-defaults"; mkdir -p "$T/dconf/profile"; printf 'user-db:user\n' > "$T/dconf/profile/gdm"
run SETUP_GDM_DEFAULTS="$T/gdm-defaults"
check "GDM: a profile without the gdm database is left alone" test "$(cat "$T/dconf/profile/gdm")" = "user-db:user"
check "GDM: and named" has "$output" "doesn't read the gdm dconf database"
check "GDM: and no banner is written" test ! -e "$T/dconf/db/gdm.d/50-tide-hostname"
teardown

# The /etc profile overrides a shipped one that reads the gdm database.
setup; ARGS=(); : > "$T/gdm-defaults"; mkdir -p "$T/dconf/profile"; printf 'user-db:user\n' > "$T/dconf/profile/gdm"
printf 'user-db:user\nsystem-db:gdm\n' > "$T/share-profile"
run SETUP_GDM_DEFAULTS="$T/gdm-defaults" SETUP_DCONF_SHARE_PROFILE="$T/share-profile"
check "GDM: an overriding /etc profile without the gdm database is named" has "$output" "doesn't read the gdm dconf database"
check "GDM: even when the shipped profile reads it" test ! -e "$T/dconf/db/gdm.d/50-tide-hostname"
teardown

# A failed temporary write installs nothing. mktemp hands back a directory,
# which even root can't write as a file; --no-install keeps every earlier
# step off mktemp.
setup; ARGS=(--no-install); : > "$T/gdm-defaults"; mkdir "$T/not-a-file"
cat > "$T/bin/mktemp" <<MOCK
#!/bin/sh
echo "$T/not-a-file"
MOCK
chmod +x "$T/bin/mktemp"
run SETUP_GDM_DEFAULTS="$T/gdm-defaults"
check "GDM: a failed temporary write installs no profile" test ! -e "$T/dconf/profile/gdm"
check "GDM: and says so" has "$output" "couldn't write a temporary copy of $T/dconf/profile/gdm"
teardown

setup; ARGS=(); run
check "no GDM, no banner" test ! -e "$T/dconf/db/gdm.d/50-tide-hostname"
teardown

setup; ARGS=(--no-sudo); : > "$T/gdm-defaults"; run SETUP_GDM_DEFAULTS="$T/gdm-defaults"
check "--no-sudo leaves GDM alone" test ! -e "$T/dconf/db/gdm.d/50-tide-hostname"
teardown

setup; ARGS=(--bogus); run
check "an unknown option fails" test "$status" -eq 1
teardown

