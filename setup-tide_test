#!/bin/bash
# Tests for setup-tide
#
# Runs setup-tide against a throwaway HOME, logind dir and tide
# checkout, with sudo, the package managers, git, make, systemctl and
# Hyprland mocked. Each mock logs its argv to $CALLS.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$SCRIPT_DIR/setup-tide"
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0

setup() {
    T="$(mktemp -d)"
    CALLS="$T/calls"
    # What the installs would create.
    mkdir -p "$T/bin" "$T/home" "$T/logind" "$T/usr-local-bin"
    printf '#!/bin/sh\nprintf "%%s\\n" "make $*" >> "%s"\n' "$CALLS" > "$T/bin/make"
    # dnf copr enable fails with \$FAKE_DNF_COPR_FAILS, and installing the
    # copr plugin with \$FAKE_DNF_PLUGIN_FAILS.
    cat > "$T/bin/dnf" <<MOCK
#!/bin/sh
printf "%s\\n" "dnf \$*" >> "$CALLS"
test "\$1" != copr || test -z "\$FAKE_DNF_COPR_FAILS" || exit 1
test "\$*" != "install -y dnf-command(copr)" || test -z "\$FAKE_DNF_PLUGIN_FAILS" || exit 1
MOCK
    # pacman refuses the whole command when it names a package in
    # \$FAKE_MISSING.
    cat > "$T/bin/pacman" <<MOCK
#!/bin/sh
printf "%s\\n" "pacman \$*" >> "$CALLS"
for arg; do
    case " \$FAKE_MISSING " in *" \$arg "*) exit 1 ;; esac
done
MOCK
    # dpkg-query reports Qt base's private headers as \$FAKE_QT_VERSION and
    # Qt Declarative's as \$FAKE_QTDECL_VERSION, or Ubuntu 26.04's.
    cat > "$T/bin/dpkg-query" <<MOCK
#!/bin/sh
printf "%s\\n" "dpkg-query \$*" >> "$CALLS"
shift 2
for pkg; do
    case "\$pkg" in
        qt6-base-private-dev) echo "\$pkg \${FAKE_QT_VERSION:-6.10.2+dfsg-7}" ;;
        qt6-declarative-private-dev) echo "\$pkg \${FAKE_QTDECL_VERSION:-6.10.2+dfsg-3}" ;;
        *) echo "\$pkg 6.10.2-4" ;;
    esac
done
MOCK
    # meson setup also logs the compilers it was given.
    cat > "$T/bin/meson" <<MOCK
#!/bin/sh
printf "%s\\n" "meson \$*" >> "$CALLS"
test "\$1" != setup || printf "%s\\n" "meson compilers CC=\$CC CXX=\$CXX" >> "$CALLS"
MOCK
    # apt-get refuses the whole command when it names a package in
    # \$FAKE_MISSING, as apt does.
    cat > "$T/bin/apt-get" <<MOCK
#!/bin/sh
printf "%s\\n" "apt-get \$*" >> "$CALLS"
test -z "\$FAKE_APT_GET_FAILS" || exit 100
for arg; do
    case " \$FAKE_MISSING " in *" \$arg "*) exit 100 ;; esac
done
MOCK
    # apt-cache policy knows every package but those in \$FAKE_MISSING,
    # offering Hyprland \$FAKE_APT_HYPRLAND (or a new enough one), g++-16
    # \$FAKE_APT_GXX and libxkbcommon-dev \$FAKE_APT_XKB (or Ubuntu 26.04's),
    # and 1.0 of the rest. \$FAKE_APT_CACHE_FAILS makes it fail.
    cat > "$T/bin/apt-cache" <<MOCK
#!/bin/sh
test -z "\$FAKE_APT_CACHE_FAILS" || exit 100
shift
for pkg; do
    case " \$FAKE_MISSING " in *" \$pkg "*) continue ;; esac
    case "\$pkg" in
        hyprland) version="\${FAKE_APT_HYPRLAND:-0.56.2-1}" ;;
        g++-16) version="\${FAKE_APT_GXX:-16-20260322-1ubuntu1}" ;;
        libxkbcommon-dev) version="\${FAKE_APT_XKB:-1.13.1-1}" ;;
        qt6-base-dev) version="\${FAKE_APT_QT:-6.10.2+dfsg-7}" ;;
        *) version=1.0-1 ;;
    esac
    printf "%s:\\n  Installed: (none)\\n  Candidate: %s\\n  Version table:\\n" "\$pkg" "\$version"
done
MOCK
    # cmake configuring into a prefix creates the commands the build would
    # install there, and logs which hyprwayland-scanner it would run.
    # Configuring anything named in \$FAKE_CMAKE_FAILS fails.
    cat > "$T/bin/cmake" <<MOCK
#!/bin/sh
printf "%s\\n" "cmake \$*" >> "$CALLS"
for arg; do
    case "\$arg" in
        -DCMAKE_INSTALL_PREFIX=*)
            prefix=\${arg#*=}
            mkdir -p "\$prefix/bin"
            for cmd in Hyprland hyprctl start-hyprland hyprwayland-scanner qs quickshell; do
                printf "#!/bin/sh\\n" > "\$prefix/bin/\$cmd"
                chmod +x "\$prefix/bin/\$cmd"
            done
            ;;
    esac
done
printf "%s\\n" "cmake finds \$(command -v hyprwayland-scanner)" >> "$CALLS"
if test -n "\$FAKE_CMAKE_FAILS"; then
    case "\$*" in *"/\$FAKE_CMAKE_FAILS "*) exit 1 ;; esac
fi
exit 0
MOCK
    # sudo runs the command, so rm and the rest really happen (on $T paths).
    # \$FAKE_LN_FAILS makes linking fail. \$FAKE_RM_KEEPS makes rm remove
    # everything but the file it names, then fail.
    cat > "$T/bin/sudo" <<MOCK
#!/bin/sh
printf "%s\\n" "sudo \$*" >> "$CALLS"
test "\$1" != ln || test -z "\$FAKE_LN_FAILS" || exit 1
if test "\$1" = rm && test -n "\$FAKE_RM_KEEPS"; then
    shift
    for f; do
        case "\$f" in -*|*/"\$FAKE_RM_KEEPS") ;; *) rm -f "\$f" ;; esac
    done
    exit 1
fi
"\$@"
MOCK
    # git clone creates the checkout, its last argument; pull just logs, or
    # fails with \$FAKE_PULL_FAILS.
    cat > "$T/bin/git" <<MOCK
#!/bin/sh
printf "%s\\n" "git \$*" >> "$CALLS"
if test "\$1" = clone; then
    for last; do :; done
    mkdir -p "\$last/.git"
    # wayland-protocols generates its headers with a strict scanner.
    case "\$last" in
        */wayland-protocols) printf "%s\\n" "command: [scanner, '--strict', 'enum-header']" > "\$last/meson.build" ;;
    esac
fi
if test "\$3" = pull && test -n "\$FAKE_PULL_FAILS"; then exit 1; fi
# rev-parse names the commit a Hyprland pin's checkout was pinned at, or
# another for the one named in \$FAKE_MOVED_PIN; Quickshell's is its pinned
# commit, or \$FAKE_QS_COMMIT.
if test "\$3" = rev-parse; then
    name=\${2##*/}
    pinned=\$(awk -v name="\$name" '\$1 == name { print \$2 }' "$T/pins")
    if test "\$name" = "\$FAKE_MOVED_PIN"; then
        echo 0000000000000000000000000000000000000000
    elif test -n "\$pinned"; then
        echo "\$pinned"
    else
        echo "\${FAKE_QS_COMMIT:-1a4716cde794a59928d9d9fc15f2afc7a95de360}"
    fi
fi
MOCK
    # Each Hyprland pin's name and commit, for git rev-parse.
    sed -n '/^HYPRLAND_PINS="/,/^"/p' "$SCRIPT" | awk 'NF == 5 { print $1, $4 }' > "$T/pins"
    cat > "$T/bin/systemctl" <<MOCK
#!/bin/sh
printf "%s\\n" "systemctl \$*" >> "$CALLS"
test "\$2" != show-environment || exit \${FAKE_NO_USER_MANAGER:-0}
MOCK
    # go answers GOVERSION with \$FAKE_GO_VERSION, or a new enough one.
    cat > "$T/bin/go" <<MOCK
#!/bin/sh
printf "%s\\n" "go \$*" >> "$CALLS"
test "\$*" != "env GOVERSION" || echo "\${FAKE_GO_VERSION:-go1.22.2}"
MOCK
    cat > "$T/bin/dconf" <<MOCK
#!/bin/sh
printf "%s\\n" "dconf \$*" >> "$CALLS"
MOCK
    cat > "$T/bin/Hyprland" <<MOCK
#!/bin/sh
echo "Hyprland \${FAKE_HYPRLAND_VERSION:-0.56.2} built from branch main"
MOCK
    chmod +x "$T"/bin/*
}

teardown() {
    rm -rf "$T"
}

run() {
    set +e
    output=$(env HOME="$T/home" PATH="$T/bin:$PATH" SETUP_LOGIND_DIR="$T/logind" \
        SETUP_DBUS_SERVICE_DIRS="$T/no-dbus" SETUP_USER_UNIT_DIRS="$T/no-units" \
        SETUP_GDM_DEFAULTS="$T/no-gdm" SETUP_DCONF_DIR="$T/dconf" SETUP_DCONF_SHARE_PROFILE="$T/no-profile" \
        TIDE_DIR="$T/src/tide" TIDE_REPO="https://example.com/tide.git" \
        HYPRLAND_PREFIX="$T/opt/hyprland" HYPRLAND_SRC="$T/src/hyprland-build" HYPRLAND_BIN_DIR="$T/usr-local-bin" \
        QUICKSHELL_PREFIX="$T/opt/quickshell" QUICKSHELL_SRC="$T/src/quickshell-build" QUICKSHELL_BIN_DIR="$T/usr-local-bin" \
        "$@" "$SCRIPT" "${ARGS[@]}" 2>&1)
    status=$?
    set -e
    calls=
    if test -f "$CALLS"; then
        calls=$(cat "$CALLS")
    fi
}

check() {
    name=$1
    shift
    TESTS_RUN=$((TESTS_RUN + 1))
    if "$@"; then
        TESTS_PASSED=$((TESTS_PASSED + 1))
    else
        TESTS_FAILED=$((TESTS_FAILED + 1))
        echo "FAIL: $name"
        echo "  output: $output"
        echo "  calls: $calls"
    fi
}
# The directory this run's pins install into.
inst() { printf '%s\n' "$T"/opt/hyprland/v0.56.2-*; }
has() { case "$1" in *"$2"*) return 0 ;; esac; return 1; }
lacks() { ! has "$1" "$2"; }

set -e

setup; ARGS=(); run
check "exits 0" test "$status" -eq 0
check "installs Hyprland, hypridle and uwsm" has "$calls" "hyprland hypridle hyprlock uwsm"
check "installs hyprlock, the lock screen Super+L and hypridle run" has "$calls" " hyprlock "
check "installs the transitional owners" has "$calls" "waybar"
check "clones tide when it isn't there" has "$calls" "git clone https://example.com/tide.git $T/src/tide"
check "clones from mikelward/tide by default" grep -q '^TIDE_REPO="${TIDE_REPO:-https://github.com/mikelward/tide.git}"$' "$SCRIPT"
check "runs tide's make install" has "$calls" "make -C $T/src/tide install"
# Go too, for a run without setup.
check "installs Go itself" has "$calls" "golang"

check "tells make install which Go to build with" has "$calls" "make -C $T/src/tide install GO=go"
check "installs the session under /usr with sudo" has "$calls" "sudo make -C $T/src/tide install-session PREFIX=/usr"
check "enables tide.service" has "$calls" "systemctl --user enable tide.service"
check "reloads units before enabling" has "$calls" "systemctl --user daemon-reload"
check "masks the distro's waybar and swaync units, stopping them now" \
    has "$calls" "systemctl --user mask --now waybar.service swaync.service"
check "leaves hypridle's unit to tide's session-only drop-in" lacks "$calls" "hypridle.service"
check "touches no other user's units" lacks "$calls" "--global"
teardown

setup; ARGS=(); run GO="$T/no-such-go"
check "no Go is an error" test "$status" -ne 0
check "no Go names the packages to install" has "$output" "tide needs Go 1.22 or newer to build tide-grant"
check "no Go stops before make install" lacks "$calls" "make -C $T/src/tide install"
teardown

setup; ARGS=(); run FAKE_GO_VERSION=go1.19.8
check "a Go older than 1.22 is an error" test "$status" -ne 0
check "an old Go says which it found and where to get a newer one" \
    has "$output" "and go is 1.19.8; on Debian 12, install golang from bookworm-backports"
check "an old Go stops before make install" lacks "$calls" "make -C $T/src/tide install"
teardown

setup; ARGS=(); run FAKE_GO_VERSION=go1.24.7
check "a newer Go is fine" test "$status" -eq 0
teardown

setup; ARGS=(); run SETUP_OS=redhat
check "Fedora installs Hyprland and Go with dnf" has "$calls" "dnf install -y hyprland hypridle"
check "Fedora installs its swaync, notify-send and Go" has "$calls" "SwayNotificationCenter libnotify golang"
teardown

setup; ARGS=(); run SETUP_OS=redhat
check "Fedora installs dnf's copr plugin, whichever dnf it has" has "$calls" "sudo dnf install -y dnf-command(copr)"
check "Fedora enables Quickshell's COPR" has "$calls" "sudo dnf copr enable -y errornointernet/quickshell"
check "then installs Quickshell on its own" has "$calls" "dnf install -y quickshell"
check "Fedora's Qt has the effects module already" lacks "$calls" "qml6-module-qtquick-effects"
check "so Fedora warns of nothing missing" lacks "$output" "won't load"
teardown

# Without the copr plugin there's no COPR, and that costs only the bar.
setup; ARGS=(); run SETUP_OS=redhat FAKE_DNF_PLUGIN_FAILS=1
check "a missing copr plugin isn't fatal" test "$status" -eq 0
check "a missing copr plugin says the bar won't run" has "$output" "couldn't install dnf's copr plugin"
check "a missing copr plugin doesn't try the COPR" lacks "$calls" "dnf copr enable"
teardown

# A COPR that won't enable costs only the bar.
setup; ARGS=(); run SETUP_OS=redhat FAKE_DNF_COPR_FAILS=1
check "a failed COPR isn't fatal" test "$status" -eq 0
check "a failed COPR says the bar won't run" has "$output" "couldn't enable the errornointernet/quickshell COPR"
check "a failed COPR doesn't try to install Quickshell" lacks "$calls" "dnf install -y quickshell"
teardown

setup; ARGS=(); run
check "Debian and Ubuntu install Quickshell and its effects module from apt" has "$calls" "apt-get install -y quickshell qml6-module-qtquick-effects"
check "Quickshell isn't in the main install, so its absence can't block it" lacks "$calls" "golang quickshell"
teardown

setup; ARGS=(); run FAKE_MISSING=qml6-module-qtquick-effects
check "a missing effects module isn't fatal" test "$status" -eq 0
check "a missing effects module says the bar won't load" has "$output" "couldn't install qml6-module-qtquick-effects, so tide's bar won't load"
check "Quickshell still installs without it" has "$calls" "apt-get install -y quickshell"
teardown

setup; ARGS=(); run SETUP_OS=arch FAKE_MISSING=quickshell
check "a distro without Quickshell isn't fatal" test "$status" -eq 0
check "a distro without Quickshell says the bar won't run" has "$output" "couldn't install Quickshell (the distro may not package it)"
check "and that waybar stays" has "$output" "waybar stays the bar"
teardown

# The directory this run's Quickshell build installs into.
qs_inst() { printf '%s\n' "$T"/opt/quickshell/v0.3.1-*; }

# apt without Quickshell (Ubuntu 26.04): build the pinned release.
setup; ARGS=(); run FAKE_MISSING=quickshell
check "apt without Quickshell builds it" test "$status" -eq 0
check "the Quickshell build never asks apt for quickshell" lacks "$calls" "apt-get install -y quickshell"
check "the Quickshell build installs Qt's private headers" has "$calls" "qt6-declarative-private-dev"
check "the Quickshell build installs the effects module the bar needs" has "$calls" "qml6-module-qtquick-effects"
check "the Quickshell build installs the GLES headers Qt's GUI module needs" has "$calls" " libgles-dev "
check "the Quickshell build clones the pinned tag" \
    has "$calls" "git clone --quiet --depth 1 --branch v0.3.1 https://github.com/quickshell-mirror/quickshell.git $T/src/quickshell-build/quickshell"
check "the Quickshell build installs under its prefix" has "$calls" "-DCMAKE_INSTALL_PREFIX=$(qs_inst)"
check "the Quickshell build leaves out the crash handler Ubuntu can't build" has "$calls" "-DCRASH_HANDLER=OFF"
check "the Quickshell build installs without sudo" lacks "$calls" "sudo cmake"
check "the Quickshell build records the Qt it was built for" has "$(cat "$(qs_inst)/quickspace-build")" "qt6-base-private-dev 6.10.2+dfsg-7"
check "the Quickshell build is current" test "$(readlink -f "$T/opt/quickshell/current")" = "$(qs_inst)"
check "the Quickshell build links qs onto PATH, through current" \
    test "$(readlink "$T/usr-local-bin/qs")" = "$T/opt/quickshell/current/bin/qs"
check "the Quickshell build doesn't warn" lacks "$output" "waybar stays the bar"
: > "$CALLS"
run FAKE_MISSING=quickshell
check "the same Quickshell and Qt don't rebuild" lacks "$calls" "cmake -S"
check "the same Quickshell and Qt say so" has "$output" "already built for Qt 6.10.2+dfsg-7"
first=$(qs_inst)
: > "$CALLS"
run FAKE_MISSING=quickshell FAKE_QT_VERSION=6.10.3-1
check "a new Qt rebuilds Quickshell" has "$calls" "cmake -S $T/src/quickshell-build/quickshell "
check "a new Qt's build is current" test "$(readlink -f "$T/opt/quickshell/current")" = "$(qs_inst)"
check "a new Qt's build replaces the old one" test ! -e "$first"
: > "$CALLS"
run FAKE_MISSING=quickshell FAKE_QT_VERSION=6.10.3-1 FAKE_QTDECL_VERSION=6.10.3-1
check "a new Qt Declarative alone rebuilds Quickshell" has "$calls" "cmake -S $T/src/quickshell-build/quickshell "
# A new pin for the same tag is a new build too.
sed 's/^QUICKSHELL_COMMIT=.*/QUICKSHELL_COMMIT=2222222222222222222222222222222222222222/' "$SCRIPT" > "$T/setup-repinned"
chmod +x "$T/setup-repinned"
: > "$CALLS"
SCRIPT="$T/setup-repinned" run FAKE_MISSING=quickshell FAKE_QT_VERSION=6.10.3-1 FAKE_QTDECL_VERSION=6.10.3-1 \
    FAKE_QS_COMMIT=2222222222222222222222222222222222222222
check "a new pinned commit alone rebuilds Quickshell" has "$calls" "cmake -S $T/src/quickshell-build/quickshell "
teardown

# apt's Quickshell without its effects module still takes over from a
# source build's links.
setup; ARGS=(); run FAKE_MISSING=quickshell
run FAKE_MISSING=qml6-module-qtquick-effects
check "apt's Quickshell without the effects module removes the build's qs link" test ! -L "$T/usr-local-bin/qs"
teardown

# A Qt older than Quickshell needs (Ubuntu 24.04's 6.4) can't build it, so
# nothing is installed or cloned for it.
setup; ARGS=(); run FAKE_MISSING=quickshell FAKE_APT_QT=6.4.2+dfsg-21.1build5
check "an old Qt isn't fatal" test "$status" -eq 0
check "an old Qt says why there's no Quickshell" has "$output" "building it needs Qt 6.6, but apt's Qt is 6.4.2"
check "an old Qt installs no build dependencies" lacks "$calls" "qt6-declarative-private-dev"
check "an old Qt clones nothing" lacks "$calls" "quickshell-mirror"
teardown

# A tag moved to another commit isn't built: its build files never run.
setup; ARGS=(); run FAKE_MISSING=quickshell FAKE_QS_COMMIT=0000000000000000000000000000000000000000
check "a moved Quickshell tag isn't fatal" test "$status" -eq 0
check "a moved Quickshell tag is named" has "$output" "not the pinned 1a4716cde794a59928d9d9fc15f2afc7a95de360; not building it"
check "a moved Quickshell tag runs no cmake" lacks "$calls" "cmake -S $T/src/quickshell-build/quickshell"
check "a moved Quickshell tag's clone is removed" test ! -e "$T/src/quickshell-build/quickshell"
teardown

# A rejected clone that can't be removed is named, not left silently.
setup; ARGS=()
cat > "$T/bin/rm" <<MOCK
#!/bin/sh
case "\$*" in *"$T/src/quickshell-build/quickshell") test -d "$T/src/quickshell-build/quickshell/.git" && exit 1 ;; esac
exec /bin/rm "\$@"
MOCK
chmod +x "$T/bin/rm"
run FAKE_MISSING=quickshell FAKE_QS_COMMIT=0000000000000000000000000000000000000000
check "an unremovable rejected clone is named" has "$output" "couldn't remove the rejected clone"
rm -f "$T/bin/rm"
teardown

# Only setup's own finished builds are cleaned up: not a directory without
# its marker, nor one a command still links into directly, as one does when
# relinking it failed.
setup; ARGS=()
mkdir -p "$T/opt/quickshell/v0.2.0-1" "$T/opt/quickshell/v0.2.0-2/bin"
: > "$T/opt/quickshell/v0.2.0-2/quickspace-build"
ln -s "$T/opt/quickshell/v0.2.0-2/bin/quickshell" "$T/usr-local-bin/quickshell"
mkdir -p "$T/opt/quickshell/v0.2.0-3"
: > "$T/opt/quickshell/v0.2.0-3/quickspace-build"
run FAKE_MISSING=quickshell FAKE_LN_FAILS=1
check "an unmarked directory isn't removed" test -d "$T/opt/quickshell/v0.2.0-1"
check "a build a command links into isn't removed" test -d "$T/opt/quickshell/v0.2.0-2"
check "an unused old build is removed" test ! -e "$T/opt/quickshell/v0.2.0-3"
teardown

# A partial build that can't be removed isn't built into and marked complete.
setup; ARGS=()
cat > "$T/bin/rm" <<MOCK
#!/bin/sh
case "\$*" in *"$T/opt/quickshell/"*) exit 1 ;; esac
exec /bin/rm "\$@"
MOCK
chmod +x "$T/bin/rm"
run FAKE_MISSING=quickshell
check "an unremovable partial build isn't fatal" test "$status" -eq 0
check "an unremovable partial build is named" has "$output" "couldn't remove the old Quickshell sources or partial build"
check "an unremovable partial build isn't built into" lacks "$calls" "cmake -S $T/src/quickshell-build/quickshell"
rm -f "$T/bin/rm"
teardown

# A rebuild for a new Qt that fails leaves no build made for the old Qt on
# PATH, so waybar takes over rather than a qs that would crash.
setup; ARGS=(); run FAKE_MISSING=quickshell
run FAKE_MISSING=quickshell FAKE_QT_VERSION=6.10.3-1 FAKE_CMAKE_FAILS=quickshell
check "a failed rebuild for a new Qt removes the old qs link" test ! -L "$T/usr-local-bin/qs"
check "a failed rebuild for a new Qt leaves nothing current" test ! -e "$T/opt/quickshell/current"
teardown

# A failed rebuild for an unchanged Qt (a new pin, say) keeps the build that
# still works.
setup; ARGS=(); run FAKE_MISSING=quickshell
sed 's/^QUICKSHELL_COMMIT=.*/QUICKSHELL_COMMIT=3333333333333333333333333333333333333333/' "$SCRIPT" > "$T/setup-repinned"
chmod +x "$T/setup-repinned"
SCRIPT="$T/setup-repinned" run FAKE_MISSING=quickshell FAKE_QS_COMMIT=3333333333333333333333333333333333333333 FAKE_CMAKE_FAILS=quickshell
check "a failed rebuild for the same Qt keeps the qs link" test -L "$T/usr-local-bin/qs"
teardown

# apt's Quickshell failing to install, after Qt changed, also leaves no
# build made for the old Qt on PATH.
setup; ARGS=(); run FAKE_MISSING=quickshell
run FAKE_APT_GET_FAILS=1 FAKE_QT_VERSION=6.10.3-1
check "a failed apt Quickshell after a Qt change removes the old qs link" test ! -L "$T/usr-local-bin/qs"
teardown

# A link that can't be removed keeps current, so it doesn't dangle.
setup; ARGS=(); run FAKE_MISSING=quickshell
run FAKE_MISSING=quickshell FAKE_QT_VERSION=6.10.3-1 FAKE_CMAKE_FAILS=quickshell FAKE_RM_KEEPS=qs
check "an unremovable qs link keeps current" test -L "$T/opt/quickshell/current"
check "an unremovable qs link still resolves" test -e "$T/usr-local-bin/qs"
teardown

# On the way to apt's Quickshell, a link that can't be removed is warned
# about and setup carries on.
setup; ARGS=(); run FAKE_MISSING=quickshell
run FAKE_RM_KEEPS=qs
check "an unremovable qs link doesn't stop setup" test "$status" -eq 0
check "an unremovable qs link is named" has "$output" "couldn't remove $T/usr-local-bin/qs"
teardown

# A failed build costs only the bar.
setup; ARGS=(); run FAKE_MISSING=quickshell FAKE_CMAKE_FAILS=quickshell
check "a failed Quickshell build isn't fatal" test "$status" -eq 0
check "a failed Quickshell build says waybar stays" has "$output" "building Quickshell failed"
check "a failed Quickshell build links nothing" test ! -e "$T/usr-local-bin/qs"
check "a failed Quickshell build isn't marked built" test ! -e "$T/opt/quickshell/current"
teardown

# Once apt has Quickshell, the build's links go, so /usr/bin/qs wins.
setup; ARGS=(); run FAKE_MISSING=quickshell
run
