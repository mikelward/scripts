# What earlier versions built in $HOME is setup's own, for Quickshell too.
legacy_quickshell() {
    legacy="$T/home/.local/opt/quickshell"
    mkdir -p "$legacy/v0.3.1-1/bin"
    : > "$legacy/v0.3.1-1/quickspace-build"
    ln -s v0.3.1-1 "$legacy/current"
    for cmd in qs quickshell; do
        printf '#!/bin/sh\n' > "$legacy/v0.3.1-1/bin/$cmd"
        chmod +x "$legacy/v0.3.1-1/bin/$cmd"
        ln -s "$legacy/current/bin/$cmd" "$T/usr-local-bin/$cmd"
    done
}
