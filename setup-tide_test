setup; ARGS=(); echo gdm3.service > "$T/dm"; run
rm "$T/usr-bin/qs"
: > "$CALLS"
run FAKE_GO_VERSION=go1.19.8
check "greetd: a broken greeter puts GDM back even when a later step fails" test "$(cat "$T/dm")" = gdm3.service
check "greetd: and says why" has "$output" "greetd's greeter can't run, so putting back gdm3.service for the next boot: greetd's user _greetd can't run qs"
