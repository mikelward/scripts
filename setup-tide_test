#!/bin/bash
# Tests for setup-tide: that it runs tide's installer, and its own extras:
# the tide checkout, the launcher entries, the old lid drop-ins and GDM's
# banner. tide's installer is tested in tide (install/tide-setup_*test).
#
# The harness, its fixtures and mocks are in setup-tide_testlib.

# shellcheck source=setup-tide_testlib
. "$(dirname "$0")/setup-tide_testlib"

set -e

setup; ARGS=(); run
check "exits 0" test "$status" -eq 0
check "clones tide when it isn't there, quietly" has "$calls" "git clone --quiet https://example.com/tide.git $T/src/tide"
check "runs tide's installer" has "$calls" "tide-setup "
check "which says to rerun setup, and puts setup-tide on setup's list" \
    has "$calls" "tide-setup env: SETUP_COMMAND=setup SETUP_APT_RETRY_NAME=setup-tide"
check "and adds to this run's problems" lacks "$calls" "no SETUP_PROBLEMS"
teardown

# Without TIDE_REPO, it clones mikelward/tide.
setup; ARGS=(); DEFAULT_REPO=1 run
check "clones mikelward/tide by default" has "$calls" "git clone --quiet https://github.com/mikelward/tide.git $T/src/tide"
teardown

# --help shows what this adds and the installer's own help, and changes
# nothing: no fetch, no launcher entries, no lid drop-ins or GDM.
setup; checkout; : > "$T/logind/10-hypr-lid.conf"; ARGS=(--help); run
check "--help exits 0" test "$status" -eq 0
check "--help says what setup-tide adds" has "$output" "Usage: setup-tide"
check "--help shows the installer's options" has "$calls" "tide-setup --help"
check "--help fetches nothing" lacks "$calls" "git "
check "--help leaves the lid drop-ins" test -e "$T/logind/10-hypr-lid.conf"
check "--help runs no sudo" lacks "$calls" "sudo "
check "--help writes no launcher entries" test ! -d "$T/home/.local/share/applications"
teardown
setup; ARGS=(-h); run
check "-h without a checkout still exits 0" test "$status" -eq 0
check "and says how to get the installer" has "$output" "No installer at $T/src/tide/install/tide-setup yet"
check "and clones nothing" lacks "$calls" "git clone"
teardown

# Every option but --fetch and --no-fetch is the installer's.
setup; checkout; ARGS=(--no-fetch --greeter --tidewm --dm=gdm --github https://ghe.example.com -v); run
check "passes on tide-setup's options, not --no-fetch" has "$calls" "tide-setup --greeter --tidewm --dm=gdm --github https://ghe.example.com -v"
check "and the mirror" has "$calls" "GITHUB_PREFIX=https://ghe.example.com"
teardown

# The installer's warnings are repeated once, at the end, with this one's.
setup; checkout; ARGS=(--no-fetch); run FAKE_TIDE_SETUP_WARNS="a tide warning"
check "repeats the installer's warnings at the end" \
    has "$(printf '%s\n' "$output" | tail -n 3)" "setup-tide: the warnings and errors from this run, again:
  Warning: a tide warning"
check "then says, last, that it finished with a warning" \
    test "$(printf '%s\n' "$output" | tail -n 1)" = "setup-tide finished, with 1 warning; see above"
teardown

# A failed install still gets the extras, and fails the run.
setup; checkout; ARGS=(--no-fetch); run FAKE_TIDE_SETUP_EXIT=3
check "a failed install fails the run with its status" test "$status" -eq 3
check "and still lists the app scripts" test -d "$T/home/.local/share/applications"
teardown

# An old checkout, from before tide had its installer.
setup; mkdir -p "$T/src/tide/.git"; ARGS=(--no-fetch); run
check "a checkout without the installer fails" test "$status" -ne 0
check "and says to update it" has "$output" "has no installer (install/tide-setup); update it"
teardown

setup; checkout; ARGS=(); run
check "updates an existing checkout, quietly" has "$calls" "git -C $T/src/tide pull --quiet --ff-only"
check "doesn't clone over it" lacks "$calls" "git clone"
teardown

setup; checkout; ARGS=(); run FAKE_PULL_FAILS=1
check "a failed pull still installs" test "$status" -eq 0
check "a failed pull says why" has "$output" "Warning: couldn't update $T/src/tide: can't reach origin; installing it as it is"
check "a failed pull installs the existing checkout" has "$calls" "tide-setup"
teardown

setup; ARGS=(); run TIDE_REPO="https://user:hunter2@example.com/tide.git"
check "the clone message doesn't print the URL" lacks "$output" "hunter2"
teardown

setup; checkout; ARGS=(--no-fetch); run
check "--no-fetch neither pulls nor clones" lacks "$calls" "git "
check "--no-fetch installs the checkout" has "$calls" "tide-setup"
teardown

setup; ARGS=(--no-fetch); run
check "--no-fetch without a checkout fails" test "$status" -ne 0
check "--no-fetch without a checkout says so" has "$output" "no tide checkout"
teardown

setup; : > "$T/logind/10-hypr-lid.conf"; : > "$T/logind/10-sway-lid.conf"; : > "$T/logind/50-mine.conf"
ARGS=(); run
check "removes the old hypr lid drop-in" test ! -e "$T/logind/10-hypr-lid.conf"
check "removes the old sway lid drop-in" test ! -e "$T/logind/10-sway-lid.conf"
check "leaves other drop-ins alone" test -e "$T/logind/50-mine.conf"
check "reloads logind after removing one" has "$calls" "systemctl kill -s HUP systemd-logind"
teardown

setup; ARGS=(); run
check "no old drop-in, no logind reload" lacks "$calls" "systemd-logind"
teardown
setup; : > "$T/logind/10-hypr-lid.conf"; ARGS=(--no-sudo); run
check "--no-sudo runs no sudo" lacks "$calls" "sudo "
check "--no-sudo leaves the drop-in" test -e "$T/logind/10-hypr-lid.conf"
teardown

# GDM shows the short hostname, through the gdm dconf database.
host=$(uname -n | cut -d. -f1)
setup; ARGS=(); : > "$T/gdm-defaults"; run SETUP_GDM_DEFAULTS="$T/gdm-defaults"
check "GDM: writes the hostname banner" \
    test "$(cat "$T/dconf/db/gdm.d/50-tide-hostname")" = "$(printf "[org/gnome/login-screen]\nbanner-message-enable=true\nbanner-message-text='%s'" "$host")"
check "GDM: writes a profile that reads the gdm database" \
    test "$(cat "$T/dconf/profile/gdm")" = "$(printf 'user-db:user\nsystem-db:gdm\nfile-db:%s' "$T/gdm-defaults")"
check "GDM: compiles the database" has "$calls" "sudo dconf update"
: > "$CALLS"; run SETUP_GDM_DEFAULTS="$T/gdm-defaults"
check "GDM: an unchanged banner isn't rewritten" lacks "$calls" "dconf"
teardown

setup; ARGS=(); : > "$T/gdm-defaults"; printf 'user-db:user\nsystem-db:gdm\n' > "$T/share-profile"
run SETUP_GDM_DEFAULTS="$T/gdm-defaults" SETUP_DCONF_SHARE_PROFILE="$T/share-profile"
check "GDM: a shipped profile that reads the gdm database is used" test ! -e "$T/dconf/profile/gdm"
check "GDM: the banner is still written" test -e "$T/dconf/db/gdm.d/50-tide-hostname"
teardown

setup; ARGS=(); : > "$T/gdm-defaults"; mkdir -p "$T/dconf/profile"; printf 'user-db:user\n' > "$T/dconf/profile/gdm"
run SETUP_GDM_DEFAULTS="$T/gdm-defaults"
check "GDM: a profile without the gdm database is left alone" test "$(cat "$T/dconf/profile/gdm")" = "user-db:user"
check "GDM: and named" has "$output" "doesn't read the gdm dconf database"
check "GDM: and no banner is written" test ! -e "$T/dconf/db/gdm.d/50-tide-hostname"
teardown

# The /etc profile overrides a shipped one that reads the gdm database.
setup; ARGS=(); : > "$T/gdm-defaults"; mkdir -p "$T/dconf/profile"; printf 'user-db:user\n' > "$T/dconf/profile/gdm"
printf 'user-db:user\nsystem-db:gdm\n' > "$T/share-profile"
run SETUP_GDM_DEFAULTS="$T/gdm-defaults" SETUP_DCONF_SHARE_PROFILE="$T/share-profile"
check "GDM: an overriding /etc profile without the gdm database is named" has "$output" "doesn't read the gdm dconf database"
check "GDM: even when the shipped profile reads it" test ! -e "$T/dconf/db/gdm.d/50-tide-hostname"
teardown

# A failed temporary write installs nothing. mktemp hands back a directory,
# which even root can't write as a file; a problems file of setup's keeps
# the run's own off mktemp.
setup; ARGS=(); : > "$T/gdm-defaults"; mkdir "$T/not-a-file"
cat > "$T/bin/mktemp" <<MOCK
#!/bin/sh
echo "$T/not-a-file"
MOCK
chmod +x "$T/bin/mktemp"
: > "$T/problems"
run SETUP_GDM_DEFAULTS="$T/gdm-defaults" SETUP_PROBLEMS="$T/problems"
check "GDM: a failed temporary write installs no profile" test ! -e "$T/dconf/profile/gdm"
check "GDM: and says so" has "$output" "couldn't write a temporary copy of $T/dconf/profile/gdm"
teardown

setup; ARGS=(); run
check "no GDM, no banner" test ! -e "$T/dconf/db/gdm.d/50-tide-hostname"
teardown

setup; ARGS=(--no-sudo); : > "$T/gdm-defaults"; run SETUP_GDM_DEFAULTS="$T/gdm-defaults"
check "--no-sudo leaves GDM alone" test ! -e "$T/dconf/db/gdm.d/50-tide-hostname"
teardown

# --- Launcher entries for the app scripts ---

# An app script, as scripts' own: a web app opens its site with chrome.
app_script() {
    mkdir -p "$T/scripts"
    printf '#!/bin/bash\n%s\n' "$2" > "$T/scripts/$1"
    chmod +x "$T/scripts/$1"
}
entry() { cat "$T/home/.local/share/applications/scripts-$1.desktop"; }
apps_dir="home/.local/share/applications"

setup; app_script gmail 'chrome --app="https://mail.google.com"'; app_script notepad 'scite "$@"'
app_script args 'printf "%s\n" "$@"'
ARGS=(); run
check "launcher: exits 0" test "$status" -eq 0
check "launcher: lists gmail by its name" has "$(entry gmail)" "Name=Gmail"
check "launcher: runs the script itself, quoted" has "$(entry gmail)" "Exec=\"$T/scripts/gmail\""
check "launcher: hides the entry if the script goes" has "$(entry gmail)" "TryExec=$T/scripts/gmail"
check "launcher: is an application" has "$(entry gmail)" "Type=Application"
check "launcher: a web app's window class is Chrome's for its site" \
    has "$(entry gmail)" "StartupWMClass=chrome-mail.google.com__-Default"
check "launcher: a web app gets its site's icon" \
    has "$(entry gmail)" "Icon=$T/home/.local/share/icons/scripts/gmail.png"
check "launcher: the site icon is kept" test -s "$T/home/.local/share/icons/scripts/gmail.png"
check "launcher: fetches the icon by the site's host alone" \
    has "$calls" "https://www.google.com/s2/favicons?sz=128&domain=mail.google.com"
check "launcher: another app gets its theme icon" has "$(entry notepad)" "Icon=text-x-generic"
check "launcher: another app names no window class" lacks "$(entry notepad)" "StartupWMClass"
check "launcher: a command-line tool gets no entry" test ! -e "$T/$apps_dir/scripts-args.desktop"
check "launcher: a listed script that isn't here gets no entry" test ! -e "$T/$apps_dir/scripts-irc.desktop"
check "launcher: says how many it listed only with --verbose" lacks "$output" "app scripts in the launcher"
# A rerun reuses the icon rather than fetching it again.
: > "$CALLS"; run
check "launcher: a rerun fetches no icon it has" lacks "$calls" "curl"
check "launcher: a rerun still uses it" has "$(entry gmail)" "Icon=$T/home/.local/share/icons/scripts/gmail.png"
teardown

# A fork in ~/scripts.local runs instead, as it does on PATH, and its own
# --app URL names the window class. A file there that can't run doesn't
# count, and once the fork goes, a rerun points back at ~/scripts.
setup; app_script gmail 'chrome --app="https://mail.google.com"'; app_script notepad 'scite "$@"'
mkdir -p "$T/home/scripts.local"
printf '#!/bin/bash\nbrowser2 --app="https://mail.example.com"\n' > "$T/home/scripts.local/gmail"
chmod +x "$T/home/scripts.local/gmail"
printf '#!/bin/sh\n' > "$T/home/scripts.local/notepad"
ARGS=(); run
check "launcher: runs a scripts.local fork" has "$(entry gmail)" "Exec=\"$T/home/scripts.local/gmail\""
check "launcher: hides it if the fork goes" has "$(entry gmail)" "TryExec=$T/home/scripts.local/gmail"
check "launcher: a fork's class is its own site's" has "$(entry gmail)" "StartupWMClass=chrome-mail.example.com__-Default"
check "launcher: a fork that can't run isn't used" has "$(entry notepad)" "Exec=\"$T/scripts/notepad\""
rm "$T/home/scripts.local/gmail"; run
check "launcher: without the fork, runs the script here again" has "$(entry gmail)" "Exec=\"$T/scripts/gmail\""
check "launcher: and its class is this one's" has "$(entry gmail)" "StartupWMClass=chrome-mail.google.com__-Default"
teardown

# A path past the host goes into the class, each / a _.
setup; app_script discord 'chrome --app="https://discord.com/app"'; ARGS=(); run
check "launcher: a site's path is in its class" has "$(entry discord)" "StartupWMClass=chrome-discord.com__app-Default"
teardown

# A failed fetch falls back to the theme icon, warns, and isn't fatal.
setup; app_script gmail 'chrome --app="https://mail.google.com"'; ARGS=(); run FAKE_CURL_FAILS=1
check "launcher: a failed icon fetch isn't fatal" test "$status" -eq 0
check "launcher: a failed icon fetch uses the theme icon" has "$(entry gmail)" "Icon=mail-unread-symbolic"
check "launcher: a failed icon fetch says so" has "$output" "couldn't fetch gmail's site icon"
check "launcher: a failed icon fetch leaves no file" test ! -e "$T/home/.local/share/icons/scripts/gmail.png"
teardown

# Something other than a PNG (an error page) isn't kept as the icon.
setup; app_script gmail 'chrome --app="https://mail.google.com"'; ARGS=(); run FAKE_CURL_NOT_PNG=1
check "launcher: a page that isn't a PNG uses the theme icon" has "$(entry gmail)" "Icon=mail-unread-symbolic"
check "launcher: and isn't kept" test -z "$(ls -A "$T/home/.local/share/icons/scripts")"
teardown

# --no-fetch is about the tide checkout, and setup always passes it, so
# the icons are still fetched.
setup; app_script gmail 'chrome --app="https://mail.google.com"'; ARGS=(--no-fetch); checkout; run
check "launcher: --no-fetch still fetches the site icon" has "$calls" "curl"
check "launcher: --no-fetch uses it" has "$(entry gmail)" "Icon=$T/home/.local/share/icons/scripts/gmail.png"
teardown

# An entry for a script no longer listed, or gone, is removed; others' stay.
setup; app_script gmail 'chrome --app="https://mail.google.com"'
mkdir -p "$T/$apps_dir"
printf '[Desktop Entry]\n' > "$T/$apps_dir/scripts-hangouts.desktop"
printf '[Desktop Entry]\n' > "$T/$apps_dir/shortcut-browser1.desktop"
printf '[Desktop Entry]\n' > "$T/$apps_dir/firefox.desktop"
ARGS=(); run
check "launcher: removes an entry for a script it no longer lists" test ! -e "$T/$apps_dir/scripts-hangouts.desktop"
check "launcher: keeps setup-kde's shortcut entries" test -e "$T/$apps_dir/shortcut-browser1.desktop"
check "launcher: keeps other apps' entries" test -e "$T/$apps_dir/firefox.desktop"
check "launcher: keeps its own" test -e "$T/$apps_dir/scripts-gmail.desktop"
teardown

# A path Exec can't quote is skipped, with a warning.
setup; mkdir -p "$T/odd\$dir"; printf '#!/bin/sh\n' > "$T/odd\$dir/notepad"; chmod +x "$T/odd\$dir/notepad"
ARGS=(); run SETUP_SCRIPTS_DIR="$T/odd\$dir"
check "launcher: a path with \$ is skipped" test ! -e "$T/$apps_dir/scripts-notepad.desktop"
check "launcher: and named" has "$output" "can't quote, so the launcher won't list notepad"
teardown

# Every listed script is in this repo, and every web app's URL is found.
setup; ARGS=(); run SETUP_SCRIPTS_DIR="$SCRIPT_DIR"
listed=$(grep -v '^#' "$SCRIPT_DIR/launcher-scripts" | cut -d'|' -f1)
missing=
for s in $listed; do
    test -e "$T/$apps_dir/scripts-$s.desktop" || missing="$missing $s"
done
check "launcher: every listed script exists here (missing:$missing)" test -z "$missing"
for s in gmail google-calendar google-chat google-meet youtube-music discord remote-desktop; do
    check "launcher: $s is a web app" has "$(entry "$s")" "StartupWMClass=chrome-"
done
check "launcher: YouTube Music's class" has "$(entry youtube-music)" "StartupWMClass=chrome-music.youtube.com__-Default"
teardown

# The list is launcher-scripts: comments and blank lines are skipped, a
# missing list is named, and every line has its four fields.
setup; mkdir -p "$T/list"; printf '#!/bin/sh\n' > "$T/list/notepad"; chmod +x "$T/list/notepad"
printf '# a comment|Nope|x|-\n\nnotepad|My notes|text-x-generic|com.apple.TextEdit\n' > "$T/list/launcher-scripts"
ARGS=(); run SETUP_SCRIPTS_DIR="$T/list" SETUP_LAUNCHER_SCRIPTS="$T/list/launcher-scripts"
check "launcher: the list's name" has "$(entry notepad)" "Name=My notes"
check "launcher: the list's icon, not the macOS field" has "$(entry notepad)" "Icon=text-x-generic"
check "launcher: a comment isn't a script" test ! -e "$T/$apps_dir/scripts-# a comment.desktop"
teardown
setup; ARGS=(); run SETUP_LAUNCHER_SCRIPTS="$T/no-such-list"
check "launcher: a missing list is named" has "$output" "can't read $T/no-such-list, so the launcher won't list the app scripts"
check "launcher: and setup goes on" test "$status" -eq 0
teardown
bad=$(grep -v '^#' "$SCRIPT_DIR/launcher-scripts" | awk -F'|' 'NF != 4 || $2 == "" || $3 == "" || $4 == "" { print NR": "$0 }')
check "launcher: every line of launcher-scripts has SCRIPT|NAME|ICON|MAC ($bad)" test -z "$bad"

# --github, or setup's mirror in $GITHUB_PREFIX, stands in for GitHub in
# the tide clone too.
unset GIT_CONFIG_COUNT
rule_for() { printf 'git config: url.%s.insteadOf=https://github.com/' "$1"; }
# A checkout cloned through the mirror names GitHub as its origin, so a
# rerun's pull goes through the mirror too.
setup; checkout; ARGS=(--github https://ghe.example.com); run
check "mirror: a rerun pulls tide through the mirror" has "$calls" "git -C $T/src/tide pull --quiet --ff-only
$(rule_for https://ghe.example.com/)"
teardown

finish
