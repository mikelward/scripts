setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_MOVED_PIN=hyprutils
check "a moved pin is named" has "$output" "hyprutils's v0.14.2 tag is commit 0000000000000000000000000000000000000000, not the pinned "
check "a moved pin is fatal" test "$status" -ne 0
check "a moved pin runs no build" lacks "$calls" "cmake -S $T/src/hyprland-build/hyprutils "
check "a moved pin stops the build" lacks "$calls" "cmake -S $T/src/hyprland-build/Hyprland "
check "a moved pin's clone is removed" test ! -e "$T/src/hyprland-build/hyprutils"
check "a moved pin isn't stamped built" test ! -e "$(inst)/.built-hyprutils"
