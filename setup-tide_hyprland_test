teardown

# A failed step stops the build before anything is linked or recorded.
setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_CMAKE_FAILS=hyprlang
check "a failed build step is reported" has "$output" "building Hyprland failed; the sources are in $T/src/hyprland-build"
check "a failed build is fatal" test "$status" -ne 0
check "a failed build doesn't claim success" lacks "$output" "tide installed"
check "a failed build stops before Hyprland" lacks "$calls" "cmake -S $T/src/hyprland-build/Hyprland"
check "a failed build isn't marked complete" test ! -e "$(inst)/quickspace-pins"
check "a failed build says a rerun resumes" has "$output" "a rerun resumes from the step that failed"
check "a failed build links nothing" test ! -e "$T/usr-local-bin/Hyprland"
ARGS=(--ignore-errors); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_CMAKE_FAILS=hyprlang
check "--ignore-errors carries on past a failed build" has "$output" "tide installed"
teardown

