#!/bin/sh
# Install the tide session (github.com/mikelward/tide) beside KDE.
#
# `setup --tide` runs this after setup-kde, so KDE Plasma stays the
# fallback session. It:
#
# - installs the session's packages: Hyprland, hypridle, uwsm, the Hyprland
#   and GTK portals, Go (to build tide-grant), and, until the
#   Quickshell shell lands, the transitional owners (waybar, swaync) and the
#   tools conf's Hyprland config calls. A package the distro doesn't have
#   (swww on Ubuntu 26.04) is reported and the rest still install;
# - installs Quickshell, which draws tide's own shell (the bar so far),
#   where the distro packages it: apt and pacman, and on Fedora the
#   errornointernet/quickshell COPR. Where apt has none (Ubuntu 26.04), or
#   only one older than tide's shell needs (Debian's 0.2.1), it builds a
#   pinned release from source into /opt/quickshell (see
#   build_quickshell). Without it the bar can't run, and waybar stays the
#   bar;
# - on Debian and Ubuntu, where apt's Hyprland is older than the 0.56 the
#   Lua config needs, builds Hyprland and the hyprwm libraries it needs from
#   source, at pinned tags, into /opt/hyprland (see build_hyprland). Both
#   builds are outside $HOME because the greeter runs them too, as greetd's
#   own user, which can't read a home directory;
# - clones or updates the tide repo, runs its `make install` (the
#   layout, the focus guard, the user units, the portal config) and, with
#   sudo, `make install-session PREFIX=/usr` (the display manager's session
#   entry, its compositor wrapper, and the tide commands);
# - enables tide.service, which hangs it off the tide session's
#   target only, and masks the distro's waybar and swaync user units, which
#   would otherwise start in every session, Plasma's included;
# - installs greetd and makes it the display manager, from the next boot,
#   with tide's greeter as its default session (see setup_greeter). It
#   checks first that the greeter can run, notes the display manager it
#   replaces, and --no-greeter puts that one back. Plasma stays a session
#   at the new greeter, and logging in unlocks gnome-keyring, as GDM does;
# - on a GDM machine, puts the short hostname on GDM's login screen, as
#   hyprlock shows it on the lock screen, for as long as GDM is the way
#   back;
# - removes the logind lid drop-ins the retired setup-hypr/setup-sway
#   installed. They set HandleLidSwitch=ignore, and tide leaves suspend
#   to logind's defaults, so with one left in place an undocked lid close
#   would never suspend.
#
# The dotfiles (conf's config/hypr and friends) come from confinst, which
# setup runs first.
#
# Usage:
#     setup-tide [--no-install] [--no-sudo] [--ignore-errors] [--no-fetch]
#                      [--no-build-hyprland] [--no-greeter] [-h | --help]
#
# --no-install skips the packages and the root `make install-session`.
# --no-sudo skips every privileged step. --ignore-errors keeps going past
# failures. setup forwards all three. --no-fetch uses $TIDE_DIR as it
# is: setup passes it after cloning or pulling the repo with its own
# clone_or_pull, which honors --github and redacts the URLs it prints.
# --no-build-hyprland leaves Hyprland to the distro even when it's too old.
# --no-greeter leaves the display manager alone, or puts back the one setup
# replaced with greetd.

INSTALL=yes
SUDO=yes
IGNORE_ERRORS=no
FETCH=yes
BUILD_HYPRLAND=yes
GREETER=yes

# Overridable for tests, which can't touch the real /etc or clone.
LOGIND_DIR="${SETUP_LOGIND_DIR:-/etc/systemd/logind.conf.d}"
# GDM's greeter defaults (present when GDM is installed), the dconf system
# config, and the gdm dconf profile Debian ships outside /etc.
GDM_DEFAULTS="${SETUP_GDM_DEFAULTS:-/usr/share/gdm/greeter-dconf-defaults}"
DCONF_DIR="${SETUP_DCONF_DIR:-/etc/dconf}"
DCONF_SHARE_PROFILE="${SETUP_DCONF_SHARE_PROFILE:-/usr/share/dconf/profile/gdm}"
# Where packages install D-Bus activation files and systemd user units.
DBUS_SERVICE_DIRS="${SETUP_DBUS_SERVICE_DIRS:-/usr/share/dbus-1/services /usr/local/share/dbus-1/services}"
USER_UNIT_DIRS="${SETUP_USER_UNIT_DIRS:-/usr/lib/systemd/user /lib/systemd/user /usr/local/lib/systemd/user}"
TIDE_REPO="${TIDE_REPO:-https://github.com/mikelward/tide.git}"
TIDE_DIR="${TIDE_DIR:-$HOME/src/tide}"
# Fedora packages Quickshell only in this COPR, which Quickshell's own
# BUILD.md names as a packager.
QUICKSHELL_COPR=errornointernet/quickshell
# Hyprland reads only hyprland.lua from 0.56 on.
MIN_HYPRLAND=0.56

# The Quickshell release build_quickshell builds where apt has none, from
# the GitHub mirror tide's SPEC.md cites. Its own prefix, like
# Hyprland's, with qs linked onto PATH. Earlier versions built into the
# legacy prefix, whose links and builds are still setup's own. Overridable
# for tests.
QUICKSHELL_REPO=https://github.com/quickshell-mirror/quickshell.git
QUICKSHELL_TAG=v0.3.1
# The commit that tag named when it was pinned. A tag can be moved, so the
# clone must check out exactly this before its build files are run.
QUICKSHELL_COMMIT=1a4716cde794a59928d9d9fc15f2afc7a95de360
QUICKSHELL_PREFIX="${QUICKSHELL_PREFIX:-/opt/quickshell}"
LEGACY_QUICKSHELL_PREFIX="${LEGACY_QUICKSHELL_PREFIX:-$HOME/.local/opt/quickshell}"
QUICKSHELL_SRC="${QUICKSHELL_SRC:-$HOME/src/quickshell-build}"
QUICKSHELL_BIN_DIR="${QUICKSHELL_BIN_DIR:-/usr/local/bin}"
QUICKSHELL_COMMANDS="qs quickshell"
# Ubuntu has no cpptrace, so the crash handler is left out; systemd
# restarts the shell instead.
QUICKSHELL_CMAKE_FLAGS="-DCMAKE_BUILD_TYPE=Release -DCRASH_HANDLER=OFF"
# The oldest Quickshell tide's shell loads in: 0.3.0 added IdleInhibitor,
# IdleMonitor and Quickshell.Networking, and an older qs can't load a file
# that names one. tide's tide-shell and tide doctor check the same. All
# three parts, so a 0.3.0 pre-release (0.3.0~rc1) is older.
MIN_QUICKSHELL=0.3.0
# Quickshell's CMakeLists.txt requires at least this Qt.
MIN_QUICKSHELL_QT=6.6
# The Qt packages whose private API Quickshell builds against. Each is
# packaged and upgraded on its own, so a new version of any of them means a
# rebuild.
QUICKSHELL_QT_PRIVATE="qt6-base-private-dev qt6-declarative-private-dev qt6-wayland-private-dev"
# What the build needs from apt, named as on Ubuntu 26.04, from Quickshell's
# BUILD.md, plus the QML modules tide's shell imports at run time.
# Ubuntu has no cpptrace, so the build leaves out Quickshell's crash
# handler; systemd restarts the shell instead.
QUICKSHELL_BUILD_DEPS="build-essential cmake ninja-build pkg-config git
    qt6-base-dev qt6-base-private-dev qt6-declarative-dev qt6-declarative-private-dev
    qt6-wayland-dev qt6-wayland-private-dev qt6-shadertools-dev spirv-tools
    libcli11-dev libjemalloc-dev libdrm-dev libgbm-dev libegl-dev libgles-dev libvulkan-dev
    libwayland-dev libwayland-bin wayland-protocols libxcb1-dev
    libpipewire-0.3-dev libpam0g-dev libpolkit-agent-1-dev libpolkit-gobject-1-dev libglib2.0-dev
    qt6-svg-plugins qml6-module-qtquick qml6-module-qtquick-layouts qml6-module-qtquick-effects"

# Where build_hyprland builds and installs Hyprland, and where it links its
# commands. Its own prefix keeps its libraries out of the system's library
# path: the distro's hypridle and portal link the distro's older hyprutils
# and hyprlang, and would break on ours. It's outside $HOME, which greetd's
# greeter user can't read, and owned by root: a build is made as this user,
# in a directory of its own, and handed to root once it's complete (see
# make_build_dir and seal_build), so the greeter, which reads every
# password typed at login, runs nothing this user can still change.
# Earlier versions built into the legacy prefix. Overridable for tests.
HYPRLAND_PREFIX="${HYPRLAND_PREFIX:-/opt/hyprland}"
LEGACY_HYPRLAND_PREFIX="${LEGACY_HYPRLAND_PREFIX:-$HOME/.local/opt/hyprland}"
HYPRLAND_SRC="${HYPRLAND_SRC:-$HOME/src/hyprland-build}"
HYPRLAND_BIN_DIR="${HYPRLAND_BIN_DIR:-/usr/local/bin}"

# What build_hyprland builds, in order: name, repository, tag, the commit
# that tag named when it was pinned, build system. A tag can be moved, so
# each clone must check out exactly that commit before its build files run.
# Each tag meets the next one's minimums (Hyprland v0.56.2's CMakeLists.txt
# names them); wayland-protocols is here because Ubuntu 26.04 has 1.47 and
# Hyprland needs 1.49.
HYPRLAND_PINS="
wayland-protocols https://gitlab.freedesktop.org/wayland/wayland-protocols.git 1.49 ee78491a237eaff9389a0ccf8680521d074407d3 meson
hyprwayland-scanner https://github.com/hyprwm/hyprwayland-scanner.git v0.4.6 b8632713a6beaf28b56f2a7b0ab2fb7088dbb404 cmake
hyprutils https://github.com/hyprwm/hyprutils.git v0.14.2 a21e87b878e72ee5dfd375899e8b2ad0d0c4c0e1 cmake
hyprwire https://github.com/hyprwm/hyprwire.git v0.3.1 3e6865ce5fd9237b58f5b2ce5de18814df3baff5 cmake
hyprlang https://github.com/hyprwm/hyprlang.git v0.6.8 3a1c1b25b059dae2c6bbc46991562ba1158d125c cmake
hyprcursor https://github.com/hyprwm/hyprcursor.git v0.1.13 44e91d467bdad8dcf8bbd2ac7cf49972540980a5 cmake
hyprgraphics https://github.com/hyprwm/hyprgraphics.git v0.5.1 482d4b7ec36ffdaf3573086aa586b178fd5404be cmake
aquamarine https://github.com/hyprwm/aquamarine.git v0.15.1 f31c47a1b9d300847d8fc3108ad959448103dfc1 cmake
Hyprland https://github.com/hyprwm/Hyprland.git v0.56.2 efb50993780079460b0cbed1363e2166a2de1d9f cmake
"
# The GCC every pin builds with. Hyprland 0.56 uses std::ranges::starts_with,
# which libstdc++ first has in GCC 16; Ubuntu 26.04's default g++ is 15, but
# it packages g++-16, and its libstdc++6 runtime is already 16's.
HYPRLAND_GCC=16

# What the build needs from apt, named as on Ubuntu 26.04.
HYPRLAND_BUILD_DEPS="build-essential gcc-$HYPRLAND_GCC g++-$HYPRLAND_GCC cmake meson ninja-build pkg-config git python3
    libwayland-dev libwayland-bin libpugixml-dev libpixman-1-dev libzip-dev
    libcairo2-dev librsvg2-dev libtomlplusplus-dev libdrm-dev libpango1.0-dev
    libjpeg-dev libwebp-dev libmagic-dev libpng-dev libjxl-dev libheif-dev
    libgles-dev libegl-dev libgbm-dev libseat-dev libinput-dev libudev-dev
    libdisplay-info-dev hwdata libxkbcommon-dev uuid-dev libxcursor-dev libeis-dev
    libglib2.0-dev libre2-dev libmuparser-dev liblcms2-dev liblua5.5-dev
    glslang-dev glslang-tools libudis86-dev libffi-dev libreadline-dev
    libxcb1-dev libxcb-render0-dev libxcb-xfixes0-dev libxcb-icccm4-dev libxcb-composite0-dev libxcb-res0-dev libxcb-errors-dev
    xwayland"
# greetd's config directory, and tide's greetd config template, which
# `make install-session PREFIX=/usr` installs. Overridable for tests.
GREETD_DIR="${SETUP_GREETD_DIR:-/etc/greetd}"
GREETD_TEMPLATE="${SETUP_GREETD_TEMPLATE:-/usr/share/tide/greeter/greetd.toml}"
# The greeter's PATH: greetd sources /etc/profile, which sets this for every
# user but root.
GREETER_PATH="${SETUP_GREETER_PATH:-/usr/local/bin:/usr/bin:/bin}"
# The PATH a program systemd or pam_exec runs as root finds a command on,
# or more: systemd's own for a service, and the one pam_env sets on Debian,
# where it sets one.
SERVICE_PATH="${SETUP_SERVICE_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"
# What the greeter runs from that PATH: tide-greeter, the Hyprland it
# starts, the hyprctl that ends that Hyprland, and the qs it shows.
GREETER_COMMANDS="tide-greeter Hyprland hyprctl qs"
# Where the package manager's /bin, /sbin, /usr/bin and /usr/sbin are, whose
# commands load only what it installs. Overridable for tests, which still
# count /'s own as the package manager's, since what a script's #! names
# is there.
SYSTEM_ROOT="${SETUP_SYSTEM_ROOT:-}"
# greetd's own default name for its user, Debian's, and a plain greetd, for
# when greetd's config names none that exists.
GREETER_USERS="greeter _greetd greetd"
# Where UID_MIN, the first UID for a person's account, is set.
LOGIN_DEFS="${SETUP_LOGIN_DEFS:-/etc/login.defs}"
# The home setup gives greetd's user when it has none of its own to write,
# where the greeter remembers the last login.
GREETER_HOME="${SETUP_GREETER_HOME:-/var/lib/tide-greeter}"
# PAM's config, where greetd's stack is.
PAM_DIR="${SETUP_PAM_DIR:-/etc/pam.d}"
# Where PAM looks for a file PAM_DIR hasn't got: the vendor's.
PAM_VENDOR_DIR="${SETUP_PAM_VENDOR_DIR:-$SYSTEM_ROOT/usr/lib/pam.d}"
# Whether PAM reads @include lines, which Debian's patch adds. Another
# distro's takes one for a line of a type it doesn't know, which fails.
PAM_AT_INCLUDE="${SETUP_PAM_AT_INCLUDE:-}"
if test -z "$PAM_AT_INCLUDE"; then
    if test -f /etc/debian_version; then
        PAM_AT_INCLUDE=yes
    else
        PAM_AT_INCLUDE=no
    fi
fi
# Where setup notes the display manager greetd replaced, for --no-greeter.
STATE_DIR="${SETUP_STATE_DIR:-/var/lib/setup-tide}"
PREVIOUS_DM_FILE="$STATE_DIR/previous-display-manager"

# tide's make install builds tide-grant with this Go, which
# must be at least MIN_GO (its go.mod). setup installs Go for everything
# that needs it, vcs too; this installs it again for a run on its own.
# Overridable for tests.
GO="${GO:-go}"
MIN_GO=1.22

info() {
    printf "%s\n" "$*"
}

warn() {
    printf "Warning: %s\n" "$*" >&2
}

error() {
    printf "Error: %s\n" "$*" >&2
    exit 1
}

is_command() {
    test -x "$(command -v "$1")"
}

# Run one privileged command without letting a sudo failure abort the helper
# under set -e. Mirrors setup's sudo_or_warn: on a box where sudo is allowed
# for package installs but denied for other commands, a denied lid/service
# step warns and the helper keeps going instead of exiting. The proactive
# --no-sudo skip is handled by the caller's SUDO guard below, so this wrapper
# only needs the reactive path -- but it still honours SUDO=no defensively.
sudo_or_warn() {
    _sudo_name=${1##*/}
    if test "$SUDO" = no; then
        warn "skipping 'sudo $_sudo_name' (--no-sudo)"
        return 1
    fi
    _sudo_stderr=$(mktemp) || {
        warn "sudo $_sudo_name: could not create a temporary error log"
        return 1
    }

    if sudo "$@" 2>"$_sudo_stderr"; then
        cat "$_sudo_stderr" >&2
        rm -f "$_sudo_stderr"
        return 0
    else
        _sudo_status=$?
    fi
    _sudo_detail=$(awk 'NF { line = $0 } END { print line }' "$_sudo_stderr")
    rm -f "$_sudo_stderr"

    case "$_sudo_status" in
        126) _sudo_detail="permission denied" ;;
        127) _sudo_detail="command not found" ;;
        *)
            case "$_sudo_detail" in
                "sudo: $_sudo_name: "*) _sudo_detail=${_sudo_detail#"sudo: $_sudo_name: "} ;;
                "sudo: "*) _sudo_detail=${_sudo_detail#"sudo: "} ;;
                "$_sudo_name: "*) _sudo_detail=${_sudo_detail#"$_sudo_name: "} ;;
            esac
            if test -z "$_sudo_detail"; then
                _sudo_detail="failed (exit status $_sudo_status)"
            fi
            ;;
    esac
    warn "sudo $_sudo_name: $_sudo_detail"
    return "$_sudo_status"
}

usage() {
    cat <<'USAGE'
Usage: setup-tide [--no-install] [--no-sudo] [--ignore-errors]
                  [--no-build-hyprland] [--no-greeter] [-h | --help]

Install the tide session (Hyprland + uwsm) beside KDE Plasma.

Options:
  --no-install     Skip the packages and the system-wide session install
  --no-sudo        Skip every privileged step (packages, the session entry,
                   removing the old lid drop-ins)
  --ignore-errors  Keep going past failures instead of aborting on the first
  --no-build-hyprland
                   On Debian and Ubuntu, don't build Hyprland from source when
                   apt's is older than 0.56 (the build takes 10-20 minutes)
  --no-greeter     Don't make greetd, with tide's greeter, the display
                   manager; if setup made it one, put back the display
                   manager it replaced
  -h, --help       Show this help and exit
USAGE
}

while test $# -gt 0; do
    case "$1" in
        --install) INSTALL=yes ;;
        --no-install) INSTALL=no ;;
        --sudo) SUDO=yes ;;
        --no-sudo) SUDO=no ;;
        --ignore-errors) IGNORE_ERRORS=yes ;;
        --fetch) FETCH=yes ;;
        --no-fetch) FETCH=no ;;
        --build-hyprland) BUILD_HYPRLAND=yes ;;
        --no-build-hyprland) BUILD_HYPRLAND=no ;;
        --greeter) GREETER=yes ;;
        --no-greeter) GREETER=no ;;
        -h|--help) usage; exit 0 ;;
        *)
            warn "Unknown option: $1"
            usage >&2
            exit 1
            ;;
    esac
    shift
done

if test "$IGNORE_ERRORS" = no; then
    set -e
fi

# $SETUP_OS overrides it for tests.
detect_os() {
    if test -n "${SETUP_OS:-}"; then
        echo "$SETUP_OS"
    elif test -f /etc/debian_version; then
        echo debian
    elif test -f /etc/redhat-release || test -f /etc/fedora-release; then
        echo redhat
    elif test -f /etc/arch-release; then
        echo arch
    else
        echo unknown
    fi
}

# --- Packages ---

# pkg_install installs packages with the distro's package manager.
pkg_install() {
    case "$(detect_os)" in
        debian) sudo_or_warn apt-get install -y "$@" ;;
        redhat) sudo_or_warn dnf install -y "$@" ;;
        arch) sudo_or_warn pacman -S --needed --noconfirm "$@" ;;
        *) return 1 ;;
    esac
}

# apt_candidates prints "package version" for each of its arguments apt
# knows, with "(none)" for a version apt has no candidate for, and fails when
# apt-cache does. Asked in the C locale, whose labels it parses.
apt_candidates() {
    _policy=$(LC_ALL=C apt-cache policy "$@") || return 1
    printf '%s\n' "$_policy" | awk '
        /^[^ ].*:$/ { pkg = substr($0, 1, length($0) - 1) }
        /^  Candidate:/ { print pkg, $2 }'
}

# The upstream part of a Debian version (4:15.2.0-5ubuntu1 -> 15.2.0), or
# nothing for "(none)". A pre-release's ~ stays (0.3.0~rc1-1 -> 0.3.0~rc1):
# sort -V, like Debian, orders it before the release.
upstream_version() {
    printf '%s\n' "$1" | sed -n 's/^\([0-9]*:\)\{0,1\}\([0-9][0-9.]*\(~[0-9A-Za-z.]*\)\{0,1\}\).*/\2/p'
}

version_at_least() {
    test "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" = "$2"
}

# install_all installs the packages it can and prints the ones it couldn't,
# failing if there are any. apt, dnf and pacman all refuse the lot over one
# name they don't know (swww isn't in Ubuntu 26.04), so on Debian and Ubuntu
# it asks apt which exist first, and installs those in one go. The package
# manager's own output goes to stderr, so stdout carries only the list.
install_all() {
    _install="$*"
    _missing=
    if test "$(detect_os)" = debian; then
        if _known=$(apt_candidates "$@"); then
            _install=
            for _pkg in "$@"; do
                if printf '%s\n' "$_known" | awk -v p="$_pkg" '$1 == p && $2 != "(none)" { found = 1 } END { exit !found }'; then
                    _install="$_install $_pkg"
                else
                    _missing="$_missing $_pkg"
                fi
            done
        else
            warn "couldn't ask apt which packages exist; installing them all"
        fi
    fi
    if test -n "$_install"; then
        # shellcheck disable=SC2086  # word-split the package list
        pkg_install $_install >&2 || _missing="$_missing $_install"
    fi
    printf '%s\n' "${_missing# }"
    test -z "$_missing"
}

# set_install_dir sets install_dir to where HYPRLAND_PINS build, and
# pins_file to the marker that says the build there is complete.
hyprland_pins_record() {
    printf '%s\ngcc %s\n' "$HYPRLAND_PINS" "$HYPRLAND_GCC"
}

set_install_dir() {
    hyprland_tag=$(printf '%s\n' "$HYPRLAND_PINS" | awk '$1 == "Hyprland" { print $3 }')
    # A new compiler is a new build, as a new pin is.
    pins_sum=$(hyprland_pins_record | cksum | cut -d' ' -f1)
    install_dir="$HYPRLAND_PREFIX/$hyprland_tag-$pins_sum"
    # Named for tide's old name, which existing builds carry: renaming the
    # marker would rebuild them all.
    pins_file="$install_dir/quickspace-pins"
}

# decide_hyprland_build sets BUILD_NOW to whether this run builds Hyprland
# from source: on Debian and Ubuntu, when apt's Hyprland is older than
# MIN_HYPRLAND or missing, and apt has the toolchain the build needs.
# Anything else keeps apt's Hyprland, saying why when it's too old.
decide_hyprland_build() {
    BUILD_NOW=no
    test "$BUILD_HYPRLAND" = yes && test "$(detect_os)" = debian || return 0
    if ! known=$(apt_candidates hyprland "g++-$HYPRLAND_GCC" libxkbcommon-dev liblua5.5-dev); then
        warn "couldn't ask apt for its Hyprland version; installing apt's"
        return 0
    fi
    candidate() {
        upstream_version "$(printf '%s\n' "$known" | awk -v p="$1" '$1 == p { print $2 }')"
    }
    apt_hyprland=$(candidate hyprland)
    if test -n "$apt_hyprland" && version_at_least "$apt_hyprland" "$MIN_HYPRLAND"; then
        return 0
    fi
    # A finished build only needs relinking, not the toolchain.
    set_install_dir
    if test -f "$pins_file"; then
        BUILD_NOW=yes
        return 0
    fi
    # Hyprland 0.56 needs GCC 16's libstdc++, xkbcommon 1.11 and Lua 5.5,
    # which Debian 13 doesn't have.
    gxx=$(candidate "g++-$HYPRLAND_GCC")
    xkb=$(candidate libxkbcommon-dev)
    if test -z "$gxx" \
        || test -z "$xkb" || ! version_at_least "$xkb" 1.11 \
        || test -z "$(candidate liblua5.5-dev)"; then
        warn "apt's Hyprland is ${apt_hyprland:-missing}, and building $MIN_HYPRLAND needs g++-$HYPRLAND_GCC, libxkbcommon 1.11 and Lua 5.5, which apt doesn't have here (it has g++-$HYPRLAND_GCC ${gxx:-none}, libxkbcommon ${xkb:-none}); installing apt's Hyprland, which can't run tide's Lua config"
        return 0
    fi
    BUILD_NOW=yes
}

# install_packages sets DISTRO_HYPRLAND to yes when it installed the
# distro's Hyprland.
install_packages() {
    DISTRO_HYPRLAND=no
    # hyprlock is the lock screen until tide-lock lands (M5): conf's
    # Super+L and hypridle's lock_cmd both run it. It's a separate program,
    # so the distro's works beside a source-built Hyprland. notify-send (the
    # libnotify package below) is how screenshot reports from a key binding,
    # and python3 is how `tide doctor` reads the session bus's XML config.
    # tide-shell shows the wallpaper with swww, or with swaybg where
    # the distro has no swww (Ubuntu 26.04), so both are asked for.
    common="hypridle hyprlock uwsm xdg-desktop-portal-hyprland xdg-desktop-portal-gtk \
            waybar swww swaybg fuzzel grim slurp wl-clipboard brightnessctl playerctl jq"
    # A source build replaces the distro's Hyprland rather than sitting
    # beside it.
    if test "$BUILD_NOW" = no; then
        common="hyprland $common"
    fi
    case "$(detect_os)" in
        debian) extra="sway-notification-center libnotify-bin golang python3" ;;
        redhat) extra="SwayNotificationCenter libnotify golang python3" ;;
        arch) extra="swaync libnotify go python" ;;
        *)
            # shellcheck disable=SC2086  # word-split the package list
            warn "unknown OS; install Hyprland $MIN_HYPRLAND+, Quickshell, swaync, notify-send, Go $MIN_GO+, python3 and these manually:$(printf ' %s' ${common#hyprland })"
            return 0
            ;;
    esac
    installed=yes
    # shellcheck disable=SC2086  # word-split the package list
    missing=$(install_all $common $extra) || installed=no
    case " $missing " in
        *" hyprland "*) ;;
        *) test "$BUILD_NOW" = yes || DISTRO_HYPRLAND=yes ;;
    esac
    # satty is screenshot's Annotate action, offered only where it's
    # installed. It's asked for on its own: not every distro packages it,
    # and dnf and pacman refuse a whole transaction over one unknown name.
    if ! install_all satty >/dev/null; then
        info "couldn't install satty; screenshots offer Annotate once it's installed"
    fi
    if test "$installed" = no; then
        # shellcheck disable=SC2086  # word-split the package list
        warn "could not install:$(printf ' %s' $missing); install them manually"
        case " $missing " in
            *" swaybg "*) case " $missing " in
                *" swww "*) warn "without swww or swaybg there's no wallpaper" ;;
            esac ;;
            *" swww "*) info "swww isn't packaged here; swaybg shows the wallpaper instead" ;;
        esac
    fi
}

# install_quickshell installs Quickshell in a step of its own, so a distro
# that doesn't package it costs only tide's bar, not the rest.
install_quickshell() {
    install_or_build_quickshell
    # Whichever way that ended, a source build made for a Qt that's since
    # changed would crash rather than let waybar take over.
    if test "$(detect_os)" = debian && ! current_quickshell_matches_qt; then
        # current goes only once nothing links through it, or a link left
        # behind would dangle. The legacy prefix is this user's.
        if unlink_quickshell "it was built for a Qt that's no longer installed"; then
            if test "$qs_prefix" = "$LEGACY_QUICKSHELL_PREFIX"; then
                rm -f "$qs_prefix/current"
            else
                sudo_or_warn rm -f "$qs_prefix/current"
            fi || warn "couldn't remove $qs_prefix/current"
        fi
    fi
}

install_or_build_quickshell() {
    # The bar tints its icons with QtQuick.Effects, part of Qt Declarative,
    # which Debian and Ubuntu package on their own.
    effects=
    case "$(detect_os)" in
        debian) effects=qml6-module-qtquick-effects ;;
        arch) ;;
        redhat)
            # dnf's copr command is a plugin: dnf-plugins-core for dnf 4,
            # dnf5-plugins for dnf 5. Both provide dnf-command(copr).
            if ! pkg_install 'dnf-command(copr)'; then
                warn "couldn't install dnf's copr plugin, so Quickshell isn't installed; tide's bar won't run, and waybar stays the bar"
                return 0
            fi
            if ! sudo_or_warn dnf copr enable -y "$QUICKSHELL_COPR"; then
                warn "couldn't enable the $QUICKSHELL_COPR COPR, so Quickshell isn't installed; tide's bar won't run, and waybar stays the bar"
                return 0
            fi
            ;;
        *) return 0 ;;
    esac
    # apt refuses to install a package it doesn't know, so it's asked first:
    # where it has no Quickshell, or one too old to load tide's shell, it's
    # built instead, given a Qt it builds with.
    if test "$(detect_os)" = debian && known=$(apt_candidates quickshell qt6-base-dev); then
        apt_qs=$(upstream_version "$(printf '%s\n' "$known" | awk '$1 == "quickshell" { print $2 }')")
        if test -z "$apt_qs"; then
            why="apt has no Quickshell"
        elif ! version_at_least "$apt_qs" "$MIN_QUICKSHELL"; then
            why="apt's Quickshell is $apt_qs, and tide's shell needs $MIN_QUICKSHELL"
        else
            why=
        fi
        if test -n "$why"; then
            qt=$(upstream_version "$(printf '%s\n' "$known" | awk '$1 == "qt6-base-dev" { print $2 }')")
            if test -z "$qt" || ! version_at_least "$qt" "$MIN_QUICKSHELL_QT"; then
                warn "$why, and building it needs Qt $MIN_QUICKSHELL_QT, but apt's Qt is ${qt:-missing}; tide's bar won't run, and waybar stays the bar"
                return 0
            fi
            build_quickshell "$why" || warn "building Quickshell failed, so tide's bar won't run yet; waybar stays the bar. Rerun setup-tide to retry"
            return 0
        fi
    fi
    # shellcheck disable=SC2086  # $effects is one name or none
    missing=$(install_all quickshell $effects) && return_ok=yes || return_ok=no
    # The packaged qs, in /usr/bin, would lose to links from a build, even
    # when an optional module didn't install beside it.
    case " $missing " in
        *" quickshell "*) ;;
        # It warns about each link it couldn't remove, and the step goes on.
        *) unlink_quickshell || : ;;
    esac
    test "$return_ok" = no || return 0
    # Missing packages cost only the bar, so they're warnings, not errors.
    case " $missing " in
        *" quickshell "*)
            warn "couldn't install Quickshell (the distro may not package it), so tide's bar won't run yet; waybar stays the bar"
            return 0
            ;;
    esac
    if test -n "$effects"; then
        case " $missing " in
            *" $effects "*)
                warn "couldn't install $effects, so tide's bar won't load; waybar stays the bar"
                return 0
                ;;
        esac
    fi
    warn "installing Quickshell failed without naming a package, so tide's bar may not run; waybar stays the bar"
}

# --- Source builds ---

# make_build_dir DIR makes DIR for this user to build into, in a prefix
# only root can write. A directory already there is a build that stopped
# partway. This user's own is resumed. Another account's can't be written,
# and what that account built would be sealed as root's, so it's started
# afresh.
make_build_dir() {
    if test -d "$1"; then
        if ! _mine=$(find "$1" -maxdepth 0 -user "$(id -u)" -print); then
            warn "couldn't check whose partial build $1 is"
            return 1
        fi
        test -z "$_mine" || return 0
        info "$1 is another account's partial build, so it's started afresh"
        if ! sudo_or_warn rm -rf "$1"; then
            warn "couldn't remove $1 to rebuild it"
            return 1
        fi
    fi
    if ! sudo_or_warn install -d -m 755 -o 0 -g 0 "${1%/*}" \
        || ! sudo_or_warn install -d -m 755 -o "$(id -u)" -g "$(id -g)" "$1"; then
        warn "couldn't make $1 to build into"
        return 1
    fi
}

# seal_build DIR COMMANDS hands a finished build to root, so nothing run as
# this user can change it once it's on PATH: root owns every file, and no
# one else can write one, whatever modes the build left (chown keeps them).
# The prefix above it too, where current is: whoever can write there can
# point current anywhere. Everyone can read it, though, and get into its
# directories, which a restrictive umask (077) would otherwise leave to root
# alone; each of COMMANDS is checked to still run for this user. It's rerun
# before every link, so a build a failed seal left behind isn't linked until
# it's sealed.
seal_build() {
    _prefix=${1%/*}
    if ! sudo_or_warn chown -R 0:0 "$1" || ! sudo_or_warn chmod -R a+rX,go-w "$1" \
        || ! sudo_or_warn chown 0:0 "$_prefix" || ! sudo_or_warn chmod a+rX,go-w "$_prefix"; then
        warn "couldn't hand $1 to root, so it isn't linked onto PATH"
        return 1
    fi
    # Links aren't followed, and their own modes mean nothing.
    if ! _writable=$(find "$_prefix" -maxdepth 0 -perm /022 -print && find "$1" ! -type l -perm /022 -print); then
        warn "couldn't check $1 is root's alone, so it isn't linked onto PATH"
        return 1
    fi
    if test -n "$_writable"; then
        warn "others can still write $(printf '%s\n' "$_writable" | head -n1), so $1 isn't linked onto PATH"
        return 1
    fi
    for _cmd in $2; do
        if ! test -x "$1/bin/$_cmd"; then
            warn "$1/bin/$_cmd can't be run once it's root's, so $1 isn't linked onto PATH"
            return 1
        fi
    done
}

# is_setup_link TARGET PREFIX LEGACY: whether a link to TARGET is one setup
# made, into either prefix.
is_setup_link() {
    case "$1" in
        "$2"/* | "$3"/*) return 0 ;;
    esac
    return 1
}

# remove_legacy_builds PREFIX MARKER BIN_DIR COMMANDS removes what earlier
# versions built into PREFIX, in $HOME, once a build in the new prefix is
# linked in its place: the builds, by their MARKER or a component's stamp,
# and the current link. Not while any of COMMANDS in BIN_DIR still links
# into it, as one does when relinking it failed. Anything else there is left
# alone, and with it the prefix.
remove_legacy_builds() {
    legacy=$1
    marker=$2
    test -d "$legacy" || return 0
    for cmd in $4; do
        case "$(readlink "$3/$cmd")" in
            "$legacy"/*) return 0 ;;
        esac
    done
    for old in "$legacy"/v*-[0-9]*/; do
        old=${old%/}
        if ! test -d "$old" || test -L "$old"; then
            continue
        fi
        set -- "$old"/.built-*
        test -f "$old/$marker" || test -e "$1" || continue
        info "Removing $old, an earlier build the greeter can't run"
        rm -rf "$old" || warn "couldn't remove the earlier build in $old"
    done
    if test -L "$legacy/current"; then
        rm -f "$legacy/current" || warn "couldn't remove $legacy/current"
    fi
    if test -z "$(ls -A "$legacy")"; then
        rmdir "$legacy" || warn "couldn't remove the empty $legacy"
    fi
}

# --- Quickshell from source ---

# build_quickshell builds QUICKSHELL_TAG into its own directory under
# $QUICKSHELL_PREFIX, as this user, then hands it to root and links its
# commands onto PATH. Its argument says why apt's won't do.
# Quickshell uses Qt's private API, so it must be rebuilt for each Qt
# release: the directory is named for the tag and the versions of the Qt
# packages it uses privately, a new one builds afresh, and a rerun with
# none changed only relinks.
build_quickshell() {
    info "$1; building $QUICKSHELL_TAG from source"
    # shellcheck disable=SC2086  # word-split the package list
    if ! missing=$(install_all $QUICKSHELL_BUILD_DEPS); then
        warn "could not install Quickshell's build dependencies:$(printf ' %s' $missing)"
        return 1
    fi
    # shellcheck disable=SC2086  # word-split the package list
    if ! qt_versions=$(dpkg-query -W -f='${Package} ${Version}\n' $QUICKSHELL_QT_PRIVATE) \
        || test "$(printf '%s\n' "$qt_versions" | grep -c .)" -ne "$(set -- $QUICKSHELL_QT_PRIVATE; echo $#)"; then
        warn "couldn't read the installed versions of$(printf ' %s' $QUICKSHELL_QT_PRIVATE), which Quickshell has to be built for"
        return 1
    fi
    qt_version=$(printf '%s\n' "$qt_versions" | awk '$1 == "qt6-base-private-dev" { print $2 }')
    # Every input the build depends on, so a change to any one of them is a
    # new build rather than a relink of an old one.
    qs_record=$(printf '%s\n' "$QUICKSHELL_REPO $QUICKSHELL_TAG $QUICKSHELL_COMMIT" \
        "cmake $QUICKSHELL_CMAKE_FLAGS" "$qt_versions")
    qs_sum=$(printf '%s\n' "$qs_record" | cksum | cut -d' ' -f1)
    qs_dir="$QUICKSHELL_PREFIX/$QUICKSHELL_TAG-$qs_sum"
    # Named for tide's old name, like Hyprland's quickspace-pins.
    qs_marker="$qs_dir/quickspace-build"
    if test -f "$qs_marker"; then
        info "Quickshell $QUICKSHELL_TAG is already built for Qt $qt_version in $qs_dir"
    else
        src="$QUICKSHELL_SRC/quickshell"
        # A stale clone or partial install left in place would be built into
        # and then marked complete. The partial install is in root's prefix,
        # so only root can remove it.
        if ! rm -rf "$src" || { test -e "$qs_dir" && ! sudo_or_warn rm -rf "$qs_dir"; }; then
            warn "couldn't remove the old Quickshell sources or partial build in $src and $qs_dir; not building"
            return 1
        fi
        mkdir -p "$QUICKSHELL_SRC" || return 1
        make_build_dir "$qs_dir" || return 1
        git clone -c advice.detachedHead=false --quiet --depth 1 --branch "$QUICKSHELL_TAG" "$QUICKSHELL_REPO" "$src" || return 1
        commit=$(git -C "$src" rev-parse HEAD) || return 1
        if test "$commit" != "$QUICKSHELL_COMMIT"; then
            warn "Quickshell's $QUICKSHELL_TAG tag is commit $commit, not the pinned $QUICKSHELL_COMMIT; not building it"
            rm -rf "$src" || warn "couldn't remove the rejected clone in $src"
            return 1
        fi
        # shellcheck disable=SC2086  # word-split the flags
        cmake -S "$src" -B "$src/build" -G Ninja -DCMAKE_INSTALL_PREFIX="$qs_dir" \
            $QUICKSHELL_CMAKE_FLAGS -DDISTRIBUTOR="setup-tide (source build)" \
            && cmake --build "$src/build" \
            && cmake --install "$src/build" || return 1
        printf '%s\n' "$qs_record" > "$qs_marker" || {
            warn "couldn't write $qs_marker"
            return 1
        }
    fi
    link_quickshell || return 1
    remove_old_quickshell_builds
    remove_legacy_builds "$LEGACY_QUICKSHELL_PREFIX" quickspace-build "$QUICKSHELL_BIN_DIR" "$QUICKSHELL_COMMANDS"
}

# link_quickshell hands $qs_dir to root, points $QUICKSHELL_PREFIX/current
# at it, then makes sure the commands' links go through it.
link_quickshell() {
    for cmd in $QUICKSHELL_COMMANDS; do
        if ! test -x "$qs_dir/bin/$cmd"; then
            warn "$qs_dir/bin/$cmd is missing; remove $qs_marker to rebuild"
            return 1
        fi
    done
    seal_build "$qs_dir" "$QUICKSHELL_COMMANDS" || return 1
    current="$QUICKSHELL_PREFIX/current"
    if ! sudo_or_warn ln -sfn "${qs_dir##*/}" "$current.new" || ! sudo_or_warn mv -Tf "$current.new" "$current"; then
        warn "couldn't point $current at $qs_dir"
        if test -L "$current.new"; then
            sudo_or_warn rm -f "$current.new" || warn "couldn't remove $current.new"
        fi
        return 1
    fi
    for cmd in $QUICKSHELL_COMMANDS; do
        link="$QUICKSHELL_BIN_DIR/$cmd"
        test "$(readlink "$link")" != "$current/bin/$cmd" || continue
        # Only replace a link of ours; anything else there is someone else's.
        if test -e "$link" || test -L "$link"; then
            if ! is_setup_link "$(readlink "$link")" "$QUICKSHELL_PREFIX" "$LEGACY_QUICKSHELL_PREFIX"; then
                warn "NOT LINKING $cmd: $link is already there, and setup didn't make it; remove it to use this build"
                continue
            fi
        fi
        # tide.service finds qs on the user manager's PATH, and the greeter
        # on greetd's.
        if ! sudo_or_warn ln -sfn "$current/bin/$cmd" "$link"; then
            warn "COULDN'T LINK $cmd INTO $QUICKSHELL_BIN_DIR: the tide session won't find Quickshell; link $current/bin/$cmd onto its PATH yourself"
        fi
    done
}

# Builds for an older tag or Qt, now that current points elsewhere. A
# running qs keeps the files it has open. Only finished builds of setup's,
# by their marker, and none a command link still points into directly.
remove_old_quickshell_builds() {
    for old in "$QUICKSHELL_PREFIX"/v*-[0-9]*/; do
        old=${old%/}
        if ! test -d "$old" || test -L "$old" || test "$old" = "$qs_dir" \
            || ! test -f "$old/quickspace-build"; then
            continue
        fi
        for cmd in $QUICKSHELL_COMMANDS; do
            case "$(readlink "$QUICKSHELL_BIN_DIR/$cmd")" in
                "$old"/*) continue 2 ;;
            esac
        done
        sudo_or_warn rm -rf "$old" || warn "couldn't remove the old Quickshell build in $old"
    done
}

# True when the current build, if any, was made for the Qt installed now:
# the one in the prefix qs links into, which after an upgrade can still be
# the legacy one, and otherwise this prefix's. Sets qs_prefix to that
# prefix. No current build matches trivially: there's nothing stale to run.
current_quickshell_matches_qt() {
    qs_prefix=$QUICKSHELL_PREFIX
    case "$(readlink "$QUICKSHELL_BIN_DIR/qs")" in
        "$LEGACY_QUICKSHELL_PREFIX"/*) qs_prefix=$LEGACY_QUICKSHELL_PREFIX ;;
    esac
    marker="$qs_prefix/current/quickspace-build"
    test -e "$qs_prefix/current" || return 0
    test -f "$marker" || return 1
    # shellcheck disable=SC2086  # word-split the package list
    installed=$(dpkg-query -W -f='${Package} ${Version}\n' $QUICKSHELL_QT_PRIVATE) || return 1
    printf '%s\n' "$installed" | while read -r line; do
        grep -qxF "$line" "$marker" || exit 1
    done
}

# unlink_quickshell removes the links build_quickshell made, saying why: the
# distro packages Quickshell, or the build no longer matches Qt.
unlink_quickshell() {
    _why=${1:-the distro packages Quickshell now}
    _unlinked=yes
    for cmd in $QUICKSHELL_COMMANDS; do
        link="$QUICKSHELL_BIN_DIR/$cmd"
        test -L "$link" || continue
        is_setup_link "$(readlink "$link")" "$QUICKSHELL_PREFIX" "$LEGACY_QUICKSHELL_PREFIX" || continue
        info "Removing $link, which points to a source build: $_why"
        if ! sudo_or_warn rm -f "$link"; then
            warn "couldn't remove $link; it still points to the source-built Quickshell"
            _unlinked=no
        fi
    done
    test "$_unlinked" = yes
}

# --- Hyprland from source ---

# build_hyprland builds and installs each of HYPRLAND_PINS in turn, as this
# user, then hands the build to root and links its commands onto PATH. Each
# set of
# pins gets its own directory under $HYPRLAND_PREFIX, so a failed rebuild
# leaves the working one alone; quickspace-pins in it marks it complete, and
# a rerun with the same pins only relinks.
build_hyprland() {
    set_install_dir
    if test -f "$pins_file"; then
        info "Hyprland is already built from these pins in $install_dir"
        link_hyprland || return 1
        remove_old_builds
        remove_legacy_builds "$LEGACY_HYPRLAND_PREFIX" quickspace-pins "$HYPRLAND_BIN_DIR" "$HYPRLAND_COMMANDS"
        return
    fi
    info "Building Hyprland from source into $install_dir (apt's is older than $MIN_HYPRLAND; this takes a while)"
    # shellcheck disable=SC2086  # word-split the package list
    if ! missing=$(install_all $HYPRLAND_BUILD_DEPS); then
        warn "could not install Hyprland's build dependencies:$(printf ' %s' $missing)"
        return 1
    fi
    # Our own libraries come first, ahead of any the distro has.
    PKG_CONFIG_PATH="$install_dir/lib/pkgconfig:$install_dir/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    export PKG_CONFIG_PATH
    # aquamarine and Hyprland run the hyprwayland-scanner we just built by name.
    PATH="$install_dir/bin:$PATH"
    mkdir -p "$HYPRLAND_SRC" || return 1
    # Every component stamped but no marker is a finished build whose marker
    # was removed to rebuild it, as link_hyprland says to: resumed, it would
    # rebuild nothing, and once sealed it's root's, so this user couldn't
    # write its marker again. Like Quickshell's, it's built afresh.
    if test -d "$install_dir" && printf '%s\n' "$HYPRLAND_PINS" | while read -r name _; do
        test -n "$name" || continue
        test -f "$install_dir/.built-$name" || exit 1
    done; then
        info "Hyprland's build in $install_dir has lost its marker, so it's rebuilt"
        if ! sudo_or_warn rm -rf "$install_dir"; then
            warn "couldn't remove $install_dir to rebuild it"
            return 1
        fi
    fi
    make_build_dir "$install_dir" || return 1
    # A failed build keeps what it finished, stamped, so a rerun picks up
    # where it stopped. Nothing uses it until it's complete and current.
    printf '%s\n' "$HYPRLAND_PINS" | while read -r name url tag commit kind; do
        test -n "$name" || continue
        stamp="$install_dir/.built-$name"
        if test -f "$stamp"; then
            info "Already built $name $tag"
            continue
        fi
        build_component "$name" "$url" "$tag" "$commit" "$kind" && : > "$stamp" || exit 1
    done || {
        warn "building Hyprland failed; the sources are in $HYPRLAND_SRC, and a rerun resumes from the step that failed"
        return 1
    }
    # Marked complete before linking, so a failed link is retried rather
    # than the build.
    hyprland_pins_record > "$pins_file" || {
        warn "couldn't write $pins_file"
        return 1
    }
    link_hyprland || return 1
    remove_old_builds
    remove_legacy_builds "$LEGACY_HYPRLAND_PREFIX" quickspace-pins "$HYPRLAND_BIN_DIR" "$HYPRLAND_COMMANDS"
}

# Once $HYPRLAND_PREFIX/current points at this build, older ones, finished
# or not, are unused. A running Hyprland from one keeps the files it has open.
remove_old_builds() {
    for old in "$HYPRLAND_PREFIX"/*/; do
        old=${old%/}
        # current is a link to this build, not a build of its own.
        if ! test -d "$old" || test -L "$old" || test "$old" = "$install_dir"; then
            continue
        fi
        # Only what build_hyprland made: a <tag>-<checksum> directory with its
        # marker or a component's stamp. Anything else here is left alone.
        case "${old##*/}" in
            v*-[0-9]*) ;;
            *) continue ;;
        esac
        set -- "$old"/.built-*
        if ! test -f "$old/quickspace-pins" && ! test -e "$1"; then
            continue
        fi
        # Nor one a command link still points into directly.
        for cmd in $HYPRLAND_COMMANDS; do
            case "$(readlink "$HYPRLAND_BIN_DIR/$cmd")" in
                "$old"/*) continue 2 ;;
            esac
        done
        sudo_or_warn rm -rf "$old" || warn "couldn't remove the old Hyprland build in $old"
    done
}

# The build's commands that go on PATH. The tide session starts
# Hyprland through start-hyprland, its crash watchdog, when it can find it.
HYPRLAND_COMMANDS="Hyprland hyprctl start-hyprland"

# link_hyprland hands this build to root and points $HYPRLAND_PREFIX/current
# at it, which switches every command at once, then makes sure the
# commands' links go through it.
link_hyprland() {
    for cmd in $HYPRLAND_COMMANDS; do
        if ! test -x "$install_dir/bin/$cmd"; then
            warn "$install_dir/bin/$cmd is missing; remove $pins_file to rebuild"
            return 1
        fi
    done
    seal_build "$install_dir" "$HYPRLAND_COMMANDS" || return 1
    # Renamed into place, so current is never missing or half-switched.
    current="$HYPRLAND_PREFIX/current"
    if ! sudo_or_warn ln -sfn "${install_dir##*/}" "$current.new" || ! sudo_or_warn mv -Tf "$current.new" "$current"; then
        warn "couldn't point $current at $install_dir"
        if test -L "$current.new"; then
            sudo_or_warn rm -f "$current.new" || warn "couldn't remove $current.new"
        fi
        return 1
    fi
    for cmd in $HYPRLAND_COMMANDS; do
        link="$HYPRLAND_BIN_DIR/$cmd"
        test "$(readlink "$link")" != "$current/bin/$cmd" || continue
        # Only replace a link of ours; anything else there is someone else's.
        if test -e "$link" || test -L "$link"; then
            if ! is_setup_link "$(readlink "$link")" "$HYPRLAND_PREFIX" "$LEGACY_HYPRLAND_PREFIX"; then
                warn "NOT LINKING $cmd: $link is already there, and setup didn't make it; remove it to use this build, or put $current/bin on the session's PATH"
                continue
            fi
        fi
        # The display manager finds Hyprland on its PATH, and so does the
        # greeter; without the links, only a session told where it is can.
        if ! sudo_or_warn ln -sfn "$current/bin/$cmd" "$link"; then
            warn "COULDN'T LINK $cmd INTO $HYPRLAND_BIN_DIR: the tide session may not find it; link $current/bin/$cmd onto the session's PATH yourself"
        fi
    done
}

# unlink_hyprland removes links that build_hyprland made, so that apt's
# Hyprland, in /usr/bin, isn't shadowed by an earlier source build.
unlink_hyprland() {
    # The links to remove, and where each pointed, one "link target" a line.
    saved=
    set --
    for cmd in $HYPRLAND_COMMANDS; do
        link="$HYPRLAND_BIN_DIR/$cmd"
        test -L "$link" || continue
        target=$(readlink "$link")
        if is_setup_link "$target" "$HYPRLAND_PREFIX" "$LEGACY_HYPRLAND_PREFIX"; then
            set -- "$@" "$link"
            saved="$saved$link $target
"
        fi
    done
    test $# -gt 0 || return 0
    info "Removing $*, which point to a source build; using apt's Hyprland"
    # Both go in one command, and anything a failure half-removed is put
    # back, so the commands never come from different builds.
    sudo_or_warn rm -f "$@" && return 0
    printf '%s' "$saved" | while read -r link target; do
        test -L "$link" && continue
        sudo_or_warn ln -s "$target" "$link" || warn "couldn't restore $link; point it at $target"
    done
    return 1
}

build_component() {
    dir="$HYPRLAND_SRC/$1"
    info "Building $1 $3"
    rm -rf "$dir"
    # Hyprland's Tracy submodule is only built with -DUSE_TRACY=ON, for
    # profiling, so it isn't fetched; a mirror without it can't fail the clone.
    git clone -c advice.detachedHead=false --quiet --depth 1 --branch "$3" --recurse-submodules=':(exclude)subprojects/tracy' --shallow-submodules "$2" "$dir" || return 1
    head=$(git -C "$dir" rev-parse HEAD) || return 1
    if test "$head" != "$4"; then
        warn "$1's $3 tag is commit $head, not the pinned $4; not building it"
        rm -rf "$dir" || warn "couldn't remove the rejected clone in $dir"
        return 1
    fi
    case "$1" in
        wayland-protocols)
            # 1.49's XML fails the strict DTD check of Ubuntu 26.04's
            # wayland-scanner (1.24) when generating its optional C enum
            # headers, which Hyprland doesn't use; it only needs the XML.
            find "$dir" -name meson.build -exec sed -i "s/'--strict', *//g" {} + || return 1
            ;;
    esac
    case "$5" in
        meson)
            CC="gcc-$HYPRLAND_GCC" CXX="g++-$HYPRLAND_GCC" meson setup "$dir/build" "$dir" --prefix="$install_dir" --libdir=lib -Dtests=false \
                && meson compile -C "$dir/build" \
                && meson install -C "$dir/build"
            ;;
        cmake)
            # The run path is how Hyprland finds these libraries, since
            # $install_dir/lib isn't in the system's library path.
            cmake -S "$dir" -B "$dir/build" -G Ninja -DCMAKE_BUILD_TYPE=Release \
                -DCMAKE_INSTALL_PREFIX="$install_dir" -DCMAKE_INSTALL_LIBDIR=lib \
                -DCMAKE_PREFIX_PATH="$install_dir" -DCMAKE_INSTALL_RPATH="$install_dir/lib" \
                -DCMAKE_C_COMPILER="gcc-$HYPRLAND_GCC" -DCMAKE_CXX_COMPILER="g++-$HYPRLAND_GCC" \
                -DBUILD_TESTING=OFF \
                && cmake --build "$dir/build" \
                && cmake --install "$dir/build"
            ;;
    esac
}

# Hyprland before 0.56 reads hyprland.conf, which conf no longer ships.
check_hyprland_version() {
    if ! is_command Hyprland; then
        warn "Hyprland isn't installed; the tide session won't start"
        return 0
    fi
    version=$(Hyprland --version 2>/dev/null | sed -n 's/^Hyprland \([0-9][0-9.]*\).*/\1/p' | head -n1)
    if test -z "$version"; then
        warn "couldn't read Hyprland's version; tide needs $MIN_HYPRLAND or later"
        return 0
    fi
    if test "$(printf '%s\n%s\n' "$MIN_HYPRLAND" "$version" | sort -V | head -n1)" != "$MIN_HYPRLAND"; then
        warn "Hyprland $version is older than $MIN_HYPRLAND, which the Lua config needs; upgrade it"
    fi
}

# --- The tide repo ---

# $TIDE_REPO only steers a fresh clone; an existing checkout pulls from
# its own origin.
fetch_tide() {
    if test "$FETCH" = no; then
        test -d "$TIDE_DIR/.git" \
            || error "no tide checkout at $TIDE_DIR (--no-fetch)"
    elif test -d "$TIDE_DIR/.git"; then
        info "Updating $TIDE_DIR"
        # The existing checkout is enough to install, so a failed pull (no
        # network, say) warns rather than ending the run.
        git -C "$TIDE_DIR" pull --ff-only \
            || warn "could not update $TIDE_DIR; installing the existing checkout"
    else
        # Not naming the URL: one passed with credentials in it would land in
        # the terminal and any captured log.
        info "Cloning tide into $TIDE_DIR"
        mkdir -p "$(dirname "$TIDE_DIR")"
        git clone "$TIDE_REPO" "$TIDE_DIR"
    fi
}

install_tide() {
    # make install builds tide-grant first, and without Go it would
    # stop before installing anything.
    is_command "$GO" \
        || error "tide needs Go $MIN_GO or newer to build tide-grant; setup installs it, or install golang (Debian, Ubuntu, Fedora) or go (Arch)"
    if ! go_version=$("$GO" env GOVERSION 2>&1); then
        error "couldn't ask $GO for its version: $go_version"
    fi
    go_version=${go_version#go}
    if test "$(printf '%s\n%s\n' "$MIN_GO" "$go_version" | sort -V | head -n1)" != "$MIN_GO"; then
        error "tide needs Go $MIN_GO or newer to build tide-grant, and $GO is $go_version; on Debian 12, install golang from bookworm-backports, or Go from https://go.dev/dl/"
    fi
    info "Installing tide's user files"
    make -C "$TIDE_DIR" install GO="$GO"
    if test "$INSTALL" = yes; then
        info "Installing the tide session entry and commands under /usr"
        sudo_or_warn make -C "$TIDE_DIR" install-session PREFIX=/usr \
            || warn "could not install the session entry; run 'sudo make -C $TIDE_DIR install-session PREFIX=/usr'"
    fi
}

# Distro packages enable waybar's and swaync's user units for every session,
# and D-Bus activates swaync's on the first notification sent while nothing
# owns the name. Under Plasma, swaync fights plasmashell for that name and
# waybar draws a second bar; in tide, an activated swaync takes the name
# the shell's own swaync needs. tide-shell (or conf's plain-Hyprland
# config) runs both programs itself, so the units are never wanted, and a
# user mask overrides every enablement, global or runtime. mask edits unit
# files only; just --now needs a running user manager. hypridle's unit stays:
# tide's drop-in runs it only in the tide session.
#
# swaync is one of many daemons D-Bus can activate for the notification name:
# Xfce's xfce4-notifyd took it in the first sessions, and dunst, mako or
# MATE's could next. So rather than a list, every activation file claiming
# the name is read, and the unit it activates through is masked. One with no
# unit can't be masked; it's named, so it can be removed. KDE's is left alone:
# it only waits for plasmashell, which owns the name itself.
notification_units() {
    for dir in $DBUS_SERVICE_DIRS; do
        for f in "$dir"/*.service; do
            test -f "$f" || continue
            grep -qx 'Name=org.freedesktop.Notifications' "$f" || continue
            unit=$(sed -n 's/^SystemdService=//p' "$f")
            if test -n "$unit"; then
                printf '%s\n' "$unit"
            elif ! grep -q '^Exec=.*plasma_waitforname' "$f"; then
                warn "$f can start a notification daemon that would take tide's notifications, and it has no unit to mask; remove its package if that happens"
            fi
        done
    done
}

# Stopping a unit that isn't installed would fail the whole mask call.
installed_unit() {
    for d in $USER_UNIT_DIRS; do
        test -e "$d/$1" && return 0
    done
    return 1
}

mask_distro_units() {
    units="waybar.service swaync.service"
    for u in $(notification_units | sort -u); do
        case " $units " in
            *" $u "*) ;;
            *) installed_unit "$u" && units="$units $u" ;;
        esac
    done
    # Without a manager to reach, whatever the reason, the mask still takes,
    # but anything already running keeps going until the next login.
    now=
    if probe=$(systemctl --user show-environment 2>&1 >/dev/null); then
        now=--now
    else
        warn "couldn't reach the systemd user manager${probe:+ ($probe)}; masking $units without stopping them, so a running one lasts until the next login"
    fi
    # shellcheck disable=SC2086  # word-split the unit list
    systemctl --user mask $now $units \
        || warn "couldn't mask $units; they can start under Plasma, and another notification daemon can take tide's notifications"
}

enable_unit() {
    if ! is_command systemctl || ! systemctl --user show-environment >/dev/null 2>&1; then
        warn "no systemd user manager; run 'systemctl --user enable tide.service' in your session"
        return 0
    fi
    systemctl --user daemon-reload
    systemctl --user enable tide.service
}

# --- logind ---

remove_old_lid_dropins() {
    removed=no
    for f in "$LOGIND_DIR/10-hypr-lid.conf" "$LOGIND_DIR/10-sway-lid.conf"; do
        if test -e "$f"; then
            info "Removing $f (tide leaves the lid to logind's defaults)"
            if sudo_or_warn rm -f "$f"; then
                removed=yes
            else
                warn "could not remove $f; an undocked lid close won't suspend until it's gone"
            fi
        fi
    done
    if test "$removed" = yes; then
        sudo_or_warn systemctl kill -s HUP systemd-logind \
            || warn "could not reload systemd-logind; the change applies after a reboot"
    fi
}

# --- GDM ---

# Installs $2 as the root-owned file $1, unless it already says that and
# only root can change it: a copy someone else can change is replaced, since
# root reads each of these, and nothing is written in a directory someone
# else can. Returns 1 if it couldn't, and sets $changed when it wrote.
install_text() {
    # In a directory someone else can write, they could swap the file once
    # it's written, so it isn't written there.
    if ! trusted "${1%/*}" missing-ok; then
        warn "not writing $1: $why"
        return 1
    fi
    _tmp=$(mktemp) || {
        warn "couldn't create a temporary file for $1"
        return 1
    }
    if ! printf '%s\n' "$2" > "$_tmp"; then
        warn "couldn't write a temporary copy of $1"
        rm -f "$_tmp"
        return 1
    fi
    if cmp -s "$_tmp" "$1" && trusted "$1"; then
        rm -f "$_tmp"
        return 0
    fi
    if sudo_or_warn install -D -m 644 "$_tmp" "$1"; then
        rm -f "$_tmp"
        changed=yes
        return 0
    fi
    rm -f "$_tmp"
    return 1
}

# GDM's login screen shows a banner set in dconf: a keyfile in the gdm
# system database, which the gdm profile reads. Debian ships that profile in
# /usr/share; elsewhere it goes in /etc, as GNOME's admin guide does it. The
# name is read at each run, so rerun setup after renaming the machine.
gdm_hostname_banner() {
    test -e "$GDM_DEFAULTS" || return 0
    if ! is_command dconf; then
        warn "GDM is installed but dconf isn't, so the login screen can't show the hostname; install dconf-cli (Debian) or dconf"
        return 0
    fi
    host=$(uname -n | cut -d. -f1)
    changed=no
    profile="$DCONF_DIR/profile/gdm"
    # The /etc profile, when there is one, overrides the shipped one.
    if test -e "$profile"; then
        if ! grep -qx 'system-db:gdm' "$profile"; then
            warn "$profile doesn't read the gdm dconf database (system-db:gdm), so the login screen won't show the hostname; add that line"
            return 0
        fi
    elif test -e "$DCONF_SHARE_PROFILE" && grep -qx 'system-db:gdm' "$DCONF_SHARE_PROFILE"; then
        : # the shipped profile reads the gdm database
    else
        install_text "$profile" "user-db:user
system-db:gdm
file-db:$GDM_DEFAULTS" || {
            warn "couldn't install $profile; the login screen won't show the hostname"
            return 0
        }
    fi
    install_text "$DCONF_DIR/db/gdm.d/50-tide-hostname" "[org/gnome/login-screen]
banner-message-enable=true
banner-message-text='$host'" || {
        warn "couldn't install GDM's hostname banner; the login screen won't show the hostname"
        return 0
    }
    if test "$changed" = yes; then
        info "GDM's login screen now shows $host"
        sudo_or_warn dconf update \
            || warn "dconf update failed, so GDM won't show the hostname until it succeeds; run 'sudo dconf update'"
    fi
}

# --- greetd ---

# greetd runs tide's greeter (tide's SPEC.md §11) as its default session,
# as a user of its own. setup makes it the display manager from the next
# boot, and never restarts one, which would end the session setup runs in.
# Debian's GDM and SDDM units refuse to start unless
# /etc/X11/default-display-manager names them, and greetd's doesn't check,
# so that file is left alone: it's what lets the way back work.

unit_property() {
    systemctl show --property="$2" --value "$1"
}

# display_manager prints the unit display-manager.service is, or "none".
display_manager() {
    _state=$(unit_property display-manager.service LoadState) || return 1
    if test "$_state" != loaded; then
        echo none
        return 0
    fi
    unit_property display-manager.service Id
}

# Whether $1 is a display manager setup can put back: a unit's name, or
# "none". The note it comes from is root's, but it's checked anyway before
# it reaches systemctl.
valid_display_manager() {
    case "$1" in
        none) return 0 ;;
        "" | *[!A-Za-z0-9@._-]*) return 1 ;;
        *.service) return 0 ;;
    esac
    return 1
}

# install_greetd installs the packages the greeter needs from the distro.
install_greetd() {
    case "$(detect_os)" in
        debian | redhat | arch) ;;
        *)
            warn "unknown OS; install greetd to log in with tide's greeter"
            return 0
            ;;
    esac
    if ! install_all greetd >/dev/null; then
        warn "couldn't install greetd, so tide's greeter can't be the login screen"
    fi
    # PAM's gnome-keyring module, which unlocks the keyring at login. Arch
    # ships it in gnome-keyring itself. On its own, so a name a distro
    # doesn't know can't stop greetd installing.
    case "$(detect_os)" in
        debian) _keyring="gnome-keyring libpam-gnome-keyring" ;;
        redhat) _keyring="gnome-keyring gnome-keyring-pam" ;;
        arch) _keyring=gnome-keyring ;;
    esac
    # shellcheck disable=SC2086  # word-split the package list
    if ! _missing=$(install_all $_keyring); then
        # shellcheck disable=SC2086  # word-split the package list
        warn "couldn't install$(printf ' %s' $_missing), so logging in won't unlock the keyring"
    fi
}

# is_system_account NAME: whether NAME is a system account, which is what
# the greeter runs as: not root, which would hand everything it parses root's
# privileges, nor a person's account, whose files and processes the greeter
# would share while it reads every password typed at login. One whose UID is
# below login.defs' UID_MIN, as a package's are.
is_system_account() {
    _uid=$(getent passwd "$1" | cut -d: -f3) || return 1
    _uid_min=
    if test -r "$LOGIN_DEFS"; then
        _uid_min=$(awk '$1 == "UID_MIN" { print $2; exit }' "$LOGIN_DEFS") || _uid_min=
    fi
    case "$_uid_min" in
        "" | *[!0-9]*) _uid_min=1000 ;;
    esac
    case "$_uid" in
        "" | *[!0-9]*) return 1 ;;
    esac
    test "$_uid" -gt 0 && test "$_uid" -lt "$_uid_min"
}

# greeter_user sets greeter to the user greetd runs its greeter as: one of
# greetd's own, GREETER_USERS, that's a system account. The one greetd's
# config names comes first, which is the one the distro's package made
# (Debian's _greetd). A config naming any other account isn't followed: the
# greeter, which reads every password typed at login, would share that
# account's files and processes. Sets greeter_looked to the names it tried.
greeter_user() {
    _named=
    if test -r "$GREETD_DIR/config.toml"; then
        _named=$(awk '
            /^[[:space:]]*\[/ { section = $0; gsub(/[[:space:]]/, "", section) }
            section == "[default_session]" && /^[[:space:]]*user[[:space:]]*=/ {
                sub(/^[^=]*=[[:space:]]*/, "")
                sub(/[[:space:]]*(#.*)?$/, "")
                gsub(/"/, "")
                print
                exit
            }' "$GREETD_DIR/config.toml") || _named=
        case " $GREETER_USERS " in
            *" $_named "*) ;;
            *) _named= ;;
        esac
    fi
    greeter_looked=
    for _user in $_named $GREETER_USERS; do
        greeter_looked="$greeter_looked $_user"
        if is_system_account "$_user"; then
            greeter=$_user
            return 0
        fi
    done
    return 1
}

# greeter_vt sets vt to the VT greetd's unit keeps getty off, which its
# config has to name: upstream's unit takes VT 1 and Debian's VT 7, and a
# greeter on any other VT would fight a getty for it. Fails, setting why,
# when it can't tell, or the unit keeps getty off none, or off one Linux
# hasn't got, which greetd would fail to start on at every boot.
greeter_vt() {
    if ! _conflicts=$(unit_property greetd.service Conflicts); then
        why="couldn't ask systemd which VT greetd's unit keeps for it"
        return 1
    fi
    vt=$(printf '%s\n' "$_conflicts" | tr ' ' '\n' \
        | sed -n 's/^getty@tty\([0-9][0-9]*\)\.service$/\1/p' | head -n1)
    if test -z "$vt"; then
        why="greetd's unit keeps getty off no VT, so the greeter would share one with a login prompt"
        return 1
    fi
    case "$vt" in
        [1-9] | [1-5][0-9] | 6[0-3]) ;;
        *)
            why="greetd's unit keeps getty off tty$vt, which isn't one of Linux's VTs, 1 to 63, so greetd couldn't start there"
            return 1
            ;;
    esac
}

# trusted_entry PATH: whether PATH itself, not where a link leads, is root's,
# and writable by no one else unless it's a link, whose own mode means
# nothing. Sets entry_type, or why it isn't.
trusted_entry() {
    # %F is translated, so ask for C's.
    if ! _e_stat=$(LC_ALL=C stat -c '%u %a %F' -- "$1"); then
        why="couldn't look at $1"
        return 1
    fi
    _e_uid=${_e_stat%% *}
    _e_stat=${_e_stat#* }
    _e_mode=${_e_stat%% *}
    entry_type=${_e_stat#* }
    if test "$_e_uid" != 0; then
        why="$1 is uid $_e_uid's, not root's"
        return 1
    fi
    test "$entry_type" != "symbolic link" || return 0
    case "$_e_mode" in
        "" | *[!0-7]*)
            why="couldn't read $1's mode"
            return 1
            ;;
    esac
    if test $((0$_e_mode & 022)) -ne 0; then
        why="users other than root can write $1"
        return 1
    fi
}

# trusted PATH [missing-ok]: whether only root can change what PATH names,
# setting why if not. The greeter reads every password typed at login, so
# nothing it runs, or reads as code, may be anyone else's to change. Every
# directory on the way down from /, every link on the way and every one
# where it leads, and PATH itself, have to be root's and writable by no one
# else, as the kernel would walk them. Sets trusted_to to where PATH leads.
# With missing-ok, a PATH that isn't there passes, since only root could
# make it.
trusted() {
    case "$1" in
        /*) ;;
        *)
            why="$1 isn't a full path"
            return 1
            ;;
    esac
    trusted_entry / || return 1
    _t_nl='
'
    _t_dir=/
    _t_rest=$1
    _t_links=0
    while :; do
        _t_rest=${_t_rest#"${_t_rest%%[!/]*}"}
        test -n "$_t_rest" || break
        _t_name=${_t_rest%%/*}
        _t_rest=${_t_rest#"$_t_name"}
        case "$_t_name" in
            .) continue ;;
            ..)
                _t_dir=${_t_dir%/*}
                test -n "$_t_dir" || _t_dir=/
                continue
                ;;
        esac
        _t_path=${_t_dir%/}/$_t_name
        if ! test -e "$_t_path" && ! test -L "$_t_path"; then
            if test "$2" = missing-ok; then
                trusted_to=
                return 0
            fi
            why="$_t_path isn't there"
            return 1
        fi
        trusted_entry "$_t_path" || return 1
        if test "$entry_type" != "symbolic link"; then
            _t_dir=$_t_path
            continue
        fi
        # The kernel's limit.
        _t_links=$((_t_links + 1))
        if test "$_t_links" -gt 40; then
            why="$1 leads through too many links"
            return 1
        fi
        # The x keeps a newline the target ends in, which $(...) would
        # strip, to check a name other than the one the kernel follows.
        if ! _t_target=$(readlink -- "$_t_path" && echo x); then
            why="couldn't read the link $_t_path"
            return 1
        fi
        _t_target=${_t_target%x}
        _t_target=${_t_target%"$_t_nl"}
        case "$_t_target" in
            *"$_t_nl"*)
                why="the link $_t_path leads to a name with a newline in it"
                return 1
                ;;
        esac
        case "$_t_target" in
            /*) _t_dir=/ ;;
        esac
        _t_rest=$_t_target/$_t_rest
    done
    trusted_to=$_t_dir
}

# trusted_tree DIR: whether DIR is trusted, and everything in it, and
# wherever each link in it leads, through the whole of each directory a link
# leads to, setting why if not. For a build, whose commands load its
# libraries, and tide's greeter files, which the greeter runs as code. Sets
# trusted_to to where DIR leads.
trusted_tree() {
    trusted "$1" || return 1
    _tt_root=$trusted_to
    _tt_nl='
'
    # Directories still to look through, and those looked through already,
    # one a line: a link back into one, or a loop of them, ends there.
    _tt_todo=$_tt_root
    _tt_seen=
    while test -n "$_tt_todo"; do
        case "$_tt_todo" in
            *"$_tt_nl"*)
                _tt_dir=${_tt_todo%%"$_tt_nl"*}
                _tt_todo=${_tt_todo#*"$_tt_nl"}
                ;;
            *)
                _tt_dir=$_tt_todo
                _tt_todo=
                ;;
        esac
        _tt_inside=no
        while IFS= read -r _tt_done; do
            test -n "$_tt_done" || continue
            case "$_tt_dir" in
                "$_tt_done" | "${_tt_done%/}"/*) _tt_inside=yes ;;
            esac
        done <<EOF
$_tt_seen
EOF
        test "$_tt_inside" = no || continue
        _tt_seen=$_tt_seen$_tt_nl$_tt_dir
        # What follows reads a name a line, so a name with a newline in it
        # would read as two, and what it names go unchecked.
        if ! _tt_nlname=$(find "$_tt_dir" -name "*$_tt_nl*" -print -quit); then
            why="couldn't look through $_tt_dir"
            return 1
        fi
        if test -n "$_tt_nlname"; then
            why="${_tt_nlname%/*} holds a name with a newline in it"
            return 1
        fi
        if ! _tt_entries=$(find "$_tt_dir" ! -type l -exec stat -c '%u %a %n' -- {} +); then
            why="couldn't look through $_tt_dir"
            return 1
        fi
        if ! _tt_bad=$(printf '%s\n' "$_tt_entries" | awk '
            {
                name = $0
                sub(/^[^ ]* [^ ]* /, "", name)
                group = substr($2, length($2) - 1, 1)
                others = substr($2, length($2), 1)
                if ($1 != 0) { print "uid " $1 " " name; exit }
                if (group ~ /[2367]/ || others ~ /[2367]/) { print "writable " name; exit }
            }'); then
            why="couldn't check who can change what's in $_tt_dir"
            return 1
        fi
        case "$_tt_bad" in
            uid\ *)
                _tt_bad=${_tt_bad#uid }
                why="${_tt_bad#* } is uid ${_tt_bad%% *}'s, not root's"
                return 1
                ;;
            writable\ *)
                why="users other than root can write ${_tt_bad#writable }"
                return 1
                ;;
        esac
        if ! _tt_links=$(find "$_tt_dir" -type l -print); then
            why="couldn't look through $_tt_dir"
            return 1
        fi
        while IFS= read -r _tt_link; do
            test -n "$_tt_link" || continue
            trusted "$_tt_link" || return 1
            # find doesn't follow a link, so a directory one leads to is
            # looked through in turn.
            if test -d "$trusted_to"; then
                _tt_todo=$_tt_todo${_tt_todo:+$_tt_nl}$trusted_to
            fi
        done <<EOF
$_tt_links
EOF
    done
    trusted_to=$_tt_root
}

# PAM_AWK reads PAM files, and prints each name pam_names_trusted checks,
# one a line: a kind, -, the name, and the file it's in. A name starts a
# word, or follows a [, =, : or , in one, and it's a path, a file an
# include names by its full path, a program pam_exec runs named without
# one, or relative, any other name in a module's arguments; and climbs is
# a word that climbs out of where PAM looks with "..".
# at_include says whether PAM reads @include lines. It joins the lines a
# backslash carries on, as PAM does, but needn't read them as PAM does:
# CHAIN_AWK does that, and every name in every word here is checked anyway.
# shellcheck disable=SC2016  # $0 and the rest are awk's
PAM_AWK='
    function flush(    n, w, i, t, s, at, first, full, name, inc, c, mi, a, prog) {
        if (line == "") return
        n = split(line, w)
        line = ""
        # The word that names the file an include reads.
        inc = 0
        if (at_include == "yes" && tolower(w[1]) ~ /^-?@include$/) inc = 2
        else if (tolower(w[2]) == "include" || tolower(w[2]) == "substack") inc = 3
        for (i = 1; i <= n; i++) {
            t = w[i]
            if (i == inc && t ~ /^\//) print "include", "-", t, file
            first = 0
            s = t
            while (match(s, /(^|\[|=|:|,)\//)) {
                at = RSTART + (substr(s, RSTART, 1) == "/" ? 0 : 1)
                if (!first) first = length(t) - length(s) + at
                full = substr(s, at)
                name = full
                # A bracketed argument ends in one.
                if (sub(/\]$/, "", name)) print "path", "-", name, file
                print "path", "-", full, file
                s = substr(s, at + 1)
            }
            s = first ? substr(t, 1, first - 1) : t
            if (s ~ /(^|\[|\/|=|:|,)\.\.(\]|\/|=|:|,|$)/) print "climbs", "-", t, file
        }
        if (inc) return
        c = w[2]
        mi = 3
        if (c ~ /^\[/) while (c !~ /\]$/ && mi <= n) c = c " " w[mi++]
        # pam_exec runs a program on any line, as root: the first word after
        # its options. One named without a full path, which it runs from the
        # directory greetd runs in, /, is held to the same rule as a full one.
        prog = 0
        if (mi <= n && w[mi] ~ /(^|\/)pam_exec\.so$/) {
            for (i = mi + 1; i <= n; i++) {
                a = tolower(w[i])
                if (a !~ /^\// && (a ~ /^(debug|stdout|seteuid|quiet|quiet_log|expose_authtok)$/ || a ~ /^(log|type)=/)) continue
                if (a !~ /^\//) {
                    print "program", "-", w[i], file
                    prog = i
                }
                break
            }
        }
        # Any module opens a file an argument names without a full path from
        # there too: every other word after the module, and what follows a
        # =, : or , in one, could name one.
        for (i = mi + 1; i <= n; i++) {
            if (i == prog) continue
            s = w[i]
            sub(/^\[/, "", s)
            sub(/\]$/, "", s)
            while (s != "") {
                if (s !~ /^\//) print "relative", "-", s, file
                if (!match(s, /[=:,]/)) break
                s = substr(s, RSTART + 1)
            }
        }
    }
    FNR == 1 { flush(); file = as != "" ? as : FILENAME }
    /^[ \t]*(#|$)/ { next }
    {
        s = $0
        if (index(s, "#")) {
            sub(/#.*/, "", s)
            line = line " " s
            flush()
            next
        }
        if (s ~ /\\[ \t]*$/) {
            sub(/\\[ \t]*$/, "", s)
            line = line " " s
            next
        }
        line = line " " s
        flush()
    }
    END { flush() }'

# pam_names_trusted: whether only root can change the directory greetd's
# PAM files are in, and where each include by its full path in them leads,
# setting why if not. The vendor's /usr/lib/pam.d, where PAM looks for a
# file PAM_DIR hasn't got, is held to the rule too. Sets pam_files to the
# files in both, pam_fullpaths to where each include by its full path leads
# in them, a tab between, one a line, pam_root to where PAM_DIR leads, and
# pam_vendor and pam_vendor_root to the vendor's directory and where it
# leads, or nothing when it isn't there. Each file, and what its lines
# name, is checked only when greetd's stacks read it, by
# pam_files_trusted, since another service's aren't greetd's.
pam_names_trusted() {
    trusted "$PAM_DIR" || return 1
    pam_root=$trusted_to
    pam_checked=
    # PAM looks for a file in the vendor's directory when PAM_DIR hasn't
    # got it.
    pam_vendor=$PAM_VENDOR_DIR
    pam_vendor_root=
    set -- "$PAM_DIR"
    if test -d "$pam_vendor"; then
        trusted "$pam_vendor" || return 1
        pam_vendor_root=$trusted_to
        set -- "$@" "$pam_vendor"
    fi
    # Only the includes by full path are read out of them here, which a
    # file greetd's stacks never read doesn't need: one setup can't read is
    # skipped, and if greetd's stacks do read it, reading them fails.
    if ! pam_files=$(find -L "$@" -type f) \
        || ! _pn_names=$(find -L "$@" -type f -readable -exec awk -v at_include="$PAM_AT_INCLUDE" "$PAM_AWK" {} +); then
        why="couldn't read the files in $*"
        return 1
    fi
    pam_fullpaths=
    while read -r _pn_kind _pn_type _pn_name _pn_file; do
        test "$_pn_kind" = include || continue
        # One that isn't root's alone, or leads outside where setup looks,
        # isn't followed, and pam_files_trusted fails a stack that reads
        # the file including it.
        trusted "$_pn_name" missing-ok || continue
        test -n "$trusted_to" || continue
        pam_include_inside "$_pn_name" || continue
        pam_fullpaths="$pam_fullpaths$_pn_name	$pam_include
"
    done <<EOF
$_pn_names
EOF
}

# pam_files_trusted FILES: whether only root can change each of FILES, one
# a line, and every full path a line in one names, setting why if not.
# Anyone who could change one could let any password in. A module
# named by its full path loads from there, not from PAM's own directory,
# and an argument can name a program a module runs, as pam_exec's does, or
# a file it reads, all as root. So each is held to trusted's rule, and one
# in a bin, sbin, lib or lib64 directory outside the package manager's has
# the whole prefix it's installed in checked too, since it loads its
# libraries from there. A file included from outside PAM_DIR and the
# vendor's directory isn't looked through, so it fails, and so does a
# relative name that climbs out of where PAM looks with "..". A file a
# module reads without a line naming it, as pam_env reads /etc/environment,
# isn't greetd's: every login on the machine reads it, so keeping it root's
# is the system's to do, and setup doesn't list them.
# pam_names_trusted has to have read the stack.
pam_files_trusted() {
    _pf_nl='
'
    while IFS= read -r _pf_file; do
        test -n "$_pf_file" || continue
        if test "$_pf_file" != "$pam_override"; then
            case "$_pf_nl$pam_checked" in
                *"$_pf_nl$_pf_file$_pf_nl"*) continue ;;
            esac
        fi
        # One setup would write in place of the file there keeps its owner
        # and mode, so it's checked too, when it's there.
        trusted "$_pf_file" missing-ok || return 1
        # What setup would write in place of one is read as PAM would.
        if test "$_pf_file" = "$pam_override"; then
            _pn_names=$(printf '%s\n' "$pam_override_text" | awk -v at_include="$PAM_AT_INCLUDE" -v as="$_pf_file" "$PAM_AWK")
        else
            _pn_names=$(awk -v at_include="$PAM_AT_INCLUDE" "$PAM_AWK" "$_pf_file")
        fi || {
            why="couldn't read $_pf_file"
            return 1
        }
        pam_names_check || return 1
        test "$_pf_file" = "$pam_override" || pam_checked="$pam_checked$_pf_file$_pf_nl"
    done <<EOF
$1
EOF
}

# pam_names_check: whether only root can change each name PAM_AWK printed,
# in _pn_names, as pam_files_trusted says, setting why if not.
pam_names_check() {
    while read -r _pn_kind _pn_type _pn_name _pn_file; do
        _pn_named=$_pn_name
        if test "$_pn_kind" = program; then
            # pam_exec runs a program named without a full path from
            # greetd's directory, /.
            _pn_kind=path
            _pn_named="$_pn_name (which pam_exec runs as /$_pn_name)"
            _pn_name=/$_pn_name
        elif test "$_pn_kind" = relative; then
            # A module opens a file named without a full path from there
            # too. Only root can make one in / itself, so a name with no
            # directory in it matters only when it's there.
            case "$_pn_name" in
                */*) ;;
                *) test -e "/$_pn_name" || test -L "/$_pn_name" || continue ;;
            esac
            _pn_kind=path
            _pn_named="$_pn_name (which a module reads as /$_pn_name)"
            _pn_name=/$_pn_name
        fi
        case "$_pn_kind" in
            climbs)
                why="$_pn_file names $_pn_name, which climbs out of where PAM looks"
                return 1
                ;;
            include)
                if ! trusted "$_pn_name" missing-ok; then
                    why="$_pn_file includes $_pn_name: $why"
                    return 1
                fi
                # pam_stack_works looks for one that isn't there.
                test -n "$trusted_to" || continue
                pam_include_inside "$_pn_name" && continue
                why="$_pn_file includes $_pn_name, outside $PAM_DIR and $pam_vendor, which setup doesn't look through"
                return 1
                ;;
            path)
                if ! trusted "$_pn_name" missing-ok; then
                    why="$_pn_file names $_pn_named: $why"
                    return 1
                fi
                test -f "$trusted_to" || continue
                _pn_prefix=
                case "$trusted_to" in
                    "$SYSTEM_ROOT"/bin/* | "$SYSTEM_ROOT"/sbin/* | "$SYSTEM_ROOT"/usr/bin/* | "$SYSTEM_ROOT"/usr/sbin/*) ;;
                    "$SYSTEM_ROOT"/lib/* | "$SYSTEM_ROOT"/lib64/* | "$SYSTEM_ROOT"/usr/lib/* | "$SYSTEM_ROOT"/usr/lib64/*) ;;
                    */bin/*) _pn_prefix=${trusted_to%/bin/*} ;;
                    */sbin/*) _pn_prefix=${trusted_to%/sbin/*} ;;
                    */lib/*) _pn_prefix=${trusted_to%/lib/*} ;;
                    */lib64/*) _pn_prefix=${trusted_to%/lib64/*} ;;
                esac
                if test -n "$_pn_prefix" && ! trusted_tree "$_pn_prefix"; then
                    why="$_pn_file names $_pn_named: $why"
                    return 1
                fi
                ;;
        esac
    done <<EOF
$_pn_names
EOF
}

# pam_include_inside NAME: whether NAME, a file a PAM file includes by its
# full path, which trusted has just followed, is one in PAM_DIR or the
# vendor's directory, which pam_names_trusted looks through, and sets
# pam_include to how that names it. That's either by its name, as one under
# either, wherever a link there leads, or by where it leads.
pam_include_inside() {
    case "$1" in
        */./* | */../* | */. | */..) ;;
        "$PAM_DIR"/*)
            pam_include=$1
            return 0
            ;;
        "$pam_vendor"/*)
            if test -n "$pam_vendor_root"; then
                pam_include=$1
                return 0
            fi
            ;;
    esac
    case "$trusted_to" in
        "$pam_root"/*)
            pam_include=$PAM_DIR/${trusted_to#"$pam_root"/}
            return 0
            ;;
    esac
    if test -n "$pam_vendor_root"; then
        case "$trusted_to" in
            "$pam_vendor_root"/*)
                pam_include=$pam_vendor/${trusted_to#"$pam_vendor_root"/}
                return 0
                ;;
        esac
    fi
    return 1
}

# ELF_IDENT_AWK reads the start of a file, as od -An -v -tu1 prints it,
# and prints the class, byte order and machine of the ELF file it is, or
# nothing when it isn't one.
# shellcheck disable=SC2016  # $i and the rest are awk's
ELF_IDENT_AWK='
    { for (i = 1; i <= NF; i++) b[n++] = $i + 0 }
    END {
        if (n < 20 || b[0] != 127 || b[1] != 69 || b[2] != 76 || b[3] != 70) exit
        print b[4], b[5], (b[5] == 1 ? b[18] + 256 * b[19] : 256 * b[18] + b[19])
    }'

# ELF_EXEC_AWK reads the start of a file, as od -An -v -tu1 prints it, the
# first 65536 bytes or all of it, and prints what the kernel makes of it as
# a program to start, given its size, size, and ident, the system's class,
# byte order and machine: static, for one it starts itself, interp and the
# loader it names, for one it starts with that loader, or why it won't:
# notelf, arch, noident, type, for an ELF file that isn't a program, entry,
# for one whose entry point isn't in code it loads from the file, headers,
# for program headers that aren't whole within what was read, short, for a
# part of it the kernel loads that runs past its end, or interp, for a
# loader it can't name.
# shellcheck disable=SC2016  # $i and the rest are awk's
ELF_EXEC_AWK='
    { for (i = 1; i <= NF; i++) b[n++] = $i + 0 }
    # The len-byte number at off, in the byte order of the file.
    function num(off, len,    v, i) {
        v = 0
        if (le) for (i = len - 1; i >= 0; i--) v = v * 256 + b[off + i]
        else for (i = 0; i < len; i++) v = v * 256 + b[off + i]
        return v
    }
    END {
        if (n < 52 || b[0] != 127 || b[1] != 69 || b[2] != 76 || b[3] != 70) { print "notelf"; exit }
        if (ident == "") { print "noident"; exit }
        le = b[5] == 1
        wide = b[4] == 2
        if (b[4] " " b[5] " " num(18, 2) != ident) { print "arch"; exit }
        # A program, or a position-independent one.
        type = num(16, 2)
        if (type != 2 && type != 3) { print "type"; exit }
        if (wide) {
            if (n < 64) { print "headers"; exit }
            entry = num(24, 8); phoff = num(32, 8); phsize = num(54, 2); phnum = num(56, 2)
        } else {
            entry = num(24, 4); phoff = num(28, 4); phsize = num(42, 2); phnum = num(44, 2)
        }
        # In ELF, an entry point of 0 means there is none.
        if (entry == 0) { print "entry"; exit }
        if (phnum == 0 || phnum == 65535 || phsize != (wide ? 56 : 32) || phoff + phnum * phsize > n) { print "headers"; exit }
        interp = ""
        code = 0
        for (k = 0; k < phnum; k++) {
            h = phoff + k * phsize
            ptype = num(h, 4)
            if (wide) { flags = num(h + 4, 4); off = num(h + 8, 8); vaddr = num(h + 16, 8); filesz = num(h + 32, 8) }
            else { off = num(h + 4, 4); vaddr = num(h + 8, 4); filesz = num(h + 16, 4); flags = num(h + 24, 4) }
            # PT_LOAD, mapped from the file, which faults past its end.
            if (ptype == 1 && off + filesz > size) { print "short"; exit }
            # The program starts at its entry point, which has to be in code
            # loaded from the file, mapped executable, as PF_X says.
            if (ptype == 1 && flags % 2 == 1 && entry >= vaddr && entry < vaddr + filesz) code = 1
            # PT_INTERP, a name ending in a NUL.
            if (ptype == 3) {
                if (filesz < 2 || off + filesz > n || b[off + filesz - 1] != 0) { print "interp"; exit }
                interp = ""
                for (i = off; i < off + filesz - 1; i++) {
                    if (b[i] < 33 || b[i] > 126) { print "interp"; exit }
                    interp = interp sprintf("%c", b[i])
                }
            }
        }
        if (!code) { print "entry"; exit }
        if (interp == "") print "static"
        else print "interp", interp
    }'

# ELF_AWK reads a file, as od -An -v -tu1 prints it, and prints exports
# and the functions PAM calls that it exports, a , after each, when it's an
# ELF shared object of the class, byte order and machine in ident, the
# system's, which is all dlopen takes. dlsym finds only a symbol it defines
# and exports, with default or protected visibility. Otherwise it prints
# notelf, arch, noident when ident isn't known, or unread when its symbols
# can't be read, as when strip has removed the section headers they're
# found by. Each fails, as what setup can't check does. Whether the loader
# can map and link it is ldd's to say.
# shellcheck disable=SC2016  # $i and the rest are awk's
ELF_AWK='
    { for (i = 1; i <= NF; i++) b[n++] = $i + 0 }
    # The len-byte number at off, in the byte order of the file.
    function num(off, len,    v, i) {
        v = 0
        if (le) for (i = len - 1; i >= 0; i--) v = v * 256 + b[off + i]
        else for (i = 0; i < len; i++) v = v * 256 + b[off + i]
        return v
    }
    END {
        if (n < 64 || b[0] != 127 || b[1] != 69 || b[2] != 76 || b[3] != 70 || (b[4] != 1 && b[4] != 2) || (b[5] != 1 && b[5] != 2)) {
            print "notelf"
            exit
        }
        wide = b[4] == 2
        le = b[5] == 1
        # ET_DYN, a shared object.
        if (num(16, 2) != 3) {
            print "notelf"
            exit
        }
        if (split(ident, id) != 3) {
            print "noident"
            exit
        }
        if (b[4] != id[1] || b[5] != id[2] || num(18, 2) != id[3]) {
            print "arch"
            exit
        }
        shoff = wide ? num(40, 8) : num(32, 4)
        shsize = wide ? num(58, 2) : num(46, 2)
        shnum = wide ? num(60, 2) : num(48, 2)
        if (shoff == 0 || shnum == 0 || shsize < (wide ? 64 : 40) || shoff + shnum * shsize > n) {
            print "unread"
            exit
        }
        for (s = 0; s < shnum; s++) {
            h = shoff + s * shsize
            # SHT_DYNSYM, and the string table it links to.
            if (num(h + 4, 4) != 11) continue
            dynsym = 1
            off = wide ? num(h + 24, 8) : num(h + 16, 4)
            size = wide ? num(h + 32, 8) : num(h + 20, 4)
            link = num(h + (wide ? 40 : 24), 4)
            ent = wide ? num(h + 56, 8) : num(h + 36, 4)
            if (link >= shnum || ent < (wide ? 24 : 16)) continue
            str = wide ? num(shoff + link * shsize + 24, 8) : num(shoff + link * shsize + 16, 4)
            for (o = off; o + ent <= off + size && o + ent <= n; o += ent) {
                bind = int(b[o + (wide ? 4 : 12)] / 16)
                vis = b[o + (wide ? 5 : 13)] % 4
                # Undefined, local, or hidden, it is not exported.
                if (num(o + (wide ? 6 : 14), 2) == 0 || (bind != 1 && bind != 2 && bind != 10) || (vis != 0 && vis != 3)) continue
                name = ""
                for (p = str + num(o, 4); p < n && b[p] != 0; p++) name = name sprintf("%c", b[p])
                if (name ~ /^pam_sm_(authenticate|setcred|acct_mgmt|open_session|close_session|chauthtok)$/ && !(name in has)) {
                    has[name] = 1
                    out = out name ","
                }
            }
        }
        if (!dynsym) {
            print "unread"
            exit
        }
        print "exports " out
    }'
pam_elf_ident_read=

# pam_module_check NAME: whether PAM finds the module NAME, by its full
# path, or named without one in pam_module_dir, and can load it, setting
# pam_module_exports to the functions PAM calls that it has, a , after
# each, or pam_module_why to why it can't, as when it isn't there. It loads
# only a library built for this system, as /bin/sh is, and one whose
# libraries and symbols the system's loader can all find, setting
# pam_module_untrusted to why when it, or one of those libraries, isn't
# root's alone.
pam_module_check() {
    pam_module_why=
    pam_module_exports=
    pam_module_untrusted=
    elf_ident_find
    case "$1" in
        /*) set -- "$1" ;;
        *) set -- "$pam_module_dir$1" ;;
    esac
    for _pm_module; do
        test -f "$_pm_module" || continue
        # PAM loads it as root, so it has to be root's alone, where a link
        # to it leads too, even in the package manager's directory.
        if ! trusted "$_pm_module"; then
            pam_module_untrusted=$why
            return 1
        fi
        # One setup can't read fails, as what it can't check does.
        if ! test -r "$_pm_module" \
            || ! _pm_verdict=$(od -An -v -tu1 -- "$_pm_module" | LC_ALL=C awk -v ident="$pam_elf_ident" "$ELF_AWK"); then
            test -n "$pam_module_why" || pam_module_why="which setup couldn't read"
            continue
        fi
        case "$_pm_verdict" in
            "exports "*)
                if pam_module_links "$_pm_module"; then
                    pam_module_exports=${_pm_verdict#exports }
                    return 0
                fi
                test -z "$pam_module_untrusted" || return 1
                ;;
            arch) _pm_why="which is built for another kind of machine than this one" ;;
            noident) _pm_why="which setup can't tell is built for this machine, since it couldn't read /bin/sh as one" ;;
            unread) _pm_why="whose functions setup can't read" ;;
            *) _pm_why="which isn't a library PAM can load" ;;
        esac
        test -n "$pam_module_why" || pam_module_why=$_pm_why
    done
    test -n "$pam_module_why" || pam_module_why="which isn't there"
    return 1
}

# elf_ident_find sets pam_elf_ident to the class, byte order and machine
# of this system's programs, as /bin/sh is built, once, or to nothing when
# it can't read it, and then no module or program passes.
elf_ident_find() {
    test "$pam_elf_ident_read" != yes || return 0
    pam_elf_ident=$(od -An -v -tu1 -N 20 /bin/sh | LC_ALL=C awk "$ELF_IDENT_AWK") || pam_elf_ident=
    pam_elf_ident_read=yes
}

# LDD_LIBS_AWK reads what ldd says and prints each file it says the loader
# loads, by its full path, one a line, or a ? and the rest of the line for
# one it names in a way setup can't read. Something mapped from no file,
# the vdso, is no file to check, and one not found is no file at all.
# shellcheck disable=SC2016  # $0 is awk's
LDD_LIBS_AWK='
    function lib(s) {
        if (s ~ /^\(0x[0-9a-fA-F]+\)$/) return
        if (s !~ /^\/[^ \t]+ \(0x[0-9a-fA-F]+\)$/) { print "?" s; return }
        sub(/ \(0x[0-9a-fA-F]+\)$/, "", s)
        print s
    }
    / => not found/ { next }
    / => / { s = $0; sub(/^.* => +/, "", s); lib(s); next }
    /^[ \t]+\// { s = $0; sub(/^[ \t]+/, "", s); lib(s) }'

# ldd_libs_trusted OUT WHO: whether only root can change each file ldd,
# whose output is OUT, says the loader loads for WHO, setting why if not.
# The loader takes a library from wherever an RPATH, a RUNPATH or
# ld.so.conf leads, and it runs as whatever loads it.
ldd_libs_trusted() {
    if ! _ll_libs=$(printf '%s\n' "$1" | LC_ALL=C awk "$LDD_LIBS_AWK"); then
        why="couldn't read what ldd says $2 loads"
        return 1
    fi
    while IFS= read -r _ll_lib; do
        case "$_ll_lib" in
            "") continue ;;
            "?"*)
                why="ldd says $2 loads ${_ll_lib#?}, which setup can't read as a file"
                return 1
                ;;
        esac
        if ! trusted "$_ll_lib"; then
            why="$2 loads $_ll_lib: $why"
            return 1
        fi
    done <<EOF
$_ll_libs
EOF
}

# pam_module_links FILE: whether the system's loader can load FILE as PAM
# does, binding every symbol at once, setting _pm_why if not: each library
# it needs is there, and each symbol it uses is defined, by one of them, or
# by a library greetd itself links, which a module it loads sees too. ldd
# has the loader map it and bind its symbols without running it.
pam_module_links() {
    if ! is_command ldd; then
        _pm_why="which setup can't check without ldd"
        return 1
    fi
    # What ldd says is read in C's words, whatever the locale.
    if ! _pl_out=$(unset LD_LIBRARY_PATH LD_PRELOAD; LC_ALL=C ldd -r -- "$1" 2>&1); then
        _pm_why="which the system's loader can't load"
        return 1
    fi
    _pl_lib=$(printf '%s\n' "$_pl_out" | sed -n 's/^[[:space:]]*\([^[:space:]]*\) => not found.*/\1/p' | head -n 1)
    if test -n "$_pl_lib"; then
        _pm_why="which needs $_pl_lib, which isn't there"
        return 1
    fi
    if ! ldd_libs_trusted "$_pl_out" "$1"; then
        pam_module_untrusted=$why
        _pm_why="which loads what isn't root's alone"
        return 1
    fi
    _pl_symbol=$(printf '%s\n' "$_pl_out" | sed -n 's/^undefined symbol: \([^[:space:],]*\).*/\1/p' | head -n 1)
    test -n "$_pl_symbol" || return 0
    # Without them, a symbol only they define isn't found.
    pam_greetd_libs_find
    if test -n "$pam_greetd_libs"; then
        if ! _pl_out=$(unset LD_LIBRARY_PATH; LD_PRELOAD=$pam_greetd_libs LC_ALL=C ldd -r -- "$1" 2>&1); then
            _pm_why="which the system's loader can't load"
            return 1
        fi
        _pl_symbol=$(printf '%s\n' "$_pl_out" | sed -n 's/^undefined symbol: \([^[:space:],]*\).*/\1/p' | head -n 1)
        test -n "$_pl_symbol" || return 0
    fi
    _pm_why="which needs $_pl_symbol, which nothing it loads defines"
    return 1
}
pam_greetd_libs_read=

# pam_greetd_libs_find sets pam_greetd_libs to the libraries greetd links,
# a space between each, and pam_libpam to the libpam among them, once.
# Neither is set when ldd can't say.
pam_greetd_libs_find() {
    test "$pam_greetd_libs_read" != yes || return 0
    pam_greetd_libs_read=yes
    pam_greetd_libs=
    pam_libpam=
    test -n "$greetd_exe" || return 0
    _pg_out=$(unset LD_LIBRARY_PATH LD_PRELOAD; LC_ALL=C ldd -- "$greetd_exe" 2>&1) || return 0
    pam_greetd_libs=$(printf '%s\n' "$_pg_out" | sed -n 's/^.* => \(\/[^[:space:]]*\) (.*/\1/p' | tr '\n' ' ')
    pam_greetd_libs=${pam_greetd_libs% }
    pam_libpam=$(printf '%s\n' "$_pg_out" | sed -n 's/^[[:space:]]*libpam\.so[^[:space:]]* => \(\/[^[:space:]]*\) (.*/\1/p' | head -n 1)
}

# pam_module_dir_find sets pam_module_dir to the directory greetd's libpam
# loads a module named without a full path from, setting why if setup
# can't tell, or someone other than root could change what's there. libpam
# puts the name after a directory fixed when it was built, and keeps that
# as a string of its own, the only one that's a directory named security.
# One outside the package manager's directories is checked like a module
# named by its full path: the whole prefix it's in.
pam_module_dir_find() {
    pam_module_dir=
    pam_greetd_libs_find
    if test -z "$pam_libpam"; then
        why="setup couldn't find the libpam greetd loads, so it can't tell where PAM finds its modules"
        return 1
    fi
    if ! test -r "$pam_libpam" || ! _pd_text=$(LC_ALL=C tr '\0' '\n' < "$pam_libpam"); then
        why="setup couldn't read $pam_libpam, so it can't tell where PAM finds its modules"
        return 1
    fi
    _pd_dirs=$(printf '%s\n' "$_pd_text" | LC_ALL=C awk '/^\/([^\/]+\/)*security\/$/ && !/^\/etc\// && !seen[$0]++')
    case "$_pd_dirs" in
        "" | *"
"*)
            why="setup couldn't tell where $pam_libpam finds PAM's modules"
            return 1
            ;;
    esac
    case "$_pd_dirs" in
        "$SYSTEM_ROOT"/lib/* | "$SYSTEM_ROOT"/lib64/* | "$SYSTEM_ROOT"/usr/lib/* | "$SYSTEM_ROOT"/usr/lib64/*) ;;
        */lib/* | */lib64/*)
            if ! trusted_tree "${_pd_dirs%/lib*/*}"; then
                why="PAM's modules, in $_pd_dirs, aren't root's alone: $why"
                return 1
            fi
            ;;
        *)
            if ! trusted_tree "${_pd_dirs%/}"; then
                why="PAM's modules, in $_pd_dirs, aren't root's alone: $why"
                return 1
            fi
            ;;
    esac
    pam_module_dir=$_pd_dirs
}

# pam_program_runs NAME: whether the program pam_exec runs as NAME is there
# and can be run, one named without a full path from greetd's directory, /,
# as program_starts says, setting pam_program_status to what that returned,
# or 1 when it isn't there.
pam_program_runs() {
    case "$1" in
        /*) set -- "$1" ;;
        *) set -- "/$1" ;;
    esac
    pam_program_status=1
    test -f "$1" && test -x "$1" || return 1
    program_starts "$1" "$SERVICE_PATH"
    pam_program_status=$?
    test "$pam_program_status" -eq 0
}

# CHAIN_AWK reads the PAM stack of a service as libpam does, and prints, one
# a line, each handler libpam makes of it, in order, and each line it
# makes a failing one of. It reads the service from its file, in PAM_DIR or
# else the vendor directory, and its other service from other, the same
# way, every include in place, and takes as libpam does what each line
# says: whatever its case, a - before its type, an @include where PAM is
# Debian's, a control a list of result=action, and a [word] as one. What the
# versions of PAM in use read differently, or stop reading the stack at,
# stops it. Its input is the environment, PAM_CHAIN_ and SERVICE, DIR,
# VENDOR (none when there is none), DEBIAN (yes or no), FILES (the files in
# both, one a line), FULLPATHS (each include by its full path a tab and
# where in them it leads, one a line), and OVERRIDE and TEXT (a file, and
# what to read in its place). It prints, a tab between each:
#   S CHAIN FILE: the file the service, conf, or other, is read from.
#   I CHAIN FILE: each file it reads, that one and each it includes.
#   H CHAIN TYPE LEVEL KIND ACTIONS =MODULE SPEC =PROGRAM =ARGS FILE: a
#     handler for TYPE, at the substack LEVEL, of KIND M (a module), S (a
#     substack) or F (a line that fails), with ACTIONS, as PAM numbers each
#     of the 32 results, and SPEC, what the module returns, as below.
#   E CHAIN TYPE FILE WHAT =DETAIL: a line that fails, or, CHAIN all, one
#     that stops PAM reading the stack.
# shellcheck disable=SC2016  # $1 and the rest are awk's
CHAIN_AWK='
    # PAM breaks a line into words at spaces, tabs and newlines, and takes
    # a word that starts with [ to run to the first ], a \] in it standing
    # for ], as one word without its brackets. Each is in w, and as it is
    # written in raw.
    function words(s, w, raw,    n, i, len, c, t, at) {
        n = 0
        i = 1
        len = length(s)
        while (1) {
            while (i <= len && index(" \t\n", substr(s, i, 1))) i++
            if (i > len) break
            t = ""
            at = i
            if (substr(s, i, 1) == "[") {
                for (i++; i <= len && (c = substr(s, i, 1)) != "]"; i++) {
                    if (c == "\\" && substr(s, i + 1, 1) == "]") c = substr(s, ++i, 1)
                    t = t c
                }
                raw[n + 1] = substr(s, at, i - at + 1)
            } else {
                for (; i <= len && !index(" \t\n", c = substr(s, i, 1)); i++) t = t c
                raw[n + 1] = t
            }
            i++
            w[++n] = t
        }
        return n
    }
    function norm(p) {
        while (sub(/\/\.\//, "/", p)) ;
        gsub(/\/\/+/, "/", p)
        return p
    }
    # Where PAM finds the file it includes as name: by its full path, or
    # in its own directory, then the vendor one. One named by its full path
    # is where pam_names_trusted found it leads, inside either.
    function locate(name,    q) {
        if (name ~ /^\//) return (name in fullpath) ? norm(fullpath[name]) : ""
        q = norm(dir "/" name)
        if (q in files || q == override) return q
        if (vendor == "") return ""
        q = norm(vendor "/" name)
        return (q in files) ? q : ""
    }
    # The lines of the file at path p, into raw, and how many.
    function load(p, raw,    n, r, l) {
        if (p == override) {
            n = split(text, raw, "\n")
            if (n > 0 && raw[n] == "") delete raw[n--]
            return n
        }
        n = 0
        while ((r = (getline l < p)) > 0) raw[++n] = l
        close(p)
        return n
    }
    # Every action bad, ok, done and the rest as PAM numbers them, for each
    # result it has none for yet.
    function fill(act, a,    r) {
        for (r = 0; r < 32; r++) if (act[r] == -6) act[r] = a
    }
    # What a control PAM reads as a list of result=action sets act to,
    # returning 0, with every action bad, where it can not read one: each a
    # result it knows, or default, which sets those without one, and an
    # action it knows, or a jump of one or more.
    function control(c, act,    r, a, len, num) {
        while (1) {
            sub(/^[ \t\n\v\f\r]+/, "", c)
            if (c == "") return 1
            for (r = 0; r <= 32; r++) if (substr(c, 1, length(result[r])) == result[r]) break
            if (r > 32 || length(c) == length(result[r])) break
            c = substr(c, length(result[r]) + 1)
            sub(/^[ \t\n\v\f\r]+/, "", c)
            if (substr(c, 1, 1) != "=") break
            c = substr(c, 2)
            sub(/^[ \t\n\v\f\r]+/, "", c)
            if (c == "") break
            for (a = 0; a < 6; a++) if (substr(c, 1, length(action[a])) == action[a]) break
            if (a < 6) {
                c = substr(c, length(action[a]) + 1)
                a = -a
            } else {
                if (!match(c, /^[0-9]+/)) break
                num = substr(c, 1, RLENGTH) + 0
                c = substr(c, RLENGTH + 1)
                # PAM 1.6 refuses a jump too big for an int, and earlier
                # ones overflow.
                if (num == 0 || num > 2147483647) break
                a = num
            }
            if (r < 32) act[r] = a
            else fill(act, a)
        }
        for (r = 0; r < 32; r++) act[r] = -3
        return 0
    }
    # Whether PAM, which names a handler after its module, or the file a
    # substack reads, from its last / to its last ., refuses the name.
    function badname(m) {
        sub(/.*\//, "", m)
        sub(/\.[^.]*$/, "", m)
        return m == "" || m == "?"
    }
    # What pam_exec returns, run for ptype, given the words w after mi: as
    # in spec, below.
    function execs(w, n, mi, ptype,    i, a) {
        if (mi >= n) return "3"
        for (i = mi + 1; i <= n; i++) {
            a = w[i]
            if (substr(a, 1, 1) == "/") return "x"
            a = tolower(a)
            if (a ~ /^(debug|stdout|seteuid|quiet|quiet_log|expose_authtok)$/ || a ~ /^log=/) continue
            if (a !~ /^type=/) return "x"
            if (substr(w[i], 6) != ptype) return "25"
        }
        return "3"
    }
    # pam_debug returns, to a call, the result named by the first of its
    # arguments for that call, or success when none is, or when that one
    # names none.
    function debugs(w, n, mi, call,    i) {
        for (i = mi + 1; i <= n; i++) {
            if (substr(w[i], 1, length(call) + 1) != call "=") continue
            return (substr(w[i], length(call) + 2) in code) ? code[substr(w[i], length(call) + 2)] : 0
        }
        return 0
    }
    function hasword(w, n, mi, a,    i) {
        for (i = mi + 1; i <= n; i++) if (w[i] == a) return 1
        return 0
    }
    function program(w, n, mi,    i, a) {
        for (i = mi + 1; i <= n; i++) {
            a = tolower(w[i])
            if (substr(a, 1, 1) != "/" && (a ~ /^(debug|stdout|seteuid|quiet|quiet_log|expose_authtok)$/ || a ~ /^(log|type)=/)) continue
            return w[i]
        }
        return ""
    }
    function stop(p, what, detail) {
        print "E", "all", "-", p, what, "=" detail
        exit
    }
    function failed(chain, type, p, what, detail) {
        print "E", chain, type, p, what, "=" detail
    }
    function handler(kind, chain, type, level, act, module, spec, prog, args, p,    r, s) {
        s = act[0]
        for (r = 1; r < 32; r++) s = s "," act[r]
        print "H", chain, type, level, kind, s, "=" module, spec, "=" prog, "=" args, p
    }
    function parse(p, chain, req, depth, level,    raw, n, k, s, t, i, at, carried, line) {
        print "I", chain, p
        n = load(p, raw)
        at = 0
        carried = 0
        line = ""
        for (k = 1; k <= n; k++) {
            s = raw[k]
            # PAM before 1.6 reads a line into what is left of 1024 bytes,
            # and splits one too long for it.
            if (at + length(s) + 1 > 1023) stop(p, "long", "")
            t = s
            sub(/^[ \t]+/, "", t)
            if (t == "" || substr(t, 1, 1) == "#") {
                # PAM 1.6 and later end a line a backslash carries on at a
                # blank or comment line, and earlier ones carry it past.
                if (carried) stop(p, "carried", "")
                continue
            }
            if (i = index(t, "#")) {
                entry(line substr(t, 1, i - 1), p, chain, req, depth, level)
            } else if (match(t, /\\[ \t]*$/)) {
                line = line substr(t, 1, RSTART - 1) " "
                at += length(s) - length(t) + RSTART
                carried = 1
                continue
            } else {
                entry(line t, p, chain, req, depth, level)
            }
            line = ""
            carried = 0
            at = 0
        }
        if (carried) stop(p, "dangling", "")
    }
    function entry(line, p, chain, req, depth, level,    w, raw, n, i, t, type, at, broken, act, c, incl, sub1, mi, m, base, args, spec, prog) {
        n = words(line, w, raw)
        for (i = 0; i < 32; i++) act[i] = -6
        if (n == 0) {
            type = req == "any" ? "auth" : req
            failed(chain, type, p, "empty", "")
            fill(act, -3)
            handler("F", chain, type, level, act, "", "", "", "", p)
            return
        }
        t = w[1]
        if (substr(t, 1, 1) == "-") t = substr(t, 2)
        t = tolower(t)
        at = 0
        broken = 0
        if (debian == "yes" && t == "@include") {
            at = 1
            type = req
        } else if (t == "auth" || t == "account" || t == "session" || t == "password") {
            type = t
        } else {
            type = req == "any" ? "auth" : req
            broken = 1
            failed(chain, type, p, "badtype", raw[1])
        }
        if (!at && req != "any" && type != req) return
        incl = at
        sub1 = 0
        mi = at ? 2 : 3
        if (!at && n < 2) {
            fill(act, -3)
            broken = 1
            failed(chain, type, p, "nocontrol", "")
        } else if (!at) {
            c = tolower(w[2])
            if (c == "required" || c == "requisite") {
                act[0] = act[12] = -1
                act[25] = 0
                fill(act, c == "required" ? -3 : -4)
            } else if (c == "optional" || c == "sufficient") {
                act[0] = act[12] = c == "optional" ? -1 : -2
                fill(act, 0)
            } else if (c == "include" || c == "substack") {
                incl = 1
                sub1 = c == "substack"
            } else {
                if (!control(w[2], act)) failed(chain, type, p, "badcontrol", raw[2])
                fill(act, -3)
            }
        }
        if (incl) {
            m = mi <= n ? w[mi] : ""
            if (sub1) {
                if (m != "" && badname(m)) stop(p, "badname", m)
                handler("S", chain, type, level, act, "", "", "", "", p)
            }
            # PAM loads an include it can not read as a line that fails,
            # and stops reading the stack at one an @include in a file read
            # whole makes.
            if (m == "") {
                if (type == "any") stop(p, "noinclude", "")
                failed(chain, type, p, "noinclude", "")
            } else if (depth + 1 >= 16) {
                if (type == "any") stop(p, "deep", m)
                failed(chain, type, p, "deep", m)
            } else if ((t = locate(m)) == "") {
                if (type == "any") stop(p, "missing", m)
                failed(chain, type, p, "missing", m)
            } else {
                parse(t, chain, type, depth + 1, level + sub1)
                return
            }
            fill(act, -3)
            handler("F", chain, type, level, act, "", "", "", "", p)
            return
        }
        if (mi > n) {
            failed(chain, type, p, "nomodule", "")
            handler("F", chain, type, level, act, "", "", "", "", p)
            return
        }
        m = w[mi]
        if (badname(m)) stop(p, "badname", m)
        if (m ~ /\t/) stop(p, "tab", m)
        if (broken) {
            handler("F", chain, type, level, act, m, "", "", "", p)
            return
        }
        args = ""
        for (i = mi + 1; i <= n; i++) {
            t = w[i]
            gsub(/\t/, " ", t)
            args = args (i > mi + 1 ? " " : "") t
        }
        # What the module returns to each call: authenticating, setting
        # credentials, the account, opening and closing a session, and the
        # check and the change of a password; f when it may return anything,
        # n when anything but success, x when pam_exec returns success or
        # system_err as the program it runs does. pam_debug returns what its
        # arguments say. Modules Linux-PAM ships
        # are in known where some call can never succeed, as one that only
        # sets a delay or a prompt can not, so a stack of nothing else fails.
        base = m
        sub(/.*\//, "", base)
        prog = ""
        if (base == "pam_exec.so") {
            spec = execs(w, n, mi, "auth") "/25/" execs(w, n, mi, "account") "/" execs(w, n, mi, "open_session") "/" execs(w, n, mi, "close_session") "/0/" execs(w, n, mi, "password")
            prog = program(w, n, mi)
        } else if (base == "pam_debug.so") {
            spec = debugs(w, n, mi, "auth") "/" debugs(w, n, mi, "cred") "/" debugs(w, n, mi, "acct") "/" debugs(w, n, mi, "open_session") "/" debugs(w, n, mi, "close_session") "/" debugs(w, n, mi, "prechauthtok") "/" debugs(w, n, mi, "chauthtok")
        } else if (base == "pam_nologin.so" && !hasword(w, n, mi, "successok")) spec = "n/25/n/f/f/f/f"
        else if (base == "pam_wheel.so" && !hasword(w, n, mi, "trust")) spec = "n/f/n/f/f/f/f"
        else if (base in known) spec = known[base]
        else spec = "f/f/f/f/f/f/f"
        handler("M", chain, type, level, act, m, spec, prog, args, p)
    }
    BEGIN {
        OFS = "\t"
        split("success open_err symbol_err service_err system_err buf_err perm_denied auth_err cred_insufficient authinfo_unavail user_unknown maxtries new_authtok_reqd acct_expired session_err cred_unavail cred_expired cred_err no_module_data conv_err authtok_err authtok_recover_err authtok_lock_busy authtok_disable_aging try_again ignore abort authtok_expired module_unknown bad_item conv_again incomplete default", tmp, " ")
        for (i = 0; i <= 32; i++) result[i] = tmp[i + 1]
        for (i = 0; i < 32; i++) code[result[i]] = i
        split("ignore ok done bad die reset", tmp, " ")
        for (i = 0; i < 6; i++) action[i] = tmp[i + 1]
        # From the source of each in Linux-PAM 1.7: ignore, a fixed
        # error, or n for a call that returns either but never success.
        known["pam_deny.so"] = "7/17/7/14/14/20/20"
        known["pam_permit.so"] = "0/0/0/0/0/0/0"
        known["pam_access.so"] = known["pam_ftp.so"] = known["pam_sepermit.so"] = "f/25/f/f/f/f/f"
        known["pam_succeed_if.so"] = known["pam_usertype.so"] = "f/25/f/f/f/f/f"
        known["pam_canonicalize_user.so"] = known["pam_faildelay.so"] = known["pam_issue.so"] = "n/25/f/f/f/f/f"
        known["pam_echo.so"] = "f/25/f/f/25/f/25"
        known["pam_env.so"] = "25/f/3/f/f/3/3"
        known["pam_group.so"] = known["pam_keyinit.so"] = known["pam_mail.so"] = "25/f/f/f/f/f/f"
        known["pam_motd.so"] = "f/f/f/n/25/f/f"
        known["pam_selinux.so"] = "7/f/f/f/f/f/f"
        known["pam_warn.so"] = "25/25/25/25/25/25/25"
        service = ENVIRON["PAM_CHAIN_SERVICE"]
        dir = ENVIRON["PAM_CHAIN_DIR"]
        vendor = ENVIRON["PAM_CHAIN_VENDOR"]
        debian = ENVIRON["PAM_CHAIN_DEBIAN"]
        n = split(ENVIRON["PAM_CHAIN_FILES"], tmp, "\n")
        for (i = 1; i <= n; i++) if (tmp[i] != "") files[norm(tmp[i])] = 1
        n = split(ENVIRON["PAM_CHAIN_FULLPATHS"], tmp, "\n")
        for (i = 1; i <= n; i++) if ((k = index(tmp[i], "\t")) > 0) fullpath[substr(tmp[i], 1, k - 1)] = substr(tmp[i], k + 1)
        override = ENVIRON["PAM_CHAIN_OVERRIDE"]
        if (override != "") override = norm(override)
        text = ENVIRON["PAM_CHAIN_TEXT"]
        if ((p = locate(service)) != "") {
            print "S", "conf", p
            parse(p, "conf", "any", 0, 0)
        }
        if ((p = locate("other")) != "") {
            print "S", "other", p
            parse(p, "other", "any", 0, 0)
        }
    }
'

# SIM_AWK walks, as libpam does, the handlers CHAIN_AWK prints of a
# service, each through every result its module can return, and says
# whether every call greetd makes can succeed, for the login or greeter
# mode names: for a login, authenticating, the account, setting
# credentials and opening the session, and for the greeter the same
# without authenticating. Its input is what CHAIN_AWK printed, with what
# setup found of each module and program, a tab between each:
#   T M =MODULE +FUNCTIONS =: one PAM can load, with the functions it has
#     that PAM calls, a , after each, or T M =MODULE - =WHY: one it can't.
#   T P =PROGRAM yes or no: whether pam_exec can run it, and after yes,
#     what pam_exec returns for it, when that is always the same.
# Run with phase=plan, it prints M =MODULE and P =PROGRAM for each module
# and program the calls run, for the shell to find out about. Otherwise
# it prints ok, or R and why not:
#   R error FILE WHAT =DETAIL TYPE: a line that fails, from CHAIN_AWK.
#   R needs FILE =MODULE TYPE =WHY: a module PAM can't load or call on a
#     line that fails without it.
#   R runs FILE =PROGRAM TYPE: a program pam_exec can't run on such a line.
#   R noprogram FILE =MODULE TYPE: a pam_exec line with no program.
#   R fail CALL CHAIN TYPE FILE module =MODULE =WHY: a call that can't
#     succeed whatever the modules return, but would with the first module
#     PAM can't call there, or program pam_exec can't run, R fail CALL
#     CHAIN TYPE FILE program =PROGRAM, or with neither, R fail CALL CHAIN
#     TYPE FILE -; or R empty CALL TYPE FILE for one with no handlers. With report=yes it prints
#     every result each call can return instead, for the tests.
# Debian, debian=yes, ignores the result of a line that jumps when it
# sets credentials, and upstream PAM counts it as ok.
# shellcheck disable=SC2016  # $1 and the rest are awk's
SIM_AWK='
    # Whether an action, as PAM numbers them, counts a result against the
    # stack: ok and done, which make it what the stack returns, and bad and
    # die.
    function fails(a) {
        a += 0
        return a == -1 || a == -2 || a == -3 || a == -4
    }
    # Whether PAM can call function f, numbered as in a spec, on module m.
    function works(m, f) {
        return loads[m] && index(exports[m], "," symbol[f] ",") > 0
    }
    # Why module m can not do what a line of type t needs of it, or nothing.
    function lacks(m, t,    i, f) {
        if (!loads[m]) return why[m]
        for (i = 1; i <= split(calls[t], f, " "); i++) if (!works(m, f[i])) return "which has no " symbol[f[i]] " for PAM to call on " t " lines"
        return ""
    }
    # What handler k of the list c keeps for type t can return when PAM calls
    # function f: what a line PAM can not read fails with, what a module PAM
    # can not call returns, and otherwise what its spec says.
    function outcomes(c, t, k, f,    s, m) {
        if (KD[c, t, k] == "F") return "6"
        m = MD[c, t, k]
        if (!works(m, f) && m != fix) return "28"
        split(SP[c, t, k], s, "/")
        if (s[f] == "f") return free
        if (s[f] == "n") return notok
        if (s[f] == "x") {
            if (PG[c, t, k] == fixprog) return "0,4"
            if (!runs[PG[c, t, k]]) return "4"
            return (PG[c, t, k] in exits) ? exits[PG[c, t, k]] : "0,4"
        }
        return s[f]
    }
    # One of each result in the list o that the stack tells apart at
    # handler k: what the line does with it, and whether it is success,
    # new_authtok_reqd or ignore, which PAM checks for.
    function reps(k, o,    p, j, n, r, key, seen1, out) {
        n = split(o, p, ",")
        out = ""
        for (j = 1; j <= n; j++) {
            r = p[j] + 0
            key = ac[k, r] ":" (r == 0 || r == 12 || r == 25 ? r : "x")
            if (key in seen1) continue
            seen1[key] = 1
            out = out (out == "" ? "" : ",") r
        }
        return out
    }
    # Reads the list c keeps for type t into the arrays the walk reads, with
    # what each handler returns to function f1, and to f2 if there is one.
    function list(c, t, f1, f2,    k, a, r) {
        n = nh[c, t] + 0
        for (k = 1; k <= n; k++) {
            lv[k] = LV[c, t, k] + 0
            kd[k] = KD[c, t, k]
            split(AC[c, t, k], a, ",")
            for (r = 0; r < 32; r++) ac[k, r] = a[r + 1] + 0
            A[k] = kd[k] == "S" ? "0" : reps(k, outcomes(c, t, k, f1))
            B[k] = kd[k] == "S" || !f2 ? "0" : reps(k, outcomes(c, t, k, f2))
        }
    }
    # The state of a walk about to run handler i, or that has run them all
    # and returns st: PAM fails a stack that succeeds with no module that
    # said so. Only the substacks it is in, down to level 0, matter.
    function state(i, imp, st, prev, subs,    p, j, out) {
        if (i > n) return "F " (st == 0 && imp != 1 ? 6 : st)
        split(subs, p, ",")
        out = p[1]
        for (j = 2; j <= lv[i] + 1 && (j in p); j++) out = out "," p[j]
        return i " " imp " " st " " prev " " out
    }
    # PAM running handler i, as _pam_dispatch_aux does, when its module
    # returns r and the action is taken for cv, which differs when setting
    # credentials follows authenticating, and cached says it does.
    function step(i, imp, st, prev, subs, r, cv, cached,    L, a, p, j, left, k, saved) {
        L = lv[i]
        if (prev < L) {
            k = split(subs, p, ",")
            while (k < L + 1) p[++k] = "0:6"
            p[L + 1] = imp ":" st
            subs = p[1]
            for (j = 2; j <= k; j++) subs = subs "," p[j]
        }
        if (kd[i] == "S") return state(i + 1, imp, st, L, subs)
        a = ac[i, cv]
        if (a == -5) {
            split(subs, p, ",")
            saved = p[L + 1]
            split(saved, p, ":")
            return state(i + 1, p[1] + 0, p[2] + 0, L, subs)
        }
        if (a == -1 || a == -2) {
            if ((imp == 0 || (imp == 1 && st == 0)) && (r != 25 || cv == r)) {
                imp = 1
                st = r
            }
            if (imp == 1 && a == -2) return state(done(i), imp, st, L, subs)
            return state(i + 1, imp, st, L, subs)
        }
        if (a == -3 || a == -4) {
            if (imp != -1) {
                imp = -1
                st = r == 25 ? 6 : r
            }
            if (a == -4) return state(done(i), imp, st, L, subs)
            return state(i + 1, imp, st, L, subs)
        }
        if (a == 0) return state(i + 1, imp, st, L, subs)
        # A jump: Debian PAM ignores the result, and upstream PAM, setting
        # credentials, counts it as ok too.
        if (a > 0 && cached && debian != "yes" && (imp == 0 || (imp == 1 && st == 0)) && (r != 25 || cv == r)) {
            imp = 1
            st = r
        }
        j = i
        for (left = a > 0 ? a : 1; a > 0 && j < n && lv[j + 1] >= L && left > 0; left--) {
            do {
                j++
            } while (j < n && lv[j + 1] > L)
        }
        if (left > 0) {
            imp = -1
            st = 6
        }
        return state(j + 1, imp, st, L, subs)
    }
    # The handler after the rest of the substack i is in.
    function done(i,    j) {
        for (j = i; j < n && lv[j + 1] >= lv[i]; j++) ;
        return j + 1
    }
    function push(s) {
        if (s in seen) return
        seen[s] = 1
        q[++tail] = s
    }
    # Every result PAM can return walking the list once, into fin.
    function walk(cached,    head, p, i, o, j, m) {
        split("", seen)
        split("", fin)
        if (n == 0) {
            fin[6] = 1
            return
        }
        tail = 0
        push(state(1, 0, 6, 0, "0:6"))
        for (head = 1; head <= tail; head++) {
            if (q[head] ~ /^F /) {
                fin[substr(q[head], 3) + 0] = 1
                continue
            }
            split(q[head], p, " ")
            i = p[1] + 0
            m = split(A[i], o, ",")
            for (j = 1; j <= m; j++) push(step(i, p[2] + 0, p[3] + 0, p[4] + 0, p[5], o[j] + 0, o[j] + 0, cached))
        }
    }
    # Authenticating, then setting credentials on the chain that froze,
    # into pairs: PAM sets them as each handler authenticating ran returned,
    # and as one it skipped returns now.
    function joint(    head, h, a, s, ai, si, oa, os, ka, ks, x, y, start) {
        split("", seen)
        split("", pairs)
        if (n == 0) {
            pairs["6 6"] = 1
            return
        }
        tail = 0
        start = state(1, 0, 6, 0, "0:6")
        push(start "|" start)
        for (head = 1; head <= tail; head++) {
            split(q[head], h, "|")
            split(h[1], a, " ")
            split(h[2], s, " ")
            ai = a[1] == "F" ? n + 1 : a[1] + 0
            si = s[1] == "F" ? n + 1 : s[1] + 0
            if (ai > n && si > n) {
                pairs[a[2] " " s[2]] = 1
            } else if (ai < si) {
                ka = split(A[ai], oa, ",")
                for (x = 1; x <= ka; x++) push(step(ai, a[2] + 0, a[3] + 0, a[4] + 0, a[5], oa[x] + 0, oa[x] + 0, 0) "|" h[2])
            } else if (si < ai) {
                ks = split(B[si], os, ",")
                for (y = 1; y <= ks; y++) push(h[1] "|" step(si, s[2] + 0, s[3] + 0, s[4] + 0, s[5], os[y] + 0, os[y] + 0, 1))
            } else {
                ka = split(A[ai], oa, ",")
                ks = split(B[ai], os, ",")
                for (x = 1; x <= ka; x++)
                    for (y = 1; y <= ks; y++)
                        push(step(ai, a[2] + 0, a[3] + 0, a[4] + 0, a[5], oa[x] + 0, oa[x] + 0, 0) "|" step(si, s[2] + 0, s[3] + 0, s[4] + 0, s[5], os[y] + 0, oa[x] + 0, 1))
            }
        }
    }
    # Whether greetd can get through call, with the module fix taken as one
    # PAM can use: authenticating, the account, which with new_authtok_reqd
    # takes changing the password, setting credentials, which for a login
    # follows the chain authenticating froze, and opening the session.
    function can(call,    x, y) {
        if (call == "authenticate" || (call == "setcred" && mode == "login")) {
            list(use["auth"], "auth", 1, 2)
            joint()
            for (x in pairs) {
                split(x, y, " ")
                if (call == "authenticate" ? y[1] == 0 : x == "0 0") return 1
            }
            return 0
        }
        if (call == "setcred") {
            list(use["auth"], "auth", 2, 0)
            walk(1)
            return (0 in fin)
        }
        if (call == "account") {
            list(use["account"], "account", 3, 0)
            walk(0)
            if (0 in fin) return 1
            expired = (12 in fin)
            return expired && can("chauthtok")
        }
        if (call == "chauthtok") {
            list(use["password"], "password", 6, 0)
            walk(0)
            if (!(0 in fin)) return 0
            list(use["password"], "password", 7, 0)
            walk(0)
            return (0 in fin)
        }
        list(use["session"], "session", 4, 0)
        walk(0)
        return (0 in fin)
    }
    # Refuses call, made on the lines of type t, naming the first module
    # there PAM can not use without which the call would succeed, and why.
    function refuse(call, t,    c, f, k, m, more) {
        c = use[t]
        if (!nh[c, t]) {
            print "R", "empty", call, t, ("conf" in src) ? src["conf"] : "-"
            exit
        }
        f = spec[call]
        more = "\t-"
        for (k = 1; k <= nh[c, t] && more == "\t-"; k++) {
            if (KD[c, t, k] != "M") continue
            m = MD[c, t, k]
            if (!works(m, f)) {
                fix = m
                if (can(call)) more = "\tmodule\t=" m "\t=" (loads[m] ? "which has no " symbol[f] : why[m])
                fix = ""
            } else if (PG[c, t, k] != "" && !runs[PG[c, t, k]]) {
                fixprog = PG[c, t, k]
                if (can(call)) more = "\tprogram\t=" fixprog
                fixprog = ""
            }
        }
        print "R", "fail", call, c, t, src[c] more
        exit
    }
    BEGIN {
        FS = OFS = "\t"
        notok = "1"
        for (r = 2; r <= 30; r++) notok = notok "," r
        free = "0," notok
        split("pam_sm_authenticate pam_sm_setcred pam_sm_acct_mgmt pam_sm_open_session pam_sm_close_session pam_sm_chauthtok pam_sm_chauthtok", symbol, " ")
        calls["auth"] = "1 2"
        calls["account"] = "3"
        calls["session"] = "4"
        calls["password"] = "6"
        # The call greetd makes on each type, as a spec numbers them.
        main["auth"] = 1
        main["account"] = 3
        main["session"] = 4
        main["password"] = 7
        spec["authenticate"] = 1
        spec["setcred"] = 2
        spec["account"] = 3
        spec["session"] = 4
        spec["chauthtok"] = 7
    }
    $1 == "S" {
        src[$2] = $3
        next
    }
    $1 == "E" {
        e[++en] = $0
        next
    }
    $1 == "H" {
        k = ++nh[$2, $3]
        LV[$2, $3, k] = $4
        KD[$2, $3, k] = $5
        AC[$2, $3, k] = $6
        MD[$2, $3, k] = substr($7, 2)
        SP[$2, $3, k] = $8
        PG[$2, $3, k] = substr($9, 2)
        FL[$2, $3, k] = $11
        next
    }
    $1 == "T" && $2 == "M" {
        m = substr($3, 2)
        loads[m] = $4 != "-"
        exports[m] = "," substr($4, 2) ","
        why[m] = substr($5, 2)
        next
    }
    $1 == "T" && $2 == "P" {
        runs[substr($3, 2)] = $4 == "yes"
        if ($5 != "") exits[substr($3, 2)] = $5
        next
    }
    END {
        # A type the service has no lines of PAM takes from its other
        # service.
        split("auth account session password", types, " ")
        for (i = 1; i <= 4; i++) use[types[i]] = nh["conf", types[i]] ? "conf" : "other"
        if (phase == "plan") {
            for (i = 1; i <= 4; i++) {
                t = types[i]
                c = use[t]
                for (k = 1; k <= nh[c, t]; k++) {
                    if (KD[c, t, k] != "M") continue
                    if (!((m = MD[c, t, k]) in planned)) print "M", "=" m
                    planned[m] = 1
                    if ((m = PG[c, t, k]) != "" && !(("=" m) in planned)) print "P", "=" m
                    planned["=" m] = 1
                }
            }
            exit
        }
        for (i = 1; i <= en && report != "yes"; i++) {
            split(e[i], f, "\t")
            if (f[2] == "other" && use[f[3]] != "other") continue
            print "R", "error", f[4], f[5], f[6], f[3]
            exit
        }
        for (i = 1; i <= 4 && report != "yes"; i++) {
            t = types[i]
            c = use[t]
            for (k = 1; k <= nh[c, t]; k++) {
                if (KD[c, t, k] != "M") continue
                m = MD[c, t, k]
                split(AC[c, t, k], a, ",")
                split(SP[c, t, k], s, "/")
                if (fails(a[29]) && (w = lacks(m, t)) != "") {
                    print "R", "needs", FL[c, t, k], "=" m, t, "=" w
                    exit
                }
                if (!works(m, main[t])) continue
                if (s[main[t]] == "x" && !runs[PG[c, t, k]] && fails(a[5])) {
                    print "R", "runs", FL[c, t, k], "=" PG[c, t, k], t
                    exit
                }
                if (s[main[t]] == "3" && fails(a[4])) {
                    print "R", "noprogram", FL[c, t, k], "=" m, t
                    exit
                }
            }
        }
        if (report == "yes") {
            if (mode == "login") {
                list(use["auth"], "auth", 1, 2)
                joint()
                for (x in pairs) print "pair " x
            } else {
                list(use["auth"], "auth", 2, 0)
                walk(1)
                for (r in fin) print "setcred " r
            }
            list(use["account"], "account", 3, 0)
            walk(0)
            for (r in fin) print "account " r
            list(use["password"], "password", 6, 0)
            walk(0)
            for (r in fin) if (r + 0 != 0) print "chauthtok " r
            if (0 in fin) {
                list(use["password"], "password", 7, 0)
                walk(0)
                for (r in fin) print "chauthtok " r
            }
            list(use["session"], "session", 4, 0)
            walk(0)
            for (r in fin) print "session " r
            exit
        }
        # What greetd calls, in order, each of which has to succeed: for a
        # login, authenticating, the account, setting credentials and the
        # session, and for the greeter the same without authenticating.
        if (mode == "login" && !can("authenticate")) refuse("authenticate", "auth")
        if (!can("account")) {
            if (expired) refuse("chauthtok", "password")
            refuse("account", "account")
        }
        if (!can("setcred")) refuse("setcred", "auth")
        if (!can("session")) refuse("session", "session")
        print "ok"
    }
'

# pam_service_works SERVICE MODE: whether the calls greetd makes on the PAM
# stack of SERVICE can succeed, for a login, MODE login, or for the
# greeter, setting why if not. PAM refuses a login through a stack it
# can't read or load whole, and one whose lines can't all succeed; a line
# that can't do without a module PAM can't use, or a program pam_exec
# can't run, fails it too. A type a service has no lines of, PAM takes
# from its other service. pam_names_trusted has to have read the stack.
pam_service_works() {
    _pw_nl='
'
    if ! _pw_chain=$(PAM_CHAIN_SERVICE=$1 PAM_CHAIN_DIR=$PAM_DIR PAM_CHAIN_VENDOR=${pam_vendor_root:+$pam_vendor} \
        PAM_CHAIN_DEBIAN=$PAM_AT_INCLUDE PAM_CHAIN_FILES=$pam_files PAM_CHAIN_FULLPATHS=$pam_fullpaths \
        PAM_CHAIN_OVERRIDE=$pam_override PAM_CHAIN_TEXT=$pam_override_text LC_ALL=C awk "$CHAIN_AWK" </dev/null) \
        || ! _pw_plan=$(printf '%s\n' "$_pw_chain" | LC_ALL=C awk -v phase=plan "$SIM_AWK"); then
        why="couldn't read greetd's PAM stack"
        return 1
    fi
    # What the lines of the files it reads name, which PAM loads or runs.
    if ! pam_files_trusted "$(printf '%s\n' "$_pw_chain" | sed -n 's/^I	[^	]*	//p')"; then
        why="greetd's PAM stack isn't root's alone: $why"
        return 1
    fi
    while IFS='	' read -r _pw_kind _pw_name; do
        _pw_name=${_pw_name#=}
        case "$_pw_kind" in
            M)
                case "$_pw_nl$pam_table$_pw_nl" in
                    *"${_pw_nl}T	M	=$_pw_name	"*) continue ;;
                esac
                # PAM puts a directory of its own in place of $ISA when it
                # loads one, which setup can't check.
                case "$_pw_name" in
                    *\$ISA*)
                        why="greetd's PAM stack names the module $_pw_name, and setup can't fill in its \$ISA as PAM does"
                        return 1
                        ;;
                esac
                if pam_module_check "$_pw_name"; then
                    pam_table="$pam_table${_pw_nl}T	M	=$_pw_name	+$pam_module_exports	="
                elif test -n "$pam_module_untrusted"; then
                    why="greetd's PAM stack isn't root's alone: $pam_module_untrusted"
                    return 1
                else
                    pam_table="$pam_table${_pw_nl}T	M	=$_pw_name	-	=$pam_module_why"
                fi
                ;;
            P)
                _pw_runs=no
                if pam_program_runs "$_pw_name"; then
                    # pam_exec returns success for a program that exits 0
                    # and system_err for one that doesn't, so for true and
                    # false, always the same. The kernel runs the file a
                    # link leads to, which is the program, unless it's one
                    # that runs as the name it's given, busybox's or
                    # coreutils's.
                    _pw_as=
                    if trusted "/${_pw_name#/}"; then
                        _pw_as=${trusted_to##*/}
                        case "$_pw_as" in
                            busybox | coreutils) _pw_as=${_pw_name##*/} ;;
                        esac
                    fi
                    case "$_pw_as" in
                        true) _pw_runs="yes	0" ;;
                        false) _pw_runs="yes	4" ;;
                        *) _pw_runs=yes ;;
                    esac
                elif test "$pam_program_status" -eq 2; then
                    why="greetd's PAM stack isn't root's alone: $why"
                    return 1
                fi
                pam_table="$pam_table${_pw_nl}T	P	=$_pw_name	$_pw_runs"
                ;;
        esac
    done <<EOF
$_pw_plan
EOF
    if ! _pw_verdict=$(printf '%s\n%s\n' "$_pw_chain" "$pam_table" | LC_ALL=C awk -v phase=check -v mode="$2" -v debian="$PAM_AT_INCLUDE" "$SIM_AWK"); then
        why="couldn't walk greetd's PAM stack"
        return 1
    fi
    test "$_pw_verdict" != ok || return 0
    IFS='	' read -r _pw_r _pw_kind _pw_a _pw_b _pw_c _pw_d _pw_e _pw_f _pw_g <<EOF
$_pw_verdict
EOF
    _pw_stack="greetd's PAM stack"
    test "$2" = login || _pw_stack="$_pw_stack for the greeter"
    _pw_refuse="PAM refuses a login through a stack it can't load whole"
    case "$_pw_kind" in
        error)
            _pw_detail=${_pw_c#=}
            case "$_pw_b" in
                missing) _pw_what="includes $_pw_detail, which isn't there" ;;
                deep) _pw_what="includes $_pw_detail 16 deep, as a loop of includes does" ;;
                noinclude) _pw_what="has an include that names no file" ;;
                badtype) _pw_what="has a line of a type PAM doesn't know, $_pw_detail" ;;
                badcontrol) _pw_what="has a line with a control PAM doesn't know, $_pw_detail" ;;
                nocontrol) _pw_what="has a line of type $_pw_d that names no control" ;;
                nomodule) _pw_what="has a line of type $_pw_d that names no module" ;;
                dangling) _pw_what="ends in a line a backslash carries on, which PAM can't read" ;;
                badname) _pw_what="names $_pw_detail, which PAM can't name a module or substack after" ;;
                tab) _pw_what="names a module with a tab in its name, $_pw_detail" ;;
                long)
                    why="$_pw_stack, in $_pw_a, has a line longer than PAM before 1.6 reads as one, so setup can't tell what PAM makes of it"
                    return 1
                    ;;
                carried)
                    why="$_pw_stack, in $_pw_a, carries a line on with a backslash past a blank or comment line, which PAM 1.6 and later end the line at and earlier versions don't, so setup can't tell what PAM makes of it"
                    return 1
                    ;;
                *) _pw_what="has a line PAM can't read" ;;
            esac
            why="$_pw_stack, in $_pw_a, $_pw_what, and $_pw_refuse"
            ;;
        needs) why="$_pw_stack, in $_pw_a, needs the module ${_pw_b#=}, ${_pw_d#=}, and $_pw_refuse" ;;
        runs) why="$_pw_stack, in $_pw_a, runs ${_pw_b#=} with pam_exec, which isn't there or can't be run, and $_pw_refuse" ;;
        noprogram) why="$_pw_stack, in $_pw_a, has a pam_exec line that names no program to run, and $_pw_refuse" ;;
        empty)
            why="$_pw_stack, from $_pw_c, has no $_pw_b lines, and nor has its other service, which PAM takes them from, so PAM would refuse every login"
            test "$2" = login || why="$_pw_stack, from $_pw_c, has no $_pw_b lines, and nor has its other service, which PAM takes them from, so greetd couldn't start the greeter"
            ;;
        fail)
            case "$_pw_a" in
                authenticate) _pw_what="can't authenticate anyone" ;;
                account) _pw_what="can't pass anyone's account check" ;;
                chauthtok) _pw_what="can pass an account check only by changing its password, and can't change one" ;;
                setcred) _pw_what="can't set the credentials of anyone it authenticates" ;;
                *) _pw_what="can't open anyone's session" ;;
            esac
            if test "$2" != login; then
                case "$_pw_a" in
                    setcred) _pw_what="can't set the greeter's credentials" ;;
                    session) _pw_what="can't open the greeter's session" ;;
                esac
            fi
            _pw_from=$_pw_d
            test "$_pw_b" = conf || _pw_from="$_pw_d, its other service, which PAM takes its $_pw_c lines from"
            why="$_pw_stack, from $_pw_from, $_pw_what, whatever the modules it can use return, so PAM would refuse every login"
            test "$2" = login || why="$_pw_stack, from $_pw_from, $_pw_what, whatever the modules it can use return, so greetd couldn't start the greeter"
            case "$_pw_e" in
                module) why="$why; PAM can't use ${_pw_f#=} there, ${_pw_g#=}" ;;
                program) why="$why; pam_exec can't run ${_pw_f#=} there, which isn't there or can't be run" ;;
            esac
            ;;
        *) why="couldn't walk greetd's PAM stack" ;;
    esac
    return 1
}

# pam_stack_works: whether greetd can log someone in through its PAM
# stack, and start the greeter through the greeter's, greetd-greeter, or
# its own when there's none, as pam_service_works checks each, setting why
# if not.
pam_stack_works() {
    pam_table=
    pam_service_works greetd login || return 1
    if test -f "$PAM_DIR/greetd-greeter" || { test -n "$pam_vendor_root" && test -f "$pam_vendor/greetd-greeter"; }; then
        pam_service_works greetd-greeter greeter
    else
        pam_service_works greetd greeter
    fi
}
pam_override=
pam_override_text=

# runnable FILE [USER]: whether the kernel would run FILE for USER, or for
# root when there's none: root needs an execute bit for anyone, a user one
# that's theirs, which only asking as them shows.
runnable() {
    test -f "$1" || return 1
    if test -n "${2:-}"; then
        sudo -u "$2" test -x "$1"
        return
    fi
    _rn_x=$(find "$1" -prune -perm /111) && test -n "$_rn_x"
}

# program_starts FILE PATH [USER]: whether the kernel can start FILE, a
# program trusted has followed, run by USER, or by root when there's none,
# and only root can change what it starts it with,
# returning 1 if it can't start it and 2 if someone else could change what
# it runs, setting why either way. The kernel starts an ELF file itself, and
# a script with the interpreter its #! names, which has to be there, be a
# program, and be root's alone, with the prefix it's installed in, as
# command_prefix_trusted says. An interpreter that's env runs the program
# it names, which env finds on PATH, so each one of that name on PATH has to
# be root's alone, and the first has to start. An interpreter can be a
# script itself, four deep at most, as the kernel allows. What a program
# does once it starts isn't followed: what a script's lines run, or the
# argument its #! line gives the interpreter, is part of a file only root
# can change, and an ELF file the checks pass that the kernel still refuses
# is a broken build, not someone else's code.
program_starts() {
    _ps_file=$1
    _ps_user=${3:-}
    _ps_depth=0
    while :; do
        if ! _ps_magic=$(od -An -tx1 -N4 "$_ps_file" | tr -d ' \n'); then
            why="couldn't read $_ps_file"
            return 1
        fi
        case "$_ps_magic" in
            7f454c46)
                program_elf_starts "$_ps_file" "$_ps_user"
                return
                ;;
            2321*) ;;
            *)
                why="$_ps_file isn't a program the kernel can start: it's neither an ELF file nor a script whose #! names what runs it"
                return 1
                ;;
        esac
        _ps_depth=$((_ps_depth + 1))
        if test "$_ps_depth" -gt 4; then
            why="$1 is run by scripts more than four deep, which the kernel won't start"
            return 1
        fi
        # The kernel takes what follows #! up to the first blank as the
        # interpreter, and the rest of the line as one argument.
        IFS= read -r _ps_line < "$_ps_file" || test -n "$_ps_line" || {
            why="couldn't read $_ps_file"
            return 1
        }
        _ps_line=${_ps_line#??}
        IFS='	 ' read -r _ps_interp _ps_arg <<EOF
$_ps_line
EOF
        case "$_ps_interp" in
            /*) ;;
            *)
                why="$_ps_file names ${_ps_interp:-nothing} to run it with, which isn't a full path"
                return 1
                ;;
        esac
        if ! trusted "$_ps_interp" missing-ok || ! { test -z "$trusted_to" || command_prefix_trusted "$trusted_to"; }; then
            why="$_ps_file is run by $_ps_interp: $why"
            return 2
        fi
        if test -z "$trusted_to" || ! runnable "$trusted_to" "$_ps_user"; then
            why="$_ps_file is run by $_ps_interp, which isn't there or can't be run"
            return 1
        fi
        _ps_next=$trusted_to
        # The kernel runs the file a link leads to, so that's the
        # interpreter, unless it's one that runs as the name it's given,
        # busybox's or coreutils's.
        _ps_as=${trusted_to##*/}
        case "$_ps_as" in
            busybox | coreutils) _ps_as=${_ps_interp##*/} ;;
        esac
        if test "$_ps_as" = env; then
            case "$_ps_arg" in
                "" | -* | *[[:blank:]]* | [!/]*/* | */)
                    why="$_ps_file is run by env with ${_ps_arg:-nothing}, which setup can't follow"
                    return 1
                    ;;
                /*)
                    _ps_rest=${_ps_arg%/*}:
                    _ps_where="isn't there"
                    ;;
                *)
                    _ps_rest=$2:
                    _ps_where="isn't on its PATH, $2,"
                    ;;
            esac
            _ps_name=${_ps_arg##*/}
            _ps_next=
            while test -n "$_ps_rest"; do
                _ps_dir=${_ps_rest%%:*}
                _ps_rest=${_ps_rest#*:}
                _ps_found=$_ps_dir/$_ps_name
                test -e "$_ps_found" || test -L "$_ps_found" || continue
                if ! trusted "$_ps_found" || ! command_prefix_trusted "$trusted_to"; then
                    why="$_ps_file is run by env's $_ps_arg, $_ps_found: $why"
                    return 2
                fi
                test -n "$_ps_next" || _ps_next=$trusted_to
            done
            if test -z "$_ps_next" || ! runnable "$_ps_next" "$_ps_user"; then
                why="$_ps_file is run by env's $_ps_arg, which $_ps_where as a program it can run"
                return 1
            fi
        fi
        _ps_file=$_ps_next
    done
}

# program_elf_starts FILE [USER]: whether the kernel can start FILE, an ELF
# file, run by USER, or by root when there's none, and only root can change
# the loader it starts it with, returning 1 if it
# can't start it and 2 if someone else could change the loader, setting why
# either way, as program_starts does. It has to be built for this machine, as
# a program, with its entry point in code it loads, and with every part the
# kernel loads within the file, as ELF_EXEC_AWK reads it. One the kernel starts with a
# loader needs that loader there and root's alone, and the loader has to be
# able to load it, binding every symbol, with every library it needs, as
# ldd says without running it, and each of those libraries root's alone.
program_elf_starts() {
    _pe_loader=
    elf_ident_find
    if ! _pe_size=$(wc -c < "$1") \
        || ! _pe_verdict=$(od -An -v -tu1 -N 65536 -- "$1" | LC_ALL=C awk -v ident="$pam_elf_ident" -v size="$_pe_size" "$ELF_EXEC_AWK"); then
        why="couldn't read $1"
        return 1
    fi
    case "$_pe_verdict" in
        static) return 0 ;;
        "interp "?*) _pe_loader=${_pe_verdict#interp } ;;
        arch) why="$1 is built for another kind of machine than this one" ;;
        noident) why="setup can't tell $1 is built for this machine, since it couldn't read /bin/sh as one" ;;
        type) why="$1 is an ELF file, but not a program the kernel can start" ;;
        entry) why="$1 has no code where the kernel would start it" ;;
        headers) why="$1's program headers aren't whole where the kernel reads them" ;;
        short) why="$1 is cut short: a part of it the kernel loads runs past its end" ;;
        interp) why="$1 names a loader setup can't read" ;;
        *) why="$1 isn't a program the kernel can start" ;;
    esac
    test -n "$_pe_loader" || return 1
    if ! trusted "$_pe_loader" missing-ok; then
        why="$1 is loaded by $_pe_loader: $why"
        return 2
    fi
    if test -z "$trusted_to" || ! test -f "$trusted_to"; then
        why="$1 is loaded by $_pe_loader, which isn't there"
        return 1
    fi
    # The kernel runs the loader for the program's user, as it does a
    # script's interpreter.
    if ! runnable "$trusted_to" "${2:-}"; then
        why="$1 is loaded by $_pe_loader, which ${2:-root} can't run"
        return 1
    fi
    # A loader outside the package manager's library directories loads what
    # it finds beside it, as a command does.
    case "$trusted_to" in
        "$SYSTEM_ROOT"/lib/* | "$SYSTEM_ROOT"/lib64/* | "$SYSTEM_ROOT"/usr/lib/* | "$SYSTEM_ROOT"/usr/lib64/*) ;;
        /lib/* | /lib64/* | /usr/lib/* | /usr/lib64/*) ;;
        */lib/*) trusted_tree "${trusted_to%/lib/*}" ;;
        */lib64/*) trusted_tree "${trusted_to%/lib64/*}" ;;
        *) trusted_tree "${trusted_to%/*}" ;;
    esac || {
        why="$1 is loaded by $_pe_loader: $why"
        return 2
    }
    if ! is_command ldd; then
        why="setup can't check that the loader can load $1 without ldd"
        return 1
    fi
    # And the loader opens its libraries as that user, so ldd asks as them;
    # sudo drops LD_LIBRARY_PATH and LD_PRELOAD itself.
    if test -n "${2:-}"; then
        _pe_out=$(sudo -u "$2" env LC_ALL=C ldd -r -- "$1" 2>&1)
    else
        _pe_out=$(unset LD_LIBRARY_PATH LD_PRELOAD; LC_ALL=C ldd -r -- "$1" 2>&1)
    fi || {
        why="$1 can't be loaded by the system's loader"
        return 1
    }
    _pe_lib=$(printf '%s\n' "$_pe_out" | sed -n 's/^[[:space:]]*\([^[:space:]]*\) => not found.*/\1/p' | head -n 1)
    if test -n "$_pe_lib"; then
        why="$1 needs $_pe_lib, which isn't there"
        test -z "${2:-}" || why="$why, or $2 can't read it"
        return 1
    fi
    _pe_symbol=$(printf '%s\n' "$_pe_out" | sed -n 's/^undefined symbol: \([^[:space:],]*\).*/\1/p' | head -n 1)
    if test -n "$_pe_symbol"; then
        why="$1 needs $_pe_symbol, which nothing it loads defines"
        return 1
    fi
    ldd_libs_trusted "$_pe_out" "$1" || return 2
}

# command_prefix_trusted FILE: whether only root can change the prefix the
# command FILE, where a trusted path leads, is installed in, setting why if
# not. A command loads its libraries from there, so it's checked whole,
# unless it's the package manager's. /usr/local is any build's, its
# libraries in /usr/local/lib. One outside a bin or sbin directory can load
# what's beside it, so the whole directory it's in is checked, and one in /
# itself fails. trusted_to is left as FILE.
command_prefix_trusted() {
    case "$1" in
        "$SYSTEM_ROOT"/bin/* | "$SYSTEM_ROOT"/sbin/* | "$SYSTEM_ROOT"/usr/bin/* | "$SYSTEM_ROOT"/usr/sbin/*) return 0 ;;
        /bin/* | /sbin/* | /usr/bin/* | /usr/sbin/*) return 0 ;;
        */bin/*) trusted_tree "${1%/bin/*}" || return 1 ;;
        */sbin/*) trusted_tree "${1%/sbin/*}" || return 1 ;;
        /*/*) trusted_tree "${1%/*}" || return 1 ;;
        *)
            why="$1 is installed in /, which setup doesn't check whole"
            return 1
            ;;
    esac
    trusted_to=$1
}

# UNIT_AWK reads systemd unit files as systemd does and prints the file and
# key, with an =, of the first [Service] setting that isn't in allow, or
# [Unit] one that isn't in unit_allow, a tab between, or nothing. A Type
# other than simple, exec or idle is printed whole: systemd waits for
# greetd to fork, or to say it's ready, under any other, which it doesn't.
# So is a unit a dependency names, or a StartLimitAction, other than the
# ones greetd's own units name, as each could keep greetd from starting at
# boot or take the boot down with it: a Conflicts with graphical.target
# stops one or the other, an After one it comes before makes a cycle
# systemd breaks by dropping a job, a RequiredBy basic.target fails the
# boot with greetd, and a StartLimitAction reboots when it keeps failing.
# An alias has to be display-manager.service too: enabling greetd with
# --force replaces whatever another name links to, so one for another
# unit's name, network.service, say, would take that unit's place.
# A line that is all comment, after leading space, is skipped even
# inside a line a backslash carries on; an odd run of backslashes at the end
# carries the line on, as a space, and one carried on past the end of its
# file is read there.
# shellcheck disable=SC2016  # $0 and the rest are awk's
UNIT_AWK='
    function found(file, key) {
        print "found\t" file "\t" key
        done = 1
        exit
    }
    function check(l, file,    key, v, n, a, i) {
        sub(/^[ \t\n\r]+/, "", l)
        sub(/[ \t\n\r]+$/, "", l)
        if (l == "") return
        # .include, which older systemd read another file for.
        if (substr(l, 1, 1) == ".") {
            sub(/[ \t].*/, "", l)
            found(file, l)
        }
        if (substr(l, 1, 1) == "[") {
            section = substr(l, 2, length(l) - 2)
            return
        }
        if (section != "Service" && section != "Unit" && section != "Install") return
        key = l
        sub(/=.*/, "", key)
        sub(/[ \t]+$/, "", key)
        if (!((section, key) in allowed)) found(file, key "=")
        if (section == "Service" && key == "Type") {
            sub(/^[^=]*=[ \t]*/, "", l)
            if (l !~ /^(simple|exec|idle|)$/) found(file, key "=" l)
        }
        if ((section, key) in units) {
            v = l
            sub(/^[^=]*=/, "", v)
            n = split(v, a, /[ \t]+/)
            for (i = 1; i <= n; i++) if (a[i] != "" && a[i] !~ units[section, key]) found(file, key "=" a[i])
        }
        # Each name enabling it gives it, whose drop-ins systemd reads too.
        if (section == "Install" && key == "Alias") {
            sub(/^[^=]*=/, "", l)
            n = split(l, a, /[ \t]+/)
            for (i = 1; i <= n; i++) if (a[i] != "") aliases[a[i]] = 1
        }
    }
    BEGIN {
        n = split(allow, a, " ")
        for (i = 1; i <= n; i++) allowed["Service", a[i]] = 1
        n = split(unit_allow, a, " ")
        for (i = 1; i <= n; i++) allowed["Unit", a[i]] = 1
        n = split(install_allow, a, " ")
        for (i = 1; i <= n; i++) allowed["Install", a[i]] = 1
        # The units each may name, those the units greetd ships with name.
        # A getty on a VT Linux has, 1 to 63.
        getty = "getty@tty([1-9]|[1-5][0-9]|6[0-3])"
        units["Unit", "After"] = "^(systemd-user-sessions|plymouth-quit-wait|" getty ")[.]service$"
        units["Unit", "Wants"] = "^(systemd-user-sessions|plymouth-quit-wait)[.]service$"
        units["Unit", "Conflicts"] = "^" getty "[.]service$"
        units["Install", "WantedBy"] = units["Install", "RequiredBy"] = units["Install", "UpheldBy"] = "^(graphical|multi-user)[.]target$"
        units["Unit", "StartLimitAction"] = units["Service", "StartLimitAction"] = "^none$"
        # Enabling with --force replaces what another name links to, so an
        # alias with the name of another unit would take its place.
        units["Install", "Alias"] = "^display-manager[.]service$"
    }
    FNR == 1 {
        if (line != "") check(line, file)
        section = ""
        line = ""
        file = FILENAME
    }
    {
        s = $0
        t = s
        sub(/^[ \t\n\r]+/, "", t)
        if (t != "" && (substr(t, 1, 1) == "#" || substr(t, 1, 1) == ";")) next
        line = line s
        if (match(line, /\\+$/) && RLENGTH % 2 == 1) {
            line = substr(line, 1, length(line) - 1) " "
            next
        }
        l = line
        line = ""
        check(l, FILENAME)
    }
    END {
        if (!done && line != "") check(line, file)
        if (!done) for (name in aliases) print "alias\t" name
    }'

# The [Service] settings greetd's unit may make, Debian's, Arch's and
# upstream's among them, and Fedora's TimeoutStopFailureMode, which its
# systemd sets for every service. None changes what greetd runs, or where:
# one that might, RootDirectory, BindPaths or Environment, say, isn't here,
# so a unit that makes it isn't trusted. Nor is one that ends greetd once
# it's running, RuntimeMaxSec or WatchdogSec, which greetd never answers.
# Its Type has to be one UNIT_AWK allows.
GREETD_UNIT_SETTINGS="Type ExecStart Restart RestartSec RestartSteps
RestartMaxDelaySec RestartPreventExitStatus RestartForceExitStatus
SuccessExitStatus RemainAfterExit TimeoutSec TimeoutStartSec TimeoutStopSec
TimeoutAbortSec TimeoutStartFailureMode TimeoutStopFailureMode
KillMode KillSignal RestartKillSignal FinalKillSignal SendSIGHUP
SendSIGKILL WatchdogSignal IgnoreSIGPIPE StartLimitInterval
StartLimitIntervalSec StartLimitBurst StartLimitAction KeyringMode"

# The [Unit] settings it may make, those units' own and the limits on
# restarting it, which a newer systemd reads there. None can stop greetd
# starting: a condition, an assert, or a unit it requires, which could,
# isn't here, nor a unit it comes before, and UNIT_AWK checks the units the
# others name.
GREETD_UNIT_SECTION="Description Documentation After Wants Conflicts
StartLimitIntervalSec StartLimitBurst StartLimitAction"

# The [Install] settings it may make, which say what enabling it links it
# to: Also, which enables other units with it, isn't here, and UNIT_AWK
# checks the alias and the targets the others name.
GREETD_UNIT_INSTALL="Alias WantedBy RequiredBy UpheldBy"

# greetd_unit_settings FILE...: whether greetd's unit files, FILE..., make
# only the settings setup trusts, setting why if not, and
# greetd_unit_aliases to the names they give greetd when it's enabled.
greetd_unit_settings() {
    greetd_unit_aliases=
    if ! _gs_out=$(LC_ALL=C awk -v allow="$GREETD_UNIT_SETTINGS" -v unit_allow="$GREETD_UNIT_SECTION" \
        -v install_allow="$GREETD_UNIT_INSTALL" "$UNIT_AWK" "$@"); then
        greetd_unit_own_why=yes
        why="couldn't read greetd's unit files"
        return 1
    fi
    while IFS='	' read -r _gs_kind _gs_a _gs_b; do
        case "$_gs_kind" in
            alias) greetd_unit_aliases="$greetd_unit_aliases $_gs_a" ;;
            found)
                greetd_unit_own_why=yes
                case "$_gs_b" in
                    .*) why="greetd's unit has a $_gs_b line in $_gs_a, which setup doesn't follow" ;;
                    After=?* | Wants=?* | Conflicts=?* | Alias=?* | WantedBy=?* | RequiredBy=?* | UpheldBy=?* | StartLimitAction=?*)
                        why="greetd's unit sets $_gs_b in $_gs_a, which isn't one setup knows is safe there: only those greetd's own units use are"
                        ;;
                    *) why="greetd's unit sets $_gs_b in $_gs_a, which isn't one of the settings setup knows can't change what greetd runs" ;;
                esac
                return 1
                ;;
        esac
    done <<EOF
$_gs_out
EOF
}

# greetd_unit_trusted: whether only root can change what systemd starts
# greetd from, as root, at every boot, setting why if not: its unit file
# and each drop-in, those of every name it has or enabling it gives it
# among them, each directory systemd looks for one in, so no one else can
# add one, each file its environment is read from, and each program it
# runs, with the prefix one outside the package manager's is installed in.
# Its unit's [Service] settings have to be ones in GREETD_UNIT_SETTINGS,
# its [Unit] ones in GREETD_UNIT_SECTION, its [Install] ones in
# GREETD_UNIT_INSTALL, and greetd has to start with no arguments, since
# setup would have to read either as systemd and greetd do to know what
# runs, and whether it does. What systemd won't say, or says in a way
# setup can't read, fails too, and so does what systemd needs to start
# greetd that isn't there, an environment file or a program it runs, or a
# program it can't run, with greetd_unit_own_why set, since why says it
# all.
greetd_unit_trusted() {
    greetd_unit_own_why=
    greetd_exe=
    if ! _gu_fragment=$(unit_property greetd.service FragmentPath) || test -z "$_gu_fragment"; then
        greetd_unit_own_why=yes
        why="systemd didn't say where greetd's unit is"
        return 1
    fi
    trusted "$_gu_fragment" || return 1
    # Lists, a space between each: a name with a space in it splits into
    # one that isn't a full path, or isn't there, which fails.
    if ! _gu_dropins=$(unit_property greetd.service DropInPaths); then
        greetd_unit_own_why=yes
        why="systemd didn't say where greetd's drop-ins are"
        return 1
    fi
    if ! _gu_dirs=$(systemctl show --property=UnitPath --value) || test -z "$_gu_dirs"; then
        greetd_unit_own_why=yes
        why="systemd didn't say where it looks for units"
        return 1
    fi
    case "$_gu_dropins$_gu_dirs" in
        *[*?[]*)
            greetd_unit_own_why=yes
            why="systemd named a unit path setup can't read: $_gu_dropins $_gu_dirs"
            return 1
            ;;
    esac
    for _gu_path in $_gu_dropins; do
        trusted "$_gu_path" || return 1
    done
    if ! _gu_names=$(unit_property greetd.service Names); then
        greetd_unit_own_why=yes
        why="systemd didn't say what greetd's names are"
        return 1
    fi
    case "$_gu_names" in
        *[*?[]*)
            greetd_unit_own_why=yes
            why="systemd named greetd in a way setup can't read: $_gu_names"
            return 1
            ;;
    esac
    # shellcheck disable=SC2086  # the drop-ins are a list
    greetd_unit_settings "$_gu_fragment" $_gu_dropins || return 1
    # systemd reads the drop-ins of every name greetd has: those it has
    # now, and those enabling it gives it, display-manager.service and any
    # other its unit names, which systemd doesn't count as greetd's until
    # then. Each name's are in its own directory, and in one for each
    # prefix of it that ends in a -, display-.service.d, say, and in
    # service.d, in each directory of systemd's unit path.
    _gu_names="greetd.service display-manager.service $_gu_names $greetd_unit_aliases"
    _gu_seen=" "
    _gu_name_dropins=
    for _gu_path in $_gu_dirs; do
        trusted "$_gu_path" missing-ok || return 1
    done
    for _gu_name in $_gu_names; do
        case "$_gu_name" in
            *[!A-Za-z0-9:_.-]* | .service) _gu_base= ;;
            ?*.service) _gu_base=${_gu_name%.service} ;;
            *) _gu_base= ;;
        esac
        if test -z "$_gu_base"; then
            greetd_unit_own_why=yes
            why="systemd names greetd $_gu_name, which setup can't look for drop-ins of"
            return 1
        fi
        set -- "$_gu_name.d" service.d
        while case "$_gu_base" in *-*) ;; *) false ;; esac; do
            _gu_base=${_gu_base%-*}
            set -- "$@" "$_gu_base-.service.d"
        done
        for _gu_sub; do
            for _gu_path in $_gu_dirs; do
                case "$_gu_seen" in
                    *" $_gu_path/$_gu_sub "*) continue ;;
                esac
                _gu_seen="$_gu_seen$_gu_path/$_gu_sub "
                trusted "$_gu_path/$_gu_sub" missing-ok || return 1
                for _gu_conf in "$_gu_path/$_gu_sub"/*.conf; do
                    test -e "$_gu_conf" || test -L "$_gu_conf" || continue
                    trusted "$_gu_conf" || return 1
                    _gu_name_dropins="$_gu_name_dropins $_gu_conf"
                done
            done
        done
    done
    # And none of those may name it another.
    _gu_known=$greetd_unit_aliases
    # shellcheck disable=SC2086  # the drop-ins are a list
    greetd_unit_settings "$_gu_fragment" $_gu_dropins $_gu_name_dropins || return 1
    for _gu_name in $greetd_unit_aliases; do
        case " $_gu_known " in
            *" $_gu_name "*) ;;
            *)
                greetd_unit_own_why=yes
                why="a drop-in for another of greetd's names names it $_gu_name, whose drop-ins setup hasn't looked through"
                return 1
                ;;
        esac
    done
    # One a line, a path and whether a missing one is ignored: one that
    # isn't stops greetd starting.
    if ! _gu_lines=$(unit_property greetd.service EnvironmentFiles); then
        greetd_unit_own_why=yes
        why="systemd didn't say what greetd's environment is read from"
        return 1
    fi
    while IFS= read -r _gu_line; do
        test -n "$_gu_line" || continue
        _gu_path=${_gu_line% (ignore_errors=*)}
        case "$_gu_line" in
            *" (ignore_errors=yes)") _gu_needed= ;;
            *" (ignore_errors=no)") _gu_needed=yes ;;
            *) _gu_path=$_gu_line ;;
        esac
        if test "$_gu_path" = "$_gu_line"; then
            greetd_unit_own_why=yes
            why="systemd named an environment file for greetd setup can't read: $_gu_line"
            return 1
        fi
        trusted "$_gu_path" missing-ok || return 1
        if test -n "$_gu_needed" && test -z "$trusted_to"; then
            greetd_unit_own_why=yes
            why="greetd's unit reads its environment from $_gu_path, which isn't there, so systemd won't start it"
            return 1
        fi
    done <<EOF
$_gu_lines
EOF
    # One a line, each "{ path=PATH ; argv[]=... }".
    for _gu_prop in ExecCondition ExecStartPre ExecStart ExecStartPost ExecReload ExecStop ExecStopPost; do
        if ! _gu_lines=$(unit_property greetd.service "$_gu_prop"); then
            greetd_unit_own_why=yes
            why="systemd didn't say what greetd's $_gu_prop runs"
            return 1
        fi
        while IFS= read -r _gu_line; do
            test -n "$_gu_line" || continue
            case "$_gu_line" in
                "{ path=/"*" ; argv[]="*) ;;
                *)
                    greetd_unit_own_why=yes
                    why="systemd named a command for greetd's $_gu_prop setup can't read: $_gu_line"
                    return 1
                    ;;
            esac
            _gu_path=${_gu_line#"{ path="}
            _gu_path=${_gu_path%%" ; argv[]="*}
            # An argument can name a file greetd reads, as --config does,
            # and setup would have to know which, so there are none.
            _gu_argv=${_gu_line#*" ; argv[]="}
            _gu_argv=${_gu_argv%%" ; ignore_errors="*}
            case "$_gu_prop:$_gu_argv" in
                ExecStart:*" "*)
                    greetd_unit_own_why=yes
                    why="greetd's unit starts it as $_gu_argv, and setup only trusts greetd started with no arguments"
                    return 1
                    ;;
            esac
            # A command run to start greetd that fails stops it starting,
            # unless a - before it says that's fine. Without its ExecStart,
            # there's no greetd to start, whatever a - says.
            _gu_needed=
            case "$_gu_prop" in
                ExecCondition | ExecStartPre | ExecStart | ExecStartPost)
                    case "${_gu_line##*" ; ignore_errors="}" in
                        "no ;"*) _gu_needed=yes ;;
                        "yes ;"*) test "$_gu_prop" != ExecStart || _gu_needed=yes ;;
                        *)
                            greetd_unit_own_why=yes
                            why="systemd named a command for greetd's $_gu_prop setup can't read: $_gu_line"
                            return 1
                            ;;
                    esac
                    ;;
            esac
            trusted "$_gu_path" missing-ok || return 1
            test -z "$trusted_to" || command_prefix_trusted "$trusted_to" || return 1
            if test -n "$_gu_needed"; then
                if test -z "$trusted_to"; then
                    greetd_unit_own_why=yes
                    why="greetd's unit runs $_gu_path, which isn't there, so systemd won't start it"
                    return 1
                fi
                if ! test -f "$trusted_to" || ! _gu_x=$(find "$trusted_to" -prune -perm /111) || test -z "$_gu_x"; then
                    greetd_unit_own_why=yes
                    why="greetd's unit runs $_gu_path, which isn't a program it can run, so systemd won't start it"
                    return 1
                fi
            fi
            # What starts it, as root, has to be root's alone too, and
            # what has to run has to start.
            if test -n "$trusted_to"; then
                _gu_target=$trusted_to
                program_starts "$_gu_target" "$SERVICE_PATH"
                case $? in
                    1)
                        if test -n "$_gu_needed"; then
                            greetd_unit_own_why=yes
                            why="greetd's unit runs $_gu_path, and $why, so systemd won't start it"
                            return 1
                        fi
                        ;;
                    2) return 1 ;;
                esac
                trusted_to=$_gu_target
            fi
            if test "$_gu_prop" = ExecStart; then
                # Anything else would start no login screen. What runs is
                # where a link leads, whatever the link is named.
                if test "${trusted_to##*/}" != greetd; then
                    greetd_unit_own_why=yes
                    if test "$trusted_to" = "$_gu_path"; then
                        why="greetd's unit starts $_gu_path, which isn't greetd"
                    else
                        why="greetd's unit starts $_gu_path, which is $trusted_to, not greetd"
                    fi
                    return 1
                fi
                test -n "$greetd_exe" || greetd_exe=$trusted_to
            fi
        done <<EOF
$_gu_lines
EOF
    done
    # systemd starts a oneshot unit with no ExecStart, and nothing runs.
    if test -z "$greetd_exe"; then
        greetd_unit_own_why=yes
        why="greetd's unit starts nothing, so it wouldn't start a login screen"
        return 1
    fi
    # greetd is the only login screen once it's the display manager, so
    # systemd has to start it again whenever it stops, as greetd's own units
    # have it: no exit status stops that, and nor does staying active after.
    for _gu_prop in Restart RestartPreventExitStatus RemainAfterExit; do
        if ! _gu_value=$(unit_property greetd.service "$_gu_prop"); then
            greetd_unit_own_why=yes
            why="systemd didn't say greetd's $_gu_prop"
            return 1
        fi
        case "$_gu_prop=$_gu_value" in
            Restart=always | RestartPreventExitStatus= | RemainAfterExit=no) ;;
            *)
                greetd_unit_own_why=yes
                why="greetd's unit has $_gu_prop=$_gu_value, so systemd wouldn't always start greetd again when it stops, leaving no login screen"
                return 1
                ;;
        esac
    done
}

# greeter_ready sets greeter to greetd's user, after checking that the
# greeter can run, and that only root can change what greetd and it run:
# greetd, tide's template, greetd's config directory, its PAM stack and
# what that names by its full path, the greeter's PATH, each command the
# greeter starts, found on that PATH by greetd's user itself, with the build
# it comes from, tide's greeter files, and a new enough Hyprland. Otherwise
# it sets why to what's wrong.
greeter_ready() {
    if test "$(unit_property greetd.service LoadState)" != loaded; then
        why="greetd isn't installed"
        return 1
    fi
    # systemd runs greetd as root, at every boot.
    if ! greetd_unit_trusted; then
        test -n "$greetd_unit_own_why" || why="what systemd starts greetd from isn't root's alone: $why"
        return 1
    fi
    if ! test -r "$GREETD_TEMPLATE"; then
        why="tide's greetd config isn't installed at $GREETD_TEMPLATE"
        return 1
    fi
    # Its command is what greetd runs.
    if ! trusted "$GREETD_TEMPLATE"; then
        why="tide's greetd config isn't root's alone: $why"
        return 1
    fi
    if ! greeter_user; then
        why="greetd has no system account to run the greeter as (setup looked for$greeter_looked)"
        return 1
    fi
    # Where setup writes greetd's config, which names what greetd runs, and
    # as whom.
    if ! trusted "$GREETD_DIR" missing-ok; then
        why="greetd's config directory isn't root's alone: $why"
        return 1
    fi
    # The directory of the PAM stack greetd, which runs as root, checks
    # passwords with, where anyone who could add a file could add greetd's
    # own. pam_service_works checks each file greetd's stacks read.
    if ! trusted "$PAM_DIR" missing-ok; then
        why="greetd's PAM stack isn't root's alone: $why"
        return 1
    fi
    # Without it, in PAM_DIR or else the vendor's directory, PAM checks
    # greetd's logins with its "other" service, which can refuse them all:
    # it does on Fedora.
    if ! test -f "$PAM_DIR/greetd" && ! test -f "$PAM_VENDOR_DIR/greetd"; then
        why="greetd has no PAM file at $PAM_DIR/greetd or $PAM_VENDOR_DIR/greetd, and PAM's fallback for one can refuse every login"
        return 1
    fi
    if ! pam_names_trusted; then
        why="greetd's PAM stack isn't root's alone: $why"
        return 1
    fi
    pam_module_dir_find || return 1
    pam_stack_works || return 1
    # A directory on the PATH someone else can write could hold their own
    # command by any name the greeter runs, ahead of root's.
    _path_rest=$GREETER_PATH:
    while test -n "$_path_rest"; do
        _dir=${_path_rest%%:*}
        _path_rest=${_path_rest#*:}
        if test -z "$_dir"; then
            why="the greeter's PATH, $GREETER_PATH, names the current directory"
            return 1
        fi
        if ! trusted "$_dir" missing-ok; then
            why="the greeter's PATH isn't root's alone: $why"
            return 1
        fi
    done
    for _cmd in $GREETER_COMMANDS; do
        # shellcheck disable=SC2016  # $1 and $_p are the inner shell's
        if ! _found=$(sudo -u "$greeter" env PATH="$GREETER_PATH" /bin/sh -c '_p=$(command -v "$1") && test -x "$_p" && printf "%s\n" "$_p"' sh "$_cmd"); then
            why="greetd's user $greeter can't run $_cmd from $GREETER_PATH"
            return 1
        fi
        if ! trusted "$_found"; then
            why="the greeter's $_cmd isn't root's alone: $why"
            return 1
        fi
        case "$_cmd" in
            Hyprland) _hyprland_dir=${trusted_to%/*} ;;
            hyprctl) _hyprctl_dir=${trusted_to%/*} ;;
        esac
        if ! command_prefix_trusted "$trusted_to"; then
            why="the greeter's $_cmd isn't root's alone: $why"
            return 1
        fi
        program_starts "$trusted_to" "$GREETER_PATH" "$greeter"
        case $? in
            1)
                why="greetd's user $greeter can't start $_cmd: $why"
                return 1
                ;;
            2)
                why="the greeter's $_cmd isn't root's alone: $why"
                return 1
                ;;
        esac
        test "$_cmd" = tide-greeter || continue
        # tide-greeter runs its Hyprland config and its QML from the share
        # directory beside the bin directory it's found in, as tide's
        # make install-session puts them.
        if ! test -d "${_found%/*}/../share/tide"; then
            why="tide's greeter files aren't installed beside $_found"
            return 1
        fi
        if ! trusted_tree "${_found%/*}/../share/tide"; then
            why="tide's greeter files aren't root's alone: $why"
            return 1
        fi
        _share=$trusted_to
        for _file in greeter/hyprland.lua shell/greeter.qml; do
            if ! sudo -u "$greeter" test -r "$_share/$_file"; then
                why="greetd's user $greeter can't read $_share/$_file"
                return 1
            fi
        done
    done
    # hyprctl is how the greeter's Hyprland is told to end, so it has to be
    # that Hyprland's own: one from another install can look for another
    # socket, or speak another version's protocol, and leave the greeter
    # running in the way of the session.
    if test "$_hyprctl_dir" != "$_hyprland_dir"; then
        why="the greeter's hyprctl, in $_hyprctl_dir, isn't from the same install as its Hyprland, in $_hyprland_dir, so it may not be able to end it"
        return 1
    fi
    # The Hyprland the greeter runs, which needn't be the one on this user's
    # PATH.
    # shellcheck disable=SC2016  # the inner shell's
    if ! _version=$(sudo -u "$greeter" env PATH="$GREETER_PATH" /bin/sh -c 'Hyprland --version'); then
        why="greetd's user $greeter couldn't ask its Hyprland for its version"
        return 1
    fi
    # The number has to end the word: a prerelease, 0.56.0-rc1, isn't 0.56.0.
    _version=$(printf '%s\n' "$_version" | sed -n 's/^Hyprland \([0-9][0-9.]*\)\([ ,].*\)\{0,1\}$/\1/p' | head -n1)
    if test -z "$_version" || ! version_at_least "$_version" "$MIN_HYPRLAND"; then
        why="the greeter's Hyprland is ${_version:-of no version setup can read}, and it needs $MIN_HYPRLAND or later"
        return 1
    fi
    # And its Quickshell, which loads the greeter's QML as tide's shell is
    # loaded. 0.2 prints its version as "quickshell 0.2.1, revision ...", 0.3
    # as "Quickshell 0.3.1 (revision ...)", as tide-shell reads them.
    # shellcheck disable=SC2016  # the inner shell's
    if ! _version=$(sudo -u "$greeter" env PATH="$GREETER_PATH" /bin/sh -c 'qs --version' 2>&1); then
        why="greetd's user $greeter couldn't ask its Quickshell for its version"
        return 1
    fi
    _version=$(printf '%s\n' "$_version" | sed -n 's/^[Qq]uickshell \([0-9][0-9]*\.[0-9][0-9.]*\)\([ ,].*\)\{0,1\}$/\1/p' | head -n1)
    if test -z "$_version" || ! version_at_least "$_version" "$MIN_QUICKSHELL"; then
        why="the greeter's Quickshell is ${_version:-of no version setup can read}, and it needs $MIN_QUICKSHELL or later"
        return 1
    fi
}

# describe_dm names display manager $1 for a message.
describe_dm() {
    case "$1" in
        none) echo "the text console login" ;;
        *) echo "$1" ;;
    esac
}

# greetd_config sets greetd_text to tide's template with this greetd's user
# and VT, or why to what stops it.
greetd_config() {
    greeter_vt || return 1
    if ! greetd_text=$(sed -e "s/^user = .*/user = \"$greeter\"/" -e "s/^vt = .*/vt = $vt/" "$GREETD_TEMPLATE"); then
        why="couldn't read $GREETD_TEMPLATE"
        return 1
    fi
    if ! printf '%s\n' "$greetd_text" | grep -qxF "user = \"$greeter\"" \
        || ! printf '%s\n' "$greetd_text" | grep -qxF "vt = $vt"; then
        why="$GREETD_TEMPLATE has no user or vt line for setup to set"
        return 1
    fi
    # greetd runs as root what this names, so it has to be tide's greeter
    # on this VT as this user, and nothing else, whatever a stale or
    # half-installed template says. Comments and blank lines aside, that's
    # these five lines, in this order: no other command or key, no key
    # twice, nothing TOML would read another way.
    _want="[terminal]
vt = $vt
[default_session]
command = \"tide-greeter\"
user = \"$greeter\""
    if ! _got=$(printf '%s\n' "$greetd_text" | sed -e 's/[[:space:]]*#.*//' -e 's/^[[:space:]]*//' -e '/^$/d'); then
        why="couldn't read $GREETD_TEMPLATE"
        return 1
    fi
    if test "$_got" != "$_want"; then
        why="$GREETD_TEMPLATE isn't the config setup knows how to write: one [terminal] vt, and a [default_session] running tide-greeter as greetd's user, and nothing more"
        return 1
    fi
}

# greeter_home gives greetd's user a home it can write, where the greeter
# remembers the last login: its own, when it owns one outside /etc, or
# GREETER_HOME. Debian's _greetd has greetd's config directory, and /etc is
# no place for state. Without one, the greeter only forgets the last login,
# so a failure warns.
greeter_home() {
    if ! _entry=$(getent passwd "$greeter"); then
        warn "couldn't look up $greeter, so the greeter may not remember the last login"
        return 0
    fi
    _uid=$(printf '%s\n' "$_entry" | cut -d: -f3)
    _gid=$(printf '%s\n' "$_entry" | cut -d: -f4)
    _home=$(printf '%s\n' "$_entry" | cut -d: -f6)
    case "$_home" in
        /etc/* | "$GREETD_DIR" | "$GREETD_DIR"/*) ;;
        *)
            if test -d "$_home" && test "$(stat -c %u "$_home")" = "$_uid"; then
                return 0
            fi
            ;;
    esac
    if ! sudo_or_warn install -d -m 700 -o "$_uid" -g "$_gid" "$GREETER_HOME"; then
        warn "couldn't make $GREETER_HOME, so the greeter won't remember the last login"
        return 0
    fi
    test "$_home" != "$GREETER_HOME" || return 0
    info "Giving greetd's user $greeter the home $GREETER_HOME, in place of $_home"
    sudo_or_warn usermod -d "$GREETER_HOME" "$greeter" \
        || warn "couldn't give $greeter the home $GREETER_HOME, so the greeter won't remember the last login"
}

# KEYRING_AWK reads a PAM file as PAM does, joining the lines a backslash
# carries on, past blank and comment lines, until a # or the file's end. It
# prints, one a line: auth and session for each line of that type that
# loads pam_gnome_keyring; for a session one without auto_start, fix and its
# line's number, or, when a backslash carries it on, carried and its first
# line's number, since setup leaves that alone. greeter_ready refuses a
# file that ends in a line a backslash carries on, which PAM can't read.
# shellcheck disable=SC2016  # $0 and the rest are awk's
KEYRING_AWK='
    function flush(    n, w, c, mi, i, type) {
        if (line == "") return
        n = split(line, w)
        line = ""
        c = w[2]
        mi = 3
        if (c ~ /^\[/) while (c !~ /\]/ && mi <= n) c = c " " w[mi++]
        if (mi > n || w[mi] !~ /(^|\/)pam_gnome_keyring\.so$/) return
        type = tolower(w[1])
        sub(/^-/, "", type)
        if (type == "auth") print "auth"
        if (type != "session") return
        print "session"
        for (i = mi + 1; i <= n; i++) if (w[i] == "auto_start") return
        print (cont ? "carried" : "fix"), first
    }
    /^[ \t]*(#|$)/ { next }
    {
        s = $0
        if (line == "") {
            first = NR
            cont = 0
        }
        if (index(s, "#")) {
            sub(/#.*/, "", s)
            line = line " " s
            flush()
            next
        }
        if (s ~ /\\[ \t]*$/) {
            sub(/\\[ \t]*$/, "", s)
            line = line " " s
            cont = 1
            next
        }
        line = line " " s
        flush()
    }
    END { flush() }'

# pam_stack_would_work FILE TEXT: whether greetd's PAM stack would work
# with TEXT in place of FILE, setting why if not, as pam_stack_works checks
# it. greeter_ready has to have read the stack first.
pam_stack_would_work() {
    pam_override=$1
    pam_override_text=$2
    pam_stack_works
    _pw_status=$?
    pam_override=
    pam_override_text=
    return "$_pw_status"
}

# greeter_keyring has greetd's PAM stack unlock gnome-keyring with the
# login password, as GDM's does, so the session's apps find their secrets
# without asking for it again. Debian's file lists the module already; on
# another distro's, the lines go at the end, after whatever it includes,
# which is where the module has to come. It reads the file as PAM does, and
# what it would write has to be a stack PAM can load, or nothing changes.
greeter_keyring() {
    _nl='
'
    _pam="$PAM_DIR/greetd"
    # One only in the vendor's directory is changed as PAM_DIR's copy of
    # it, which PAM reads in its place.
    _src=$_pam
    test -f "$_pam" || ! test -f "$PAM_VENDOR_DIR/greetd" || _src="$PAM_VENDOR_DIR/greetd"
    if ! _stack=$(cat "$_src"); then
        warn "couldn't read $_src, so logging in may not unlock the keyring"
        return 0
    fi
    if ! _found=$(printf '%s\n' "$_stack" | awk "$KEYRING_AWK"); then
        warn "couldn't read $_src's lines, so logging in may not unlock the keyring"
        return 0
    fi
    # A session line without auto_start unlocks a keyring daemon that's
    # already running but starts none, which at login none is, so it gains
    # auto_start. PAM ignores everything from a # to the end of the line, so
    # auto_start goes before one. A line a backslash carries on is left
    # alone: text added at its end would follow the backslash.
    _fixed=$_stack
    for _line in $(printf '%s\n' "$_found" | sed -n 's/^fix //p'); do
        if ! _fixed=$(printf '%s\n' "$_fixed" | sed -E "${_line}{/#/!s/[[:space:]]*\$/ auto_start/;/#/s/^([^#]*[^#[:space:]])/\\1 auto_start/;}"); then
            warn "couldn't add auto_start to $_pam, so logging in may not unlock the keyring"
            return 0
        fi
    done
    case "$_nl$_found$_nl" in
        *"${_nl}carried "*)
            warn "$_pam carries a pam_gnome_keyring session line on with a backslash, so setup leaves it, and logging in may not unlock the keyring unless it has auto_start"
            ;;
    esac
    _add=
    for _type in auth session; do
        case "$_nl$_found$_nl" in
            *"$_nl$_type$_nl"*) continue ;;
        esac
        case "$_type" in
            auth) _add="${_add}auth       optional     pam_gnome_keyring.so
" ;;
            session) _add="${_add}session    optional     pam_gnome_keyring.so auto_start
" ;;
        esac
    done
    if test -z "$_add" && test "$_fixed" = "$_stack"; then
        return 0
    fi
    if test -n "$_add"; then
        _fixed="$_fixed

# Unlock gnome-keyring with the login password (setup-tide).
${_add%
}"
    fi
    if ! pam_stack_would_work "$_pam" "$_fixed"; then
        warn "not adding pam_gnome_keyring to $_pam, since PAM couldn't load greetd's stack with it: $why"
        return 0
    fi
    changed=no
    if install_text "$_pam" "$_fixed"; then
        info "greetd's PAM stack now unlocks the keyring at login"
    else
        warn "couldn't add pam_gnome_keyring to $_pam, so logging in won't unlock the keyring"
    fi
}

# replaced_display_manager prints the display manager greetd replaced, as
# setup noted it, or nothing. Root enables what it names, so a note someone
# else could have changed isn't read.
replaced_display_manager() {
    test -r "$PREVIOUS_DM_FILE" || return 0
    if ! trusted "$PREVIOUS_DM_FILE"; then
        warn "not reading $PREVIOUS_DM_FILE, since only root should be able to change it: $why"
        return 0
    fi
    cat "$PREVIOUS_DM_FILE" || warn "couldn't read $PREVIOUS_DM_FILE"
}

# way_back prints the command that puts $1 back as the display manager.
way_back() {
    case "$1" in
        none) echo "sudo systemctl disable greetd.service" ;;
        *) echo "sudo systemctl enable --force $1 && sudo systemctl disable greetd.service" ;;
    esac
}

# restore_display_manager makes $1 the display manager again in greetd's
# place, from the next boot: a unit, or "none".
restore_display_manager() {
    if ! valid_display_manager "$1" || test "$1" = greetd.service; then
        warn "greetd is the display manager, and setup doesn't know which one it replaced; enable yours, as in '$(way_back gdm.service)'"
        return 1
    fi
    # Enabling the other moves the alias, but greetd's other links, a
    # WantedBy=, say, would start it beside it, so it's disabled too: after,
    # so a failure leaves greetd rather than neither. Enabling makes only
    # the links the other's unit names, and disabling greetd takes away an
    # alias to it, so one whose alias was made by hand leaves greetd until
    # it's the display manager again, rather than none.
    if test "$1" != none; then
        if ! sudo_or_warn systemctl enable --force "$1"; then
            warn "couldn't put back $1; run '$(way_back "$1")'"
            return 1
        fi
        if ! _rd_dm=$(display_manager); then
            warn "couldn't ask systemd whether $1 is the display manager again, so greetd stays; once it is, run 'sudo systemctl disable greetd.service'"
            return 1
        fi
        if test "$_rd_dm" != "$1"; then
            warn "enabling $1 didn't make it the display manager again, as its unit would with Alias=display-manager.service, so greetd stays; make $1 the display manager, then run 'sudo systemctl disable greetd.service'"
            return 1
        fi
    fi
    if ! sudo_or_warn systemctl disable greetd.service; then
        warn "couldn't put back $1; run '$(way_back "$1")'"
        return 1
    fi
    if test "$1" = none; then
        info "greetd is no longer the display manager; from the next boot, log in on a text console"
    else
        info "$1 is the display manager again from the next boot"
    fi
}

# not_switching WHY says greetd isn't made the display manager, and why.
# When installing greetd just now made it one anyway (Debian's package does,
# where there was none), or setup can't tell whether it did, the one before
# is put back, so every way of not switching leaves the login screen as it
# was. Putting it back when nothing changed is harmless. greetd that was the
# display manager already gives way to the one it replaced too: greetd runs
# as root, and a config this run couldn't put right can be one that's
# malformed, someone else's, or for a greeter that has since changed. The
# next run that can puts greetd back.
not_switching() {
    if test "$dm_before" = greetd.service; then
        _back=$(replaced_display_manager)
        warn "$1; greetd isn't kept with a config this run couldn't put right, so putting back $(describe_dm "$_back") for the next boot"
        restore_display_manager "$_back" || :
        return 0
    fi
    warn "not making greetd the display manager, so $(describe_dm "$dm_before") stays: $1"
    # Asked afresh: whatever ran since, a package's install or an enable that
    # failed after replacing the alias, can have changed it.
    if ! _dm=$(display_manager) || ! valid_display_manager "$_dm"; then
        _dm=unknown
    fi
    if test "$_dm" != "$dm_before"; then
        restore_display_manager "$dm_before" || :
    fi
}

# setup_greeter makes greetd, with tide's greeter, the display manager, or
# with --no-greeter puts back the one it replaced. Nothing here is fatal:
# the tide session runs under any display manager. "setup_greeter early"
# installs nothing, leaving packages to the end like everything else, and
# takes greetd as the display manager, as early_greeter has just found it:
# a second query that failed would skip what that pass is for.
setup_greeter() {
    if ! is_command systemctl; then
        info "No systemd, so the display manager is left alone"
        return 0
    fi
    if test "${1-}" = early; then
        dm_now=greetd.service
    elif ! dm_now=$(display_manager) || ! valid_display_manager "$dm_now"; then
        warn "couldn't tell which display manager this is, so it's left alone"
        return 0
    fi
    dm_before=$dm_now
    if test "$GREETER" = no; then
        test "$dm_now" = greetd.service || return 0
        restore_display_manager "$(replaced_display_manager)" || :
        return 0
    fi
    # Installed here, after everything that can end the run, and once the
    # display manager is noted: Debian's package enables greetd on a machine
    # that has none, and from here on every way of not switching puts that
    # back.
    if test "$INSTALL" = yes && test "${1-}" != early; then
        install_greetd
        if ! dm_now=$(display_manager) || ! valid_display_manager "$dm_now"; then
            not_switching "couldn't tell which display manager this is after installing greetd"
            return 0
        fi
    fi
    if ! greeter_ready; then
        if test "$dm_before" != greetd.service; then
            not_switching "$why"
            return 0
        fi
        # greetd was the display manager before this run, and its greeter
        # wouldn't come up at the next boot: what it runs has broken since.
        # The login screen goes back to the one greetd replaced.
        _back=$(replaced_display_manager)
        warn "greetd's greeter can't run, so putting back $(describe_dm "$_back") for the next boot: $why"
        restore_display_manager "$_back" || :
        return 0
    fi
    if ! greetd_config; then
        not_switching "$why"
        return 0
    fi
    changed=no
    if ! install_text "$GREETD_DIR/config.toml" "$greetd_text"; then
        not_switching "couldn't write $GREETD_DIR/config.toml"
        return 0
    fi
    test "$changed" = no || info "greetd now runs tide's greeter as $greeter"
    greeter_home
    greeter_keyring
    if test "$dm_before" = greetd.service; then
        GREETER_ACTIVE=yes
        return 0
    fi
    if ! install_text "$PREVIOUS_DM_FILE" "$dm_before"; then
        not_switching "couldn't note it in $PREVIOUS_DM_FILE, which is the way back"
        return 0
    fi
    if ! sudo_or_warn systemctl enable --force greetd.service; then
        not_switching "systemctl couldn't enable greetd"
        return 0
    fi
    # Only a unit with Alias=display-manager.service takes the alias when
    # it's enabled; one without would start beside the display manager.
    if ! _dm=$(display_manager) || test "$_dm" != greetd.service; then
        # Enabling it made the links its unit names, a WantedBy=, say, which
        # would start it beside the display manager, so they go again.
        if ! sudo_or_warn systemctl disable greetd.service; then
            warn "couldn't disable greetd again, so it may start beside $(describe_dm "$dm_before") from the next boot; run 'sudo systemctl disable greetd.service'"
        fi
        not_switching "enabling greetd didn't make it the display manager, as its unit would with Alias=display-manager.service"
        return 0
    fi
    GREETER_ACTIVE=yes
    info "From the next boot, greetd's greeter replaces $(describe_dm "$dm_before"). If it doesn't come up, press Ctrl+Alt+F3, log in, and run '$(way_back "$dm_before")', or rerun 'setup --tide --no-greeter'"
}

# early_greeter runs before anything that can end the run, so a failure
# there can't keep greetd, as the display manager, with what it shouldn't
# have. When greetd is the display manager it does what setup_greeter does
# at the end, short of installing: with --no-greeter it puts back the one
# greetd replaced, and so it does when the greeter can't run as things
# stand; otherwise it puts greetd's config, the greeter's home and the PAM
# stack right. setup_greeter, at the end, makes greetd the display manager
# again if this run has made its greeter runnable.
early_greeter() {
    is_command systemctl || return 0
    # A display manager that can't be told is setup_greeter's to name.
    if ! _dm=$(display_manager) || test "$_dm" != greetd.service; then
        return 0
    fi
    setup_greeter early
}

# --- Main ---

if test "$SUDO" != no; then
    early_greeter
fi

if test "$INSTALL" = no; then
    info "Skipping tide packages (--no-install)"
elif test "$SUDO" = no; then
    info "Skipping tide packages (needs sudo; --no-sudo)"
else
    decide_hyprland_build
    install_packages
    install_quickshell
    # Only once the distro's is there to replace them.
    if test "$DISTRO_HYPRLAND" = yes; then
        unlink_hyprland || warn "couldn't remove the links to a source-built Hyprland in $HYPRLAND_BIN_DIR"
    fi
    if test "$BUILD_NOW" = yes; then
        # apt's Hyprland wasn't installed, so without this build there's no
        # compositor: that's fatal unless errors are being ignored.
        if ! build_hyprland; then
            if test "$IGNORE_ERRORS" = no; then
                error "the tide session needs Hyprland $MIN_HYPRLAND or later; rerun setup-tide to retry the build"
            fi
            warn "the tide session needs Hyprland $MIN_HYPRLAND or later; rerun setup-tide to retry the build"
        fi
    fi
fi
check_hyprland_version
fetch_tide
install_tide
enable_unit
if is_command systemctl; then
    mask_distro_units
fi
GREETER_ACTIVE=no
if test "$SUDO" = no; then
    info "Leaving the logind lid drop-ins, GDM and the display manager alone (needs sudo; --no-sudo)"
else
    remove_old_lid_dropins
    gdm_hostname_banner
    setup_greeter
fi

if test "$GREETER_ACTIVE" = yes; then
    info "tide installed. Pick the \"tide\" session at greetd's greeter; KDE Plasma stays available there."
else
    info "tide installed. Log out and pick the \"tide\" session; KDE Plasma stays available."
fi
