#!/bin/sh
# setup-tide: installs tide (github.com/mikelward/tide) with its own
# installer, install/tide-setup, then adds this repo's own extras:
#
# - a desktop entry for each app script here (gmail, google-calendar,
#   browser1, notepad, ...), so tide's launcher lists it by name, with the
#   site's own icon for a web app, fetched once; a fork of one in
#   ~/scripts.local runs instead (see install_launcher_entries);
# - on a GDM machine, the short hostname on GDM's login screen, as
#   hyprlock shows it on the lock screen, for as long as GDM is the way
#   back;
# - removes the logind lid drop-ins the retired setup-hypr/setup-sway
#   installed. They set HandleLidSwitch=ignore, and tide leaves suspend
#   to logind's defaults, so with one left in place an undocked lid close
#   would never suspend.
#
# `setup` runs this after setup-kde, so KDE Plasma stays the fallback
# session. It clones or updates the tide checkout first, unless --no-fetch,
# which setup passes, having cloned or pulled it itself. Every other option
# is tide-setup's (`install/tide-setup --help` lists them); this reads
# --no-sudo, --verbose and --github too. The dotfiles (conf's config/hypr
# and friends) come from confinst, which setup runs first.
#
# Usage:
#     setup-tide [--no-fetch] [tide-setup's options]

SUDO=yes
VERBOSE=no
FETCH=yes
GITHUB_PREFIX="${GITHUB_PREFIX:-}"
TIDE_REPO="${TIDE_REPO:-https://github.com/mikelward/tide.git}"
TIDE_DIR="${TIDE_DIR:-$HOME/src/tide}"
# Overridable for tests, which can't touch the real /etc.
LOGIND_DIR="${SETUP_LOGIND_DIR:-/etc/systemd/logind.conf.d}"
# GDM's greeter defaults (present when GDM is installed), the dconf system
# config, and the gdm dconf profile Debian ships outside /etc.
GDM_DEFAULTS="${SETUP_GDM_DEFAULTS:-/usr/share/gdm/greeter-dconf-defaults}"
DCONF_DIR="${SETUP_DCONF_DIR:-/etc/dconf}"
DCONF_SHARE_PROFILE="${SETUP_DCONF_SHARE_PROFILE:-/usr/share/dconf/profile/gdm}"


# Every warning and error goes to $SETUP_PROBLEMS too, so the run ends by
# repeating them all: one line among thousands scrolls by unseen. The
# outermost of setup and its helpers (setup-kde, setup-tide, setup-macos)
# makes the file and repeats it as it exits, however it exits; a helper it
# runs inherits the file and only adds to it.
note_problem() {
    test -n "${SETUP_PROBLEMS:-}" || return 0
    printf '%s\n' "$1" >>"$SETUP_PROBLEMS" ||
        printf "Warning: couldn't add that to %s, so the end of the run won't repeat it\n" "$SETUP_PROBLEMS" >&2
}

PROBLEMS_OWNER=no
start_problem_recap() {
    test -z "${SETUP_PROBLEMS:-}" || return 0
    if ! SETUP_PROBLEMS=$(mktemp "${TMPDIR:-/tmp}/setup-problems-XXXXXX"); then
        SETUP_PROBLEMS=
        warn "couldn't make a file to collect warnings in, so the end of the run won't repeat them"
        return 0
    fi
    export SETUP_PROBLEMS
    PROBLEMS_OWNER=yes
}

# recap_problems STATUS, from the EXIT trap: repeats every warning and error,
# says if the run stopped early, and keeps STATUS as the exit status.
# shellcheck disable=SC2317  # run from the EXIT trap
recap_problems() {
    test "$PROBLEMS_OWNER" = yes || return "$1"
    if test -s "$SETUP_PROBLEMS"; then
        printf '\n%s: the warnings and errors from this run, again:\n' "setup-tide" >&2
        sed 's/^/  /' "$SETUP_PROBLEMS" >&2
    fi
    if test "$1" -ne 0; then
        printf '%s stopped early, with exit status %s\n' "setup-tide" "$1" >&2
    fi
    rm -f "$SETUP_PROBLEMS"
    return "$1"
}

info() {
    printf "%s\n" "$*"
}

# detail: an info line that only --verbose shows, for what was already so.
detail() {
    test "${VERBOSE:-no}" = yes || return 0
    info "$@"
}

warn() {
    printf "Warning: %s\n" "$*" >&2
    note_problem "Warning: $*"
}

error() {
    printf "Error: %s\n" "$*" >&2
    note_problem "Error: $*"
    exit 1
}

is_command() {
    test -x "$(command -v "$1")"
}

# Run one privileged command without letting a sudo failure abort the helper
# under set -e. Mirrors setup's sudo_or_warn: on a box where sudo is allowed
# for package installs but denied for other commands, a denied lid/service
# step warns and the helper keeps going instead of exiting. The proactive
# --no-sudo skip is handled by the caller's SUDO guard below, so this wrapper
# only needs the reactive path -- but it still honours SUDO=no defensively.
sudo_or_warn() {
    # Named for the command, after any VAR=value sudo sets for it.
    _sudo_name=
    for _sudo_arg; do
        case "$_sudo_arg" in
            *=*) ;;
            *) _sudo_name=${_sudo_arg##*/}; break ;;
        esac
    done
    if test "$SUDO" = no; then
        warn "skipping 'sudo $_sudo_name' (--no-sudo)"
        return 1
    fi
    _sudo_stderr=$(mktemp) || {
        warn "sudo $_sudo_name: could not create a temporary error log"
        return 1
    }

    # sudo_logged sets _sudo_out to the log, for all of the output, which
    # is the user's to write, not root's. Without it, stdout is left as it
    # is.
    _sudo_status=0
    if test -n "${_sudo_out:-}"; then
        # shellcheck disable=SC2024
        sudo "$@" >>"$_sudo_out" 2>"$_sudo_stderr" || _sudo_status=$?
    else
        sudo "$@" 2>"$_sudo_stderr" || _sudo_status=$?
    fi
    if test "$_sudo_status" -eq 0; then
        if test -n "${_sudo_out:-}"; then
            cat "$_sudo_stderr" >>"$_sudo_out"
        else
            cat "$_sudo_stderr" >&2
        fi
        rm -f "$_sudo_stderr"
        return 0
    fi
    test -z "${_sudo_out:-}" || cat "$_sudo_stderr" >>"$_sudo_out"
    _sudo_detail=$(awk 'NF { line = $0 } END { print line }' "$_sudo_stderr")
    rm -f "$_sudo_stderr"

    case "$_sudo_status" in
        126) _sudo_detail="permission denied" ;;
        127) _sudo_detail="command not found" ;;
        *)
            case "$_sudo_detail" in
                "sudo: $_sudo_name: "*) _sudo_detail=${_sudo_detail#"sudo: $_sudo_name: "} ;;
                "sudo: "*) _sudo_detail=${_sudo_detail#"sudo: "} ;;
                "$_sudo_name: "*) _sudo_detail=${_sudo_detail#"$_sudo_name: "} ;;
            esac
            if test -z "$_sudo_detail"; then
                _sudo_detail="failed (exit status $_sudo_status)"
            fi
            ;;
    esac
    warn "sudo $_sudo_name: $_sudo_detail"
    return "$_sudo_status"
}

# trusted_entry PATH: whether PATH itself, not where a link leads, is root's,
# and writable by no one else unless it's a link, whose own mode means
# nothing. Sets entry_type, or why it isn't.
trusted_entry() {
    # %F is translated, so ask for C's.
    if ! _e_stat=$(LC_ALL=C stat -c '%u %a %F' -- "$1"); then
        why="couldn't look at $1"
        return 1
    fi
    _e_uid=${_e_stat%% *}
    _e_stat=${_e_stat#* }
    _e_mode=${_e_stat%% *}
    entry_type=${_e_stat#* }
    if test "$_e_uid" != 0; then
        why="$1 is uid $_e_uid's, not root's"
        return 1
    fi
    test "$entry_type" != "symbolic link" || return 0
    case "$_e_mode" in
        "" | *[!0-7]*)
            why="couldn't read $1's mode"
            return 1
            ;;
    esac
    if test $((0$_e_mode & 022)) -ne 0; then
        why="users other than root can write $1"
        return 1
    fi
}

# trusted PATH [missing-ok]: whether only root can change what PATH names,
# setting why if not. The greeter reads every password typed at login, so
# nothing it runs, or reads as code, may be anyone else's to change. Every
# directory on the way down from /, every link on the way and every one
# where it leads, and PATH itself, have to be root's and writable by no one
# else, as the kernel would walk them. Sets trusted_to to where PATH leads.
# With missing-ok, a PATH that isn't there passes, since only root could
# make it.
trusted() {
    case "$1" in
        /*) ;;
        *)
            why="$1 isn't a full path"
            return 1
            ;;
    esac
    trusted_entry / || return 1
    _t_nl='
'
    _t_dir=/
    _t_rest=$1
    _t_links=0
    while :; do
        _t_rest=${_t_rest#"${_t_rest%%[!/]*}"}
        test -n "$_t_rest" || break
        _t_name=${_t_rest%%/*}
        _t_rest=${_t_rest#"$_t_name"}
        case "$_t_name" in
            .) continue ;;
            ..)
                _t_dir=${_t_dir%/*}
                test -n "$_t_dir" || _t_dir=/
                continue
                ;;
        esac
        _t_path=${_t_dir%/}/$_t_name
        if ! test -e "$_t_path" && ! test -L "$_t_path"; then
            if test "$2" = missing-ok; then
                trusted_to=
                return 0
            fi
            why="$_t_path isn't there"
            return 1
        fi
        trusted_entry "$_t_path" || return 1
        if test "$entry_type" != "symbolic link"; then
            _t_dir=$_t_path
            continue
        fi
        # The kernel's limit.
        _t_links=$((_t_links + 1))
        if test "$_t_links" -gt 40; then
            why="$1 leads through too many links"
            return 1
        fi
        # The x keeps a newline the target ends in, which $(...) would
        # strip, to check a name other than the one the kernel follows.
        if ! _t_target=$(readlink -- "$_t_path" && echo x); then
            why="couldn't read the link $_t_path"
            return 1
        fi
        _t_target=${_t_target%x}
        _t_target=${_t_target%"$_t_nl"}
        case "$_t_target" in
            *"$_t_nl"*)
                why="the link $_t_path leads to a name with a newline in it"
                return 1
                ;;
        esac
        case "$_t_target" in
            /*) _t_dir=/ ;;
        esac
        _t_rest=$_t_target/$_t_rest
    done
    # shellcheck disable=SC2034  # tide-setup's callers read it; none here do
    trusted_to=$_t_dir
}

# Installs $2 as the root-owned file $1, unless it already says that and
# only root can change it: a copy someone else can change is replaced, since
# root reads each of these, and nothing is written in a directory someone
# else can. Returns 1 if it couldn't, and sets $changed when it wrote.
install_text() {
    # In a directory someone else can write, they could swap the file once
    # it's written, so it isn't written there.
    if ! trusted "${1%/*}" missing-ok; then
        warn "not writing $1: $why"
        return 1
    fi
    _tmp=$(mktemp) || {
        warn "couldn't create a temporary file for $1"
        return 1
    }
    if ! printf '%s\n' "$2" > "$_tmp"; then
        warn "couldn't write a temporary copy of $1"
        rm -f "$_tmp"
        return 1
    fi
    if cmp -s "$_tmp" "$1" && trusted "$1"; then
        rm -f "$_tmp"
        return 0
    fi
    if sudo_or_warn install -D -m 644 "$_tmp" "$1"; then
        rm -f "$_tmp"
        changed=yes
        return 0
    fi
    rm -f "$_tmp"
    return 1
}

# normalize_github_prefix PREFIX, as setup's: PREFIX with the separator an
# OWNER/REPO path follows, so a bare host is SSH (host:) and a URL gets a /.
normalize_github_prefix() {
    case "$1" in
        */ | *:) printf '%s' "$1" ;;
        *://*)   printf '%s/' "$1" ;;
        *)       printf '%s:' "$1" ;;
    esac
}

# Everything but --fetch and --no-fetch goes to tide-setup; these it reads
# for its own steps as well.
for arg; do
    case "$arg" in
        --no-sudo) SUDO=no ;;
        --sudo) SUDO=yes ;;
        -v | --verbose) VERBOSE=yes ;;
        --github=*) GITHUB_PREFIX=${arg#--github=} ;;
    esac
done
prev=
for arg; do
    test "$prev" != --github || GITHUB_PREFIX=$arg
    prev=$arg
done


# The mirror that stands in for https://github.com/, or nothing for GitHub
# itself. setup's default, GitHub over SSH, is GitHub too: these repos are
# public, so they're cloned over HTTPS, which needs no key.
case "$GITHUB_PREFIX" in
    "" | git@github.com: | https://github.com/) GITHUB_BASE= ;;
    *) GITHUB_BASE=$(normalize_github_prefix "$GITHUB_PREFIX") ;;
esac

# git_github runs git with each https://github.com/ URL rewritten to
# $GITHUB_BASE, a submodule's too: a url.insteadOf rule, given in the
# environment rather than with -c, so a token in the prefix stays out of
# ps. It goes after any the environment already gives git. Nothing to
# rewrite runs plain git.
git_github() {
    if test -z "$GITHUB_BASE"; then
        git "$@"
        return
    fi
    _gh_n=${GIT_CONFIG_COUNT:-0}
    case $_gh_n in
        *[!0-9]*)
            warn "GIT_CONFIG_COUNT is '$_gh_n', not a number, so git can't be pointed at $(github_host "$GITHUB_BASE")"
            return 1
            ;;
    esac
    _gh_status=0
    env "GIT_CONFIG_COUNT=$((_gh_n + 1))" "GIT_CONFIG_KEY_$_gh_n=url.$GITHUB_BASE.insteadOf" \
        "GIT_CONFIG_VALUE_$_gh_n=https://github.com/" git "$@" || _gh_status=$?
    test "$_gh_status" -eq 0 && return 0
    # git's own words name the mirror's answer, not the mirror: a repo it
    # doesn't have reads as a missing branch.
    for _gh_arg; do
        case "$_gh_arg" in
            https://github.com/*)
                warn "$(github_host "$GITHUB_BASE") couldn't give git ${_gh_arg#https://github.com/}, which stands in for GitHub; it may not mirror that repo or tag yet"
                break
                ;;
        esac
    done
    return "$_gh_status"
}

# github_host PREFIX: the host in a normalized prefix, without a user or
# token, to name in a message.
github_host() {
    case "$1" in
        *://*)
            _gh_host=${1#*://}
            _gh_host=${_gh_host%%/*}
            ;;
        *) _gh_host=${1%%:*} ;;
    esac
    printf '%s' "${_gh_host#*@}"
}

# $TIDE_REPO only steers a fresh clone; an existing checkout pulls from
# its own origin.
# default_branch DIR: origin's default branch, as DIR's clone recorded it,
# or main or master when it recorded none.
default_branch() {
    if _db=$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
        printf '%s\n' "${_db#origin/}"
        return 0
    fi
    for _db in main master; do
        if git -C "$1" show-ref --verify --quiet "refs/remotes/origin/$_db"; then
            printf '%s\n' "$_db"
            return 0
        fi
    done
    return 1
}

# pull_checkout DIR USE GIT...: runs GIT..., a git pull of DIR. When it
# fails, or leaves DIR on a branch other than origin's default, it warns why
# and what happens instead (USE): nothing here switches a branch or drops a
# change. Fails when the pull did.
pull_checkout() {
    _pc_dir=$1
    _pc_use=$2
    _pc_said=
    shift 2
    # The branch is read before pulling: a rebase that stops on conflicts
    # leaves HEAD detached. symbolic-ref exits 1 for a detached HEAD, and
    # more when it can't say.
    _pc_sym=0
    _pc_branch=$(git -C "$_pc_dir" symbolic-ref --quiet --short HEAD 2>/dev/null) || _pc_sym=$?
    _pc_status=0
    _pc_out=$("$@" 2>&1) || _pc_status=$?
    if test "$_pc_status" -eq 0; then
        test -z "$_pc_out" || printf '%s\n' "$_pc_out"
        if test -n "$_pc_branch" && _pc_default=$(default_branch "$_pc_dir") \
                && test -n "$_pc_default" && test "$_pc_branch" != "$_pc_default"; then
            warn "$_pc_dir is on branch $_pc_branch, not $_pc_default; $_pc_use"
        fi
        return 0
    fi
    case "$_pc_out" in
        *CONFLICT* | *"merge failed"*) _pc_sym=conflicts ;;
    esac
    if test "$_pc_sym" = conflicts; then
        _pc_why="it has conflicts to resolve"
    elif test "$_pc_sym" -eq 1; then
        _pc_why="it's detached at $(git -C "$_pc_dir" rev-parse --short HEAD 2>/dev/null)"
    elif test "$_pc_sym" -eq 0 && ! git -C "$_pc_dir" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
        _pc_why="branch $_pc_branch has no upstream"
    else
        # Only what says the network failed: a server that answers and
        # refuses (an HTTP 403, a rejected key) gets git's reason, below.
        case "$_pc_out" in
            *"Could not resolve host"* | *"Failed to connect to"* | *"Couldn't connect to server"* \
            | *"timed out"* | *"Network is unreachable"* | *"Connection refused"*)
                _pc_why="can't reach origin" ;;
            *"would be overwritten"* | *"local changes"* | *"unstaged changes"* \
            | *"uncommitted changes"* | *"commit your changes"* | *"commit or stash"*)
                _pc_why="local changes are in the way" ;;
            *"fast-forward"* | *"divergent"* | *"diverged"*)
                _pc_why="it has diverged from $(git -C "$_pc_dir" rev-parse --abbrev-ref '@{u}' 2>/dev/null)" ;;
            *)
                # git's own reason, with any credentials in a URL taken out,
                # and all of what git said under it when that's more than the
                # one line: the reason can come before git's line (ssh's
                # "Permission denied (publickey)") or instead of it (a hook's
                # refusal).
                _pc_said=$(printf '%s\n' "$_pc_out" | sed 's#://[^/@ ]*@#://***@#g')
                _pc_why=$(printf '%s\n' "$_pc_said" | awk '/^(fatal|error): / { sub(/^(fatal|error): /, ""); print; exit }')
                if test -z "$_pc_why"; then
                    _pc_why="git pull exited $_pc_status"
                elif test "$(printf '%s\n' "$_pc_said" | wc -l)" -eq 1; then
                    _pc_said=
                fi ;;
        esac
    fi
    warn "couldn't update $_pc_dir: $_pc_why; $_pc_use"
    test -z "$_pc_said" || printf '%s\n' "$_pc_said" | sed 's/^/    /' >&2
    return "$_pc_status"
}

fetch_tide() {
    if test "$FETCH" = no; then
        test -d "$TIDE_DIR/.git" \
            || error "no tide checkout at $TIDE_DIR (--no-fetch)"
    elif test -d "$TIDE_DIR/.git"; then
        detail "Updating $TIDE_DIR"
        # The existing checkout is enough to install, so a failed pull (no
        # network, say) warns, saying why, rather than ending the run. A
        # checkout cloned through the mirror still names GitHub as its
        # origin, so the pull goes through the mirror too. Quiet, as setup's
        # pulls are.
        pull_checkout "$TIDE_DIR" "installing it as it is" \
            git_github -C "$TIDE_DIR" pull --quiet --ff-only || :
    else
        # Not naming the URL: one passed with credentials in it would land in
        # the terminal and any captured log, so the clone isn't logged
        # either, just quiet, as setup's are.
        info "Cloning tide into $TIDE_DIR"
        mkdir -p "$(dirname "$TIDE_DIR")"
        git_github clone --quiet "$TIDE_REPO" "$TIDE_DIR"
    fi
}

# --- Launcher entries for the app scripts ---

# The scripts that open an app: launcher-scripts, beside this script, says
# which, by what name and with what icon, for tilemo's switcher too.
LAUNCHER_SCRIPTS_LIST="${SETUP_LAUNCHER_SCRIPTS:-$(cd "$(dirname "$0")" && pwd)/launcher-scripts}"
# Where they live: this script's own directory, ~/scripts.
SCRIPTS_DIR="${SETUP_SCRIPTS_DIR:-$(cd "$(dirname "$0")" && pwd)}"
# A machine's own fork of one, which conf's env puts ahead of ~/scripts on
# PATH, so it's what runenv, and so tide's keys, run. Read when setup runs:
# a fork made or removed later needs setup again.
SCRIPTS_LOCAL_DIR="$HOME/scripts.local"
# Where a web app's site icon is kept, fetched once.
LAUNCHER_ICON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/icons/scripts"

# The `--app=URL` a launcher script opens as a Chrome app window, or nothing.
launcher_web_app() {
    sed -n 's/.*--app=["'"'"']\{0,1\}\(https\{0,1\}:\/\/[^"'"'"' ;&|)]*\).*/\1/p' "$1" | head -n 1
}

# The class Chrome gives an `--app` window of URL on Wayland, as tide-grant's
# webAppClass works it out (tide SPEC.md §14.3): its host, then its path with
# each / a _, so https://mail.google.com is chrome-mail.google.com__-Default.
# The launcher grants focus to the entry's StartupWMClass, so the window
# the script opens takes focus.
launcher_web_class() {
    _lw_rest=${1#*://}
    _lw_host=${_lw_rest%%/*}
    _lw_path=/
    case "$_lw_rest" in */*) _lw_path=/${_lw_rest#*/} ;; esac
    printf 'chrome-%s_%s-Default\n' "$(printf '%s' "$_lw_host" | tr '[:upper:]' '[:lower:]')" \
        "$(printf '%s' "$_lw_path" | tr / _)"
}

# A web app's own site icon, at $LAUNCHER_ICON_DIR/SCRIPT.png: fetched once
# from Google's favicon service (the site's host is all it's told), and
# kept, so a rerun stays offline. Delete the file to fetch it again. Prints
# the path, or nothing when there's none, for the theme icon instead.
launcher_site_icon() {
    _li_icon=$LAUNCHER_ICON_DIR/$1.png
    if test -s "$_li_icon"; then
        printf '%s\n' "$_li_icon"
        return 0
    fi
    # Not tied to --no-fetch, which is about the tide checkout: setup
    # passes it on every run, having pulled the checkout itself.
    is_command curl || return 0
    _li_rest=${2#*://}
    mkdir -p "$LAUNCHER_ICON_DIR" || return 0
    _li_tmp=$(mktemp "$LAUNCHER_ICON_DIR/.$1.XXXXXX") || return 0
    if curl --fail --silent --show-error --location --max-time 10 --output "$_li_tmp" \
        "https://www.google.com/s2/favicons?sz=128&domain=${_li_rest%%/*}" \
        && test "$(head -c 4 "$_li_tmp" | tail -c 3)" = PNG \
        && mv -f "$_li_tmp" "$_li_icon"; then
        printf '%s\n' "$_li_icon"
        return 0
    fi
    rm -f "$_li_tmp"
    warn "couldn't fetch $1's site icon, so the launcher shows a theme icon; setup fetches it again next run"
}

# Writes ~/.local/share/applications/scripts-SCRIPT.desktop for each line of
# launcher-scripts whose script is here, and removes the scripts-*.desktop
# entries of scripts no longer listed or gone. An entry runs the script's
# fork in ~/scripts.local when it has one, and takes its window class from
# the fork's --app URL, since that's what opens. The prefix marks them as
# setup's, beside setup-kde's hidden shortcut-*.desktop. The launcher reads
# the directory again when it changes, so they show up without a restart.
install_launcher_entries() {
    _le_dir=${XDG_DATA_HOME:-$HOME/.local/share}/applications
    if ! mkdir -p "$_le_dir"; then
        warn "couldn't make $_le_dir, so the launcher won't list the app scripts"
        return 0
    fi
    if ! test -r "$LAUNCHER_SCRIPTS_LIST"; then
        warn "can't read $LAUNCHER_SCRIPTS_LIST, so the launcher won't list the app scripts"
        return 0
    fi
    _le_kept=' '
    _le_count=0
    # The fourth field, MAC, is tilemo's, and read into _.
    while IFS='|' read -r _le_script _le_name _le_icon _; do
        case "$_le_script" in
            '' | '#'*) continue ;;
        esac
        _le_path=$SCRIPTS_LOCAL_DIR/$_le_script
        test -x "$_le_path" || _le_path=$SCRIPTS_DIR/$_le_script
        test -x "$_le_path" || continue
        case "$_le_path" in
            *[\"\`\$\\]* | *"
"*)
                warn "$_le_path has a character a desktop entry's Exec can't quote, so the launcher won't list $_le_script"
                continue
                ;;
        esac
        _le_class=
        _le_url=$(launcher_web_app "$_le_path")
        if test -n "$_le_url"; then
            _le_class=$(launcher_web_class "$_le_url")
            _le_site=$(launcher_site_icon "$_le_script" "$_le_url")
            test -z "$_le_site" || _le_icon=$_le_site
        fi
        _le_file=$_le_dir/scripts-$_le_script.desktop
        _le_tmp=$(mktemp "$_le_dir/.scripts-$_le_script.XXXXXX") || {
            warn "couldn't write $_le_file, so the launcher won't list $_le_script"
            continue
        }
        if ! {
            printf '[Desktop Entry]\nType=Application\n'
            printf 'Name=%s\n' "$_le_name"
            # Quoted, so a path with a space is one word; the characters
            # Exec would need escaped inside the quotes are refused above.
            printf 'Exec="%s"\n' "$_le_path"
            printf 'TryExec=%s\n' "$_le_path"
            printf 'Icon=%s\n' "$_le_icon"
            test -z "$_le_class" || printf 'StartupWMClass=%s\n' "$_le_class"
        } > "$_le_tmp" || ! mv -f "$_le_tmp" "$_le_file"; then
            rm -f "$_le_tmp"
            warn "couldn't write $_le_file, so the launcher won't list $_le_script"
            continue
        fi
        _le_kept="$_le_kept$_le_script "
        _le_count=$((_le_count + 1))
    done < "$LAUNCHER_SCRIPTS_LIST"
    for _le_old in "$_le_dir"/scripts-*.desktop; do
        test -f "$_le_old" || continue
        _le_name=${_le_old##*/scripts-}
        _le_name=${_le_name%.desktop}
        case "$_le_kept" in
            *" $_le_name "*) ;;
            *) rm -f "$_le_old" || warn "couldn't remove $_le_old, a launcher entry for a script that's gone" ;;
        esac
    done
    detail "Listing $_le_count app scripts in the launcher, with entries in $_le_dir"
}

remove_old_lid_dropins() {
    removed=no
    for f in "$LOGIND_DIR/10-hypr-lid.conf" "$LOGIND_DIR/10-sway-lid.conf"; do
        if test -e "$f"; then
            info "Removing $f (tide leaves the lid to logind's defaults)"
            if sudo_or_warn rm -f "$f"; then
                removed=yes
            else
                warn "could not remove $f; an undocked lid close won't suspend until it's gone"
            fi
        fi
    done
    if test "$removed" = yes; then
        sudo_or_warn systemctl kill -s HUP systemd-logind \
            || warn "could not reload systemd-logind; the change applies after a reboot"
    fi
}

# GDM's login screen shows a banner set in dconf: a keyfile in the gdm
# system database, which the gdm profile reads. Debian ships that profile in
# /usr/share; elsewhere it goes in /etc, as GNOME's admin guide does it. The
# name is read at each run, so rerun setup after renaming the machine.
gdm_hostname_banner() {
    test -e "$GDM_DEFAULTS" || return 0
    if ! is_command dconf; then
        warn "GDM is installed but dconf isn't, so the login screen can't show the hostname; install dconf-cli (Debian) or dconf"
        return 0
    fi
    host=$(uname -n | cut -d. -f1)
    changed=no
    profile="$DCONF_DIR/profile/gdm"
    # The /etc profile, when there is one, overrides the shipped one.
    if test -e "$profile"; then
        if ! grep -qx 'system-db:gdm' "$profile"; then
            warn "$profile doesn't read the gdm dconf database (system-db:gdm), so the login screen won't show the hostname; add that line"
            return 0
        fi
    elif test -e "$DCONF_SHARE_PROFILE" && grep -qx 'system-db:gdm' "$DCONF_SHARE_PROFILE"; then
        : # the shipped profile reads the gdm database
    else
        install_text "$profile" "user-db:user
system-db:gdm
file-db:$GDM_DEFAULTS" || {
            warn "couldn't install $profile; the login screen won't show the hostname"
            return 0
        }
    fi
    install_text "$DCONF_DIR/db/gdm.d/50-tide-hostname" "[org/gnome/login-screen]
banner-message-enable=true
banner-message-text='$host'" || {
        warn "couldn't install GDM's hostname banner; the login screen won't show the hostname"
        return 0
    }
    if test "$changed" = yes; then
        info "GDM's login screen now shows $host"
        sudo_or_warn dconf update \
            || warn "dconf update failed, so GDM won't show the hostname until it succeeds; run 'sudo dconf update'"
    fi
}

# --- Main ---

# --help says what this adds, then shows the installer's own, from the
# checkout as it is: it changes nothing, fetches nothing.
for arg; do
    case "$arg" in
        -h | --help)
            printf '%s\n' "Usage: setup-tide [--no-fetch] [tide-setup's options]" \
                "" \
                "Updates the tide checkout in $TIDE_DIR (unless --no-fetch), runs its" \
                "installer, install/tide-setup, then lists this repo's app scripts in the" \
                "launcher, removes old logind lid drop-ins and puts the hostname on GDM's" \
                "login screen. The installer's options:" ""
            if test -x "$TIDE_DIR/install/tide-setup"; then
                exec "$TIDE_DIR/install/tide-setup" --help
            fi
            echo "(No installer at $TIDE_DIR/install/tide-setup yet; run setup-tide once to fetch it.)"
            exit 0
            ;;
    esac
done

start_problem_recap
trap 'recap_problems "$?"' EXIT

# tide-setup's options, without ours.
for arg; do
    shift
    case "$arg" in
        --fetch) FETCH=yes ;;
        --no-fetch) FETCH=no ;;
        *) set -- "$@" "$arg" ;;
    esac
done

fetch_tide
installer=$TIDE_DIR/install/tide-setup
test -x "$installer" \
    || error "the tide checkout in $TIDE_DIR has no installer (install/tide-setup); update it with 'git -C $TIDE_DIR pull'"

# Its messages say to run setup again, and a busy apt puts this on setup's
# list to try again. It adds to setup's log and its list of problems.
status=0
SETUP_COMMAND=setup SETUP_APT_RETRY_NAME=setup-tide GITHUB_PREFIX=$GITHUB_PREFIX \
    "$installer" "$@" || status=$?

install_launcher_entries
if test "$SUDO" = no; then
    info "Leaving the logind lid drop-ins and GDM alone (needs sudo; --no-sudo)"
else
    remove_old_lid_dropins
    gdm_hostname_banner
fi
exit "$status"
