#!/bin/bash
# Tests for setup-quickspace
#
# Runs setup-quickspace against a throwaway HOME, logind dir and quickspace
# checkout, with sudo, the package managers, git, make, systemctl and
# Hyprland mocked. Each mock logs its argv to $CALLS.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$SCRIPT_DIR/setup-quickspace"
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0

setup() {
    T="$(mktemp -d)"
    CALLS="$T/calls"
    # What the installs would create.
    mkdir -p "$T/bin" "$T/home" "$T/logind" "$T/usr-local-bin"
    for cmd in dnf pacman make; do
        printf '#!/bin/sh\nprintf "%%s\\n" "%s $*" >> "%s"\n' "$cmd" "$CALLS" > "$T/bin/$cmd"
    done
    # meson setup also logs the compilers it was given.
    cat > "$T/bin/meson" <<MOCK
#!/bin/sh
printf "%s\\n" "meson \$*" >> "$CALLS"
test "\$1" != setup || printf "%s\\n" "meson compilers CC=\$CC CXX=\$CXX" >> "$CALLS"
MOCK
    # apt-get refuses the whole command when it names a package in
    # \$FAKE_MISSING, as apt does.
    cat > "$T/bin/apt-get" <<MOCK
#!/bin/sh
printf "%s\\n" "apt-get \$*" >> "$CALLS"
test -z "\$FAKE_APT_GET_FAILS" || exit 100
for arg; do
    case " \$FAKE_MISSING " in *" \$arg "*) exit 100 ;; esac
done
MOCK
    # apt-cache policy knows every package but those in \$FAKE_MISSING,
    # offering Hyprland \$FAKE_APT_HYPRLAND (or a new enough one), g++-16
    # \$FAKE_APT_GXX and libxkbcommon-dev \$FAKE_APT_XKB (or Ubuntu 26.04's),
    # and 1.0 of the rest. \$FAKE_APT_CACHE_FAILS makes it fail.
    cat > "$T/bin/apt-cache" <<MOCK
#!/bin/sh
test -z "\$FAKE_APT_CACHE_FAILS" || exit 100
shift
for pkg; do
    case " \$FAKE_MISSING " in *" \$pkg "*) continue ;; esac
    case "\$pkg" in
        hyprland) version="\${FAKE_APT_HYPRLAND:-0.56.2-1}" ;;
        g++-16) version="\${FAKE_APT_GXX:-16-20260322-1ubuntu1}" ;;
        libxkbcommon-dev) version="\${FAKE_APT_XKB:-1.13.1-1}" ;;
        *) version=1.0-1 ;;
    esac
    printf "%s:\\n  Installed: (none)\\n  Candidate: %s\\n  Version table:\\n" "\$pkg" "\$version"
done
MOCK
    # cmake configuring into a prefix creates the commands the build would
    # install there, and logs which hyprwayland-scanner it would run.
    # Configuring anything named in \$FAKE_CMAKE_FAILS fails.
    cat > "$T/bin/cmake" <<MOCK
#!/bin/sh
printf "%s\\n" "cmake \$*" >> "$CALLS"
for arg; do
    case "\$arg" in
        -DCMAKE_INSTALL_PREFIX=*)
            prefix=\${arg#*=}
            mkdir -p "\$prefix/bin"
            for cmd in Hyprland hyprctl hyprwayland-scanner; do
                printf "#!/bin/sh\\n" > "\$prefix/bin/\$cmd"
                chmod +x "\$prefix/bin/\$cmd"
            done
            ;;
    esac
done
printf "%s\\n" "cmake finds \$(command -v hyprwayland-scanner)" >> "$CALLS"
if test -n "\$FAKE_CMAKE_FAILS"; then
    case "\$*" in *"/\$FAKE_CMAKE_FAILS "*) exit 1 ;; esac
fi
exit 0
MOCK
    # sudo runs the command, so rm and the rest really happen (on $T paths).
    # \$FAKE_LN_FAILS makes linking fail. \$FAKE_RM_KEEPS makes rm remove
    # everything but the file it names, then fail.
    cat > "$T/bin/sudo" <<MOCK
#!/bin/sh
printf "%s\\n" "sudo \$*" >> "$CALLS"
test "\$1" != ln || test -z "\$FAKE_LN_FAILS" || exit 1
if test "\$1" = rm && test -n "\$FAKE_RM_KEEPS"; then
    shift
    for f; do
        case "\$f" in -*|*/"\$FAKE_RM_KEEPS") ;; *) rm -f "\$f" ;; esac
    done
    exit 1
fi
"\$@"
MOCK
    # git clone creates the checkout, its last argument; pull just logs, or
    # fails with \$FAKE_PULL_FAILS.
    cat > "$T/bin/git" <<MOCK
#!/bin/sh
printf "%s\\n" "git \$*" >> "$CALLS"
if test "\$1" = clone; then
    for last; do :; done
    mkdir -p "\$last/.git"
    # wayland-protocols generates its headers with a strict scanner.
    case "\$last" in
        */wayland-protocols) printf "%s\\n" "command: [scanner, '--strict', 'enum-header']" > "\$last/meson.build" ;;
    esac
fi
if test "\$3" = pull && test -n "\$FAKE_PULL_FAILS"; then exit 1; fi
MOCK
    cat > "$T/bin/systemctl" <<MOCK
#!/bin/sh
printf "%s\\n" "systemctl \$*" >> "$CALLS"
test "\$2" != show-environment || exit \${FAKE_NO_USER_MANAGER:-0}
MOCK
    # go answers GOVERSION with \$FAKE_GO_VERSION, or a new enough one.
    cat > "$T/bin/go" <<MOCK
#!/bin/sh
printf "%s\\n" "go \$*" >> "$CALLS"
test "\$*" != "env GOVERSION" || echo "\${FAKE_GO_VERSION:-go1.22.2}"
MOCK
    cat > "$T/bin/Hyprland" <<MOCK
#!/bin/sh
echo "Hyprland \${FAKE_HYPRLAND_VERSION:-0.56.2} built from branch main"
MOCK
    chmod +x "$T"/bin/*
}

teardown() {
    rm -rf "$T"
}

run() {
    set +e
    output=$(env HOME="$T/home" PATH="$T/bin:$PATH" SETUP_LOGIND_DIR="$T/logind" \
        QUICKSPACE_DIR="$T/src/quickspace" QUICKSPACE_REPO="https://example.com/quickspace.git" \
        HYPRLAND_PREFIX="$T/opt/hyprland" HYPRLAND_SRC="$T/src/hyprland-build" HYPRLAND_BIN_DIR="$T/usr-local-bin" \
        "$@" "$SCRIPT" "${ARGS[@]}" 2>&1)
    status=$?
    set -e
    calls=
    if test -f "$CALLS"; then
        calls=$(cat "$CALLS")
    fi
}

check() {
    name=$1
    shift
    TESTS_RUN=$((TESTS_RUN + 1))
    if "$@"; then
        TESTS_PASSED=$((TESTS_PASSED + 1))
    else
        TESTS_FAILED=$((TESTS_FAILED + 1))
        echo "FAIL: $name"
        echo "  output: $output"
        echo "  calls: $calls"
    fi
}
# The directory this run's pins install into.
inst() { printf '%s\n' "$T"/opt/hyprland/v0.56.2-*; }
has() { case "$1" in *"$2"*) return 0 ;; esac; return 1; }
lacks() { ! has "$1" "$2"; }

set -e

setup; ARGS=(); run
check "exits 0" test "$status" -eq 0
check "installs Hyprland, hypridle and uwsm" has "$calls" "hyprland hypridle uwsm"
check "installs the transitional owners" has "$calls" "waybar"
check "clones quickspace when it isn't there" has "$calls" "git clone https://example.com/quickspace.git $T/src/quickspace"
check "runs quickspace's make install" has "$calls" "make -C $T/src/quickspace install"
# Go too, for a run without setup.
check "installs Go itself" has "$calls" "golang"

check "tells make install which Go to build with" has "$calls" "make -C $T/src/quickspace install GO=go"
check "installs the session under /usr with sudo" has "$calls" "sudo make -C $T/src/quickspace install-session PREFIX=/usr"
check "enables quickspace.service" has "$calls" "systemctl --user enable quickspace.service"
check "reloads units before enabling" has "$calls" "systemctl --user daemon-reload"
check "masks the distro's waybar and swaync units, stopping them now" \
    has "$calls" "systemctl --user mask --now waybar.service swaync.service"
check "leaves hypridle's unit to quickspace's session-only drop-in" lacks "$calls" "hypridle.service"
check "touches no other user's units" lacks "$calls" "--global"
teardown

setup; ARGS=(); run GO="$T/no-such-go"
check "no Go is an error" test "$status" -ne 0
check "no Go names the packages to install" has "$output" "quickspace needs Go 1.22 or newer to build quickspace-grant"
check "no Go stops before make install" lacks "$calls" "make -C $T/src/quickspace install"
teardown

setup; ARGS=(); run FAKE_GO_VERSION=go1.19.8
check "a Go older than 1.22 is an error" test "$status" -ne 0
check "an old Go says which it found and where to get a newer one" \
    has "$output" "and go is 1.19.8; on Debian 12, install golang from bookworm-backports"
check "an old Go stops before make install" lacks "$calls" "make -C $T/src/quickspace install"
teardown

setup; ARGS=(); run FAKE_GO_VERSION=go1.24.7
check "a newer Go is fine" test "$status" -eq 0
teardown

setup; ARGS=(); run SETUP_OS=redhat
check "Fedora installs Hyprland and Go with dnf" has "$calls" "dnf install -y hyprland hypridle"
check "Fedora installs its swaync and Go" has "$calls" "SwayNotificationCenter golang"
teardown

setup; ARGS=(); run SETUP_OS=arch
check "Arch installs Hyprland and Go with pacman" has "$calls" "pacman -S --needed --noconfirm hyprland hypridle"
check "Arch installs its swaync and Go" has "$calls" "swaync go"
check "Arch never builds Hyprland" lacks "$calls" "cmake"
teardown

# A package the distro lacks (swww on Ubuntu 26.04) would make apt refuse
# the lot, so apt is asked first and the rest install together.
setup; ARGS=(); run FAKE_MISSING=swww
check "a missing package isn't fatal" test "$status" -eq 0
check "a missing package is named" has "$output" "could not install: swww"
check "a missing swww names the stand-in" has "$output" "swaybg can stand in"
check "the rest install in one go" has "$calls" "apt-get install -y hyprland hypridle uwsm xdg-desktop-portal-hyprland xdg-desktop-portal-gtk waybar fuzzel"
check "the rest install in one go, Go too" has "$calls" "playerctl jq sway-notification-center golang"
check "a missing package is never asked for" lacks "$calls" "swww"
teardown

# When apt itself fails (offline, say), that's one failure, not one per
# package.
setup; ARGS=(); run FAKE_MISSING=nothing FAKE_APT_GET_FAILS=1
check "a failed apt is reported once" test "$(printf '%s\n' "$calls" | grep -c '^apt-get install')" -eq 1
check "a failed apt names what didn't install" has "$output" "could not install: hyprland hypridle"
teardown

# apt's Hyprland is new enough: no build.
setup; ARGS=(); run
check "a new enough apt Hyprland is installed" has "$calls" "apt-get install -y hyprland hypridle"
check "a new enough apt Hyprland isn't built" lacks "$calls" "cmake"
teardown

# apt's Hyprland is too old (Ubuntu 26.04's 0.53): build it.
setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4
check "an old apt Hyprland builds from source" test "$status" -eq 0
check "the build doesn't install apt's Hyprland" lacks "$calls" "apt-get install -y hyprland"
check "the build installs its dependencies, with GCC 16" has "$calls" "apt-get install -y build-essential gcc-16 g++-16 cmake meson"
check "the build needs Lua 5.5" has "$calls" "liblua5.5-dev"
check "the build clones pinned tags" has "$calls" "git clone --quiet --depth 1 --branch v0.56.2 --recurse-submodules --shallow-submodules https://github.com/hyprwm/Hyprland.git $T/src/hyprland-build/Hyprland"
check "the build clones wayland-protocols 1.49" has "$calls" "--branch 1.49"
check "wayland-protocols' headers skip the strict check" \
    test "$(cat "$T/src/hyprland-build/wayland-protocols/meson.build")" = "command: [scanner, 'enum-header']"
check "the build installs under its prefix, by version" has "$calls" "-DCMAKE_INSTALL_PREFIX=$T/opt/hyprland/v0.56.2-"
check "the build sets the run path" has "$calls" "-DCMAKE_INSTALL_RPATH=$(inst)/lib"
check "the build uses GCC 16" has "$calls" "-DCMAKE_C_COMPILER=gcc-16 -DCMAKE_CXX_COMPILER=g++-16"
check "meson builds use GCC 16" has "$calls" "meson compilers CC=gcc-16 CXX=g++-16"
check "the pins record the compiler" has "$(cat "$(inst)/quickspace-pins")" "gcc 16"
check "the build puts its own tools on PATH" has "$calls" "cmake finds $(inst)/bin/hyprwayland-scanner"
check "the build installs without sudo" has "$calls" "cmake --install $T/src/hyprland-build/Hyprland/build"
check "the build never uses sudo to install" lacks "$calls" "sudo cmake"
check "the build builds hyprutils before Hyprland" \
    test "$(printf '%s\n' "$calls" | grep -n 'cmake -S .*/hyprutils ' | cut -d: -f1)" -lt \
        "$(printf '%s\n' "$calls" | grep -n 'cmake -S .*/Hyprland ' | cut -d: -f1)"
check "the build is current" test "$(readlink -f "$T/opt/hyprland/current")" = "$(inst)"
check "the build links Hyprland onto PATH, through current" test "$(readlink "$T/usr-local-bin/Hyprland")" = "$T/opt/hyprland/current/bin/Hyprland"
check "the build links hyprctl onto PATH, through current" test "$(readlink "$T/usr-local-bin/hyprctl")" = "$T/opt/hyprland/current/bin/hyprctl"
check "the build records its pins" grep -q "Hyprland https://github.com/hyprwm/Hyprland.git v0.56.2 cmake" "$(inst)/quickspace-pins"
# A second run with the same pins doesn't rebuild.
: > "$CALLS"
run FAKE_APT_HYPRLAND=0.53.3+ds-4
check "the same pins don't rebuild" lacks "$calls" "cmake"
check "the same pins say so" has "$output" "already built from these pins"
teardown

# A new compiler checksums differently, so what an older one built, such as
# a GCC 15 build that stopped partway, isn't resumed or reused.
setup; ARGS=()
# The checksum before the compiler was part of it: the pins alone.
eval "$(sed -n '/^HYPRLAND_PINS="/,/^"/p' "$SCRIPT")"
old_sum=$(printf '%s\n' "$HYPRLAND_PINS" | cksum | cut -d' ' -f1)
mkdir -p "$T/opt/hyprland/v0.56.2-$old_sum"
: > "$T/opt/hyprland/v0.56.2-$old_sum/.built-hyprutils"
run FAKE_APT_HYPRLAND=0.53.3+ds-4
check "a build from another compiler isn't resumed" has "$calls" "cmake -S $T/src/hyprland-build/hyprutils "
check "a build from another compiler is cleaned up" test ! -e "$T/opt/hyprland/v0.56.2-$old_sum"
teardown

# The links are made again on a rerun, in case something removed them.
setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4
rm "$T/usr-local-bin/Hyprland"
run FAKE_APT_HYPRLAND=0.53.3+ds-4
check "a rerun restores a removed link" test "$(readlink "$T/usr-local-bin/Hyprland")" = "$T/opt/hyprland/current/bin/Hyprland"
teardown

# Links that can't be made are loud, but don't stop setup.
setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_LN_FAILS=1
check "a failed link doesn't fail setup" test "$status" -eq 0
check "a failed link is loud" has "$output" "COULDN'T LINK Hyprland INTO $T/usr-local-bin"
check "a failed link still marks the build complete" test -f "$(inst)/quickspace-pins"
teardown

# An older build, current, with the commands linked through it.
old_build() {
    old="$T/opt/hyprland/v0.55.0-1"
    mkdir -p "$old/bin"
    for cmd in Hyprland hyprctl; do
        printf '#!/bin/sh\n' > "$old/bin/$cmd"
        chmod +x "$old/bin/$cmd"
        ln -s "$T/opt/hyprland/current/bin/$cmd" "$T/usr-local-bin/$cmd"
    done
    echo "old pins" > "$old/quickspace-pins"
    ln -s v0.55.0-1 "$T/opt/hyprland/current"
}

# The commands switch together, through current, even when a link can't
# be made.
setup; old_build
mkdir -p "$T/opt/hyprland/v0.55.0-2/lib"
: > "$T/opt/hyprland/v0.55.0-2/.built-wayland-protocols"
ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_LN_FAILS=1
check "an upgrade switches current" test "$(readlink -f "$T/opt/hyprland/current")" = "$(inst)"
check "an upgrade switches Hyprland and hyprctl together" \
    test "$(readlink -f "$T/usr-local-bin/Hyprland")" = "$(inst)/bin/Hyprland" -a \
        "$(readlink -f "$T/usr-local-bin/hyprctl")" = "$(inst)/bin/hyprctl"
check "an upgrade needs no new links" lacks "$calls" "sudo ln"
check "an upgrade removes the older build" test ! -e "$old"
check "an upgrade removes an unfinished older build" test ! -e "$T/opt/hyprland/v0.55.0-2"
teardown

# A rerun after a failure resumes from the step that failed.
setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_CMAKE_FAILS=hyprlang
: > "$CALLS"
run FAKE_APT_HYPRLAND=0.53.3+ds-4
check "a resumed build skips what it finished" lacks "$calls" "cmake -S $T/src/hyprland-build/hyprutils "
check "a resumed build says so" has "$output" "Already built hyprutils v0.14.2"
check "a resumed build redoes the failed step" has "$calls" "cmake -S $T/src/hyprland-build/hyprlang "
check "a resumed build finishes" has "$calls" "cmake -S $T/src/hyprland-build/Hyprland "
check "a resumed build marks itself complete" test -f "$(inst)/quickspace-pins"
teardown

# New pins build beside the working Hyprland, which a failure leaves alone
# and a success replaces.
setup; old_build
ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_CMAKE_FAILS=hyprlang
check "a failed rebuild keeps the working build" test -x "$old/bin/Hyprland"
check "a failed rebuild keeps it current" test "$(readlink "$T/opt/hyprland/current")" = v0.55.0-1
check "a failed rebuild isn't marked complete" test ! -e "$(inst)/quickspace-pins"
run FAKE_APT_HYPRLAND=0.53.3+ds-4
check "a rebuild makes the new build current" test "$(readlink -f "$T/opt/hyprland/current")" = "$(inst)"
check "a rebuild removes the old build" test ! -e "$old"
teardown

# Opting out of the build, after one, uses apt's Hyprland again.
setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4
ln -s /usr/bin/true "$T/usr-local-bin/hyprctl.keep"
ARGS=(--no-build-hyprland); run FAKE_APT_HYPRLAND=0.53.3+ds-4
check "--no-build-hyprland removes the build's links" test ! -e "$T/usr-local-bin/Hyprland" -a ! -L "$T/usr-local-bin/hyprctl"
check "--no-build-hyprland leaves other links" test -L "$T/usr-local-bin/hyprctl.keep"
check "--no-build-hyprland says so" has "$output" "which point to a source build"
teardown

# A switch back to apt that removes one link but not the other puts the
# first back, so the two commands never come from different builds.
setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4
ARGS=(--no-build-hyprland); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_RM_KEEPS=hyprctl
check "a half-failed unlink restores the other link" test "$(readlink "$T/usr-local-bin/Hyprland")" = "$T/opt/hyprland/current/bin/Hyprland"
check "a half-failed unlink keeps the one it couldn't remove" test -L "$T/usr-local-bin/hyprctl"
check "a half-failed unlink removes both in one command" has "$calls" "sudo rm -f $T/usr-local-bin/Hyprland $T/usr-local-bin/hyprctl"
teardown

# If apt's Hyprland doesn't install, the build's links are all there is.
setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4
ARGS=(--no-build-hyprland); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_APT_GET_FAILS=1
check "a failed apt install keeps the build's links" test "$(readlink -f "$T/usr-local-bin/Hyprland")" = "$(inst)/bin/Hyprland"
teardown
setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4
ARGS=(--no-build-hyprland); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_MISSING=hyprland
check "a missing apt Hyprland keeps the build's links" test -L "$T/usr-local-bin/Hyprland"
teardown

# A build that a command link still points into directly isn't removed,
# even when the link can't be moved to current.
setup
legacy="$T/opt/hyprland/v0.55.0-1"
mkdir -p "$legacy/bin"
for cmd in Hyprland hyprctl; do
    printf '#!/bin/sh\n' > "$legacy/bin/$cmd"
    chmod +x "$legacy/bin/$cmd"
    ln -s "$legacy/bin/$cmd" "$T/usr-local-bin/$cmd"
done
echo "old pins" > "$legacy/quickspace-pins"
ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_LN_FAILS=1
check "a build a link points into is kept" test -x "$legacy/bin/Hyprland"
run FAKE_APT_HYPRLAND=0.53.3+ds-4
check "once relinked, that build is removed" test ! -e "$legacy"
check "and the link goes through current" test "$(readlink "$T/usr-local-bin/Hyprland")" = "$T/opt/hyprland/current/bin/Hyprland"
teardown

# A command setup didn't make isn't replaced, and something else under the
# prefix isn't cleaned up.
setup
printf '#!/bin/sh\n' > "$T/usr-local-bin/Hyprland"
mkdir -p "$T/opt/hyprland/my-hyprland/bin" "$T/opt/hyprland/v0.50.0-1"
touch "$T/opt/hyprland/v0.50.0-1/notes"
ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4
check "an existing command isn't replaced" test ! -L "$T/usr-local-bin/Hyprland"
check "an existing command is named" has "$output" "NOT LINKING Hyprland: $T/usr-local-bin/Hyprland is already there"
check "the other command is still linked" test "$(readlink "$T/usr-local-bin/hyprctl")" = "$T/opt/hyprland/current/bin/hyprctl"
check "cleanup leaves other directories alone" test -d "$T/opt/hyprland/my-hyprland/bin"
check "cleanup leaves unmarked lookalikes alone" test -f "$T/opt/hyprland/v0.50.0-1/notes"
teardown

# A link that isn't the build's stays.
setup; ln -s /usr/bin/true "$T/usr-local-bin/Hyprland"
ARGS=(--no-build-hyprland); run FAKE_APT_HYPRLAND=0.53.3+ds-4
check "--no-build-hyprland keeps someone else's link" test -L "$T/usr-local-bin/Hyprland"
teardown

# Debian 13 has neither g++-16 nor xkbcommon 1.11: keep apt's Hyprland.
setup; ARGS=(); run FAKE_APT_HYPRLAND=0.49.0+ds-1 FAKE_MISSING=g++-16 FAKE_APT_XKB=1.7.0-2
check "without g++-16 there's no build" lacks "$calls" "cmake"
check "without g++-16 apt's Hyprland installs" has "$calls" "apt-get install -y hyprland hypridle"
check "without g++-16 says what's missing" has "$output" "it has g++-16 none, libxkbcommon 1.7.0"
teardown

setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_MISSING=liblua5.5-dev
check "without Lua 5.5 there's no build" lacks "$calls" "cmake"
teardown

# A finished build outlives the toolchain that built it.
setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4
: > "$CALLS"
run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_APT_GXX=4:14.2.0-1
check "a finished build without the toolchain isn't rebuilt" lacks "$calls" "cmake"
check "a finished build without the toolchain keeps its links" test "$(readlink -f "$T/usr-local-bin/Hyprland")" = "$(inst)/bin/Hyprland"
check "a finished build without the toolchain skips apt's Hyprland" lacks "$calls" "apt-get install -y hyprland"
teardown

# An apt-cache that can't answer isn't taken for "no Hyprland".
setup; ARGS=(); run FAKE_APT_CACHE_FAILS=1
check "an apt-cache failure doesn't build" lacks "$calls" "cmake"
check "an apt-cache failure says so" has "$output" "couldn't ask apt for its Hyprland version"
check "an apt-cache failure installs everything" has "$calls" "apt-get install -y hyprland hypridle"
teardown

setup; ARGS=(); run FAKE_APT_HYPRLAND="(none)"
check "no apt Hyprland builds from source" has "$calls" "cmake -S $T/src/hyprland-build/Hyprland"
teardown

setup; ARGS=(--no-build-hyprland); run FAKE_APT_HYPRLAND=0.53.3+ds-4
check "--no-build-hyprland doesn't build" lacks "$calls" "cmake"
check "--no-build-hyprland installs apt's Hyprland" has "$calls" "apt-get install -y hyprland hypridle"
teardown

setup; ARGS=(--no-install); run FAKE_APT_HYPRLAND=0.53.3+ds-4
check "--no-install doesn't build" lacks "$calls" "cmake"
teardown

# A failed step stops the build before anything is linked or recorded.
setup; ARGS=(); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_CMAKE_FAILS=hyprlang
check "a failed build step is reported" has "$output" "building Hyprland failed; the sources are in $T/src/hyprland-build"
check "a failed build is fatal" test "$status" -ne 0
check "a failed build doesn't claim success" lacks "$output" "quickspace installed"
check "a failed build stops before Hyprland" lacks "$calls" "cmake -S $T/src/hyprland-build/Hyprland"
check "a failed build isn't marked complete" test ! -e "$(inst)/quickspace-pins"
check "a failed build says a rerun resumes" has "$output" "a rerun resumes from the step that failed"
check "a failed build links nothing" test ! -e "$T/usr-local-bin/Hyprland"
ARGS=(--ignore-errors); run FAKE_APT_HYPRLAND=0.53.3+ds-4 FAKE_CMAKE_FAILS=hyprlang
check "--ignore-errors carries on past a failed build" has "$output" "quickspace installed"
teardown

setup; mkdir -p "$T/src/quickspace/.git"; ARGS=(); run
check "updates an existing checkout" has "$calls" "git -C $T/src/quickspace pull --ff-only"
check "doesn't clone over it" lacks "$calls" "git clone"
teardown

setup; mkdir -p "$T/src/quickspace/.git"; ARGS=(); run FAKE_PULL_FAILS=1
check "a failed pull still installs" test "$status" -eq 0
check "a failed pull is reported" has "$output" "could not update $T/src/quickspace"
check "a failed pull installs the existing checkout" has "$calls" "make -C $T/src/quickspace install"
teardown

setup; ARGS=(); run QUICKSPACE_REPO="https://user:secret@example.com/quickspace.git"
check "the clone message doesn't print the URL" lacks "$output" "secret"
teardown

setup; mkdir -p "$T/src/quickspace/.git"; ARGS=(--no-fetch); run
check "--no-fetch neither pulls nor clones" lacks "$calls" "git "
check "--no-fetch installs the checkout" has "$calls" "make -C $T/src/quickspace install"
teardown

setup; ARGS=(--no-fetch); run
check "--no-fetch without a checkout fails" test "$status" -ne 0
check "--no-fetch without a checkout says so" has "$output" "no quickspace checkout"
teardown

setup; : > "$T/logind/10-hypr-lid.conf"; : > "$T/logind/10-sway-lid.conf"; : > "$T/logind/50-mine.conf"
ARGS=(); run
check "removes the old hypr lid drop-in" test ! -e "$T/logind/10-hypr-lid.conf"
check "removes the old sway lid drop-in" test ! -e "$T/logind/10-sway-lid.conf"
check "leaves other drop-ins alone" test -e "$T/logind/50-mine.conf"
check "reloads logind after removing one" has "$calls" "systemctl kill -s HUP systemd-logind"
teardown

setup; ARGS=(); run
check "no old drop-in, no logind reload" lacks "$calls" "systemd-logind"
teardown

setup; ARGS=(--no-install); run
check "--no-install skips packages" lacks "$calls" "hypridle"
check "--no-install skips the system-wide session install" lacks "$calls" "install-session"
check "--no-install still installs the user files" has "$calls" "make -C $T/src/quickspace install"
teardown

setup; : > "$T/logind/10-hypr-lid.conf"; ARGS=(--no-sudo); run
check "--no-sudo runs no sudo" lacks "$calls" "sudo "
check "--no-sudo leaves the drop-in" test -e "$T/logind/10-hypr-lid.conf"
check "--no-sudo still enables the user unit" has "$calls" "systemctl --user enable quickspace.service"
teardown

setup; ARGS=(); run FAKE_HYPRLAND_VERSION=0.55.1
check "an old Hyprland is warned about" has "$output" "Hyprland 0.55.1 is older than 0.56"
teardown

setup; ARGS=(); run FAKE_HYPRLAND_VERSION=0.57.0
check "a newer Hyprland is fine" lacks "$output" "older than"
teardown

setup; ARGS=(); run FAKE_NO_USER_MANAGER=1
check "no user manager is a warning, not a failure" test "$status" -eq 0
check "no user manager says how to enable it" has "$output" "systemctl --user enable quickspace.service"
check "no user manager enables nothing" lacks "$calls" "--user enable"
check "no user manager still masks, just not --now" \
    has "$calls" "systemctl --user mask waybar.service swaync.service"
check "no user manager says a running bar isn't stopped" \
    has "$output" "masking waybar and swaync without stopping them"
teardown

setup; ARGS=(--bogus); run
check "an unknown option fails" test "$status" -eq 1
teardown

echo
echo "setup-quickspace: $TESTS_PASSED/$TESTS_RUN passed"
test "$TESTS_FAILED" -eq 0
