}

configure_app_shortcuts() {
    info "Configuring application launch shortcuts (Automator Quick Actions)"

    SERVICES_DIR="$HOME/Library/Services"
    try mkdir -p "$SERVICES_DIR"

    # Quick Action name, launcher helper, and shortcut key. The Option modifier
    # is "~" in a key equivalent (Option+Shift would be "~$"). These are logical
    # key names, so the OS handles the Dvorak layout.
    #
    # Shortcut keys (physical Win sends Option after the hidutil remap):
    #   Win+G → Option+G → browser1
    #   Win+F → Option+F → browser2
    #   Win+T → Option+T → terminal
    #   Win+W → Option+W → terminal_on_workstation
    #   Win+Y → Option+Y → music
    #   Win+C → Option+C → google-chat
    #   Win+Shift+C → Option+Shift+C → google-calendar
    #
    # $@ accumulates the key/value pairs for one `defaults write`, so a
    # launcher that isn't installed drops out of the registry entry too rather
    # than leaving a shortcut bound to a workflow that runs nothing.
    set --
    for entry in \
        "Launch Browser1:browser1:g" \
        "Launch Browser2:browser2:f" \
        "Launch Terminal:terminal:t" \
        "Launch Terminal on Workstation:terminal_on_workstation:w" \
        "Launch Music:music:y" \
        "Launch Chat:google-chat:c" \
        "Launch Calendar:google-calendar:\$c"; do
        workflow_name=${entry%%:*}
        entry_rest=${entry#*:}
        launcher_name=${entry_rest%%:*}
        shortcut_key=${entry_rest##*:}

        if ! launcher_path=$(resolve_launcher "$launcher_name"); then
            warn "$launcher_name not found on PATH or beside this script; skipping its launch shortcut"
            # An earlier run may have installed a workflow for it. Leaving that
            # behind would keep the shortcut working and running the path the
            # launcher used to have, which is the opposite of skipping it. The
            # NSServicesStatus entry naming it is left alone -- `defaults` has
            # no way to delete one key from a nested dict, and rewriting the
            # whole dict would drop other applications' services -- but with
            # the workflow gone it names a service that no longer exists, so
            # the key equivalent binds nothing.
            stale_workflow="$SERVICES_DIR/$workflow_name.workflow"
            if test -d "$stale_workflow"; then
                info "Removing the stale Quick Action for $launcher_name"
                try rm -rf "$stale_workflow"
            fi
            continue
        fi
        create_launcher_workflow "$workflow_name" "$launcher_path"
        # The key is quoted inside the value too: `defaults` parses it as an
        # old-style plist, where spaces and parentheses need the quotes.
        set -- "$@" \
            "\"(null) - $workflow_name - runWorkflowAsService\"" \
            "{ \"enabled_context_menu\" = 1; \"enabled_services_menu\" = 1; \"key_equivalent\" = \"~$shortcut_key\"; }"
    done

    if test $# -eq 0; then
        warn "no launcher helpers found; no launch shortcuts were configured"
        return 0
    fi
    try defaults write pbs NSServicesStatus -dict-add "$@"

    # Writing the workflows and the key equivalents isn't enough: the Services
    # registry is a cache, and until pbs re-reads it the new Quick Actions
    # aren't registered and their shortcuts silently do nothing.
    if test -x "$PBS"; then
        "$PBS" -flush \
            || warn "could not refresh the Services registry; log out and back in for the launch shortcuts to work"
    else
        warn "$PBS not found; log out and back in for the launch shortcuts to work"
    fi
}

# --- Configure Finder, screenshots, windows and fonts (Amethyst) ---

# With tide these are tide's (write_tide_macos_settings).
configure_finder() {
    info "Configuring Finder"
    try defaults write com.apple.finder AppleShowAllFiles -bool true
    try defaults write com.apple.finder ShowPathbar -bool true
    try defaults write NSGlobalDomain AppleShowAllExtensions -bool true

    # This used to be `killall Finder 2>/dev/null || true`, which hid every
    # failure to tolerate the one expected one. See restart_app.
    restart_app Finder "its settings to take effect"
}

# --- Configure screenshots ---

# tide saves every screenshot to ~/Pictures/Screenshots. macOS's go to the
# Desktop unless Screenshot's options say otherwise, and only once the
# floating thumbnail has gone; tide copies each new one to the clipboard
# from the folder, so the thumbnail would hold that back too. SystemUIServer
# applies the options.
SCREENSHOT_DIR="$HOME/Pictures/Screenshots"

configure_screenshots() {
    info "Configuring screenshots"
    try mkdir -p "$SCREENSHOT_DIR"
    try defaults write com.apple.screencapture location -string "$SCREENSHOT_DIR"
    try defaults write com.apple.screencapture show-thumbnail -bool false
    restart_app SystemUIServer "the screenshot settings to take effect"
}

# --- Configure windows and dialogs ---

# Closer to tide: Open, Save and Print dialogs that show their folders and
# options, as GTK's do, and windows that appear and resize without animating,
# so a retile lands at once. Each app reads these as it launches.
configure_windows() {
    info "Configuring windows and dialogs"
    try defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
    try defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true
    try defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
    try defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true
    # Save to disk, not iCloud, the first time a new document is saved.
    try defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false
    try defaults write NSGlobalDomain NSAutomaticWindowAnimationsEnabled -bool false
    try defaults write NSGlobalDomain NSWindowResizeTime -float 0.001
    try defaults write com.apple.finder DisableAllAnimations -bool true
}

# --- Configure the lock screen ---

# tide's lock screen shows the short hostname; macOS's shows this message
# under the clock, on the login window too. It's in a system-wide file, hence
# sudo.
LOGINWINDOW_PLIST=/Library/Preferences/com.apple.loginwindow

configure_lock_screen() {
    _host=$(hostname -s) || _host=
    if test -z "$_host"; then
        warn "couldn't read this Mac's hostname, so the lock screen doesn't show it"
        return 0
    fi
    if test "$SUDO" = no; then
        info "Skipping the hostname on the lock screen: it needs administrator rights and --no-sudo was given"
        todo_optional "To show this Mac's name on the lock screen: sudo defaults write $LOGINWINDOW_PLIST LoginwindowText $_host"
        return 0
    fi
    info "Showing $_host on the lock screen"
    try sudo defaults write "$LOGINWINDOW_PLIST" LoginwindowText "$_host"
}

# Font smoothing at its lightest. Since Mojave, macOS's default thickens text,
# which on a non-Retina display smears bold into gray; 1 keeps a little of it,
# and 0 (off) is thinner still. It's per host (-currentHost), as System
# Settings once wrote it, and apps read it as they launch, so it waits for the
# logout.
configure_fonts() {
    info "Setting font smoothing to light"
    try defaults -currentHost write -g AppleFontSmoothing -int 1
    needs_logout "the font smoothing"
}

