# kwriteconfig6 and kreadconfig6 that keep what's written, one line a key,
# so a second run reads back what the first wrote; and a systemctl that
# finds DrKonqi masked.
mock_kconfig_store() {
    store="$TEST_TMPDIR/kconfig"
    cat > "$TEST_TMPDIR/bin/kwriteconfig6" <<MOCK
#!/bin/bash
printf "%s\\n" "kwriteconfig6 \$*" >> "$CALLS"
key="\${*:1:\$#-1}"
grep -vxF -- "\$key=\$(grep -F -- "\$key=" "$store" 2>/dev/null | head -1 | cut -d= -f2-)" "$store" 2>/dev/null > "$store.new"
printf "%s=%s\\n" "\$key" "\${!#}" >> "$store.new"
mv "$store.new" "$store"
MOCK
    cat > "$TEST_TMPDIR/bin/kreadconfig6" <<MOCK
#!/bin/bash
grep -F -- "\$*=" "$store" 2>/dev/null | tail -1 | cut -d= -f2-
MOCK
    cat > "$TEST_TMPDIR/bin/systemctl" <<MOCK
#!/bin/sh
printf "%s\\n" "systemctl \$*" >> "$CALLS"
test "\$2" != is-enabled || for unit in \$3 \$4; do echo masked; done
MOCK
    chmod +x "$TEST_TMPDIR/bin/kwriteconfig6" "$TEST_TMPDIR/bin/kreadconfig6" "$TEST_TMPDIR/bin/systemctl"
}

