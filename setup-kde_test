#!/bin/bash
# Tests for setup-kde
#
# Runs setup-kde --no-install (so nothing is cloned or built) against a
# throwaway HOME with the KDE CLI tools mocked, and checks the pure-config
# steps: kwinrc/shortcut writes go through kwriteconfig6, and app-launch
# shortcuts are created for helpers that exist on PATH and skipped (with a
# warning, not a fatal error) for helpers that don't.

set -e

# Each run starts its own log of what the commands say, in its sandbox's
# XDG_STATE_HOME, rather than adding to one a caller's setup exported.
unset SETUP_LOG

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0

setup() {
    # Most tests here are of Krohnkite's setup; the tide ones set this.
    KDE_WM=krohnkite
    TEST_TMPDIR="$(mktemp -d)"
    CALLS="$TEST_TMPDIR/calls"
    rm -f "$CALLS"
    mkdir -p "$TEST_TMPDIR/bin" "$TEST_TMPDIR/home"
    KDE_SCRIPT="$SCRIPT_DIR/setup-kde"

    # KDE CLI tools and systemctl: record argv, touch nothing real.
    for cmd in kwriteconfig6 qdbus6 qdbus kbuildsycoca6 systemctl; do
        cat > "$TEST_TMPDIR/bin/$cmd" <<MOCK
#!/bin/sh
printf "%s\\n" "$cmd \$*" >> "$CALLS"
exit 0
MOCK
    done
    # The two that chatter, as the real ones do.
    cat > "$TEST_TMPDIR/bin/kbuildsycoca6" <<MOCK
#!/bin/sh
printf "%s\\n" "kbuildsycoca6 \$*" >> "$CALLS"
echo "kf.service.sycoca: Menu \"applications-kmenuedit.menu\" not found." >&2
exit 0
MOCK
    cat > "$TEST_TMPDIR/bin/systemctl" <<MOCK
#!/bin/sh
printf "%s\\n" "systemctl \$*" >> "$CALLS"
for unit; do
    case "\$unit" in
        *.socket | *.service) echo "Created symlink '$TEST_TMPDIR/home/.config/systemd/user/\$unit' → '/dev/null'." >&2 ;;
    esac
done
exit 0
MOCK

    chmod +x "$TEST_TMPDIR"/bin/*

    # The live apply is on by default, so every run reaches for python3 to run
    # kdeshortcut.py. Mock it from the start or the tests would push shortcuts
    # into the session bus of whoever is running them. Tests that care about
    # what it returns re-mock it with mock_python3.
    mock_python3 0
}

teardown() {
    rm -rf "$TEST_TMPDIR"
}

# Add a fake launcher script (e.g. browser1) to the mock bin.
add_launcher() {
    cat > "$TEST_TMPDIR/bin/$1" <<'MOCK'
#!/bin/sh
exit 0
MOCK
    chmod +x "$TEST_TMPDIR/bin/$1"
}

# Run a copy of setup-kde from a directory with no launcher siblings. In the
# real repo the launchers live beside setup-kde, so the sibling-directory
# fallback would find them; tests about genuinely-missing launchers need the
# script isolated from its siblings.
isolate_script() {
    mkdir -p "$TEST_TMPDIR/isolated"
    cp "$SCRIPT_DIR/setup-kde" "$TEST_TMPDIR/isolated/setup-kde"
    KDE_SCRIPT="$TEST_TMPDIR/isolated/setup-kde"
}

# Mocks for the release-first install path (the default now): homepkg is
# looked up beside setup-kde ($SCRIPT_DIR/homepkg), so it must live in the
# isolated script dir, not on PATH -- isolate_script sets that up. The mock
# simulates a successful 'homepkg --backend codeberg install krohnkite' by
# dropping a fake .kwinscript where homepkg's codeberg backend would put it.
# git/npm/go-task/tsc are canaries: the release path must never reach the
# source-build fallback.
add_release_mocks() {
    isolate_script
    cat > "$TEST_TMPDIR/isolated/homepkg" <<MOCK
#!/bin/sh
printf "%s\\n" "homepkg \$*" >> "$CALLS"
if test "\$1" = "--backend" && test "\$2" = codeberg \\
        && test "\$3" = install && test "\$4" = krohnkite; then
    dir="\$HOME/.local/share/homepkg/assets/krohnkite"
    mkdir -p "\$dir"
    touch "\$dir/krohnkite-0.9.9.3_beta.kwinscript"
    echo "Downloading krohnkite-0.9.9.3_beta.kwinscript from codeberg.org"
fi
exit 0
MOCK
    chmod +x "$TEST_TMPDIR/isolated/homepkg"
    cat > "$TEST_TMPDIR/bin/kpackagetool6" <<MOCK
#!/bin/sh
printf "%s\\n" "kpackagetool6 \$*" >> "$CALLS"
echo "Successfully upgraded \$4"
exit 0
MOCK
    chmod +x "$TEST_TMPDIR/bin/kpackagetool6"
    for cmd in git npm go-task tsc; do
        cat > "$TEST_TMPDIR/bin/$cmd" <<MOCK
#!/bin/sh
printf "%s\\n" "$cmd \$*" >> "$CALLS"
exit 1
MOCK
        chmod +x "$TEST_TMPDIR/bin/$cmd"
    done
}

# Mocks for the source-build fallback path: no homepkg beside the isolated
# script (isolate_script alone leaves it absent), so install_krohnkite skips
# straight to install_krohnkite_from_source. git "clones" by creating the
# target directory with a fake prebuilt .kwinscript (the expected shape of
# the fork), kpackagetool6 just records. npm is mocked purely as a canary:
# nothing in the install may ever reach it. This exercises
# install_krohnkite_from_source's cd into the checkout.
add_install_mocks() {
    isolate_script
    cat > "$TEST_TMPDIR/bin/git" <<MOCK
#!/bin/sh
printf "%s\\n" "git \$*" >> "$CALLS"
if test "\$1" = clone; then
    for arg in "\$@"; do dir="\$arg"; done
    mkdir -p "\$dir"
    touch "\$dir/fake.kwinscript"
fi
exit 0
MOCK
    for cmd in npm kpackagetool6; do
        cat > "$TEST_TMPDIR/bin/$cmd" <<MOCK
#!/bin/sh
printf "%s\\n" "$cmd \$*" >> "$CALLS"
exit 0
MOCK
    done
    chmod +x "$TEST_TMPDIR/bin/git" "$TEST_TMPDIR/bin/npm" \
        "$TEST_TMPDIR/bin/kpackagetool6"
}

# Like add_install_mocks, but the clone is source-only (no prebuilt
# .kwinscript), forcing the build path. The mock go-task stands in for
# Krohnkite's real build and invokes npm exactly the way the Makefile and
# Taskfile do; setup-kde's shim must intercept both calls -- install
# becomes a no-op and "run tsc" execs the (mocked) local tsc -- so the
# canary npm in the mock bin is never reached.
add_source_build_mocks() {
    add_install_mocks
    cat > "$TEST_TMPDIR/bin/git" <<MOCK
#!/bin/sh
printf "%s\\n" "git \$*" >> "$CALLS"
if test "\$1" = clone; then
    for arg in "\$@"; do dir="\$arg"; done
    mkdir -p "\$dir"
fi
exit 0
MOCK
    cat > "$TEST_TMPDIR/bin/go-task" <<MOCK
#!/bin/sh
printf "%s\\n" "go-task \$*" >> "$CALLS"
npm install --save-dev || exit 1
npm run tsc -- --strict || exit 1
touch krohnkite.kwinscript
exit 0
MOCK
    cat > "$TEST_TMPDIR/bin/tsc" <<MOCK
#!/bin/sh
printf "%s\\n" "tsc \$*" >> "$CALLS"
exit 0
MOCK
    chmod +x "$TEST_TMPDIR/bin/git" "$TEST_TMPDIR/bin/go-task" \
        "$TEST_TMPDIR/bin/tsc"
}

# Run setup-kde in the sandbox: fresh HOME, and a PATH of just the mock bin
# plus the system directories -- so the real ~/scripts (if it's on the
# caller's PATH) can't satisfy the launcher lookups.
#
# XDG_CONFIG_HOME is pinned, not just inherited: setup-kde resolves
# kglobalshortcutsrc as ${XDG_CONFIG_HOME:-$HOME/.config}, so on a machine
# that exports it, overriding HOME alone leaves the script reading -- and
# remove_stale_app_shortcut_groups rewriting -- the caller's real KDE config
# while the assertions look at the sandbox. XDG_STATE_HOME is pinned for the
# same reason: it's where the live apply puts kdeshortcut.py's crash journal,
# and a test run must not touch the caller's real one.
run_kde() {
    set +e
    output="$(HOME="$TEST_TMPDIR/home" \
        XDG_CONFIG_HOME="$TEST_TMPDIR/home/.config" \
        XDG_STATE_HOME="$TEST_TMPDIR/home/.local/state" \
        XDG_SESSION_TYPE=wayland \
        SETUP_TIDE_ACCENTS_SYSTEM_TABLES="${SETUP_TIDE_ACCENTS_SYSTEM_TABLES-$TEST_TMPDIR/no-tide-accents.json}" \
        TIDE_DIR="$TEST_TMPDIR/home/src/tide" \
        PATH="$TEST_TMPDIR/bin:/usr/local/bin:/usr/bin:/bin" \
        "$KDE_SCRIPT" --wm "$KDE_WM" "$@" 2>&1)"
    status=$?
    set -e
}

# Like run_kde, but invoke the script by a RELATIVE path (./setup-kde) from
# its own directory, the way a hands-on run does.
run_kde_relative() {
    set +e
    output="$(cd "$(dirname "$KDE_SCRIPT")" && HOME="$TEST_TMPDIR/home" \
        XDG_CONFIG_HOME="$TEST_TMPDIR/home/.config" \
        XDG_STATE_HOME="$TEST_TMPDIR/home/.local/state" \
        XDG_SESSION_TYPE=wayland \
        SETUP_TIDE_ACCENTS_SYSTEM_TABLES="${SETUP_TIDE_ACCENTS_SYSTEM_TABLES-$TEST_TMPDIR/no-tide-accents.json}" \
        TIDE_DIR="$TEST_TMPDIR/home/src/tide" \
        PATH="$TEST_TMPDIR/bin:/usr/local/bin:/usr/bin:/bin" \
        ./setup-kde --wm "$KDE_WM" "$@" 2>&1)"
    status=$?
    set -e
}

assert_status() {
    if test "$status" -ne "$1"; then
        echo "  FAIL: expected exit status $1, got $status"
        echo "  output: $output"
        TEST_FAILED=1
        return 1
    fi
}

assert_output_contains() {
    case "$output" in
        *"$1"*) ;;
        *)
            printf "%s\n" "  FAIL: output does not contain '$1'"
            echo "  output: $output"
            TEST_FAILED=1
            return 1
            ;;
    esac
}

assert_output_is() {
    if test "$output" != "$1"; then
        echo "  FAIL: output is not what was expected"
        echo "  expected: $1"
        echo "  output: $output"
        TEST_FAILED=1
        return 1
    fi
}

# The log a run started, in its sandbox's XDG_STATE_HOME.
run_log() {
    cat "$TEST_TMPDIR/home/.local/state/setup/setup.log" 2>/dev/null
}

assert_log_contains() {
    case "$(run_log)" in
        *"$1"*) ;;
        *)
            printf "%s\n" "  FAIL: the log does not contain '$1'"
            echo "  log: $(run_log)"
            TEST_FAILED=1
            return 1
            ;;
    esac
}

assert_called() {
    if ! grep -q -- "$1" "$CALLS" 2>/dev/null; then
        printf "%s\n" "  FAIL: expected call '$1' not found"
        printf "%s\n" "  calls: $(cat "$CALLS" 2>/dev/null)"
        TEST_FAILED=1
        return 1
    fi
}

assert_not_called() {
    if grep -q -- "$1" "$CALLS" 2>/dev/null; then
        printf "%s\n" "  FAIL: unexpected call '$1' found"
        printf "%s\n" "  calls: $(cat "$CALLS" 2>/dev/null)"
        TEST_FAILED=1
        return 1
    fi
}

assert_output_lacks() {
    case "$output" in
        *"$1"*)
            printf "%s\n" "  FAIL: output unexpectedly contains '$1'"
            echo "  output: $output"
            TEST_FAILED=1
            return 1
            ;;
    esac
}

assert_file_exists() {
    if ! test -f "$1"; then
        echo "  FAIL: expected file '$1' to exist"
        TEST_FAILED=1
        return 1
    fi
}

assert_file_not_exists() {
    if test -f "$1"; then
        echo "  FAIL: unexpected file '$1' exists"
        TEST_FAILED=1
        return 1
    fi
}

# --- tide for KDE (--wm tide, the default) ---

# git clones by making the directory; make and node record their argv, and
# node also adds a line to the --batch file, as setup.mjs does.
add_tide_kde_mocks() {
    KDE_WM=tide
    cat > "$TEST_TMPDIR/bin/git" <<MOCK
#!/bin/sh
printf "%s\\n" "git \$*" >> "$CALLS"
if test "\$1" = clone; then
    for arg in "\$@"; do dir="\$arg"; done
    mkdir -p "\$dir"
fi
exit 0
MOCK
    cat > "$TEST_TMPDIR/bin/make" <<MOCK
#!/bin/sh
printf "%s\\n" "make \$*" >> "$CALLS"
exit 0
MOCK
    cat > "$TEST_TMPDIR/bin/kpackagetool6" <<MOCK
#!/bin/sh
exit 0
MOCK
    cat > "$TEST_TMPDIR/bin/node" <<MOCK
#!/bin/sh
printf "%s\\n" "node \$*" >> "$CALLS"
while test \$# -gt 0; do
    if test "\$1" = --batch; then
        printf 'kwin\\ttide: focus down\\tMeta+J\\ttide: focus down\\n' >> "\$2"
    fi
    shift
done
exit 0
MOCK
    chmod +x "$TEST_TMPDIR"/bin/git "$TEST_TMPDIR"/bin/make "$TEST_TMPDIR"/bin/node \
        "$TEST_TMPDIR"/bin/kpackagetool6
}

test_tide_is_the_default() {
    add_tide_kde_mocks
    set +e
    output="$(HOME="$TEST_TMPDIR/home" \
        XDG_CONFIG_HOME="$TEST_TMPDIR/home/.config" \
        XDG_STATE_HOME="$TEST_TMPDIR/home/.local/state" \
        XDG_SESSION_TYPE=wayland \
        SETUP_TIDE_ACCENTS_SYSTEM_TABLES="$TEST_TMPDIR/no-tide-accents.json" \
        TIDE_DIR="$TEST_TMPDIR/home/src/tide" \
        PATH="$TEST_TMPDIR/bin:/usr/local/bin:/usr/bin:/bin" \
        "$KDE_SCRIPT" 2>&1)"
    status=$?
    set -e
    assert_status 0 &&
    assert_called "git clone https://github.com/mikelward/tide-kde.git $TEST_TMPDIR/home/tide-kde" &&
    assert_not_called "krohnkiteEnabled true"
}

test_tide_clones_installs_and_sets_up() {
    add_tide_kde_mocks
    run_kde
    assert_status 0 &&
    assert_called "git clone https://github.com/mikelward/tide-kde.git $TEST_TMPDIR/home/tide-kde" &&
    assert_called "make -C $TEST_TMPDIR/home/tide-kde install" &&
    assert_called "node $TEST_TMPDIR/home/tide-kde/scripts/setup.mjs --batch " &&
    assert_output_contains "Installed tide for KDE" &&
    assert_batch_contains 'kwin\ttide: focus down\tMeta+J'
}

test_tide_pulls_an_existing_checkout() {
    add_tide_kde_mocks
    mkdir -p "$TEST_TMPDIR/home/tide-kde"
    run_kde
    assert_status 0 &&
    assert_called "git -C $TEST_TMPDIR/home/tide-kde pull --ff-only" &&
    assert_not_called "git clone" &&
    assert_called "make -C $TEST_TMPDIR/home/tide-kde install"
}

test_tide_turns_krohnkite_off() {
    add_tide_kde_mocks
    run_kde --no-install
    assert_status 0 &&
    assert_called "kwriteconfig6 --file kwinrc --group Plugins --key krohnkiteEnabled false" &&
    assert_not_called "Number 10" &&
    assert_not_called "--group Plugins --key diminactiveEnabled"
}

# An earlier run put KWin's desktop and window actions on the keys tide's
# take; they go back to Plasma's defaults, so tide's can have them.
test_tide_gives_back_kwins_keys() {
    add_tide_kde_mocks
    run_kde --no-install
    assert_status 0 &&
    assert_called "$(printf -- '--group kwin --key Switch to Desktop 1 Ctrl+F1\tMeta+F1,none,Switch to Desktop 1')" &&
    assert_called "--group kwin --key Switch to Desktop 10 none,none,Switch to Desktop 10" &&
    assert_called "--group kwin --key Window to Desktop 1 none,none,Window to Desktop 1" &&
    assert_called "--group kwin --key Window Close Alt+F4,none,Window Close" &&
    assert_called "--group kwin --key Window Maximize none,none,Window Maximize" &&
    assert_not_called "Meta+PgUp,none" &&
    assert_not_called "--key KrohnkiteSetMaster Meta+Return"
}

test_tide_no_install_leaves_a_missing_checkout() {
    add_tide_kde_mocks
    run_kde --no-install
    assert_status 0 &&
    assert_not_called "git clone" &&
    assert_not_called "make -C" &&
    assert_output_contains "--no-install was given"
}

test_tide_no_install_installs_a_checkout_unpulled() {
    add_tide_kde_mocks
    mkdir -p "$TEST_TMPDIR/home/tide-kde"
    run_kde --no-install
    assert_status 0 &&
    assert_not_called "pull --ff-only" &&
    assert_called "make -C $TEST_TMPDIR/home/tide-kde install"
}

test_tide_without_node_warns() {
    add_tide_kde_mocks
    rm "$TEST_TMPDIR/bin/node"
    mkdir -p "$TEST_TMPDIR/home/tide-kde"
    # run_kde's PATH keeps the system's directories, so a node installed
    # there can't be hidden; the test can only run where there's none.
    if PATH=/usr/local/bin:/usr/bin:/bin command -v node >/dev/null 2>&1; then
        echo "  skipped: node is installed in a system directory"
        return 0
    fi
    run_kde
    assert_status 0 &&
    assert_output_contains "node not found" &&
    assert_not_called "make -C"
}

test_tide_failed_install_warns() {
    add_tide_kde_mocks
    cat > "$TEST_TMPDIR/bin/make" <<MOCK
#!/bin/sh
printf "%s\\n" "make \$*" >> "$CALLS"
exit 2
MOCK
    run_kde
    assert_status 0 &&
    assert_output_contains "couldn't install tide for KDE" &&
    assert_not_called "node $TEST_TMPDIR"
}

test_wm_takes_an_equals() {
    add_tide_kde_mocks
    KDE_WM=krohnkite
    set +e
    output="$(HOME="$TEST_TMPDIR/home" XDG_CONFIG_HOME="$TEST_TMPDIR/home/.config" \
        XDG_STATE_HOME="$TEST_TMPDIR/home/.local/state" \
        PATH="$TEST_TMPDIR/bin:/usr/local/bin:/usr/bin:/bin" \
        "$KDE_SCRIPT" --wm=tide --no-install 2>&1)"
    status=$?
    set -e
    assert_status 0 &&
    assert_called "krohnkiteEnabled false"
}

test_wm_refuses_others() {
    run_kde --wm i3
    assert_status 1 &&
    assert_output_contains "--wm takes tide or krohnkite, not i3"
}

# Back from tide for KDE: it's turned off and its keys let go, or both tile.
test_krohnkite_turns_tide_off() {
    mkdir -p "$TEST_TMPDIR/home/.config"
    cat > "$TEST_TMPDIR/bin/kreadconfig6" <<'MOCK'
#!/bin/sh
case "$*" in
    *"--key tideEnabled"*) echo true ;;
esac
exit 0
MOCK
    chmod +x "$TEST_TMPDIR/bin/kreadconfig6"
    printf '[kwin]\ntide-focus-next=Meta+J,Meta+J,tide: Focus the next window\nWindow Close=Alt+F4,Alt+F4,Close Window\n' \
        > "$TEST_TMPDIR/home/.config/kglobalshortcutsrc"
    run_kde --no-install
    assert_status 0 &&
    assert_called "kwriteconfig6 --file kwinrc --group Plugins --key tideEnabled false" &&
    assert_called "--group kwin --key tide-focus-next none,none,tide-focus-next" &&
    assert_not_called "--key Window Close none" &&
    assert_called "krohnkiteEnabled true"
}

run_test() {
    name="$1"
    func="$2"
    TESTS_RUN=$((TESTS_RUN + 1))
    setup
    TEST_FAILED=
    if "$func" && test -z "$TEST_FAILED"; then
        echo "ok $TESTS_RUN $name"
        TESTS_PASSED=$((TESTS_PASSED + 1))
    else
        echo "not ok $TESTS_RUN $name"
        TESTS_FAILED=$((TESTS_FAILED + 1))
    fi
    teardown
}

# --- usage and help ---

test_help_flag() {
    run_kde --help
    assert_status 0 &&
    assert_output_contains "Usage: setup-kde"
}

test_unknown_option() {
    run_kde --bogus
    assert_status 1 &&
    assert_output_contains "Unknown option"
}

# --no-sudo is accepted (setup forwards it) and is a pure no-op here: setup-kde
# uses no sudo, so config still goes through kwriteconfig6 and the run succeeds.
test_no_sudo_accepted_noop() {
    run_kde --no-install --no-sudo
    assert_status 0 &&
    assert_called "kwriteconfig6 --file kwinrc --group Plugins --key krohnkiteEnabled true"
}

# setup-kde is entirely user-scoped. Even a sudo executable that always fails
# must be irrelevant to KDE configuration.
test_failing_sudo_is_not_used() {
    cat > "$TEST_TMPDIR/bin/sudo" <<MOCK
#!/bin/sh
printf "%s\\n" "sudo \$*" >> "$CALLS"
echo "sudo: permission denied" >&2
exit 1
MOCK
    chmod +x "$TEST_TMPDIR/bin/sudo"
    run_kde --no-install
    assert_status 0 &&
    assert_not_called "sudo" &&
    assert_output_contains "KDE settings"
}

# --- installation: release path (the default; homepkg's codeberg backend) ---

# The common case: homepkg fetches the prebuilt release and setup-kde
# installs it directly -- no clone, no build tool ever runs.
test_release_install_via_homepkg() {
    add_release_mocks
    run_kde
    assert_status 0 &&
    assert_called "homepkg --backend codeberg install krohnkite" &&
    assert_called "kpackagetool6 -t KWin/Script" &&
    assert_not_called "git" &&
    assert_not_called "npm" &&
    assert_not_called "go-task" &&
    assert_not_called "tsc "
}

# The online fetch is tried FIRST and, when it succeeds, a pre-staged bundle
# is never even touched -- refreshing from the network beats reusing
# whatever a bundle happens to carry, so a machine that already has a bundle
# staged still gets newer Krohnkite releases as they're published.
test_online_fetch_preferred_over_staged_bundle() {
    add_release_mocks
    touch "$TEST_TMPDIR/isolated/homepkg-krohnkite.tgz"
    run_kde
    assert_status 0 &&
    assert_called "homepkg --backend codeberg install krohnkite" &&
    assert_not_called "install-bundle" &&
    assert_called "kpackagetool6 -t KWin/Script"
}

# When the online fetch fails, a pre-staged bundle (homepkg-krohnkite.tgz
# beside the script) is tried as a fallback source for the release.
test_release_bundle_used_when_online_fetch_fails() {
    add_release_mocks
    cat > "$TEST_TMPDIR/isolated/homepkg" <<MOCK
#!/bin/sh
printf "%s\\n" "homepkg \$*" >> "$CALLS"
if test "\$1" = install-bundle; then
    dir="\$HOME/.local/share/homepkg/assets/krohnkite"
    mkdir -p "\$dir"
    touch "\$dir/krohnkite-0.9.9.3_beta.kwinscript"
    exit 0
fi
exit 1
MOCK
    chmod +x "$TEST_TMPDIR/isolated/homepkg"
    touch "$TEST_TMPDIR/isolated/homepkg-krohnkite.tgz"
    run_kde
    assert_status 0 &&
    assert_called "homepkg --backend codeberg install krohnkite" &&
    assert_called "homepkg install-bundle $TEST_TMPDIR/isolated/homepkg-krohnkite.tgz" &&
    assert_called "kpackagetool6 -t KWin/Script"
}

# When both the online fetch and the bundle are unavailable, a release
# cached by an earlier successful run is still used rather than falling all
# the way back to a source build -- homepkg's codeberg backend never wipes a
# good cache on a failed refresh (see install_codeberg's atomic replace).
test_stale_cached_release_used_when_refresh_fails() {
    add_release_mocks
    cat > "$TEST_TMPDIR/isolated/homepkg" <<MOCK
#!/bin/sh
printf "%s\\n" "homepkg \$*" >> "$CALLS"
exit 1
MOCK
    chmod +x "$TEST_TMPDIR/isolated/homepkg"
    mkdir -p "$TEST_TMPDIR/home/.local/share/homepkg/assets/krohnkite"
    touch "$TEST_TMPDIR/home/.local/share/homepkg/assets/krohnkite/krohnkite-0.9.9.2.kwinscript"
    run_kde
    assert_status 0 &&
    assert_called "homepkg --backend codeberg install krohnkite" &&
    assert_called "kpackagetool6 -t KWin/Script" &&
    assert_not_called "git clone"
}

# A staged bundle must still be tried when the online fetch fails, even if
# something's already cached from an earlier run -- a stale cache sitting
# there must not short-circuit the bundle check and reinstall the old
# release when a fresher one is staged and ready.
test_staged_bundle_tried_even_with_a_stale_cache_present() {
