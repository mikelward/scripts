# same_file WHAT A B: fails the test unless A and B have the same contents.
same_file() {
    if ! cmp -s "$2" "$3"; then
        echo "  FAIL: $1: $(cat "$3" 2>&1)"
        TEST_FAILED=1
        return 1
    fi
}

