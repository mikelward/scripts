# A command that finishes in time leaves nothing behind, under bash and the
# sh that curl | sh runs: the timer is stopped along with its sleep, at once
# and quietly. Killing only the timer's subshell left its sleep running, and
# macOS's bash 3.2 printed "Terminated: 15" for the subshell. The stub sleep
# records its pid once it's waiting, and notes if it runs to the end; the
# command waits for the pid, so the timer is running when it's stopped. The
# stub's own wait is only a bound, so that a timer that isn't stopped fails
# rather than hangs; stopped, the stub stops it too, and nothing is left.
run_command_in_time() {
    wtl_tmpdir="$(mktemp -d)"
    mkdir -p "$wtl_tmpdir/bin"
    cat > "$wtl_tmpdir/bin/sleep" <<EOF
#!/bin/sh
trap 'kill \$child; exit 143' TERM
$(command -v sleep) 10 &
child=\$!
echo \$\$ > $wtl_tmpdir/sleep.pid
wait \$child
echo > $wtl_tmpdir/sleep.ended
EOF
    chmod +x "$wtl_tmpdir/bin/sleep"
    set +e
    output="$(PATH="$wtl_tmpdir/bin:$PATH" "$1" -c "
$(extract_functions with_time_limit)
with_time_limit 5 sh -c 'until test -s $wtl_tmpdir/sleep.pid; do :; done'
echo status \$?
if test -e $wtl_tmpdir/sleep.ended; then
    echo SLEEP_RAN_TO_THE_END
fi
if kill -0 \$(cat $wtl_tmpdir/sleep.pid) 2>/dev/null; then
    echo SLEEP_LEFT_RUNNING
    kill \$(cat $wtl_tmpdir/sleep.pid)
fi" </dev/null 2>&1)"
    status=$?
    set -e
    rm -rf "$wtl_tmpdir"
}

test_a_command_in_time_leaves_no_timer_under_bash() {
    run_command_in_time bash
    assert_status 0 &&
    assert_output_is "status 0"
}

test_a_command_in_time_leaves_no_timer_under_sh() {
    run_command_in_time sh
    assert_status 0 &&
    assert_output_is "status 0"
}

# An ssh-agent that never answers ssh-add -l -- one behind a hung security
# key, say -- must not stall setup: once the wait is up it counts as holding
# no key, with a warning, and the key file check goes on. The stub sleep
# ends the wait at once; the stub ssh-add answers only when killed, and gives
# up after 30s, so a broken time limit fails rather than hangs.
test_a_hung_ssh_agent_is_given_up_on() {
    agent_tmpdir="$(mktemp -d)"
    mkdir -p "$agent_tmpdir/bin" "$agent_tmpdir/.ssh"
    : > "$agent_tmpdir/.ssh/id_ed25519"
    printf '#!/bin/sh\nexec %s 30\n' "$(command -v sleep)" > "$agent_tmpdir/bin/ssh-add"
    printf '#!/bin/sh\nexit 0\n' > "$agent_tmpdir/bin/sleep"
    chmod +x "$agent_tmpdir/bin/ssh-add" "$agent_tmpdir/bin/sleep"
    set +e
    output="$(PATH="$agent_tmpdir/bin:$PATH" HOME="$agent_tmpdir" \
        sh -c "set -e
SSH=auto
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS with_time_limit ssh_agent_has_key ssh_key_file_exists generate_ssh_key")
generate_ssh_key
echo BOOTSTRAP_CONTINUED" </dev/null 2>&1)"
    status=$?
    set -e
    rm -rf "$agent_tmpdir"
    assert_status 0 &&
    assert_output_contains "ssh-agent isn't answering" &&
    assert_output_lacks "ssh-agent has one" &&
    assert_output_contains "BOOTSTRAP_CONTINUED"
}

# --- Up-front sudo and SSH ---

UP_FRONT_FUNCTIONS="with_time_limit ssh_agent_has_key ssh_key_file_exists sudo_up_front ssh_destination own_git_ssh_command ssh_up_front end_up_front"

# Run ssh_up_front against a mock ssh that records its arguments and then
# signs in ($1=ok, exiting 1 as GitHub does), is refused ($1=refused, 255) or
# never answers ($1=hung: it answers only when killed, and the stub sleep
# ends the wait at once). The repos come from HARNESS_REPO (GitHub over SSH),
# ~/.ssh has a key unless HARNESS_KEY=no, and GIT_SSH_COMMAND starts as
# HARNESS_GIT_SSH_COMMAND. With HARNESS_CHECKOUT_SSH_COMMAND, a checkout in
# ~/src has that core.sshCommand. end_up_front runs after it.
run_ssh_up_front() {
    suf_tmpdir="$(mktemp -d)"
    mkdir -p "$suf_tmpdir/bin" "$suf_tmpdir/.ssh"
    if test -n "${HARNESS_CHECKOUT_SSH_COMMAND:-}"; then
        git init -q "$suf_tmpdir/src/tide"
        git -C "$suf_tmpdir/src/tide" config core.sshCommand "$HARNESS_CHECKOUT_SSH_COMMAND"
    fi
    test "${HARNESS_KEY:-yes}" = no || : > "$suf_tmpdir/.ssh/id_ed25519"
    case "$1" in
        ok) suf_answer='exit 1' ;;
        refused) suf_answer='exit 255' ;;
        hung)
            suf_answer="exec $(command -v sleep) 30"
            printf '#!/bin/sh\nexit 0\n' > "$suf_tmpdir/bin/sleep"
            chmod +x "$suf_tmpdir/bin/sleep"
            ;;
    esac
    cat > "$suf_tmpdir/bin/ssh" <<MOCK
#!/bin/sh
printf '%s\n' "ssh \$*" >> "$suf_tmpdir/calls"
$suf_answer
MOCK
    # No agent, so only the key file counts.
    printf '#!/bin/sh\nexit 2\n' > "$suf_tmpdir/bin/ssh-add"
    chmod +x "$suf_tmpdir/bin/ssh" "$suf_tmpdir/bin/ssh-add"
    set +e
    output="$(PATH="$suf_tmpdir/bin:$PATH" HOME="$suf_tmpdir" \
        GIT_SSH_COMMAND="${HARNESS_GIT_SSH_COMMAND:-}" GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
        sh -c "set -e
SCRIPTS_DIR='$suf_tmpdir/scripts'
CONF_DIR='$suf_tmpdir/conf'
SRC_DIR='$suf_tmpdir/src'
SCRIPTS_REPO='${HARNESS_REPO:-git@github.com:mikelward/scripts.git}'
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS $UP_FRONT_FUNCTIONS")
ssh_up_front
echo \"GIT_SSH_COMMAND=\$GIT_SSH_COMMAND\"
share=\${SSH_SHARE_DIR:-}
end_up_front
test -z \"\$share\" || test -e \"\$share\" || echo SHARE_CLOSED
echo BOOTSTRAP_CONTINUED" </dev/null 2>&1)"
    status=$?
    set -e
    calls="$(cat "$suf_tmpdir/calls" 2>/dev/null)"
    rm -rf "$suf_tmpdir"
}

