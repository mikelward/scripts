# Run install_vcs with conf at a temp dir, against stubs: clone_or_pull
# records its call, and makes conf/vcs (with a Makefile), or fails as git
# clone does offline if $1 is no-clone; check_go answers $2 (ok or old); make exits $3 (default 0).
run_install_vcs() {
    vcs_tmpdir="$(mktemp -d)"
    set +e
    output="$(sh -c "set -e
CONF_DIR='$vcs_tmpdir/conf'
VCS_REPO=\${VCS_REPO:-https://example.com/mikelward/vcs.git}
MIN_GO=1.21
clone_or_pull() {
    echo \"clone_or_pull \$*\"
    test '$1' = no-clone && return 1
    mkdir -p \"\$2\" && : > \"\$2/Makefile\"
}
check_go() { test '$2' = ok; }
make() { echo \"make \$*\"; return ${3:-0}; }
$(extract_functions "setup_color paint info detail warn note_problem redact_url_credentials install_vcs")
install_vcs
echo BOOTSTRAP_CONTINUED" 2>&1)"
    status=$?
    set -e
    rm -rf "$vcs_tmpdir"
}

