# Run configure_linux_desktop against stub setup-kde and setup-tide that
# record how they're called. TIDE is setup's own default, replayed from its
# source as extract_homebrew_env does, unless $1 overrides it; $2 is
# TIDE_SETUP_FLAGS.
run_linux_desktop() {
    desktop_tmpdir=$(mktemp -d)
    desktop_calls="$desktop_tmpdir/calls"
    for desktop_script in setup-kde setup-tide; do
        printf '#!/bin/sh\necho "%s TIDE_DIR=$TIDE_DIR $*" >> "%s"\necho "%s GITHUB_PREFIX=${GITHUB_PREFIX-unset}" >> "%s"\n' \
            "$desktop_script" "$desktop_calls" "$desktop_script" "$desktop_calls" > "$desktop_tmpdir/$desktop_script"
        chmod +x "$desktop_tmpdir/$desktop_script"
    done
    # DESKTOP_TIDE_BUSY=yes: setup-tide found apt busy, queued itself for
    # setup's second try, and failed for want of what apt didn't install.
    if test "${DESKTOP_TIDE_FAILS:-no}" = yes; then
        printf '#!/bin/sh\nexit 1\n' > "$desktop_tmpdir/setup-tide"
    fi
    if test "${DESKTOP_TIDE_BUSY:-no}" = yes; then
        printf '#!/bin/sh\necho setup-tide >> "$SETUP_APT_RETRY"\nexit 1\n' > "$desktop_tmpdir/setup-tide"
    fi
    # DESKTOP_TIDE_HELP is what tide's installer says --help, when given.
    if test -n "${DESKTOP_TIDE_HELP:-}"; then
        mkdir -p "$desktop_tmpdir/src/tide/install"
        printf '#!/bin/sh\necho "%s"\n' "$DESKTOP_TIDE_HELP" > "$desktop_tmpdir/src/tide/install/tide-setup"
        chmod +x "$desktop_tmpdir/src/tide/install/tide-setup"
    fi

    set +e
    output="$(sh -c "set -e
$(grep '^TIDE=' "$SETUP")
${1:+TIDE=$1}
TIDE_SETUP_FLAGS='${2-}'
UPGRADE='${DESKTOP_UPGRADE:-no}'
DESKTOP_SETUP_FLAGS=--ignore-errors
KDE_SETUP_FLAGS=
SCRIPTS_DIR='$desktop_tmpdir'
SRC_DIR='$desktop_tmpdir/src'
SETUP_APT_RETRY='$desktop_tmpdir/apt-retry'
export SETUP_APT_RETRY
TIDE_REPO=https://example.com/mikelward/tide.git
GITHUB_MIRROR='${DESKTOP_MIRROR:-no}'
GITHUB_PREFIX='${DESKTOP_PREFIX:-git@github.com:}'
clone_or_pull() { echo \"clone_or_pull \$*\" >> '$desktop_calls'; }
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS configure_linux_desktop run_setup_tide")
configure_linux_desktop
echo DESKTOP_CONTINUED" 2>&1)"
    status=$?
    set -e
    calls="$(cat "$desktop_calls" 2>/dev/null)"
    desktop_src="$desktop_tmpdir/src"
    rm -rf "$desktop_tmpdir"
}

