    assert_status 0 &&
    assert_calls_contain "--install-recommends plasma-workspace-wallpapers " &&
    assert_calls_contain "--install-recommends gnome-backgrounds " &&
    assert_calls_lack "ubuntu-wallpapers" &&
    HARNESS_OS_RELEASE="$_wp_dir/ubuntu" run_linux_packages debian 1 &&
    assert_calls_contain "--install-recommends ubuntu-wallpapers " &&
    HARNESS_OS_RELEASE="$_wp_dir/fedora" run_linux_packages redhat 1 &&
