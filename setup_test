test_purge_obsolete_off_by_default() {
    assert_source_contains "PURGE_OBSOLETE=no" &&
    assert_source_contains 'test "$PURGE_OBSOLETE" = yes'
}

# --purge-obsolete also asks homepkg to remove the tools it has retired
# (joshuto, yazi) from its env, after the scripts clone so the list is current.
test_purge_obsolete_prunes_retired_tools() {
    run_prune_retired_tools
    assert_status 0 &&
    assert_output_contains "BOOTSTRAP_CONTINUED" &&
    test "$calls" = "homepkg prune"
}

# A prune that fails warns, with the command to retry, and setup goes on.
test_failed_prune_warns_and_continues() {
    run_prune_retired_tools 1
    assert_status 0 &&
    assert_output_contains "BOOTSTRAP_CONTINUED" &&
    assert_output_contains "couldn't remove the tools homepkg has retired"
