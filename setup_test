# run_debian_keyboard [setupcon|none]: configure_keyboard on Debian, with sudo
# recording what it's asked and setupcon on PATH or not.
# KB_KEYS, when set, is what dumpkeys says the console keymap has for the key
# right of Tab (apostrophe for Dvorak, +q for QWERTY), before and after
# setup sets them: "+q apostrophe" is QWERTY before, Dvorak after.
# KB_BOOT and KB_CONSOLE_SETUP stand in for /boot and /etc/console-setup,
# KB_SYSTEMD for /etc/systemd/system, and KB_INITRAMFS_CONF for
# update-initramfs.conf. Without KB_CONSOLE_SETUP, setupcon has saved a
# keymap in a directory of the test's own.
run_debian_keyboard() {
    kb_bin=$(mktemp -d)
    kb_own_saved=
    if test -z "${KB_CONSOLE_SETUP:-}"; then
        kb_own_saved=$(mktemp -d)
        : > "$kb_own_saved/cached_UTF-8_del.kmap.gz"
    fi
    for tool in sh cat awk grep sed tr ls head uname rm; do
        ln -s "$(command -v "$tool")" "$kb_bin/$tool"
    done
    if test "$1" = setupcon; then
        printf '#!/bin/sh\n' > "$kb_bin/setupcon"
        chmod +x "$kb_bin/setupcon"
    fi
    if test -n "${KB_KEYS:-}"; then
        # One answer a call: the first is from before setup sets the keymap.
        printf '%s\n' $KB_KEYS > "$kb_bin/keys"
        cat > "$kb_bin/dumpkeys" <<MOCK
#!/bin/sh
key=\$(head -n 1 "$kb_bin/keys")
if test "\$(cat "$kb_bin/keys" | awk 'END { print NR }')" -gt 1; then
    awk 'NR > 1' "$kb_bin/keys" > "$kb_bin/keys.next" && cat "$kb_bin/keys.next" > "$kb_bin/keys"
fi
echo "keycode  15 = Tab"
echo "keycode  16 = \$key"
MOCK
        printf '#!/bin/sh\ntest "$1" = -n && shift\nexec "$@"\n' > "$kb_bin/sudo"
        chmod +x "$kb_bin/dumpkeys" "$kb_bin/sudo"
    fi
    printf '#!/bin/sh\necho active\n' > "$kb_bin/systemctl"
    printf '#!/bin/sh\necho "SETXKBMAP $*"\n' > "$kb_bin/setxkbmap"
    chmod +x "$kb_bin/systemctl" "$kb_bin/setxkbmap"
    if test -n "${KB_BOOT:-}"; then
        if test -n "${KB_UNREADABLE:-}"; then
            printf '#!/bin/sh\necho "cpio: Permission denied" >&2\nexit 1\n' > "$kb_bin/lsinitramfs"
        else
            printf '#!/bin/sh\necho console-setup/keymap\n' > "$kb_bin/lsinitramfs"
        fi
        printf '#!/bin/sh\n' > "$kb_bin/update-initramfs"
        chmod +x "$kb_bin/lsinitramfs" "$kb_bin/update-initramfs"
    fi
    set +e
    output="$(PATH="$kb_bin" SUDO="${KB_SUDO:-yes}" INSTALL="${KB_INSTALL:-yes}" CROSTINI=0 OS=debian DISPLAY="${KB_DISPLAY:-}" WAYLAND_DISPLAY="${KB_WAYLAND_DISPLAY:-}" \
        SETUP_BOOT_DIR="${KB_BOOT:-/nonexistent}" SETUP_CONSOLE_SETUP_DIR="${KB_CONSOLE_SETUP:-$kb_own_saved}" \
        SETUP_KEYBOARD_FILE="${KB_KEYBOARD_FILE:-/nonexistent}" \
        SETUP_SYSTEMD_DIR="${KB_SYSTEMD:-/nonexistent}" SETUP_INITRAMFS_CONF="${KB_INITRAMFS_CONF:-/nonexistent}" \
        sh -c "$(extract_functions "setup_color paint info detail warn note_problem configure_keyboard console_keymap load_saved_keymap_at_boot update_boot_keymap check_console_keymap explain_console_keymap")
sudo_or_warn() { echo SUDO \"\$*\"; }
configure_keyboard" 2>&1)"
    status=$?
    set -e
    rm -rf "$kb_bin" ${kb_own_saved:+"$kb_own_saved"}
}

