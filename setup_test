# macOS ships git, python3, vim, zsh, curl and unzip, and a managed Mac has
# each new version of a Homebrew binary approved by hand, so the core brew
# install leaves those six to macOS and still asks for the rest.
test_macos_core_install_uses_the_system_tools() {
    run_macos_packages 0 arm64 ok
    assert_status 0 || return 1
    core=$(printf '%s\n' "$calls" | grep '^brew install atool ')
    if test -z "$core"; then
        echo "  FAIL: no core brew install among the calls: $calls"
        return 1
    fi
    for tool in curl git python3 unzip vim zsh; do
        case " $core " in
            *" $tool "*)
                echo "  FAIL: the core brew install asks for $tool: $core"
                return 1
                ;;
        esac
    done
    for tool in atool autoconf automake bat fd fzf gh git-delta go jq mercurial micro p7zip ripgrep shellcheck; do
        case " $core " in
            *" $tool "*) ;;
            *)
                echo "  FAIL: the core brew install doesn't ask for $tool: $core"
                return 1
                ;;
        esac
    done
}

