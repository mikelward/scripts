# recap_run SCRIPT: runs SCRIPT, sh with the recap's functions and its EXIT
# trap, setting output and status.
recap_run() {
    recap_tmpdir="$(mktemp -d)"
    set +e
    output="$(TMPDIR="$recap_tmpdir" sh -c "PROBLEMS_OWNER=no
$(extract_functions "setup_color paint problem_line count_of warn error note_problem start_problem_recap recap_problems")
