# --- zsh-autosuggestions without root ---

# Run install_zsh_autosuggestions_home against a local tagged repo standing in
# for zsh-users/zsh-autosuggestions, with a sandboxed HOME and system root.
# setup's own ZSH_AUTOSUGGESTIONS_* lines are replayed, then the repo and the
# pinned commit are pointed at the fixture.
#   $1  what's already there (default none): none | checkout (an earlier run's
#       ~/.zsh/zsh-autosuggestions) | system (the distro package)
#   $2  the fixture's tag (default pinned): pinned (names the pinned commit) |
#       moved (names a later one) | missing (none, so the clone fails)
#   $3  the OS (default debian)
# Leaves $zas_state: absent | pinned (a checkout at the pinned commit) | kept
# (the earlier checkout, untouched) | other.
run_install_zsh_autosuggestions_home() {
    zas_seed="${1:-none}"
    zas_tag="${2:-pinned}"
    zas_os="${3:-debian}"
    zas_tmp="$(mktemp -d)"
    zas_home="$zas_tmp/home"
    zas_dir="$zas_home/.zsh/zsh-autosuggestions"
    mkdir -p "$zas_home"
    cat > "$zas_tmp/gitconfig" <<'CONFIG'
[user]
	name = t
	email = t@example.com
[commit]
	gpgSign = false
[tag]
	gpgSign = false
[protocol "file"]
	allow = always
CONFIG
    zas_git() {
        GIT_CONFIG_GLOBAL="$zas_tmp/gitconfig" GIT_CONFIG_NOSYSTEM=1 git "$@"
    }
    zas_consts="$(grep '^ZSH_AUTOSUGGESTIONS_' "$SETUP")"
    zas_tag_name="$(printf '%s\n' "$zas_consts" | sed -n 's/^ZSH_AUTOSUGGESTIONS_TAG=//p')"
    zas_git init -q "$zas_tmp/repo"
    printf '# the plugin\n' > "$zas_tmp/repo/zsh-autosuggestions.zsh"
    zas_git -C "$zas_tmp/repo" add zsh-autosuggestions.zsh
    zas_git -C "$zas_tmp/repo" commit -q -m plugin
    zas_pinned="$(zas_git -C "$zas_tmp/repo" rev-parse HEAD)"
    if test "$zas_tag" = moved; then
        zas_git -C "$zas_tmp/repo" commit -q --allow-empty -m moved
    fi
    if test "$zas_tag" != missing; then
        zas_git -C "$zas_tmp/repo" tag "$zas_tag_name"
    fi
    case "$zas_seed" in
        checkout)
            mkdir -p "$zas_dir"
            printf 'an earlier run\n' > "$zas_dir/earlier"
            ;;
        system)
            mkdir -p "$zas_tmp/sysroot/usr/share/zsh-autosuggestions"
            printf '# packaged\n' > "$zas_tmp/sysroot/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
            ;;
    esac

    set +e
    output="$(HOME="$zas_home" SETUP_SYSROOT="$zas_tmp/sysroot" \
        GIT_CONFIG_GLOBAL="$zas_tmp/gitconfig" GIT_CONFIG_NOSYSTEM=1 \
        sh -c "set -e
OS=$zas_os
$zas_consts
ZSH_AUTOSUGGESTIONS_REPO='file://$zas_tmp/repo'
ZSH_AUTOSUGGESTIONS_COMMIT='$zas_pinned'
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS install_zsh_autosuggestions_home")
install_zsh_autosuggestions_home
echo BOOTSTRAP_CONTINUED" 2>&1)"
    status=$?
    set -e
    if ! test -e "$zas_dir"; then
        zas_state=absent
    elif test -f "$zas_dir/earlier"; then
        zas_state=kept
    elif test -f "$zas_dir/zsh-autosuggestions.zsh" &&
            test "$(zas_git -C "$zas_dir" rev-parse HEAD)" = "$zas_pinned"; then
        zas_state=pinned
    else
        zas_state=other
    fi
    rm -rf "$zas_tmp"
}

