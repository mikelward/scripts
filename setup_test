# With a terminal, and apt-utils to read the packages' questions, apt runs
# a hook before it installs that asks debconf's questions there; without a
# terminal, or where sudo won't set DEBIAN_FRONTEND, there's no hook, and
# nothing is asked.
test_apt_asks_debconfs_questions_on_the_terminal() {
    ask_tmpdir="$(mktemp -d)"
    : > "$ask_tmpdir/tty"
    printf '#!/bin/sh\nexit 0\n' > "$ask_tmpdir/apt-extracttemplates"
    chmod +x "$ask_tmpdir/apt-extracttemplates"
    PATH="$ask_tmpdir:$PATH" APT_TTY="$ask_tmpdir/tty" run_linux_packages debian
    assert_status 0 &&
    assert_calls_contain "apt-get install -y --no-upgrade --install-recommends zoxide -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -o DPkg::Pre-Install-Pkgs::=set --; while read -r deb; do set -- \"\$@\" \"\$deb\"; done; test \"\$#\" -eq 0 || DEBIAN_FRONTEND=readline /usr/sbin/dpkg-preconfigure \"\$@\" <$ask_tmpdir/tty >$ask_tmpdir/tty 2>&1 || true [DEBIAN_FRONTEND=noninteractive]" &&
    assert_output_lacks "Setting up" &&
    PATH="$ask_tmpdir:$PATH" run_linux_packages debian &&
    assert_calls_lack "Pre-Install-Pkgs" &&
    PATH="$ask_tmpdir:$PATH" APT_TTY="$ask_tmpdir/tty" LINUX_NO_SETENV=1 run_linux_packages debian &&
    assert_calls_lack "Pre-Install-Pkgs"
    _ask_status=$?
    rm -rf "$ask_tmpdir"
    return "$_ask_status"
}

# The hook hands dpkg-preconfigure each .deb apt gives it, a line each, in
# debconf's plain text frontend, on the terminal; with none it runs nothing,
# and a dpkg-preconfigure that fails doesn't stop apt.
test_the_ask_hook_preconfigures_what_apt_installs() {
    hook_tmpdir="$(mktemp -d)"
    : > "$hook_tmpdir/tty"
    cat > "$hook_tmpdir/dpkg-preconfigure" <<MOCK
#!/bin/sh
printf '[%s]\n' "\$@" >> "$hook_tmpdir/calls"
echo "frontend=\$DEBIAN_FRONTEND"
exit \${HOOK_FAILS:-0}
MOCK
    chmod +x "$hook_tmpdir/dpkg-preconfigure"
    hook=$(APT_TTY="$hook_tmpdir/tty" DPKG_PRECONFIGURE="$hook_tmpdir/dpkg-preconfigure" sh -c "
$(extract_functions "apt_ask_hook")
apt_ask_hook")
    printf '%s\n' /var/cache/apt/archives/zoxide_0.9.3-1_amd64.deb "/tmp/a b.deb" | sh -c "$hook"
    assert_eq "$?" 0 &&
    assert_eq "$(cat "$hook_tmpdir/calls")" "[/var/cache/apt/archives/zoxide_0.9.3-1_amd64.deb]
[/tmp/a b.deb]" &&
    assert_eq "$(cat "$hook_tmpdir/tty")" "frontend=readline" &&
    rm "$hook_tmpdir/calls" &&
    sh -c "$hook" </dev/null &&
    test ! -e "$hook_tmpdir/calls" &&
    printf '%s\n' x.deb | HOOK_FAILS=1 sh -c "$hook"
    _hook_status=$?
    rm -rf "$hook_tmpdir"
    return "$_hook_status"
}

# A config file an install kept as you'd changed it, with the package's
# new version beside it, is a warning, to merge by hand: apt's .dpkg-dist,
# dnf's .rpmnew. An install that leaves none says nothing more, and brew
# has none to leave.
run_kept_config() {
    kept_tmpdir="$(mktemp -d)"
    mkdir -p "$kept_tmpdir/etc/frob"
    set +e
    output="$(SETUP_ETC="$kept_tmpdir/etc" sh -c "set -e
$(extract_functions "setup_color paint info warn note_problem $QUIET_FUNCTIONS")
pkg_versions() { echo 'frob 1.0'; }
sudo_logged() { test -z '$2' || : > '$kept_tmpdir/etc/frob/$2'; }
brew_logged() { test -z '$2' || : > '$kept_tmpdir/etc/frob/$2'; }
pkg_begin $1
# Older than whatever the install makes, however coarse the clock.
touch -t 200001010000 \"\$_pkg_before\"
${1}_install frob
pkg_end
echo BOOTSTRAP_CONTINUED" 2>&1)"
    status=$?
    set -e
    rm -rf "$kept_tmpdir"
}

test_a_kept_config_file_is_a_warning() {
    run_kept_config apt frob.conf.dpkg-dist
    assert_status 0 &&
    assert_output_contains "Warning: kept your $kept_tmpdir/etc/frob/frob.conf; the package's new version is $kept_tmpdir/etc/frob/frob.conf.dpkg-dist, to merge by hand" &&
    assert_output_contains "BOOTSTRAP_CONTINUED" &&
    run_kept_config dnf frob.conf.rpmnew &&
    assert_output_contains "Warning: kept your $kept_tmpdir/etc/frob/frob.conf; the package's new version is $kept_tmpdir/etc/frob/frob.conf.rpmnew, to merge by hand" &&
    run_kept_config apt "" &&
    assert_output_lacks "Warning:" &&
    run_kept_config apt frob.conf.rpmnew &&
    assert_output_lacks "Warning:" &&
    run_kept_config brew frob.conf.dpkg-dist &&
    assert_output_lacks "Warning:"
}

