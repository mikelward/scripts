#!/bin/bash
# The `$...` inside the assert_source_contains checks below are deliberate
# literals matched against the setup script's source, not expansions.
# shellcheck disable=SC2016
# Tests for setup.
#
# The full bootstrap can't run in CI (it installs packages and edits system
# config), so these are argument-parsing checks plus static checks on the
# script source.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SETUP="$SCRIPT_DIR/setup"
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0

run_setup() {
    set +e
    output="$("$SETUP" "$@" 2>&1)"
    status=$?
    set -e
}

assert_status() {
    if test "$status" -ne "$1"; then
        echo "  FAIL: expected exit status $1, got $status"
        echo "  output: $output"
        TEST_FAILED=1
        return 1
    fi
}

assert_output_contains() {
    case "$output" in
        *"$1"*) ;;
        *)
            echo "  FAIL: output does not contain '$1'"
            echo "  output: $output"
            TEST_FAILED=1
            return 1
            ;;
    esac
}

assert_output_not_contains() {
    case "$output" in
        *"$1"*)
            echo "  FAIL: output contains '$1'"
            echo "  output: $output"
            TEST_FAILED=1
            return 1
            ;;
    esac
}

assert_source_contains() {
    if ! grep -q "$1" "$SETUP"; then
        echo "  FAIL: setup does not contain '$1'"
        TEST_FAILED=1
        return 1
    fi
}

assert_source_not_contains() {
    if grep -q "$1" "$SETUP"; then
        echo "  FAIL: setup contains '$1'"
        TEST_FAILED=1
        return 1
    fi
}

assert_eq() {
    if test "$1" != "$2"; then
        echo "  FAIL: got '$1', expected '$2'"
        TEST_FAILED=1
        return 1
    fi
}

# Run setup's sudo wrapper in isolation against a controlled sudo mock. This
# tests the diagnostics without executing the bootstrap's system changes.
run_sudo_helper() {
    sudo_mode="$1"
    # Optional: the SUDO setting (yes/no) the wrapper runs under. Defaults to
    # yes so the existing diagnostics tests exercise the real sudo path; pass
    # "no" to check the --no-sudo short-circuit.
    sudo_setting="${2:-yes}"
    sudo_tmpdir="$(mktemp -d)"
    cat > "$sudo_tmpdir/sudo" <<'MOCK'
#!/bin/sh
case "$SUDO_MODE" in
    denied)
        echo "sudo: permission denied" >&2
        exit 1
        ;;
    missing)
        exit 127
        ;;
    silent)
        exit 42
        ;;
    success)
        echo "sudo notice" >&2
        exit 0
        ;;
esac
MOCK
    chmod +x "$sudo_tmpdir/sudo"
    sudo_functions=$(awk '
        /^warn\(\) \{/ { copying = 1 }
        /^error\(\) \{/ { copying = 0 }
        copying { print }
    ' "$SETUP")

    set +e
    output="$(SUDO_MODE="$sudo_mode" SUDO="$sudo_setting" PATH="$sudo_tmpdir:$PATH" \
        sh -c "$(extract_functions "setup_color paint")
$sudo_functions
sudo_or_warn apt-get update" 2>&1)"
    status=$?
    set -e
    rm -rf "$sudo_tmpdir"
}

# Print the named top-level functions from setup, so a test can run one in
# isolation. The full bootstrap can't run in CI, but an individual function
# can -- given mocks for what it shells out to and stubs for the helpers it
# calls. Generalizes what run_sudo_helper does by hand above.
# The quiet-install helpers, which most of what a harness runs calls, and
# one log for every harness that doesn't check its own, so none writes to
# the real ~/.local/state.
QUIET_FUNCTIONS="santa_lockdown cli_tools_blocked apt_was_busy apt_busy apt_frontend_allowed apt_can_ask apt_ask_hook start_setup_log log_mark log_failure run_logged brew_logged sudo_logged pkg_versions pkg_begin pkg_note upgrade_failed pkg_upgrade apt_upgradable brew_upgrade npm_install_typescript apt_install dnf_install brew_install pkg_end pkg_kept_configs install_os_packages os_release install_wallpapers"
SETUP_LOG=$(mktemp)
export SETUP_LOG
trap 'rm -f "$SETUP_LOG"' EXIT
# No terminal to ask debconf's questions on, wherever the tests run, unless
# a test gives one.
APT_TTY=/nonexistent/tty
export APT_TTY
# Nor an /etc of the machine's to look through for kept config files.
SETUP_ETC=/nonexistent/etc
export SETUP_ETC

extract_functions() {
    awk -v names="$1" '
        BEGIN { n = split(names, a, " "); for (i = 1; i <= n; i++) want[a[i]] = 1 }
        /^[a-z_]+\(\) \{$/ { fname = $0; sub(/\(\) \{$/, "", fname); copying = want[fname] }
        copying { print }
        /^\}$/ { copying = 0 }
    ' "$SETUP"
}

# The Homebrew environment lives at setup's top level rather than inside a
# function, so extract_functions can't reach it. Pull the export lines out of
# the source the same way, so a harness that replays them fails if setup stops
# setting them -- a hand-written copy here would pass either way.
extract_homebrew_env() {
    grep '^export HOMEBREW_' "$SETUP"
}

# write_mock_santactl DIR MODE: a santactl in DIR, as Santa's in MODE says
# its mode: lockdown (with the spacing santactl pads its table with),
# monitor, or fails (it says Lockdown, but exits non-zero). none writes
# nothing. Each run adds a line to DIR/santactl-runs.
write_mock_santactl() {
    case "$2" in
        none) return 0 ;;
        lockdown) _ms_mode="  Mode                      | Lockdown"; _ms_status=0 ;;
        monitor) _ms_mode="  Mode                      | Monitor"; _ms_status=0 ;;
        fails) _ms_mode="  Mode                      | Lockdown"; _ms_status=1 ;;
        *) echo "write_mock_santactl: unknown mode $2" >&2; return 2 ;;
    esac
    cat > "$1/santactl" <<MOCK
#!/bin/sh
echo run >> "$1/santactl-runs"
cat <<'STATUS'
>>> Daemon Info
$_ms_mode
  Log Type                  | file
STATUS
exit $_ms_status
MOCK
    chmod +x "$1/santactl"
}

# Run install_homebrew against a stub curl. The installer is fetched and run as
# `/bin/bash -c "$(curl ...)"`, so having curl print a one-line script is
# enough to see the environment the installer is actually handed -- bash runs
# it for real, no stubbing of bash needed. PATH holds only the stub, so the
# real brew (present on the GitHub Actions runners) can't short-circuit the
# function before it gets there.
run_homebrew_installer() {
    brew_tmpdir="$(mktemp -d)"
    brew_calls="$brew_tmpdir/calls"
    cat > "$brew_tmpdir/curl" <<MOCK
#!/bin/sh
cat <<'INSTALLER'
printf '%s\n' "installer ran [NONINTERACTIVE=\${NONINTERACTIVE:-unset}]" >> "$brew_calls"
INSTALLER
MOCK
    chmod +x "$brew_tmpdir/curl"
    # The only real tools the stub PATH needs: sh to run the extracted
    # functions, cat for the stub curl itself, grep to read santactl's.
    for tool in sh cat grep; do
        ln -s "$(command -v "$tool")" "$brew_tmpdir/$tool"
    done
    write_mock_santactl "$brew_tmpdir" "${HARNESS_SANTACTL:-none}"

    set +e
    output="$(PATH="$brew_tmpdir" \
        sh -c "$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS $QUIET_FUNCTIONS install_homebrew")
install_homebrew" 2>&1)"
    status=$?
    set -e
    calls="$(cat "$brew_calls" 2>/dev/null)"
    rm -rf "$brew_tmpdir"
}

# Run set_default_terminal for one OS against mocked KDE/xdg tools.
# terminal_mode=fail makes kwriteconfig6 and xdg-mime exit non-zero, so the
# tests can check that a failure is reported rather than swallowed -- and that
# the bootstrap keeps going, which is what the trailing marker proves.
run_terminal_helper() {
    terminal_os="$1"
    terminal_mode="${2:-ok}"
    terminal_tmpdir="$(mktemp -d)"
    terminal_calls="$terminal_tmpdir/calls"

    for cmd in kitty update-alternatives; do
        cat > "$terminal_tmpdir/$cmd" <<MOCK
#!/bin/sh
printf '%s\n' "$cmd \$*" >> "$terminal_calls"
exit 0
MOCK
    done
    for cmd in kwriteconfig6 xdg-mime; do
        # xdg-mime is the one on a Plasma without qtpaths, which complains
        # even when it works.
        _complaint=
        test "$cmd" = xdg-mime \
            && _complaint='echo "/usr/bin/xdg-mime: line 885: qtpaths: command not found" >&2'
        cat > "$terminal_tmpdir/$cmd" <<MOCK
#!/bin/sh
printf '%s\n' "$cmd \$*" >> "$terminal_calls"
$_complaint
test "$terminal_mode" = fail && exit 1
exit 0
MOCK
    done
    chmod +x "$terminal_tmpdir"/*

    set +e
    output="$(PATH="$terminal_tmpdir:$PATH" HOME="$terminal_tmpdir" \
        sh -c "set -e
OS=$terminal_os
sudo_or_warn() { \"\$@\"; }
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS set_kde_default_terminal set_default_terminal")
set_default_terminal
echo BOOTSTRAP_CONTINUED" 2>&1)"
    status=$?
    set -e
    calls="$(cat "$terminal_calls" 2>/dev/null)"
    rm -rf "$terminal_tmpdir"
}

# stage_stamp FILE AGE: leaves setup's upgrade stamp FILE missing (none), just
# touched (fresh), or from long ago (stale).
stage_stamp() {
    case "$2" in
        none) ;;
        fresh) mkdir -p "${1%/*}" && touch "$1" ;;
        stale) mkdir -p "${1%/*}" && touch -t 202001010000 "$1" ;;
        *) echo "stage_stamp: unknown age $2" >&2; return 2 ;;
    esac
}

# stamp_state FILE: prints missing, fresh (under a week old) or stale.
stamp_state() {
    if ! test -e "$1"; then
        echo missing
    elif test -n "$(find "$1" -mtime +6)"; then
        echo stale
    else
        echo fresh
    fi
}

# The harnesses below run a whole upgrade pass -- resolve_upgrade, the
# installs, record_upgrade -- as setup's main does. HARNESS_UPGRADE is what
# UPGRADE starts as (default no: an in-week run, with no stamp to check), and
# HARNESS_STAMP how old the stamp is beforehand (none, fresh, stale). They
# leave $stamp set to its state afterwards, and the output ends with
# UPGRADE_FAILED's value.

# Run install_packages' macOS arm against a brew that always fails, or against
# an unavailable Homebrew. Asserting the run survives is the whole point: this
# arm used to abort the bootstrap under set -e, so the tests run with set -e on
# and look for the marker after the call.
run_macos_packages() {
    # homebrew_status: 0 = installed, 1 = Homebrew unavailable
    homebrew_status="$1"
    # The Mac's architecture as uname -m reports it: arm64 (the default) or
    # x86_64 for an Intel Mac, whose node comes from homepkg instead.
    macos_arch="${2:-arm64}"
    macos_tmpdir="$(mktemp -d)"
    macos_calls="$macos_tmpdir/calls"
    # brew_mode: fail (the default) fails every call, saying why as brew
    # would; ok installs, chattering as brew does, and lists what it has;
    # upgrade-fails is ok but for brew update and brew upgrade.
    brew_mode="${3:-fail}"
    cat > "$macos_tmpdir/brew" <<MOCK
#!/bin/sh
printf '%s\n' "brew \$* [HOMEBREW_NO_ASK=\${HOMEBREW_NO_ASK:-unset}]" >> "$macos_calls"
if test "$brew_mode" = fail; then
    echo "Error: No available formula with the name \$2." >&2
    exit 1
fi
case "\$1" in
    update|upgrade)
        if test "$brew_mode" = upgrade-fails; then
            echo "Error: Failed to download the index" >&2
            exit 1
        fi
        ;;
    list) cat "$macos_tmpdir/installed" 2>/dev/null ;;
    install)
        for _name; do
            case "\$_name" in
                install|--cask) ;;
                *)
                    echo "==> Pouring \$_name--1.0.arm64_sequoia.bottle.tar.gz"
                    printf '%s\n' "\$_name" >> "$macos_tmpdir/installed"
                    ;;
            esac
        done
        ;;
esac
exit 0
MOCK
    chmod +x "$macos_tmpdir/brew"
    write_mock_uname "$macos_tmpdir" "$macos_arch"
    write_mock_santactl "$macos_tmpdir" "${HARNESS_SANTACTL:-none}"
    macos_stamp="$macos_tmpdir/state/setup/last-upgrade"
    stage_stamp "$macos_stamp" "${HARNESS_STAMP:-none}"

    set +e
    output="$(PATH="$macos_tmpdir:$PATH" XDG_STATE_HOME="$macos_tmpdir/state" SETUP_LOG="" \
        sh -c "set -e
$(extract_homebrew_env)
OS=macos
NPM=yes
ROOT=yes
GUI_ENABLED=1
SUDO=yes
UPGRADE=${HARNESS_UPGRADE:-no}
UPGRADE_FAILED=no
UPGRADE_STAMP='$macos_stamp'
sudo_or_warn() { \"\$@\"; }
install_homebrew() { return $homebrew_status; }
install_go_pkg() { echo INSTALL_GO_PKG; }
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS is_intel_mac resolve_upgrade record_upgrade install_packages")
resolve_upgrade
install_packages
record_upgrade
echo BOOTSTRAP_CONTINUED
echo UPGRADE_FAILED=\$UPGRADE_FAILED" 2>&1)"
    status=$?
    set -e
    calls="$(cat "$macos_calls" 2>/dev/null)"
    brew_log="$(cat "$macos_tmpdir/state/setup/setup.log" 2>/dev/null)"
    stamp="$(stamp_state "$macos_stamp")"
    rm -rf "$macos_tmpdir"
}

# Run install_extras for EXTRAS_BACKEND=brew with santactl in $1's mode (as
# write_mock_santactl takes it), against stubs that say which install ran.
run_install_extras_dispatch() {
    dispatch_tmpdir="$(mktemp -d)"
    dispatch_bin="$(stub_path "$dispatch_tmpdir/bin" sh grep cat)"
    write_mock_santactl "$dispatch_bin" "$1"
    set +e
    output="$(PATH="$dispatch_bin" sh -c "set -e
EXTRAS_BACKEND=brew
install_homebrew() { echo INSTALL_HOMEBREW; }
install_extras_brew() { echo EXTRAS_FROM_BREW; }
install_extras_release() { echo EXTRAS_FROM_RELEASE; }
$(extract_functions "setup_color paint info detail warn note_problem santa_lockdown cli_tools_blocked install_extras")
install_extras
echo BOOTSTRAP_CONTINUED" 2>&1)"
    status=$?
    set -e
    rm -rf "$dispatch_tmpdir"
}

# Run santa_lockdown twice with santactl in $1's mode (none: no santactl),
# printing its answers, and leave $santactl_runs set to how often santactl
# ran.
run_santa_lockdown() {
    santa_tmpdir="$(mktemp -d)"
    santa_bin="$(stub_path "$santa_tmpdir/bin" sh grep cat)"
    write_mock_santactl "$santa_bin" "$1"
    : > "$santa_bin/santactl-runs"
    set +e
    output="$(PATH="$santa_bin" sh -c "
$(extract_functions "santa_lockdown")
santa_lockdown && echo LOCKDOWN || echo NOT_LOCKDOWN
santa_lockdown && echo LOCKDOWN || echo NOT_LOCKDOWN" 2>&1)"
    status=$?
    set -e
    santactl_runs=$(wc -l < "$santa_bin/santactl-runs" | tr -d ' ')
    rm -rf "$santa_tmpdir"
}

# Write a uname into directory $1 that reports a Mac whose uname -m is $2, so a
# test's answer doesn't depend on the machine running it.
write_mock_uname() {
    cat > "$1/uname" <<MOCK
#!/bin/sh
case "\$1" in
    -m) echo $2 ;;
    *) echo Darwin ;;
esac
MOCK
    chmod +x "$1/uname"
}

# Run install_node_home on a Mac whose uname -m is $1, with NPM=$2 and ROOT=$3,
# against a mock homepkg that records its arguments and succeeds and a mock brew
# whose `list` exits $4 (0: Homebrew's node is installed, 1: it isn't).
#   Leaves $calls set to the homepkg and brew invocations.
run_node_home() {
    node_tmpdir="$(mktemp -d)"
    node_calls="$node_tmpdir/calls"
    mkdir "$node_tmpdir/bin" "$node_tmpdir/scripts"
    cat > "$node_tmpdir/scripts/homepkg" <<MOCK
#!/bin/sh
printf '%s\n' "homepkg \$*" >> "$node_calls"
MOCK
    cat > "$node_tmpdir/bin/brew" <<MOCK
#!/bin/sh
printf '%s\n' "brew \$*" >> "$node_calls"
exit $4
MOCK
    chmod +x "$node_tmpdir/scripts/homepkg" "$node_tmpdir/bin/brew"
    write_mock_uname "$node_tmpdir/bin" "$1"

    set +e
    output="$(PATH="$node_tmpdir/bin:$PATH" \
        sh -c "set -e
OS=macos
NPM=$2
ROOT=$3
SCRIPTS_DIR='$node_tmpdir/scripts'
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS is_intel_mac install_node_home")
install_node_home
echo BOOTSTRAP_CONTINUED" 2>&1)"
    status=$?
    set -e
    calls="$(cat "$node_calls" 2>/dev/null)"
    rm -rf "$node_tmpdir"
}

# Write a sudo into directory $1 that runs its command, noting in file $2
# which command it ran. It sets the VAR=value it's given, unless
# $LINUX_NO_SETENV stands for a sudo rule that allows apt-get but not
# setting variables for it.
write_mock_sudo() {
    cat > "$1/sudo" <<MOCK
#!/bin/sh
while case "\$1" in *=*) true ;; *) false ;; esac; do
    if test -n "${LINUX_NO_SETENV:-}"; then
        echo "sudo: sorry, you are not allowed to set the following environment variables: \${1%%=*}" >&2
        exit 1
    fi
    export "\$1"
    shift
done
printf 'sudo runs %s\n' "\$1" >> "$2"
exec "\$@"
MOCK
    chmod +x "$1/sudo"
}

# Run install_packages' Linux arm ($1: debian|redhat) against a mock package
# manager that records every invocation and succeeds, with the GUI off. This
# exercises the real dispatch -- which install commands are actually issued --
# rather than grepping the source, so it can prove the file managers are NOT
# attempted via apt/dnf and that the GUI-only packages are not installed under
# --no-gui. NPM=no keeps the node/tsc steps out of the recorded calls.
#   Leaves $calls set to the package-manager invocations.
run_linux_packages() {
    linux_os="$1"
    linux_gui="${2:-0}"
    case "$linux_os" in
        debian) linux_pm=apt-get ;;
        redhat) linux_pm=dnf ;;
        *) echo "run_linux_packages: unknown OS $linux_os" >&2; return 2 ;;
    esac
    linux_tmpdir="$(mktemp -d)"
    linux_calls="$linux_tmpdir/calls"
    # It chatters as the real ones do, and records whether apt may ask.
    # HARNESS_PM_MODE=upgrade-fails fails its upgrades (apt-get install
    # --only-upgrade, dnf upgrade) and nothing else; update-fails fails
    # apt-get update; busy holds dpkg's lock. HARNESS_RETRY=yes keeps a
    # retry list, as setup does, and tries again at the end.
    cat > "$linux_tmpdir/$linux_pm" <<MOCK
#!/bin/sh
printf '%s\n' "$linux_pm \$* [DEBIAN_FRONTEND=\${DEBIAN_FRONTEND:-unset}] [stdin=\$(cat)]" >> "$linux_calls"
# busy holds dpkg's lock for its first HARNESS_BUSY_CALLS calls (default
# 1), not counting the --version setup asks first.
if test "${HARNESS_PM_MODE:-ok}" = busy && test "\$1" != --version; then
    _busy=\$(cat "$linux_tmpdir/busy-calls" 2>/dev/null || echo 0)
    echo \$((_busy + 1)) > "$linux_tmpdir/busy-calls"
    if test "\$_busy" -lt "${HARNESS_BUSY_CALLS:-1}"; then
        echo "E: Could not get lock /var/lib/dpkg/lock-frontend. It is held by process 1234 (unattended-upgr)" >&2
        exit 100
    fi
fi
case "${HARNESS_PM_MODE:-ok} \$*" in
    "update-fails update"*)
        echo "E: Could not resolve the mirror" >&2
        exit 100
        ;;
    "upgrade-fails "*--only-upgrade* | "upgrade-fails upgrade "*)
        echo "E: Failed to fetch the upgrades" >&2
        exit 100
        ;;
    # no-extras: the release has no extra wallpapers; unlisted: dnf lists
    # them but can't install them.
    "no-extras -q repoquery "*) exit 0 ;;
    *" -q repoquery "*) echo "\$4-1.0-1.noarch"; exit 0 ;;
    "unlisted install "*backgrounds-extras*)
        echo "Failed to resolve the transaction:" >&2
        echo "No match for argument: f44-backgrounds-extras-base" >&2
        echo "You can try to add to command line:" >&2
        echo "  --skip-unavailable to skip unavailable packages" >&2
        exit 1
        ;;
esac
echo "Setting up \$*"
exit 0
MOCK
    # The packages installed beforehand are HARNESS_INSTALLED's, as dpkg and
    # rpm list them; tsc is there when HARNESS_TSC=yes.
    cat > "$linux_tmpdir/dpkg-query" <<MOCK
#!/bin/sh
for _name in ${HARNESS_INSTALLED:-}; do echo "ii  \$_name 1.0-1"; done
MOCK
    cat > "$linux_tmpdir/rpm" <<MOCK
#!/bin/sh
for _name in ${HARNESS_INSTALLED:-}; do echo "\$_name 1.0-1"; done
MOCK
    cat > "$linux_tmpdir/npm" <<MOCK
#!/bin/sh
printf '%s\n' "npm \$*" >> "$linux_calls"
test "${HARNESS_NPM_FAILS:-no}" = no || exit 1
MOCK
    if test "${HARNESS_TSC:-no}" = yes; then
        printf '#!/bin/sh\n' > "$linux_tmpdir/tsc"
        chmod +x "$linux_tmpdir/tsc"
    fi
    # apt has 2.0-1 of each installed package, newer than its 1.0-1, but for
    # HARNESS_APT_NEWER's, installed at 9.9-1, newer than apt's.
    cat > "$linux_tmpdir/apt-cache" <<MOCK
#!/bin/sh
test "${HARNESS_APT_CACHE_FAILS:-no}" = no || { echo "E: apt-cache failed" >&2; exit 100; }
shift
for _name; do
    _installed="(none)"
    for _i in ${HARNESS_INSTALLED:-}; do test "\$_i" = "\$_name" && _installed=1.0-1; done
    for _i in ${HARNESS_APT_NEWER:-}; do test "\$_i" = "\$_name" && _installed=9.9-1; done
    printf '%s:\n  Installed: %s\n  Candidate: 2.0-1\n' "\$_name" "\$_installed"
done
MOCK
    # dpkg --compare-versions, for hosts without dpkg (macOS, Fedora): the
    # versions above are N.N-N, compared field by field as numbers.
    cat > "$linux_tmpdir/dpkg" <<'MOCK'
#!/bin/sh
test "$1" = --compare-versions || exit 2
awk -v a="$2" -v op="$3" -v b="$4" 'BEGIN {
    n = split(a, x, /[.:-]/); m = split(b, y, /[.:-]/); c = 0
    for (i = 1; i <= (n > m ? n : m) && c == 0; i++) {
        if (x[i] + 0 > y[i] + 0) c = 1; else if (x[i] + 0 < y[i] + 0) c = -1
    }
    if (op == "gt") exit !(c > 0)
    if (op == "lt") exit !(c < 0)
    if (op == "eq") exit !(c == 0)
    exit 2
}'
MOCK
    write_mock_sudo "$linux_tmpdir" "$linux_calls"
    chmod +x "$linux_tmpdir/$linux_pm" "$linux_tmpdir/sudo" "$linux_tmpdir/dpkg-query" \
        "$linux_tmpdir/rpm" "$linux_tmpdir/npm" "$linux_tmpdir/apt-cache" "$linux_tmpdir/dpkg"
    linux_stamp="$linux_tmpdir/state/setup/last-upgrade"
    stage_stamp "$linux_stamp" "${HARNESS_STAMP:-none}"

    set +e
    # An answer waits on stdin, for a package manager that asks anything.
    output="$(printf 'y\n' | PATH="$linux_tmpdir:$PATH" \
        sh -c "set -e
unset DEBIAN_FRONTEND
OS=$linux_os
NPM=${HARNESS_NPM:-no}
GUI_ENABLED=$linux_gui
CROSTINI=0
OS_RELEASE='${HARNESS_OS_RELEASE:-/nonexistent}'
SUDO=yes
UPGRADE=${HARNESS_UPGRADE:-no}
UPGRADE_FAILED=no
UPGRADE_STAMP='$linux_stamp'
SETUP_APT_RETRY=${HARNESS_RETRY:+$linux_tmpdir/apt-retry}
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS sudo_or_warn resolve_upgrade record_upgrade install_packages retry_busy_apt")
resolve_upgrade
install_packages
test -z \"\$SETUP_APT_RETRY\" || retry_busy_apt
record_upgrade
echo BOOTSTRAP_CONTINUED
echo UPGRADE_FAILED=\$UPGRADE_FAILED" 2>&1)"
    status=$?
    set -e
    calls="$(cat "$linux_calls" 2>/dev/null)"
    stamp="$(stamp_state "$linux_stamp")"
    rm -rf "$linux_tmpdir"
}

# Another program holding dpkg's lock doesn't stop the run: setup says it
# tries again at the end, and does, once.
test_busy_apt_is_tried_again_at_the_end() {
