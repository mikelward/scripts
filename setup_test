# --- keyd: Caps Lock with the arrows ---

# Run configure_keyd against a fake /etc/keyd, with a PATH of just the tools
# it uses.
#   $1  how sudo goes (default ok): ok | denied
#   $2  the OS (default debian)
#   $3  what's already there (default none): none | current (this run's
#       config) | old (an earlier run's) | other (somebody else's)
#   $4  whether keyd is installed (default yes): yes | no | rvaiya (as
#       Debian's package names it, keyd.rvaiya)
#   $5  CROSTINI (default 0)
#   $6  ROOT (default yes)
#   $7  whether keyd is running already (default no): yes | no
# Leaves $calls set to the privileged commands asked for, and $kd_body to
# the config (empty when none).
run_configure_keyd() {
    kd_sudo="${1:-ok}"
    kd_os="${2:-debian}"
    kd_seed="${3:-none}"
    kd_has="${4:-yes}"
    kd_crostini="${5:-0}"
    kd_root="${6:-yes}"
    kd_active="${7:-no}"
    kd_tmpdir="$(mktemp -d)"
    kd_dir="$kd_tmpdir/etc/keyd"
    kd_bin="$kd_tmpdir/bin"
    mkdir -p "$kd_bin"
    for kd_tool in sh grep tee cat mkdir rm mktemp sed tr printf; do
        kd_path=$(command -v "$kd_tool") && case "$kd_path" in /*) ln -s "$kd_path" "$kd_bin/$kd_tool" ;; esac
    done
    # systemctl answers is-active as asked; the rest only say they ran,
    # and sudo_or_warn's stub logs those.
    if test "$kd_active" = yes; then
        printf '#!/bin/sh\nexit 0\n' > "$kd_bin/systemctl"
    else
        printf '#!/bin/sh\ntest "$1" = is-active && exit 3\nexit 0\n' > "$kd_bin/systemctl"
    fi
    chmod +x "$kd_bin/systemctl"
    case "$kd_has" in
        yes) kd_cmd=keyd ;;
        rvaiya) kd_cmd=keyd.rvaiya ;;
        *) kd_cmd="" ;;
    esac
    if test -n "$kd_cmd"; then
        printf '#!/bin/sh\nexit 0\n' > "$kd_bin/$kd_cmd"
        chmod +x "$kd_bin/$kd_cmd"
    fi
    case "$kd_seed" in
        current|old)
            mkdir -p "$kd_dir"
            printf '%s\n' "# Written by setup (github.com/mikelward/scripts): an earlier run's" \
                > "$kd_dir/default.conf"
            ;;
        other)
            mkdir -p "$kd_dir"
            printf '%s\n' "# somebody's own keyd config" > "$kd_dir/default.conf"
            ;;
    esac
    if test "$kd_sudo" = denied; then
        kd_stub='sudo_or_warn() { printf "%s\n" "$*" >> "$KD_CALLS"; warn "sudo ${1##*/}: permission denied"; return 1; }'
    else
        kd_stub='sudo_or_warn() { printf "%s\n" "$*" >> "$KD_CALLS"; "$@"; }'
    fi
    kd_script="set -e
OS=$kd_os
CROSTINI=$kd_crostini
ROOT=$kd_root
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS configure_keyd")
$kd_stub"
    # current: what a run writes, so the run after it finds it unchanged.
    if test "$kd_seed" = current; then
        PATH="$kd_bin" KD_CALLS="$kd_tmpdir/seed-calls" SETUP_KEYD_DIR="$kd_dir" \
            "$kd_bin/sh" -c "$kd_script
configure_keyd" >/dev/null 2>&1
    fi

    set +e
    output="$(PATH="$kd_bin" KD_CALLS="$kd_tmpdir/calls" SETUP_KEYD_DIR="$kd_dir" \
        "$kd_bin/sh" -c "$kd_script
configure_keyd
echo BOOTSTRAP_CONTINUED" 2>&1)"
    status=$?
    set -e
    calls=""
    if test -f "$kd_tmpdir/calls"; then
        calls="$(cat "$kd_tmpdir/calls")"
    fi
    kd_body=""
    if test -f "$kd_dir/default.conf"; then
        kd_body="$(cat "$kd_dir/default.conf")"
    fi
    rm -rf "$kd_tmpdir"
}

# The layer: held Caps Lock, a tap still Caps Lock (compose:caps makes it
# Compose), the arrows, Alt's document ends, and Alt+Home/End.
assert_keyd_config_written() {
    for kd_line in "capslock = overload(nav, capslock)" \
            "[nav]" "left = home" "right = end" "up = pageup" "down = pagedown" \
            "[nav+alt]" "left = C-home" "up = C-home" "right = C-end" "down = C-end" \
            "[alt]" "home = C-home" "end = C-end" \
            "[nav+altgr]" "[altgr]"; do
        if ! printf '%s\n' "$kd_body" | grep -qxF "$kd_line"; then
            echo "  FAIL: the keyd config lacks '$kd_line'"
            echo "  config: $kd_body"
            TEST_FAILED=1
            return 1
        fi
    done
}

# Right Alt is keyd's altgr layer, so it gets the same as left Alt.
assert_keyd_altgr_matches_alt() {
    kd_alt=$(printf '%s\n' "$kd_body" | sed -n '/^\[nav+alt\]$/,/^$/p;/^\[alt\]$/,/^$/p' | grep -v '^\[')
    kd_altgr=$(printf '%s\n' "$kd_body" | sed -n '/^\[nav+altgr\]$/,/^$/p;/^\[altgr\]$/,/^$/p' | grep -v '^\[' | grep -v '^#')
    assert_eq "$kd_altgr" "$kd_alt"
}

test_keyd_configured() {
