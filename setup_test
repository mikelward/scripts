# install_home_tools prefers a staged bundle: if one is present it unpacks it
# (offline, flat into the prefix) and stops; otherwise it installs the set
# online into a managed conda env. No online reconcile after the bundle --
# unpack (flat) and the online install (env) are different mechanisms and
# mustn't be layered on one run. Discovery: $HOMEPKG_BUNDLE, or
# homepkg-bundle.tgz beside the scripts repo / in $HOME.
test_home_tools_uses_bundle_optimistically() {
    assert_source_contains '"$homepkg" install-bundle "$bundle"' &&
    assert_source_contains 'HOMEPKG_BUNDLE' &&
    assert_source_contains 'homepkg-bundle.tgz' &&
    assert_source_contains "a bundle unpacks its full contents additively" &&
    # A staged bundle wins outright -- no env gate, no conda-meta probe.
    assert_source_contains 'if test -n "$bundle"; then' &&
    assert_source_not_contains 'conda-meta' &&
    # No online reconcile after the bundle (that would build a shadowing env).
    assert_source_not_contains "couldn't reconcile the requested tools online"
}

# install-bundle exits 2 for a partial install (some tools landed, one the
# bundle was built without didn't) and 1 when it installed nothing. On 2 setup
# trusts the partial -- ~/.local/bin goes on PATH for what landed (unpack builds
# no env marker to consult). On a total failure (wrong platform, unreadable
# bundle) it falls through to the online install, so a connected box still gets
# its tools. The online block is gated on provisioned, not on there being no
# bundle, so that fall-through reaches it.
test_home_tools_provisioned_by_a_partial_bundle() {
    assert_source_contains 'rc=$?' &&
    assert_source_contains 'if test "$rc" -eq 2; then' &&
    assert_source_contains "the bundle didn't provide everything (offline?); using what it did unpack" &&
    assert_source_contains "falling back to the online install" &&
    assert_source_contains 'if test "$provisioned" = no; then' &&
    # provisioned=yes on bundle-success, partial (rc 2), and online-success --
    # the three PATH-carrying outcomes.
    test "$(grep -c '^ *provisioned=yes$' "$SETUP")" -ge 3
}

# A failed pull on an EXISTING checkout (e.g. offline) must warn and continue,
# not abort under set -e -- otherwise the offline "setup --no-root" bootstrap
# dies on the scripts/conf pull before reaching the homepkg bundle install. A
# failed clone (no checkout to fall back to) stays fatal, so success is never
# faked when there's nothing usable on disk.
# A throwaway origin with a commit on main, and a clone of it in
# $co_tmpdir/repo, with git configured by nothing outside it.
co_git() {
    HOME="$co_tmpdir" GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_NAME=Test GIT_AUTHOR_EMAIL=test@example.com \
        GIT_COMMITTER_NAME=Test GIT_COMMITTER_EMAIL=test@example.com git "$@"
}

make_checkout() {
    co_tmpdir="$(mktemp -d)"
    co_git init -q --bare "$co_tmpdir/origin.git"
    co_git -C "$co_tmpdir/origin.git" symbolic-ref HEAD refs/heads/main
    co_git init -q "$co_tmpdir/seed"
    co_git -C "$co_tmpdir/seed" checkout -q -b main
    echo one > "$co_tmpdir/seed/file"
    co_git -C "$co_tmpdir/seed" add file
    co_git -C "$co_tmpdir/seed" commit -q -m one
    co_git -C "$co_tmpdir/seed" push -q "$co_tmpdir/origin.git" main
    co_git clone -q "$co_tmpdir/origin.git" "$co_tmpdir/repo"
}

# advance_origin: a new commit on origin's main, making file "two".
advance_origin() {
    echo two > "$co_tmpdir/seed/file"
    co_git -C "$co_tmpdir/seed" commit -q -am two
    co_git -C "$co_tmpdir/seed" push -q "$co_tmpdir/origin.git" main
}

# run_clone_or_pull REPO: clone_or_pull REPO into $co_tmpdir/repo, under
# set -e, as setup runs it.
run_clone_or_pull() {
    set +e
    output="$(HOME="$co_tmpdir" GIT_CONFIG_NOSYSTEM=1 sh -c "set -e
GITHUB_MIRROR=no
$(extract_functions "setup_color paint info detail warn note_problem redact_url_credentials canonical_remote default_branch pull_checkout clone_or_pull")
clone_or_pull '$1' '$co_tmpdir/repo' yes
echo BOOTSTRAP_CONTINUED" 2>&1)"
    status=$?
    set -e
}

# A pull that works says nothing, and moves the checkout.
test_clone_or_pull_updates_quietly() {
    make_checkout
    advance_origin
    run_clone_or_pull "$co_tmpdir/origin.git"
    assert_status 0 &&
    assert_eq "$(printf '%s\n' "$output" | grep -v '^Updating ')" "BOOTSTRAP_CONTINUED" &&
    assert_eq "$(cat "$co_tmpdir/repo/file")" "two"
    rm -rf "$co_tmpdir"
}

# A pull that fails on an existing checkout (offline, say) warns, saying why,
# and setup carries on with the checkout as it is: an offline "setup
# --no-root" still reaches the homepkg bundle install.
test_clone_or_pull_degrades_offline() {
    make_checkout
    # An ssh that can't look the host up, as ssh says it offline.
    cat > "$co_tmpdir/ssh" <<'SSH'
#!/bin/sh
echo "ssh: Could not resolve hostname example.invalid: Name or service not known" >&2
exit 255
SSH
    chmod +x "$co_tmpdir/ssh"
    co_git -C "$co_tmpdir/repo" config core.sshCommand "$co_tmpdir/ssh"
    co_git -C "$co_tmpdir/repo" remote set-url origin ssh://example.invalid/repo.git
    run_clone_or_pull "$co_tmpdir/origin.git"
    assert_status 0 &&
    assert_output_contains "Warning: couldn't update $co_tmpdir/repo: can't reach origin; using the existing checkout" &&
    assert_output_contains "BOOTSTRAP_CONTINUED"
    rm -rf "$co_tmpdir"
}

# A server that answers and refuses isn't "can't reach origin": the warning
# gives git's reason, without the credentials in the URL.
test_a_refused_pull_says_what_the_server_said() {
    make_checkout
    # A remote helper that fails as git's https one does on a 403.
    mkdir "$co_tmpdir/bin"
    cat > "$co_tmpdir/bin/git-remote-denied" <<'HELPER'
#!/bin/sh
echo "fatal: unable to access 'https://user:secret-token@example.com/repo.git/': The requested URL returned error: 403" >&2
exit 128
HELPER
    chmod +x "$co_tmpdir/bin/git-remote-denied"
    co_git -C "$co_tmpdir/repo" remote set-url origin denied::https://example.com/repo.git
    _path=$PATH
    PATH="$co_tmpdir/bin:$PATH"
    run_clone_or_pull "$co_tmpdir/origin.git"
    PATH=$_path
    assert_status 0 &&
    assert_output_contains "Warning: couldn't update $co_tmpdir/repo: unable to access 'https://***@example.com/repo.git/': The requested URL returned error: 403; using the existing checkout" &&
    assert_output_not_contains "secret-token" &&
    assert_output_not_contains "can't reach origin"
    rm -rf "$co_tmpdir"
}

# ssh says why it was refused before git's own line, which says only that it
# couldn't read: what ssh said is shown under the warning.
test_a_refused_ssh_key_is_shown() {
    make_checkout
    cat > "$co_tmpdir/ssh" <<'SSH'
#!/bin/sh
echo "git@example.com: Permission denied (publickey)." >&2
exit 255
SSH
    chmod +x "$co_tmpdir/ssh"
    co_git -C "$co_tmpdir/repo" config core.sshCommand "$co_tmpdir/ssh"
    co_git -C "$co_tmpdir/repo" remote set-url origin ssh://git@example.com/repo.git
    run_clone_or_pull "$co_tmpdir/origin.git"
    assert_status 0 &&
    assert_output_contains "Warning: couldn't update $co_tmpdir/repo: Could not read from remote repository.; using the existing checkout
    git@example.com: Permission denied (publickey)." &&
    assert_output_not_contains "can't reach origin" &&
    assert_output_contains "BOOTSTRAP_CONTINUED"
    rm -rf "$co_tmpdir"
}

test_a_branch_with_no_upstream_says_so() {
    make_checkout
    co_git -C "$co_tmpdir/repo" checkout -q -b foo
    advance_origin
    run_clone_or_pull "$co_tmpdir/origin.git"
    assert_status 0 &&
    assert_output_contains "Warning: couldn't update $co_tmpdir/repo: branch foo has no upstream; using the existing checkout" &&
    assert_eq "$(co_git -C "$co_tmpdir/repo" symbolic-ref --short HEAD)" "foo" &&
    assert_eq "$(cat "$co_tmpdir/repo/file")" "one"
    rm -rf "$co_tmpdir"
}

test_local_changes_in_the_way_say_so_and_stay() {
    make_checkout
    echo mine > "$co_tmpdir/repo/file"
    advance_origin
    run_clone_or_pull "$co_tmpdir/origin.git"
    assert_status 0 &&
    assert_output_contains "Warning: couldn't update $co_tmpdir/repo: local changes are in the way; using the existing checkout" &&
    assert_eq "$(cat "$co_tmpdir/repo/file")" "mine"
    rm -rf "$co_tmpdir"
}

test_a_diverged_checkout_says_so() {
    make_checkout
    co_git -C "$co_tmpdir/repo" config pull.ff only
    echo mine > "$co_tmpdir/repo/other"
    co_git -C "$co_tmpdir/repo" add other
    co_git -C "$co_tmpdir/repo" commit -q -m mine
    advance_origin
    run_clone_or_pull "$co_tmpdir/origin.git"
    assert_status 0 &&
    assert_output_contains "Warning: couldn't update $co_tmpdir/repo: it has diverged from origin/main; using the existing checkout"
    rm -rf "$co_tmpdir"
}

test_a_detached_checkout_says_so() {
    make_checkout
    co_git -C "$co_tmpdir/repo" checkout -q --detach
    run_clone_or_pull "$co_tmpdir/origin.git"
    assert_status 0 &&
    assert_output_contains "Warning: couldn't update $co_tmpdir/repo: it's detached at $(co_git -C "$co_tmpdir/repo" rev-parse --short HEAD); using the existing checkout"
    rm -rf "$co_tmpdir"
}

# A rebasing pull that stops on conflicts leaves HEAD detached: the warning
# names the conflicts, not the detached HEAD.
test_a_rebase_that_stops_on_conflicts_says_so() {
    make_checkout
    co_git -C "$co_tmpdir/repo" config pull.rebase true
    echo mine > "$co_tmpdir/repo/file"
    co_git -C "$co_tmpdir/repo" commit -q -am mine
    advance_origin
    run_clone_or_pull "$co_tmpdir/origin.git"
    assert_status 0 &&
    assert_output_contains "Warning: couldn't update $co_tmpdir/repo: it has conflicts to resolve; using the existing checkout" &&
    assert_output_lacks "detached"
    rm -rf "$co_tmpdir"
}

# A failure git gives no error line for (a hook that refuses the merge, say)
# shows all of what git said, since that's where the reason is.
test_a_failure_without_an_error_line_shows_what_git_said() {
    make_checkout
    co_git -C "$co_tmpdir/repo" config pull.rebase false
    co_git -C "$co_tmpdir/repo" config user.name Test
    co_git -C "$co_tmpdir/repo" config user.email test@example.com
    echo mine > "$co_tmpdir/repo/other"
    co_git -C "$co_tmpdir/repo" add other
    co_git -C "$co_tmpdir/repo" commit -q -m mine
    printf '#!/bin/sh\necho "the merge hook says no"\nexit 1\n' > "$co_tmpdir/repo/.git/hooks/pre-merge-commit"
    chmod +x "$co_tmpdir/repo/.git/hooks/pre-merge-commit"
    advance_origin
    run_clone_or_pull "$co_tmpdir/origin.git"
    assert_status 0 &&
    assert_output_contains "Warning: couldn't update $co_tmpdir/repo: git pull exited 1; using the existing checkout" &&
    assert_output_contains "    the merge hook says no"
    rm -rf "$co_tmpdir"
}

# One that pulls, but on a branch other than origin's default, is named:
# that's how a stale checkout of an old branch gets installed unnoticed.
test_a_checkout_off_its_default_branch_is_named_when_it_pulls() {
    make_checkout
    co_git -C "$co_tmpdir/repo" checkout -q -b foo --track origin/main
    advance_origin
    run_clone_or_pull "$co_tmpdir/origin.git"
    assert_status 0 &&
    assert_output_contains "Warning: $co_tmpdir/repo is on branch foo, not main; using the existing checkout" &&
    assert_eq "$(co_git -C "$co_tmpdir/repo" symbolic-ref --short HEAD)" "foo"
    rm -rf "$co_tmpdir"
}

# A failed clone has no checkout to fall back to, so it stays fatal.
test_clone_or_pull_fails_when_a_clone_does() {
    co_tmpdir="$(mktemp -d)"
    run_clone_or_pull "$co_tmpdir/gone.git"
    assert_status 128 &&
    assert_output_lacks "BOOTSTRAP_CONTINUED"
    rm -rf "$co_tmpdir"
}

# --- --github internal-mirror flag ---

# --github takes a value and is a known option: setup consumes the argument and
# then reaches --help (exit 0), so it neither errors as unknown nor swallows the
# following flag. The equals form parses too.
test_github_flag_accepted() {
    run_setup --github git@ghe.corp.example.com --help
    assert_status 0 &&
    assert_output_contains "Usage: setup" &&
    assert_output_contains "--github"
}

test_github_equals_form_accepted() {
    run_setup --github=https://ghe.corp.example.com --help
    assert_status 0 &&
    assert_output_contains "Usage: setup"
}

# --github with no following argument is an error, not a silent no-op that would
# leave GITHUB_PREFIX as the default and clone from github.com anyway.
test_github_requires_argument() {
    run_setup --github
    assert_status 1 &&
    assert_output_contains "requires a host/prefix argument"
}

# A forgotten value before another flag (setup --github --no-install) must be
# rejected, not swallow the next flag as the prefix -- otherwise --no-install is
# silently dropped and setup clones from a bogus "--no-install:mikelward/..."
# remote. A real host/prefix never starts with '-'.
test_github_rejects_option_as_value() {
    run_setup --github --no-install
    assert_status 1 &&
    assert_output_contains "requires a host/prefix argument"
}

# The equals form must apply the same validation: "--github=" is an empty
# required value that would otherwise normalize to ":" and clone from
# ":mikelward/...", so it errors immediately like the separate-argument form.
test_github_rejects_empty_equals() {
    run_setup --github=
    assert_status 1 &&
    assert_output_contains "requires a host/prefix argument"
}

# The repos are assembled from GITHUB_PREFIX + path, defaulting to GitHub over
# SSH, so an unset --github clones from github.com exactly as before.
test_github_default_and_assembly() {
    assert_source_contains 'GITHUB_DEFAULT_PREFIX="git@github.com:"' &&
    assert_source_contains 'GITHUB_PREFIX="${GITHUB_PREFIX:-$GITHUB_DEFAULT_PREFIX}"' &&
    assert_source_contains 'SCRIPTS_REPO_PATH="mikelward/scripts.git"' &&
    assert_source_contains 'SCRIPTS_REPO="${GITHUB_PREFIX}${SCRIPTS_REPO_PATH}"' &&
    assert_source_contains 'CONF_REPO="${GITHUB_PREFIX}${CONF_REPO_PATH}"' &&
    assert_source_contains 'ROOT_REPO="${GITHUB_PREFIX}${ROOT_REPO_PATH}"' &&
    assert_source_contains 'normalize_github_prefix "$GITHUB_PREFIX"'
}

# Exercise the real normalize_github_prefix by extracting it from setup: a
# prefix that already ends in a separator is left alone, a URL-scheme prefix
# gets a trailing '/', and an scp-style or bare host gets a trailing ':'. This
# is what lets one flag carry either an SSH or an HTTPS target.
test_normalize_github_prefix() {
    eval "$(sed -n '/^normalize_github_prefix() {/,/^}/p' "$SETUP")"
    assert_eq "$(normalize_github_prefix 'git@github.com:')" 'git@github.com:' &&
    assert_eq "$(normalize_github_prefix 'git@ghe.corp:')" 'git@ghe.corp:' &&
    assert_eq "$(normalize_github_prefix 'git@ghe.corp')" 'git@ghe.corp:' &&
    assert_eq "$(normalize_github_prefix 'https://ghe.corp/')" 'https://ghe.corp/' &&
    assert_eq "$(normalize_github_prefix 'https://ghe.corp')" 'https://ghe.corp/' &&
    assert_eq "$(normalize_github_prefix 'ssh://git@ghe.corp')" 'ssh://git@ghe.corp/'
}

# GITHUB_MIRROR is what the SSH-key and remote-rewrite steps key off, so it has
# to be derived from the *normalized* prefix -- otherwise "--github git@github.com"
# (the default, spelled without its separator) would look like a mirror. The
# HTTPS check decides whether an SSH key is needed to clone at all.
test_github_mirror_derived_after_normalizing() {
    assert_source_contains 'test "$GITHUB_MIRROR" = yes' &&
    assert_source_contains 'if test "$GITHUB_PREFIX" = "$GITHUB_DEFAULT_PREFIX"; then' &&
    assert_source_contains 'GITHUB_PREFIX_SSH=no' &&
    # The GITHUB_MIRROR/GITHUB_PREFIX_SSH block reads the normalized prefix, so
    # it must come after normalize_github_prefix rewrites it.
    test "$(grep -n 'GITHUB_PREFIX=$(normalize_github_prefix' "$SETUP" | cut -d: -f1)" \
        -lt "$(grep -n '^    GITHUB_MIRROR=no$' "$SETUP" | cut -d: -f1)"
}

# Exercise the real github_prefix_host: both prefix shapes reduce to a bare
# host, so the SSH-key and remote messages can name where the repos came from.
test_github_prefix_host() {
    eval "$(sed -n '/^github_prefix_host() {/,/^}/p' "$SETUP")"
    assert_eq "$(github_prefix_host 'git@github.com:')" 'github.com' &&
    assert_eq "$(github_prefix_host 'git@ghe.corp.example.com:')" 'ghe.corp.example.com' &&
    assert_eq "$(github_prefix_host 'https://ghe.corp.example.com/')" 'ghe.corp.example.com' &&
    assert_eq "$(github_prefix_host 'ssh://git@ghe.corp.example.com/')" 'ghe.corp.example.com' &&
    assert_eq "$(github_prefix_host 'https://user@ghe.corp.example.com/')" 'ghe.corp.example.com'
}

# Exercise the real redact_url_credentials. An HTTPS clone URL can carry a
# token, and the token-as-username forms mean a bare user-info is no safer than
# a password, so the whole of it is replaced -- while credential-free URLs and
# scp-style remotes (no password field in that syntax) print unchanged, so the
# ordinary case stays readable and copy-pasteable.
test_redact_url_credentials() {
    eval "$(sed -n '/^redact_url_credentials() {/,/^}/p' "$SETUP")"
    assert_eq "$(redact_url_credentials 'https://user:tok@ghe.corp.example.com/mikelward/scripts.git')" \
        'https://***@ghe.corp.example.com/mikelward/scripts.git' &&
    assert_eq "$(redact_url_credentials 'https://tok@ghe.corp.example.com/mikelward/scripts.git')" \
        'https://***@ghe.corp.example.com/mikelward/scripts.git' &&
    assert_eq "$(redact_url_credentials 'https://ghe.corp.example.com/mikelward/scripts.git')" \
        'https://ghe.corp.example.com/mikelward/scripts.git' &&
    assert_eq "$(redact_url_credentials 'git@github.com:mikelward/scripts.git')" \
        'git@github.com:mikelward/scripts.git' &&
    # An '@' in the path is not user-info, so it survives untouched.
    assert_eq "$(redact_url_credentials 'https://ghe.corp.example.com/mikelward/a@b.git')" \
        'https://ghe.corp.example.com/mikelward/a@b.git'
}

# --- Keeping the display card powered ---

# The rule keep_display_gpu_awake should write, line for line.
DISPLAY_GPU_RULE='ACTION=="add|bind", SUBSYSTEM=="pci", ATTR{class}=="0x03*", DRIVER=="amdgpu|radeon|nouveau|nvidia", ATTR{power/control}="on"'

# Run keep_display_gpu_awake against a fake /sys and udev rules directory, so
# the tests check what it does to real-shaped devices rather than what the
# source says.
#   $1  the PCI devices, space-separated, each ADDRESS/DRIVER/CLASS/CONTROL:
#       DRIVER "-" for none bound, CLASS the PCI class as sysfs gives it
#       (0x030000 for a VGA controller), CONTROL its power/control
#   $2  how sudo goes (default ok): ok | denied
#   $3  the OS (default debian)
#   $4  the power supplies, space-separated, each NAME/TYPE/SCOPE, SCOPE "-"
#       for none given (default none: a desktop)
#   $5  the rule file already there (default none): none | setup (one an
#       earlier run wrote) | other (somebody else's at the same path)
# Leaves $calls set to the privileged commands asked for, $gpu_rule_body to the
# rule file written (empty when none), and $gpu_controls to every device's
# power/control afterwards, one ADDRESS=STATE line each.
run_keep_display_gpu_awake() {
    gpu_devices="$1"
    gpu_sudo="${2:-ok}"
    gpu_os="${3:-debian}"
    gpu_supplies="${4:-}"
    gpu_seed="${5:-none}"
    gpu_tmpdir="$(mktemp -d)"
    gpu_sys="$gpu_tmpdir/sys"
    gpu_rules="$gpu_tmpdir/rules"
    mkdir -p "$gpu_sys/bus/pci/devices" "$gpu_sys/class/power_supply" "$gpu_rules"
    for gpu_spec in $gpu_supplies; do
        IFS=/ read -r gpu_psu gpu_psu_type gpu_psu_scope <<SPEC
$gpu_spec
SPEC
        mkdir -p "$gpu_sys/class/power_supply/$gpu_psu"
        printf '%s\n' "$gpu_psu_type" > "$gpu_sys/class/power_supply/$gpu_psu/type"
        if test "$gpu_psu_scope" != -; then
            printf '%s\n' "$gpu_psu_scope" > "$gpu_sys/class/power_supply/$gpu_psu/scope"
        fi
    done
    for gpu_spec in $gpu_devices; do
        IFS=/ read -r gpu_addr gpu_driver gpu_class gpu_control <<SPEC
$gpu_spec
SPEC
        gpu_dev="$gpu_sys/bus/pci/devices/$gpu_addr"
        mkdir -p "$gpu_dev/power"
        printf '%s\n' "$gpu_control" > "$gpu_dev/power/control"
        printf '%s\n' "$gpu_class" > "$gpu_dev/class"
        if test "$gpu_driver" != -; then
            mkdir -p "$gpu_sys/bus/pci/drivers/$gpu_driver"
            ln -s "../../drivers/$gpu_driver" "$gpu_dev/driver"
        fi
    done
    case "$gpu_seed" in
        setup)
            printf '%s\n' "# Written by setup (github.com/mikelward/scripts): an earlier run's rule" \
                "$DISPLAY_GPU_RULE" > "$gpu_rules/80-display-gpu-awake.rules"
            ;;
        other)
            printf '%s\n' "# somebody's own rule" > "$gpu_rules/80-display-gpu-awake.rules"
            ;;
    esac
    # Records each privileged command, then runs it as-is or refuses it the
    # way sudo_or_warn reports a denial.
    if test "$gpu_sudo" = denied; then
        gpu_stub='sudo_or_warn() { printf "%s\n" "$*" >> "$GPU_CALLS"; warn "sudo ${1##*/}: permission denied"; return 1; }'
    else
        gpu_stub='sudo_or_warn() { printf "%s\n" "$*" >> "$GPU_CALLS"; "$@"; }'
    fi

    set +e
    output="$(GPU_CALLS="$gpu_tmpdir/calls" SETUP_SYSFS="$gpu_sys" SETUP_UDEV_RULES="$gpu_rules" \
        sh -c "set -e
OS=$gpu_os
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS has_system_battery display_gpu_rule_is_ours remove_display_gpu_rule keep_display_gpu_awake")
$gpu_stub
keep_display_gpu_awake
echo BOOTSTRAP_CONTINUED" 2>&1)"
    status=$?
    set -e
    calls=""
    if test -f "$gpu_tmpdir/calls"; then
        calls="$(cat "$gpu_tmpdir/calls")"
    fi
    gpu_rule_body=""
    if test -f "$gpu_rules/80-display-gpu-awake.rules"; then
        gpu_rule_body="$(cat "$gpu_rules/80-display-gpu-awake.rules")"
    fi
    gpu_controls="$(for gpu_dev in "$gpu_sys"/bus/pci/devices/*; do
        printf '%s=%s\n' "${gpu_dev##*/}" "$(cat "$gpu_dev/power/control")"
    done)"
    rm -rf "$gpu_tmpdir"
}

assert_display_gpu_rule_written() {
    case "$gpu_rule_body" in
        *"$DISPLAY_GPU_RULE"*) ;;
        *)
            echo "  FAIL: the udev rule isn't the one that holds the display card powered"
            echo "  rule file: $gpu_rule_body"
            TEST_FAILED=1
            return 1
            ;;
    esac
}

assert_no_display_gpu_rule() {
    if test -n "$gpu_rule_body"; then
        echo "  FAIL: a udev rule was written: $gpu_rule_body"
        TEST_FAILED=1
        return 1
    fi
}

# The WX 3200 case: an amdgpu card driving the screens, with its HDMI audio
# function beside it, which isn't a display controller and stays as it was.
test_display_gpu_amd_desktop_held_powered() {
    run_keep_display_gpu_awake "0000:61:00.0/amdgpu/0x030000/auto 0000:61:00.1/snd_hda_intel/0x040300/auto"
    assert_status 0 &&
    assert_output_contains "BOOTSTRAP_CONTINUED" &&
    assert_output_contains "display card at 0000:61:00.0 (amdgpu) powered" &&
    assert_eq "$gpu_controls" "0000:61:00.0=on
0000:61:00.1=auto" &&
    assert_display_gpu_rule_written
}

# The drivers that power a card down only in a hybrid laptop are held too, as
# a backstop against a changed default.
test_display_gpu_other_drivers_held_powered() {
    for gpu_test_driver in radeon nouveau nvidia; do
        run_keep_display_gpu_awake "0000:01:00.0/$gpu_test_driver/0x030000/auto"
        assert_status 0 &&
        assert_eq "$gpu_controls" "0000:01:00.0=on" &&
        assert_display_gpu_rule_written ||
            { echo "  (driver $gpu_test_driver)"; return 1; }
    done
}

# A desktop can start on its built-in graphics and drive its screens from an
# AMD card; the AMD card is held all the same, and the Intel one left be.
test_display_gpu_desktop_second_card_held() {
    run_keep_display_gpu_awake "0000:00:02.0/i915/0x030000/auto 0000:01:00.0/amdgpu/0x030000/auto"
    assert_status 0 &&
    assert_eq "$gpu_controls" "0000:00:02.0=auto
0000:01:00.0=on" &&
    assert_display_gpu_rule_written
}

# A hybrid laptop's cards look like a desktop's, and a muxed one can even
# start on its discrete card; a machine with its own battery keeps its power
# saving whatever its cards say.
test_display_gpu_laptop_left_alone() {
    run_keep_display_gpu_awake "0000:00:02.0/i915/0x030000/auto 0000:01:00.0/amdgpu/0x030000/auto" \
        ok debian "AC/Mains/- BAT0/Battery/-"
    assert_status 0 &&
    assert_eq "$calls" "" &&
    assert_eq "$gpu_controls" "0000:00:02.0=auto
0000:01:00.0=auto" &&
    assert_no_display_gpu_rule
}

# A wireless mouse's battery is the mouse's, not the machine's.
test_display_gpu_mouse_battery_still_a_desktop() {
    run_keep_display_gpu_awake "0000:61:00.0/amdgpu/0x030000/auto" ok debian "hidpp_battery_0/Battery/Device"
    assert_status 0 &&
    assert_eq "$gpu_controls" "0000:61:00.0=on" &&
    assert_display_gpu_rule_written
}

# An earlier run's rule goes once the machine stops qualifying: a laptop whose
# battery wasn't reported then, or a card swapped for one that needs no help.
test_display_gpu_stale_rule_removed() {
    run_keep_display_gpu_awake "0000:01:00.0/amdgpu/0x030000/auto" ok debian "BAT0/Battery/-" setup
    assert_status 0 &&
    assert_output_contains "this machine runs on a battery" &&
    assert_no_display_gpu_rule || { echo "  (laptop)"; return 1; }
    run_keep_display_gpu_awake "0000:00:02.0/i915/0x030000/auto" ok debian "" setup
    assert_status 0 &&
    assert_output_contains "no display card here powers itself down" &&
    assert_no_display_gpu_rule || { echo "  (Intel card)"; return 1; }
}

# A file at the rule's path that setup didn't write is somebody else's: not
# removed where no card qualifies, and not overwritten where one does -- though
# the card is still held for this boot, and the warning says why not after.
test_display_gpu_foreign_rule_left_alone() {
    run_keep_display_gpu_awake "0000:00:02.0/i915/0x030000/auto" ok debian "" other
    assert_status 0 &&
    assert_calls_lack "rm" &&
    assert_eq "$gpu_rule_body" "# somebody's own rule" || { echo "  (Intel card)"; return 1; }
    run_keep_display_gpu_awake "0000:61:00.0/amdgpu/0x030000/auto" ok debian "" other
    assert_status 0 &&
    assert_calls_lack "80-display-gpu-awake.rules" &&
    assert_eq "$gpu_rule_body" "# somebody's own rule" &&
    assert_eq "$gpu_controls" "0000:61:00.0=on" &&
    assert_output_contains "setup didn't write it, so the display card can power itself down again after a reboot" ||
