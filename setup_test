test_retired_tools_pruned_only_on_purge_obsolete_after_the_clone() {
    files=$(grep -n '^    install_file_managers$' "$SETUP" | cut -d: -f1)
    prune=$(grep -n '^    prune_retired_tools$' "$SETUP" | cut -d: -f1)
    gate=$((prune - 1))
    if test -z "$files" || test -z "$prune" || test "$prune" -le "$files"; then
        echo "  FAIL: prune_retired_tools runs before the clone's install_file_managers"
        TEST_FAILED=1
    elif test "$(sed -n "${gate}p" "$SETUP")" != 'if test "$PURGE_OBSOLETE" = yes; then'; then
        echo "  FAIL: prune_retired_tools isn't gated on --purge-obsolete"
        TEST_FAILED=1
    fi
}

# Only the packages the query reports installed reach apt-get purge: swaync
