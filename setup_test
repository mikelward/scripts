        "$(canonical_remote 'https://ghe.corp.example.com/mikelward/scripts')" &&
    assert_eq "$(canonical_remote 'git@ghe.corp.example.com:mikelward/scripts.git')" \
        'git@ghe.corp.example.com:mikelward/scripts' &&
