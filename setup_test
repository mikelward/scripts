# Run install_shell_tools against a sandboxed HOME whose ~/.local/bin either
# runs binaries or kills them, as a managed Mac's policy does (exit 137).
#   $1  ok | killed: what running a binary from ~/.local/bin does
#   $2  santactl's mode, as write_mock_santactl takes it (default none)
# The sandbox starts with an atuin there that's killed when run, a carapace
# that runs, and a homepkg stub that records whether it was called. Leaves
# $lb_home for the assertions; the caller removes $lb_tmpdir.
run_local_bin_check() {
    lb_tmpdir="$(mktemp -d)"
    lb_home="$lb_tmpdir/home"
    mkdir -p "$lb_home/.local/bin" "$lb_tmpdir/scripts"
    printf '#!/bin/sh\nkill -9 $$\n' > "$lb_tmpdir/killed"
    printf '#!/bin/sh\nexit 0\n' > "$lb_tmpdir/ok"
    printf '#!/bin/sh\necho "homepkg $*" >> "%s/calls"\n' "$lb_tmpdir" > "$lb_tmpdir/scripts/homepkg"
    chmod +x "$lb_tmpdir/killed" "$lb_tmpdir/ok" "$lb_tmpdir/scripts/homepkg"
    mkdir -p "$lb_tmpdir/bin"
    write_mock_santactl "$lb_tmpdir/bin" "${2:-none}"
    cp "$lb_tmpdir/killed" "$lb_home/.local/bin/atuin"
    cp "$lb_tmpdir/ok" "$lb_home/.local/bin/carapace"
    # carapace runs, so neither is "missing" there: move atuin aside for the
    # case where binaries run, so the install has something to do.
    if test "$1" = ok && test "${2:-none}" = none; then
        rm -f "$lb_home/.local/bin/atuin"
    fi
    set +e
    output="$(HOME="$lb_home" LOCAL_BIN_PROBE="$lb_tmpdir/$1" PATH="$lb_tmpdir/bin:/usr/bin:/bin" bash -c "SCRIPTS_DIR='$lb_tmpdir/scripts'
OS=macos
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS santa_lockdown cli_tools_blocked local_bin_blocked remove_blocked_shell_tools missing_shell_tools install_shell_tools")
install_shell_tools
install_shell_tools
echo \"blocked=\$LOCAL_BIN_BLOCKED\"" 2>&1)"
    status=$?
    set -e
    calls="$(cat "$lb_tmpdir/calls" 2>/dev/null)"
}

# On a machine that kills ~/.local/bin's binaries, setup installs nothing
# there and removes the shell tools it put there before, since the shell
# would start them and see them killed. It tells by running a copy of a
# system binary there, so nothing looks for a particular company.
test_local_bin_blocked_skips_and_cleans_up() {
    run_local_bin_check killed
    assert_status 0 &&
    assert_output_contains "this machine doesn't run binaries from ~/.local/bin (a copy of $lb_tmpdir/killed there exited 137); installing nothing there" &&
    assert_output_contains "Skipping atuin and carapace: this machine doesn't run binaries" &&
    assert_output_contains "Removing ~/.local/bin/atuin, which this machine won't run" &&
    assert_output_contains "blocked=yes" &&
    assert_eq "$calls" "" &&
    assert_eq "$(test -e "$lb_home/.local/bin/atuin" && echo there || echo gone)" "gone" &&
    assert_eq "$(test -e "$lb_home/.local/bin/carapace" && echo there || echo gone)" "there" &&
    assert_eq "$(ls -A "$lb_home/.local/bin" | grep -c setup-probe)" "0" &&
    # Checked once a run, so the second call says nothing more.
    assert_eq "$(printf '%s\n' "$output" | grep -c "installing nothing there")" "1"
    rm -rf "$lb_tmpdir"
}

# Under Lockdown the shell tools an earlier run put there go too, if they
# no longer run, though the probe isn't needed to know to skip installs.
test_lockdown_cleans_up_shell_tools() {
