# --- Lightspeed receiver reset ---

# Run install_lightspeed_reset against a fake udev rules directory and
# libexec, with a PATH of just the tools it uses.
#   $1  how sudo goes (default ok): ok | denied
#   $2  the OS (default debian)
#   $3  what's already there (default none): none | setup (an earlier run's
#       rule and script) | other (somebody else's rule at the same path)
#   $4  whether systemd-run is on the PATH (default yes): yes | no
#   $5  CROSTINI (default 0)
# Leaves $calls set to the privileged commands asked for, $ls_rule_body to
# the rule file (empty when none), $ls_script_body to the installed script
# (empty when none), and $ls_systemd_run to the systemd-run it should name.
run_install_lightspeed_reset() {
    ls_sudo="${1:-ok}"
    ls_os="${2:-debian}"
    ls_seed="${3:-none}"
    ls_has_run="${4:-yes}"
    ls_crostini="${5:-0}"
    ls_tmpdir="$(mktemp -d)"
    ls_rules="$ls_tmpdir/rules"
    ls_libexec="$ls_tmpdir/libexec"
    ls_bin="$ls_tmpdir/bin"
    mkdir -p "$ls_rules" "$ls_bin"
    for ls_tool in sh grep cmp tee cat mkdir rm mktemp sed awk tr chmod cp dirname; do
        ln -s "$(command -v "$ls_tool")" "$ls_bin/$ls_tool"
    done
    # GNU install, which setup runs it as: macOS's -D is something else.
    cat > "$ls_bin/install" <<'MOCK'
#!/bin/sh
test "$1" = -D && test "$2" = -m || { echo "install: unexpected $*" >&2; exit 2; }
mkdir -p "$(dirname "$5")" && cp "$4" "$5" && chmod "$3" "$5"
MOCK
    chmod +x "$ls_bin/install"
    ls_systemd_run="$ls_bin/systemd-run"
    if test "$ls_has_run" = yes; then
        printf '#!/bin/sh\nexit 0\n' > "$ls_systemd_run"
        chmod +x "$ls_systemd_run"
    fi
    case "$ls_seed" in
        setup)
            printf '%s\n' "# Written by setup (github.com/mikelward/scripts): an earlier run's rule" \
                > "$ls_rules/80-lightspeed-reset.rules"
            mkdir -p "$ls_libexec"
            cp "$SCRIPT_DIR/lightspeed-reset" "$ls_libexec/lightspeed-reset"
            ;;
        other)
            printf '%s\n' "# somebody's own rule" > "$ls_rules/80-lightspeed-reset.rules"
            ;;
    esac
    if test "$ls_sudo" = denied; then
        ls_stub='sudo_or_warn() { printf "%s\n" "$*" >> "$LS_CALLS"; warn "sudo ${1##*/}: permission denied"; return 1; }'
    else
        ls_stub='sudo_or_warn() { printf "%s\n" "$*" >> "$LS_CALLS"; "$@"; }'
    fi

    set +e
    output="$(PATH="$ls_bin" LS_CALLS="$ls_tmpdir/calls" SETUP_UDEV_RULES="$ls_rules" \
        SETUP_LIBEXEC="$ls_libexec" "$ls_bin/sh" -c "set -e
OS=$ls_os
CROSTINI=$ls_crostini
SCRIPTS_DIR='$SCRIPT_DIR'
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS install_lightspeed_reset")
$ls_stub
install_lightspeed_reset
echo BOOTSTRAP_CONTINUED" 2>&1)"
    status=$?
    set -e
    calls=""
    if test -f "$ls_tmpdir/calls"; then
        calls="$(cat "$ls_tmpdir/calls")"
    fi
    ls_rule_body=""
    if test -f "$ls_rules/80-lightspeed-reset.rules"; then
        ls_rule_body="$(cat "$ls_rules/80-lightspeed-reset.rules")"
    fi
    ls_script_body=""
    if test -f "$ls_libexec/lightspeed-reset"; then
        ls_script_body="$(cat "$ls_libexec/lightspeed-reset")"
    fi
    rm -rf "$ls_tmpdir"
}

# The rule runs the installed copy, through systemd-run, for the receiver.
assert_lightspeed_rule_written() {
    ls_want="ACTION==\"add\", SUBSYSTEM==\"usb\", ENV{DEVTYPE}==\"usb_device\", ATTR{idVendor}==\"046d\", ATTR{idProduct}==\"c543\", RUN+=\"$ls_systemd_run --no-block --collect --quiet $ls_libexec/lightspeed-reset \$devpath\""
    case "$ls_rule_body" in
        *"$ls_want"*) ;;
        *)
            echo "  FAIL: the udev rule doesn't run lightspeed-reset for the receiver"
            echo "  rule file: $ls_rule_body"
            TEST_FAILED=1
            return 1
            ;;
    esac
}

test_lightspeed_reset_installed() {
    run_install_lightspeed_reset
