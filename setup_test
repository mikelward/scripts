# Run sudo_up_front on OS $1 with SUDO $2 against a mock sudo that records
# its arguments; sudo -n true succeeds when HARNESS_SUDO_CACHED=yes. Then
# end_up_front, which must stop the refresh.
run_sudo_up_front() {
    suo_tmpdir="$(mktemp -d)"
    mkdir -p "$suo_tmpdir/bin"
    cat > "$suo_tmpdir/bin/sudo" <<MOCK
#!/bin/sh
printf '%s\n' "sudo \$*" >> "$suo_tmpdir/calls"
test "\$*" != "-n true" || test "${HARNESS_SUDO_CACHED:-no}" = yes
MOCK
    chmod +x "$suo_tmpdir/bin/sudo"
    set +e
    output="$(PATH="$suo_tmpdir/bin:$PATH" sh -c "set -e
OS=$1
SUDO=$2
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS $UP_FRONT_FUNCTIONS")
sudo_up_front
refresh=\${SUDO_REFRESH_PID:-}
end_up_front
if test -n \"\$refresh\"; then
    wait \"\$refresh\" 2>/dev/null || true
    kill -0 \"\$refresh\" 2>/dev/null || echo REFRESH_STOPPED
fi
echo BOOTSTRAP_CONTINUED" </dev/null 2>&1)"
    status=$?
    set -e
    calls="$(cat "$suo_tmpdir/calls" 2>/dev/null)"
    rm -rf "$suo_tmpdir"
}

