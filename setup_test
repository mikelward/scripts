test_zsh_autosuggestions_clone_on_no_root_path() {
    zas_branch=$(awk '
        /^elif test "\$ROOT" = no; then$/ { inside = 1; next }
        inside && /^(elif|else|fi)/ { inside = 0 }
        inside && /^    install_zsh_autosuggestions_home$/ { print "found" }
    ' "$SETUP")
    assert_eq "$zas_branch" found
}

