# Run install_go_pkg on a Mac whose uname -m is $1, against a go.dev whose
# release list is GO_JSON (below) and whose download's SHA-256 is $2, with
# the Go at /usr/local/go already at version $3 (none: no Go there). Leaves
# $calls the curl, shasum and installer runs, and the output ends with GO's
# value.
GO_JSON='[
 {
  "version": "go1.27.4",
  "stable": true,
  "files": [
   {
    "filename": "go1.27.4.darwin-arm64.tar.gz",
    "os": "darwin",
    "arch": "arm64",
    "sha256": "tarball-sum",
    "kind": "archive"
   },
   {
    "filename": "go1.27.4.darwin-amd64.pkg",
    "os": "darwin",
    "arch": "amd64",
    "sha256": "amd64-sum",
    "kind": "installer"
   },
   {
    "filename": "go1.27.4.darwin-arm64.pkg",
    "os": "darwin",
    "arch": "arm64",
    "sha256": "arm64-sum",
    "kind": "installer"
   }
  ]
 },
 {
  "version": "go1.26.9",
  "stable": true,
  "files": [
   {
    "filename": "go1.26.9.darwin-arm64.pkg",
    "sha256": "old-sum",
    "kind": "installer"
   }
  ]
 }
]'
run_go_pkg() {
    gp_tmpdir="$(mktemp -d)"
    gp_calls="$gp_tmpdir/calls"
    gp_bin="$(stub_path "$gp_tmpdir/bin" sh cat grep awk mktemp rm)"
    printf '%s' "$GO_JSON" > "$gp_tmpdir/list.json"
    cat > "$gp_bin/curl" <<MOCK
#!/bin/sh
printf '%s\\n' "curl \$*" >> "$gp_calls"
case "\$*" in
    *'?mode=json'*) test -z "${HARNESS_LIST_FAILS:-}" || { echo "curl: (6) Could not resolve host" >&2; exit 6; }; cat "$gp_tmpdir/list.json" ;;
    *' -o '*) shift 2; echo pkg > "\$1" ;;
esac
MOCK
    cat > "$gp_bin/shasum" <<MOCK
#!/bin/sh
printf '%s\\n' "shasum \$*" >> "$gp_calls"
echo "$2  \$3"
MOCK
    chmod +x "$gp_bin/curl" "$gp_bin/shasum"
    write_mock_uname "$gp_bin" "$1"
    if test -n "${HARNESS_PATH_GO:-}"; then
        printf '#!/bin/sh\necho go%s\n' "$HARNESS_PATH_GO" > "$gp_bin/go"
        chmod +x "$gp_bin/go"
    fi
    if test "$3" != none; then
        mkdir -p "$gp_tmpdir/usr-local-go/bin"
        printf '#!/bin/sh\necho go%s\n' "$3" > "$gp_tmpdir/usr-local-go/bin/go"
        chmod +x "$gp_tmpdir/usr-local-go/bin/go"
    fi
    set +e
    output="$(PATH="$gp_bin" GO_DL=https://go.example/dl GO_PKG_GO="$gp_tmpdir/usr-local-go/bin/go" \
        sh -c "set -e
GO=go
MIN_GO=1.21
UPGRADE=${HARNESS_UPGRADE:-no}
UPGRADE_FAILED=no
UPGRADE_STAMP='$gp_tmpdir/stamp'
sudo_or_warn() { printf '%s\\n' \"sudo \$*\" >> '$gp_calls'; test -z '${HARNESS_INSTALLER_FAILS:-}'; }
$(extract_functions "setup_color paint info detail warn note_problem go_at_least go_builds_vcs go_pkg_for fetch_go_pkg upgrade_failed update_go_pkg use_go_pkg install_go_pkg")
install_go_pkg
echo BOOTSTRAP_CONTINUED
echo GO=\$GO
echo UPGRADE_FAILED=\$UPGRADE_FAILED
echo PATH=\$PATH
