# Run each step that downloads a command-line tool on a Mac whose santactl
# is in $1's mode (as write_mock_santactl takes it): the release extras,
# atuin and carapace, lf, an Intel Mac's node, the --no-root tools, the
# homepkg env's upgrade, uv and fnm. homepkg and curl only record that they
# ran.
run_lockdown_downloads() {
    dl_tmpdir="$(mktemp -d)"
    dl_home="$dl_tmpdir/home"
    mkdir -p "$dl_home/.local/share/homepkg/env" "$dl_tmpdir/scripts"
    dl_bin="$(stub_path "$dl_tmpdir/bin" sh grep cat mkdir cp rm mktemp)"
    write_mock_santactl "$dl_bin" "$1"
    write_mock_uname "$dl_bin" x86_64
    printf '#!/bin/sh\necho "homepkg $*" >> "%s/calls"\n' "$dl_tmpdir" > "$dl_tmpdir/scripts/homepkg"
    printf '#!/bin/sh\necho "curl $*" >> "%s/calls"\n' "$dl_tmpdir" > "$dl_bin/curl"
    printf '#!/bin/sh\nexit 0\n' > "$dl_tmpdir/ok"
    chmod +x "$dl_tmpdir/scripts/homepkg" "$dl_bin/curl" "$dl_tmpdir/ok"
    set +e
    output="$(HOME="$dl_home" LOCAL_BIN_PROBE="$dl_tmpdir/ok" PATH="$dl_bin" sh -c "
OS=macos
NPM=yes
ROOT=yes
UPGRADE=yes
UPGRADE_FAILED=no
SCRIPTS_DIR='$dl_tmpdir/scripts'
$(extract_functions "setup_color paint info detail warn note_problem $QUIET_FUNCTIONS is_intel_mac local_bin_blocked remove_blocked_shell_tools system_jj set_extras_tools link_helix_runtime install_extras_release missing_shell_tools install_shell_tools lf_missing install_file_managers install_node_home install_home_tools upgrade_home_env install_uv install_fnm")
install_extras_release
install_shell_tools
install_file_managers
install_node_home
install_home_tools
upgrade_home_env
install_uv
install_fnm
echo BOOTSTRAP_CONTINUED" 2>&1)"
    status=$?
    set -e
    calls="$(cat "$dl_tmpdir/calls" 2>/dev/null)"
    rm -rf "$dl_tmpdir"
}

