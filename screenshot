#!/bin/sh
#
# Takes a screenshot on Wayland (grim, slurp, wl-copy), copies it to the
# clipboard as PNG and saves it to ~/Pictures/Screenshots. tide's Print
# bindings run it. Wayland and GNU mktemp only; the X11 scrot version is gone.
#
# A notification says when the shot is there: a full ultrawide shot takes a
# moment, and the clipboard is otherwise silent. It shows the shot and offers
# Open, Annotate (satty, where installed) and Delete; the script returns at
# once, and a background child waits for the choice. Light PNG compression
# (grim -l 1) keeps that moment short. Canceling a region with Esc takes no
# shot and says nothing; slurp says "selection cancelled" then, so any other
# slurp failure is reported. Every other failure is a critical notification
# naming the step and its error, since a key binding has no terminal.

scriptname=${0##*/}

usage() {
    cat <<EOF >&2
Usage: $scriptname [-d <delay>] [-h] [-s | -o <output> | -r | -w | -g <geometry>]
       $scriptname [--delay <delay>] [--help]
                  [--screen | --output <output> | --region | --window |
                   --window-id <stableId> | --geometry <geometry>]

Copies the focused monitor (the default), a named one, a region picked with
slurp, the focused window or one named by its Hyprland stableId, or the
rectangle 'X,Y WxH' to the clipboard as PNG, and saves it as
~/Pictures/Screenshots/YYYY-MM-DD_HH-MM-SS.png (-2, -3 and so on for a
second shot in the same second).
EOF
}

fail() {
    notify-send -a Screenshot -u critical 'Screenshot failed' "$1"
    exit 1
}

mode=screen
output=
named=
toplevel=
wanted=
picked=
geometry=
delay=0
while test $# -gt 0; do
    case "$1" in
        -d|--delay|-g|--geometry|-o|--output|--window-id)
            if test $# -lt 2; then
                echo "Option $1 requires an argument" >&2
                usage
                exit 2
            fi
            case "$1" in
                -d|--delay) delay=$2 ;;
                -o|--output) mode=screen; output=$2; named=1 ;;
                --window-id) mode=window; wanted=$2; picked=1 ;;
                *) mode=geometry; geometry=$2 ;;
            esac
            shift
            ;;
        --delay=*) delay=${1#*=} ;;
        --geometry=*) mode=geometry; geometry=${1#*=} ;;
        --output=*) mode=screen; output=${1#*=}; named=1 ;;
        -s|--screen) mode=screen; output=; named= ;;
        -r|--region) mode=region ;;
        --window-id=*) mode=window; wanted=${1#*=}; picked=1 ;;
        -w|--window) mode=window; wanted=; picked= ;;
        -h|--help) usage; exit 0 ;;
        *)
            echo "Invalid option $1" >&2
            usage
            exit 2
            ;;
    esac
    shift
done
if test "$mode" = geometry && test -z "$geometry"; then
    echo "--geometry needs a rectangle, like '0,0 800x600'" >&2
    usage
    exit 2
fi
# Only the mode that wins is checked: a later option overrides an earlier
# one, empty or not, as --screen overrides --output.
if test "$mode" = window && test -n "$picked" && test -z "$wanted"; then
    echo "--window-id needs a window's stableId, from hyprctl clients -j" >&2
    usage
    exit 2
fi
if test "$mode" = screen && test -n "$named" && test -z "$output"; then
    echo "--output needs a monitor name, like DP-1" >&2
    usage
    exit 2
fi

# The temporary files go on exit, even an interrupted one.
f=
e=
trap 'rm -f "$f" "$e"' EXIT
# A temporary file's path reaches the shell through a command substitution,
# and a signal to the process group in that window kills both ends with the
# file made and its name never recorded. dash can't block a signal, only
# ignore it, so each mktemp runs with them ignored; one landing there is
# dropped, and the run finishes as if it had come a moment later.
trap '' HUP INT TERM
e=$(mktemp 2>&1) || { m=$e; e=; fail "mktemp: $m"; }
trap 'exit 1' HUP INT TERM

sleep "$delay" 2>"$e" || fail "sleep: $(cat "$e")"

case "$mode" in
    screen)
        # The monitor the focus is on, unless one was named (tide's launcher
        # names the one it opened on, so closing it can't move the shot).
        if test -z "$output"; then
            monitors=$(hyprctl monitors -j 2>"$e") || fail "hyprctl: $(cat "$e")"
            output=$(printf '%s\n' "$monitors" \
                | jq -r 'first(.[] | select(.focused) | .name) // ""' 2>"$e") \
                || fail "jq: $(cat "$e")"
            test -n "$output" || fail "no focused monitor"
        fi
        ;;
    region)
        if ! geometry=$(slurp 2>"$e"); then
            case $(cat "$e") in
                *cancelled*) exit 0 ;;
            esac
            fail "slurp: $(cat "$e")"
        fi
        ;;
    window)
        # A window named by its stableId (tide's launcher records the one it
        # opened over) is looked up where it is now. If it has closed, or
        # isn't on screen (its workspace isn't showing on any monitor, or it
        # is hidden), the focused window is the next best thing, and stderr
        # says so: grim -T can wait on a window that isn't shown until it is.
        window=
        if test -n "$wanted"; then
            clients=$(hyprctl clients -j 2>"$e") || fail "hyprctl: $(cat "$e")"
            window=$(printf '%s\n' "$clients" \
                | jq -c --arg id "$wanted" 'first(.[] | select((.stableId // "" | tostring) == $id)) // empty' 2>"$e") \
                || fail "jq: $(cat "$e")"
            if test -z "$window"; then
                echo "$scriptname: window $wanted is gone; taking the focused window" >&2
            else
                monitors=$(hyprctl monitors -j 2>"$e") || fail "hyprctl: $(cat "$e")"
                shown=$(printf '%s\n' "$window" \
                    | jq -r --argjson m "$monitors" \
                        '[$m[] | .activeWorkspace.id, .specialWorkspace.id] as $ws
                         | if .hidden != true and .mapped != false and (.workspace.id as $w | $ws | index($w)) then "yes" else "" end' 2>"$e") \
                    || fail "jq: $(cat "$e")"
                if test -z "$shown"; then
                    echo "$scriptname: window $wanted isn't on screen; taking the focused window" >&2
                    window=
                fi
            fi
        fi
        # An empty workspace has no active window: hyprctl prints {} then.
        if test -z "$window"; then
            window=$(hyprctl activewindow -j 2>"$e") || fail "hyprctl: $(cat "$e")"
        fi
        geometry=$(printf '%s\n' "$window" \
            | jq -r 'if .at then "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])" else "" end' 2>"$e") \
            || fail "jq: $(cat "$e")"
        toplevel=$(printf '%s\n' "$window" | jq -r '.stableId // "" | tostring' 2>"$e") \
            || fail "jq: $(cat "$e")"
        if test -z "$geometry"; then
            notify-send -a Screenshot -t 2000 'No window to screenshot'
            exit 0
        fi
        ;;
esac

# The name is the moment of the shot, not of the save.
stamp=$(date +%Y-%m-%d_%H-%M-%S 2>"$e") || fail "date: $(cat "$e")"
# The shot is taken into a hidden file beside where it's saved, so naming it
# is a hard link: atomic, refused for a name anything at all already has (a
# file, a symlink, dangling or not, a FIFO), and the name only ever appears
# on a complete shot. noclobber is not that: it refuses only regular files,
# and an open of a FIFO under it succeeds. -T (GNU) because without it a
# directory, or a symlink to one, at the name takes the link inside it.
dir=$HOME/Pictures/Screenshots
mkdir -p "$dir" 2>"$e" || fail "mkdir: $(cat "$e")"
trap '' HUP INT TERM
f=$(mktemp -p "$dir" .screenshot-XXXXXX.png 2>&1) || { m=$f; f=; fail "mktemp: $m"; }
trap 'exit 1' HUP INT TERM
case "$mode" in
    screen)
        grim -l 1 -o "$output" "$f" 2>"$e" || fail "grim: $(cat "$e")"
        ;;
    window)
        # -T captures the window's own contents, even under a popup. It
        # needs grim 1.5 and a compositor with toplevel capture; failing
        # that, the window's rectangle is the next best thing, and stderr
        # (which tide's launcher logs) says why it was used. It is bounded,
        # because a capture of a window that isn't being drawn can wait for
        # it indefinitely (hyprwm/Hyprland discussion 13710), and a hung
        # key binding is worse than a rectangle.
        if test -z "$toplevel"; then
            echo "$scriptname: the window has no stableId; taking its rectangle" >&2
        elif timeout 5 grim -l 1 -T "$toplevel" "$f" 2>"$e"; then
            geometry=
        else
            status=$?
            if test "$status" -eq 124; then
                why="timed out after 5s"
            else
                why=$(cat "$e")
            fi
            echo "$scriptname: grim -T: $why; taking the window's rectangle" >&2
        fi
        if test -n "$geometry"; then
            grim -l 1 -g "$geometry" "$f" 2>"$e" || fail "grim: $(cat "$e")"
        fi
        ;;
    *)
        grim -l 1 -g "$geometry" "$f" 2>"$e" || fail "grim: $(cat "$e")"
        ;;
esac

# Saved before it's copied, so a clipboard failure loses no shot. A second
# shot in the same second takes -2, then -3, and nothing is overwritten.
out=$dir/$stamp.png
n=1
while ! ln -T "$f" "$out" 2>"$e"; do
    # Taken is the one failure that means "try the next name": by anything,
    # a dangling symlink included, which test -e alone would call free.
    # Nothing there now can mean it was taken and has since gone (a Delete
    # racing this shot), so the name gets one more try. A second failure
    # with nothing there is a real error, and ends the loop.
    if ! test -e "$out" && ! test -L "$out"; then
        ln -T "$f" "$out" 2>"$e" && break
        test -e "$out" || test -L "$out" || fail "saving $out: $(cat "$e")"
    fi
    n=$((n + 1))
    out=$dir/$stamp-$n.png
done

# stderr goes to a file, not $(...): wl-copy stays running in the background
# to serve the paste, and would hold a pipe open.
wl-copy --type image/png < "$f" 2>"$e" || fail "wl-copy: $(cat "$e")"

# The notification waits for a choice, so it runs in the background and the
# key binding returns now. Its stdout is the chosen action's name; stderr
# stays the caller's, which also keeps a caller reading it waiting until the
# choice is made, as the tests do.
# The thumbnail is a file: URI, so every byte of the path but the unreserved
# ones and / is percent-encoded: a # or ? in $HOME would otherwise end the
# path early.
uri=file://$(printf '%s' "$out" | od -An -v -tx1 | LC_ALL=C awk '
    BEGIN { for (i = 0; i < 16; i++) hex[substr("0123456789abcdef", i + 1, 1)] = i }
    {
        for (i = 1; i <= NF; i++) {
            c = sprintf("%c", hex[substr($i, 1, 1)] * 16 + hex[substr($i, 2, 1)])
            if (c ~ /[A-Za-z0-9._~\/-]/) printf "%s", c
            else printf "%%%s", toupper($i)
        }
    }')
# Annotate only where satty is installed: not every distro packages it, and
# an action that can only fail is worse than none.
annotate=
if command -v satty >/dev/null 2>&1; then
    annotate=annotate=Annotate
fi
(
    action=$(notify-send -a Screenshot -h "string:image-path:$uri" \
        -A open=Open ${annotate:+-A "$annotate"} -A delete=Delete \
        'Screenshot copied' "Saved as ${out##*/}")
    case "$action" in
        open) what='xdg-open' ;;
        annotate) what='satty' ;;
        delete) what='rm' ;;
        # Dismissed, timed out, or notify-send itself failed: there's no
        # channel left to report the last on.
        *) exit 0 ;;
    esac
    # The action's error is kept in a variable, not a file: a satty left open
    # can be interrupted long after the script has gone, and a file would
    # need a trap, and a window where its path isn't recorded yet.
    case "$action" in
        open) err=$(xdg-open "$out" 2>&1 >/dev/null) ;;
        annotate) err=$(satty --filename "$out" 2>&1 >/dev/null) ;;
        delete) err=$(rm "$out" 2>&1 >/dev/null) ;;
    esac
    status=$?
    if test "$status" -ne 0; then
        notify-send -a Screenshot -u critical 'Screenshot failed' "$what: $err"
    fi
    exit "$status"
) >/dev/null &
