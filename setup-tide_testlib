#!/bin/bash
# The harness setup-tide_test sources: runs setup-tide against a throwaway
# HOME, logind dir and dconf, with a fake tide installer, and sudo, git,
# install, stat and curl mocked. Each mock logs its argv to $CALLS.

# shellcheck disable=SC2034  # what it sets, the tests that source it read
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$SCRIPT_DIR/setup-tide"
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0
umask 022

setup() {
    T="$(mktemp -d)"
    CALLS="$T/calls"
    mkdir -p "$T/bin" "$T/home" "$T/logind"
    # tide's installer logs its arguments and what this hands it, adds a
    # warning to setup's list with \$FAKE_TIDE_SETUP_WARNS, and exits
    # \$FAKE_TIDE_SETUP_EXIT.
    cat > "$T/fake-tide-setup" <<MOCK
#!/bin/sh
printf "%s\\n" "tide-setup \$*" >> "$CALLS"
printf "%s\\n" "tide-setup env: SETUP_COMMAND=\$SETUP_COMMAND SETUP_APT_RETRY_NAME=\$SETUP_APT_RETRY_NAME GITHUB_PREFIX=\$GITHUB_PREFIX" >> "$CALLS"
test -n "\$SETUP_PROBLEMS" || echo "tide-setup: no SETUP_PROBLEMS" >> "$CALLS"
if test -n "\$FAKE_TIDE_SETUP_WARNS"; then
    echo "Warning: \$FAKE_TIDE_SETUP_WARNS" >&2
    echo "Warning: \$FAKE_TIDE_SETUP_WARNS" >> "\$SETUP_PROBLEMS"
fi
exit "\${FAKE_TIDE_SETUP_EXIT:-0}"
MOCK
    chmod +x "$T/fake-tide-setup"
    # sudo runs the command, so rm and the rest really happen (on $T paths).
    # \$FAKE_LN_FAILS makes linking a command onto PATH fail. \$FAKE_RM_KEEPS
    # makes rm remove everything but the file it names, then fail.
    # \$FAKE_INSTALL_FAILS makes installing to the path it names fail.
    # Another user can't run the files in \$FAKE_USER_NOEXEC, or read those in
    # \$FAKE_USER_NOREAD, as the loader would for them. A VAR=value before
    # the command is set for it, unless \$FAKE_SUDO_NO_SETENV stands for a
    # sudo rule that won't.
    cat > "$T/bin/sudo" <<MOCK
#!/bin/sh
printf "%s\\n" "sudo \$*" >> "$CALLS"
while case "\$1" in *=*) true ;; *) false ;; esac; do
    if test -n "\$FAKE_SUDO_NO_SETENV"; then
        echo "sudo: sorry, you are not allowed to set the following environment variables: \${1%%=*}" >&2
        exit 1
    fi
    export "\$1"
    shift
done
# -u USER runs the command as this user.
if test "\$1" = -u; then
    shift 2
    # sudo's reset environment has no runtime directory.
    unset XDG_RUNTIME_DIR
    if test "\$1" = test && test "\$2" = -x; then
        case " \$FAKE_USER_NOEXEC " in *" \$3 "*) exit 1 ;; esac
    fi
    FAKE_AS_USER=yes
    export FAKE_AS_USER
    exec "\$@"
fi
if test "\$1" = ln && test -n "\$FAKE_LN_FAILS"; then
    case "\$*" in *"$T/usr-local-bin/"*) exit 1 ;; esac
fi
if test "\$1" = install && test -n "\$FAKE_INSTALL_FAILS"; then
    case "\$*" in *" \$FAKE_INSTALL_FAILS") exit 1 ;; esac
fi
if test "\$1" = rm && test -n "\$FAKE_RM_KEEPS"; then
    shift
    for f; do
        case "\$f" in -*|*/"\$FAKE_RM_KEEPS") ;; *) rm -f "\$f" ;; esac
    done
    exit 1
fi
"\$@"
MOCK
    # git clone creates the checkout, its last argument, with tide's
    # installer in it (the fake below), or fails for a repository named in
    # \$FAKE_CLONE_FAILS; pull just logs, or fails with \$FAKE_PULL_FAILS.
    cat > "$T/bin/git" <<MOCK
#!/bin/sh
printf "%s\\n" "git \$*" >> "$CALLS"
# A url.insteadOf rule given in the environment (setup-tide's git_github).
i=0
while test "\$i" -lt "\${GIT_CONFIG_COUNT:-0}"; do
    eval "k=\\\$GIT_CONFIG_KEY_\$i v=\\\$GIT_CONFIG_VALUE_\$i"
    printf "%s\\n" "git config: \$k=\$v" >> "$CALLS"
    i=\$((i + 1))
done
if test "\$1" = clone; then
    for last; do :; done
    case " \$* " in
        *"\${FAKE_CLONE_FAILS:-no such repo}"*)
            echo "fatal: repository not found" >&2
            exit 128
            ;;
    esac
    mkdir -p "\$last/.git" "\$last/install"
    cp "$T/fake-tide-setup" "\$last/install/tide-setup"
fi
if test "\$3" = pull && test -n "\$FAKE_PULL_FAILS"; then
    echo "fatal: unable to access 'https://example.com/tide.git/': Could not resolve host: example.com" >&2
    exit 1
fi
# A checkout on its default branch.
if test "\$3" = symbolic-ref; then
    echo origin/main
fi
if test "\$3" = rev-parse && test "\$4" = --abbrev-ref; then
    echo main
fi
MOCK
    # install drops -o and -g, which only root can give to another user.
    cat > "$T/bin/install" <<'MOCK'
#!/bin/sh
skip=
for arg; do
    shift
    if test -n "$skip"; then
        skip=
        continue
    fi
    case "$arg" in
        -o | -g) skip=1; continue ;;
    esac
    set -- "$@" "$arg"
done
exec /usr/bin/install "$@"
MOCK
    real_stat=$(command -v stat)
    cat > "$T/bin/stat" <<MOCK
#!/bin/sh
fmt=\$2
shift 2
test "\$1" != -- || shift
me=\$(id -u)
status=0
for f; do
    if test "\$f" != "$T"; then
        case "$T/" in
            "\${f%/}/"*)
                printf "%s\\n" "\$fmt" | sed -e "s/%u/0/" -e "s/%a/755/" -e "s/%F/directory/" -e "s|%n|\$f|"
                continue
                ;;
        esac
    fi
    if ! line=\$($real_stat -c "\$fmt" -- "\$f"); then
        status=1
        continue
    fi
    uid=\${line%% *}
    case "\$line" in
        *" "*) rest=" \${line#* }" ;;
        *) rest= ;;
    esac
    test "\$uid" != "\$me" || uid=0
    for entry in \$FAKE_OWNER; do
        case "\$f" in
            "\${entry#*:}" | "\${entry#*:}"/*) uid=\${entry%%:*} ;;
        esac
    done
    printf "%s%s\\n" "\$uid" "\$rest"
done
exit \$status
MOCK
    cat > "$T/bin/dconf" <<MOCK
#!/bin/sh
printf "%s\\n" "dconf \$*" >> "$CALLS"
MOCK
    # curl fetches a site icon: a PNG's first bytes, or an HTML page with
    # \$FAKE_CURL_NOT_PNG; it fails with \$FAKE_CURL_FAILS. Nerd Fonts'
    # release is \$FAKE_NERD_TARBALL. No test reaches the network.
    cat > "$T/bin/curl" <<MOCK
#!/bin/sh
printf "%s\\n" "curl \$*" >> "$CALLS"
test -z "\$FAKE_CURL_FAILS" || exit 22
out=
url=
while test \$# -gt 0; do
    test "\$1" != --output || out=\$2
    url=\$1
    shift
done
# Nerd Fonts' release: the tarball in \$FAKE_NERD_TARBALL.
case "\$url" in
    *NerdFontsSymbolsOnly.tar.xz)
        test -n "\$FAKE_NERD_TARBALL" || exit 22
        cp "\$FAKE_NERD_TARBALL" "\$out"
        exit
        ;;
esac
if test -n "\$FAKE_CURL_NOT_PNG"; then
    printf "<html>" > "\$out"
else
    printf "\\211PNG\\r\\n" > "\$out"
fi
MOCK
    cat > "$T/bin/systemctl" <<MOCK
#!/bin/sh
printf "%s\\n" "systemctl \$*" >> "$CALLS"
MOCK
    chmod +x "$T"/bin/*
}

# checkout: a tide checkout already there, with its installer.
checkout() {
    mkdir -p "$T/src/tide/.git" "$T/src/tide/install"
    cp "$T/fake-tide-setup" "$T/src/tide/install/tide-setup"
}

teardown() {
    rm -rf "$T"
}

run() {
    set +e
    # DEFAULT_REPO=1 runs with no TIDE_REPO, for its default.
    _repo=TIDE_REPO=https://example.com/tide.git
    test -z "${DEFAULT_REPO:-}" || _repo=
    output=$(env -u TIDE_REPO ${_repo:+"$_repo"} HOME="$T/home" PATH="$T/bin:$PATH" SETUP_LOGIND_DIR="$T/logind" \
        XDG_CONFIG_HOME="$T/home/.config" XDG_DATA_HOME="$T/home/.local/share" XDG_STATE_HOME="$T/home/.local/state" \
        SETUP_LOG= SETUP_PROBLEMS= SETUP_SCRIPTS_DIR="$T/scripts" \
        SETUP_GDM_DEFAULTS="$T/no-gdm" SETUP_DCONF_DIR="$T/dconf" SETUP_DCONF_SHARE_PROFILE="$T/no-profile" \
        TIDE_DIR="$T/src/tide" \
        "$@" "$SCRIPT" "${ARGS[@]}" 2>&1)
    status=$?
    set -e
    calls=
    if test -f "$CALLS"; then
        calls=$(cat "$CALLS")
    fi
}

check() {
    name=$1
    shift
    TESTS_RUN=$((TESTS_RUN + 1))
    if "$@"; then
        TESTS_PASSED=$((TESTS_PASSED + 1))
    else
        TESTS_FAILED=$((TESTS_FAILED + 1))
        echo "FAIL: $name"
        echo "  output: $output"
        echo "  calls: $calls"
    fi
}

has() {
    case "$1" in *"$2"*) return 0 ;; esac
    return 1
}

lacks() {
    ! has "$1" "$2"
}

finish() {
    echo "$(basename "$0"): $TESTS_PASSED/$TESTS_RUN passed"
    test "$TESTS_FAILED" -eq 0
}
