#!/bin/bash
# The fakes' bodies are single-quoted on purpose: they expand when they run.
# shellcheck disable=SC2016
# Tests for screenshot: each mode shoots the right geometry, copies it as PNG
# and saves it under ~/Pictures/Screenshots with a notification whose actions
# open, annotate or delete it, Esc on a region is silent, every other failure
# is a critical notification naming the step with a nonzero exit, and no
# temporary file survives, even an interrupted run. Runs the real script
# against fake grim, slurp, wl-copy, notify-send, hyprctl, date, xdg-open and
# satty that log their calls, following the runenv_test conventions.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0

fake() {
  printf '#!/bin/sh\n%s\n' "$2" > "$BIN/$1"
  chmod +x "$BIN/$1"
}

setup() {
  TEST_TMPDIR="$(mktemp -d)"
  BIN="$TEST_TMPDIR/bin"
  SHOTTMP="$TEST_TMPDIR/tmp"
  CALLS="$TEST_TMPDIR/calls"
  SHOTHOME="$TEST_TMPDIR/home"
  SHOTS="$SHOTHOME/Pictures/Screenshots"
  mkdir -p "$BIN" "$SHOTTMP" "$SHOTHOME"
  : > "$CALLS"
  cp "$SCRIPT_DIR/screenshot" "$SCRIPT_DIR/screenshot-window" "$BIN/"
  fake grim 'echo "grim $*" >> "$CALLS"
test -z "$GRIM_FAILS" || { echo "no outputs" >&2; exit 1; }
test -z "$GRIM_KILLED" || { kill -TERM $PPID; exit 1; }
for a; do out=$a; done; echo png > "$out"'
  fake slurp 'test -z "$SLURP_CANCELS" || { echo "selection cancelled" >&2; exit 1; }
test -z "$SLURP_FAILS" || { echo "no layer shell" >&2; exit 1; }
echo "1,2 3x4"'
  fake wl-copy 'echo "wl-copy $* $(cat)" >> "$CALLS"
test -z "$WLCOPY_FAILS" || { echo "no seat" >&2; exit 1; }'
  # With actions, it answers with $NOTIFY_ACTION, as a click would.
  fake notify-send 'echo "notify-send $*" >> "$CALLS"
case " $* " in *" -A "*) test -z "$NOTIFY_ACTION" || echo "$NOTIFY_ACTION" ;; esac'
  fake date 'echo "${SHOT_TIME:-2026-10-04_12-00-00}"'
  fake xdg-open 'echo "xdg-open $*" >> "$CALLS"
test -z "$OPEN_FAILS" || { echo "no handler" >&2; exit 4; }'
  fake satty 'echo "satty $*" >> "$CALLS"
test -z "$SATTY_KILLED" || { kill -TERM $PPID; exit 1; }'
  # With $LN_VANISHED, the first link fails as if the name were taken and
  # then deleted; with $LN_FAILS, every link fails as on vfat.
  fake ln "if test -n \"\$LN_FAILS\"; then echo 'Operation not permitted' >&2; exit 1; fi
if test -n \"\$LN_VANISHED\" && ! test -e \"\$LN_VANISHED\"; then : > \"\$LN_VANISHED\"; echo 'File exists' >&2; exit 1; fi
exec $(command -v ln) \"\$@\""
  # With $MKTEMP_KILLED, a TERM reaches the script once the file exists but
  # before its name is back, as a signal to the process group would.
  fake mktemp "path=\$($(command -v mktemp) \"\$@\") || exit
echo \"\$path\"
test -z \"\$MKTEMP_KILLED\" || kill -TERM \$PPID"
  fake hyprctl 'test -z "$HYPRCTL_FAILS" || { echo "no socket" >&2; exit 1; }
printf "%s\n" "${ACTIVE_WINDOW:-{\"at\": [10, 20], \"size\": [300, 400]\}}"'
}

teardown() { rm -rf "$TEST_TMPDIR"; }

run() {
  set +e
  # $(...) also waits for the notification's background child, which keeps
  # stderr, so its action has run by the time this returns.
  output="$(env PATH="$BIN:$PATH" HOME="$SHOTHOME" CALLS="$CALLS" TMPDIR="$SHOTTMP" "${ENV[@]}" "$BIN/screenshot" "$@" 2>&1)"
  status=$?
  set -e
  calls=$(cat "$CALLS")
  # The shot is taken into a hidden file beside the saved ones, so that
  # counts as a temporary file too.
  leftovers=$(ls -A "$SHOTTMP"; if test -d "$SHOTS"; then find "$SHOTS" -maxdepth 1 -name '.screenshot-*'; fi)
}

fail_test() { echo "  FAIL: $1"; echo "  calls: $calls"; TEST_FAILED=1; }
assert_status() { test "$status" -eq "$1" || fail_test "expected exit $1, got $status ($output)"; }
assert_called() { case "$calls" in *"$1"*) ;; *) fail_test "expected a call with '$1'" ;; esac; }
assert_not_called() { case "$calls" in *"$1"*) fail_test "unexpected call with '$1'" ;; esac; }
assert_saved() { test "$(cat "$SHOTS/$1" 2>/dev/null)" = png || fail_test "$1 wasn't saved with the shot"; }
assert_clean() { test -z "$leftovers" || fail_test "temporary files left behind: $leftovers"; }

run_test() {
  TESTS_RUN=$((TESTS_RUN + 1))
  setup
  TEST_FAILED=
  ENV=()
  if "$2" && test -z "$TEST_FAILED"; then
    echo "ok $TESTS_RUN $1"; TESTS_PASSED=$((TESTS_PASSED + 1))
  else
    echo "not ok $TESTS_RUN $1"; TESTS_FAILED=$((TESTS_FAILED + 1))
  fi
  teardown
}

test_screen() {
  run
  assert_status 0
  assert_called "grim -l 1 $SHOTS/.screenshot-"
  assert_not_called "grim -l 1 -g"
  assert_called "wl-copy --type image/png png"
  assert_called "notify-send -a Screenshot -h string:image-path:file://$SHOTS/2026-10-04_12-00-00.png -A open=Open -A annotate=Annotate -A delete=Delete Screenshot copied Saved as 2026-10-04_12-00-00.png"
  assert_saved 2026-10-04_12-00-00.png
  assert_clean
}

test_same_second() {
  run
  run --region
  # A name taken by something else is skipped, never overwritten.
  echo mine > "$SHOTS/2026-10-04_12-00-00-3.png"
  run --window
  assert_status 0
  assert_saved 2026-10-04_12-00-00.png
  assert_saved 2026-10-04_12-00-00-2.png
  assert_saved 2026-10-04_12-00-00-4.png
  test "$(cat "$SHOTS/2026-10-04_12-00-00-3.png")" = mine || fail_test "an existing file was overwritten"
  assert_called "Saved as 2026-10-04_12-00-00-4.png"
}

test_dangling_symlink() {
  mkdir -p "$SHOTS"
  ln -s missing "$SHOTS/2026-10-04_12-00-00.png"
  run
  assert_status 0
  assert_saved 2026-10-04_12-00-00-2.png
  test -L "$SHOTS/2026-10-04_12-00-00.png" || fail_test "the symlink was replaced"
}

test_directory_name() {
  # Without ln -T, the link would go inside these rather than skip them.
  mkdir -p "$SHOTS/2026-10-04_12-00-00.png" "$TEST_TMPDIR/elsewhere"
  ln -s "$TEST_TMPDIR/elsewhere" "$SHOTS/2026-10-04_12-00-00-2.png"
  run
  assert_status 0
  assert_saved 2026-10-04_12-00-00-3.png
  test -z "$(find "$SHOTS/2026-10-04_12-00-00.png" "$TEST_TMPDIR/elsewhere" -mindepth 1)" || fail_test "a shot went inside a directory"
  assert_clean
}

test_name_vanished() {
  # The first try at the name fails as taken, but the name is gone by the
  # time the script looks: it takes that name, not the next.
  ENV=(LN_VANISHED="$TEST_TMPDIR/ln-seen")
  run
  assert_status 0
  assert_saved 2026-10-04_12-00-00.png
  test ! -e "$SHOTS/2026-10-04_12-00-00-2.png" || fail_test "the shot skipped a free name"
  assert_clean
}

test_no_hard_links() {
  # A filesystem without hard links fails every try; the script says so
  # rather than trying names forever.
  ENV=(LN_FAILS=1)
  run
  assert_status 1
  assert_called "Screenshot failed saving $SHOTS/2026-10-04_12-00-00.png: Operation not permitted"
  assert_not_called "wl-copy"
  assert_clean
}

test_unsavable() {
  # A file where the directory should be: mkdir -p can't make it.
  mkdir -p "$SHOTHOME/Pictures"
  : > "$SHOTS"
  run
  assert_status 1
  assert_called "Screenshot failed mkdir: "
  assert_not_called "wl-copy"
  assert_clean
}

test_unwritable() {
  mkdir -p "$SHOTS"
  chmod a-w "$SHOTS"
  run
  chmod u+w "$SHOTS"
  if test "$(id -u)" -eq 0; then
    # root writes anyway; nothing to test.
    return 0
  fi
  assert_status 1
  assert_called "Screenshot failed mktemp: "
  assert_not_called "wl-copy"
  assert_clean
}

test_fifo() {
  # noclobber would open this and write the shot into the pipe, or block.
  mkdir -p "$SHOTS"
  mkfifo "$SHOTS/2026-10-04_12-00-00.png"
  run
  assert_status 0
  test -p "$SHOTS/2026-10-04_12-00-00.png" || fail_test "the FIFO was replaced"
  assert_saved 2026-10-04_12-00-00-2.png
  assert_clean
}

test_uri_encoding() {
  # Reserved characters in the path, and a byte outside ASCII.
  local home="$TEST_TMPDIR/a #b?c%d é"
  mkdir -p "$home"
  ENV=(HOME="$home")
  run
  assert_status 0
  assert_called "string:image-path:file://$TEST_TMPDIR/a%20%23b%3Fc%25d%20%C3%A9/Pictures/Screenshots/2026-10-04_12-00-00.png "
}

test_no_satty() {
  rm "$BIN/satty"
  run
  assert_status 0
  assert_called "-A open=Open -A delete=Delete Screenshot copied"
  assert_not_called "annotate"
}

test_open() {
  ENV=(NOTIFY_ACTION=open)
  run
  assert_status 0
  assert_called "xdg-open $SHOTS/2026-10-04_12-00-00.png"
  assert_saved 2026-10-04_12-00-00.png
}

test_open_failure() {
  ENV=(NOTIFY_ACTION=open OPEN_FAILS=1)
  run
  assert_status 0
  assert_called "Screenshot failed xdg-open: no handler"
}

test_annotate() {
  ENV=(NOTIFY_ACTION=annotate)
  run
  assert_called "satty --filename $SHOTS/2026-10-04_12-00-00.png"
}

test_delete() {
  ENV=(NOTIFY_ACTION=delete)
  run
  assert_status 0
  test ! -e "$SHOTS/2026-10-04_12-00-00.png" || fail_test "Delete left the file"
  assert_not_called "Screenshot failed"
}

test_annotate_interrupted() {
  ENV=(NOTIFY_ACTION=annotate SATTY_KILLED=1)
  run
  assert_called "satty --filename"
  assert_saved 2026-10-04_12-00-00.png
  assert_clean
}

test_dismissed() {
  run
  assert_not_called "xdg-open"
  assert_not_called "satty"
  assert_saved 2026-10-04_12-00-00.png
}

test_region() {
  run --region
  assert_status 0
  assert_called "grim -l 1 -g 1,2 3x4 "
  assert_called "Screenshot copied"
  assert_clean
}

test_region_cancel() {
  ENV=(SLURP_CANCELS=1)
  run -r
  assert_status 0
  test -z "$calls" || fail_test "a canceled region should do nothing"
  assert_clean
}

test_region_failure() {
  ENV=(SLURP_FAILS=1)
  run --region
  assert_status 1
  assert_not_called "grim"
  assert_called "Screenshot failed slurp: no layer shell"
  assert_clean
}

test_window() {
  run --window
  assert_status 0
  assert_called "grim -l 1 -g 10,20 300x400 "
  assert_called "Screenshot copied"
  assert_clean
}

test_window_wrapper() {
  set +e
  output="$(env PATH="$BIN:$PATH" HOME="$SHOTHOME" CALLS="$CALLS" TMPDIR="$SHOTTMP" "$BIN/screenshot-window" 2>&1)"
  status=$?
  set -e
  calls=$(cat "$CALLS")
  assert_status 0
  assert_called "grim -l 1 -g 10,20 300x400 "
}

test_no_window() {
  ENV=(ACTIVE_WINDOW='{}')
  run -w
  assert_status 0
  assert_not_called "grim"
  assert_called "No window to screenshot"
  assert_clean
}

test_window_lookup_failure() {
  ENV=(HYPRCTL_FAILS=1)
  run --window
  assert_status 1
  assert_not_called "grim"
  assert_called "Screenshot failed hyprctl: no socket"
  assert_clean
}

test_window_parse_failure() {
  ENV=(ACTIVE_WINDOW='not json')
  run --window
  assert_status 1
  assert_not_called "grim"
  assert_called "Screenshot failed jq: "
  assert_clean
}

test_empty_geometry() {
  run --geometry=
  assert_status 2
  test -z "$calls" || fail_test "an empty geometry should take no shot"
  run --geometry ''
  assert_status 2
  test -z "$calls" || fail_test "an empty geometry should take no shot"
}

test_delay() {
  run --delay 0
  assert_status 0
  assert_called "Screenshot copied"
  : > "$CALLS"
  run -d bogus
  assert_status 1
  assert_not_called "grim"
  assert_called "Screenshot failed sleep: "
  assert_clean
  : > "$CALLS"
  run --delay=
  assert_status 1
  assert_not_called "grim"
  assert_called "Screenshot failed sleep: "
  assert_clean
}

test_geometry() {
  run --geometry '5,6 7x8'
  assert_called "grim -l 1 -g 5,6 7x8 "
  : > "$CALLS"
  run --geometry='9,10 11x12'
  assert_status 0
  assert_called "grim -l 1 -g 9,10 11x12 "
  assert_clean
}

test_grim_failure() {
  ENV=(GRIM_FAILS=1)
  run
  assert_status 1
  assert_not_called "wl-copy"
  assert_called "Screenshot failed grim: no outputs"
  test -z "$(ls -A "$SHOTS" 2>/dev/null)" || fail_test "a failed shot was saved"
  assert_clean
}

test_wlcopy_failure() {
  ENV=(WLCOPY_FAILS=1)
  run
  assert_status 1
  assert_called "Screenshot failed wl-copy: no seat"
  assert_not_called "Screenshot copied"
  # The shot itself isn't lost.
  assert_saved 2026-10-04_12-00-00.png
  assert_clean
}

test_mktemp_failure() {
  ENV=(TMPDIR="$TEST_TMPDIR/missing")
  run
  assert_status 1
  assert_not_called "grim"
  assert_called "Screenshot failed mktemp: "
}

test_interrupted() {
  ENV=(GRIM_KILLED=1)
  run
  test "$status" -ne 0 || fail_test "an interrupted run should fail"
  assert_not_called "Screenshot copied"
  assert_clean
}

test_interrupted_mktemp() {
  ENV=(MKTEMP_KILLED=1)
  run
  assert_status 0
  assert_saved 2026-10-04_12-00-00.png
  assert_clean
}

test_bad_option() {
  run --bogus
  assert_status 2
  case "$output" in *"Usage: screenshot"*) ;; *) fail_test "no usage in: $output" ;; esac
  run --geometry
  assert_status 2
  test -z "$calls" || fail_test "a usage error should take no shot"
}

run_test "copies the whole screen as PNG and says so" test_screen
run_test "a second shot in the same second gets the next free name" test_same_second
run_test "a dangling symlink takes its name" test_dangling_symlink
run_test "a directory that can't be made is reported" test_unsavable
run_test "a directory that can't be written is reported" test_unwritable
run_test "a FIFO takes its name" test_fifo
run_test "a directory or a symlink to one takes its name" test_directory_name
run_test "a name that frees up before it's checked is taken" test_name_vanished
run_test "a filesystem without hard links is reported" test_no_hard_links
run_test "the thumbnail URI percent-encodes the path" test_uri_encoding
run_test "Annotate isn't offered without satty" test_no_satty
run_test "Open opens the saved shot" test_open
run_test "a failed Open is reported" test_open_failure
run_test "Annotate opens it in satty" test_annotate
run_test "an interrupted Annotate leaves no files behind" test_annotate_interrupted
run_test "Delete removes the saved shot" test_delete
run_test "dismissing the notification keeps the shot" test_dismissed
run_test "--region shoots the slurp selection" test_region
run_test "canceling a region is silent" test_region_cancel
run_test "any other slurp failure is reported" test_region_failure
run_test "--window shoots the focused window" test_window
run_test "screenshot-window shoots the focused window" test_window_wrapper
run_test "no focused window says so and takes no shot" test_no_window
run_test "a failed window lookup is reported" test_window_lookup_failure
run_test "unparsable window JSON is reported" test_window_parse_failure
run_test "--delay waits, and a bad delay is reported" test_delay
run_test "--geometry takes both argument forms" test_geometry
run_test "an empty --geometry is a usage error" test_empty_geometry
run_test "a grim failure is reported and copies nothing" test_grim_failure
run_test "a wl-copy failure is reported" test_wlcopy_failure
run_test "a mktemp failure is reported" test_mktemp_failure
run_test "an interrupted run leaves no files behind" test_interrupted
run_test "a signal while a temporary file is made leaves none behind" test_interrupted_mktemp
run_test "a bad option is a usage error" test_bad_option

echo "$TESTS_PASSED/$TESTS_RUN tests passed"
test "$TESTS_FAILED" -eq 0
