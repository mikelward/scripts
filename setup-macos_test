}

# The preflight says only what to do before the run: no prices, no
# alternatives to install, no account of what each dependency costs. tide
# dims the windows itself, so no dimming app is suggested either.
assert_preflight_is_only_what_to_do() {
    _preflight=$(printf '%s\n' "$output" | sed -n '/^Before continuing:/,/^The rest is listed at the end of the run\.$/p')
    if test -z "$_preflight"; then
        printf "%s\n" "  FAIL: no preflight in the output"
        echo "  output: $output"
        TEST_FAILED=1
        return 1
    fi
    if test "$(printf '%s\n' "$_preflight" | wc -l)" -gt 6; then
        printf "%s\n" "  FAIL: the preflight runs past 6 lines: $_preflight"
        TEST_FAILED=1
        return 1
    fi
    for _word in HazeOver JankyBorders "free" "one-time" "\$10" Setapp "open source" \
            "driver extension" "Optional"; do
        assert_output_lacks "$_word" || return 1
    done
}

