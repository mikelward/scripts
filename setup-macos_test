# A conf checkout from before the rename has timo.json, named "timo:", which
# tide still accepts: name that rule rather than warn it's missing.
test_tilemo_names_the_karabiner_rule_from_before_the_rename() {
    remove_amethyst
    stage_not_running Amethyst
    stage_not_running Rectangle
    printf '%s\n' '"description": "timo: Win is Super (Ctrl+Option+Command)"' \
        > "$TEST_TMPDIR/home/.config/karabiner/assets/complex_modifications/timo.json"
    run_macos --wm tide
    assert_status 0 &&
    assert_says "click Setup in its sidebar" &&
    assert_output_contains "timo.json predates the rename to tide and still works" &&
    assert_output_lacks "tide.json not found" &&
    assert_output_contains "macOS configured successfully"
}

